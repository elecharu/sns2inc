div.ItsNum {
    float:left;
    display:inline-block;
    margin-top:2px;
    margin-bottom:2px;
    background-color:transparent;
}
div.ItsNum_table {
    background-color:transparent;
}

div.ItsNum_table > span {
    vertical-align:middle;
    display:inline-block;
    text-align:right;
    background-color:transparent; 
    white-space: normal;
    font-family: 'SpoqaHanSansNeo_M';
    color:#565656;
}
div.ItsNum_table > input {
    outline: none;
    text-align:right;
    padding:0px 4px 0px 4px;
    vertical-align:middle;
    height:20px;
    border:1px solid #C0C0C0;
    box-sizing: border-box;
    line-height: 11px;
    font-weight:normal;
    font-size:12px;
    color:#565656;
}
div.ItsNum_table > input:focus                                      {    border:1px solid #4774B9;   }
div.ItsNum_table > input:focus ~ .ItsNum_button                     {    border-left:1px solid #4774B9;     }
div.ItsNum_table > input:focus:read-only                            {    border:1px solid #C0C0C0;     }
div.ItsNum_table > input:focus:read-only ~ .ItsNum_button           {    border-left:1px solid #C0C0C0;     }

div.ItsNum_table > input:read-only {    background-color:#F0F0F0;    color:#A3A3A3;     }
div.ItsNum_table > input:read-only ~ .ItsNum_button > .ItsNum_plus  {    background: url(../images/UserControl/ic_up_d.png) no-repeat, #FFFFFF; background-size: 20px 8px;    }
div.ItsNum_table > input:read-only ~ .ItsNum_button > .ItsNum_minus {    background: url(../images/UserControl/ic_down_d.png) no-repeat, #FFFFFF; background-size: 20px 8px;  }

div.ItsNum_button {
    display:inline-block;
    overflow:hidden;
    vertical-align:middle;
    height:18px;
    width:21px;
    text-align:center;
    border-left:1px solid #C0C0C0;
    position:absolute;
    margin-left: -22px;
    margin-top: 0.5px;
}

div.ItsNum_plus {
    cursor:pointer;
    display:block;
    text-align:center;
    height:8px;
    background: url(../images/UserControl/ic_up_n.png) no-repeat, #FFFFFF;
    background-size: 20px 9px;
    background-position-y:-1px;
}
div.ItsNum_bar {
    height:1px;
    background-color: #C0C0C0;
}
div.ItsNum_minus {
    cursor:pointer;
    display:block;
    text-align:center;
    height:8px;
    background: url(../images/UserControl/ic_down_n.png) no-repeat, #FFFFFF;
    background-size: 20px 9px;
    background-position-y: 1px;
}