<UserControl x:Class="ITSLIB.Combo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             Foreground="Black"
             mc:Ignorable="d"
             Height="28" MinHeight="28" MaxHeight="28"
             Width="200" MinWidth="100">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap" 
                   Width="75" 
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="DotumChe" />
        <Border DockPanel.Dock="Right" BorderThickness="1" BorderBrush="Silver" Height="22"
                x:Name="borderName"
                Visibility="Collapsed"
                Margin="-3 0 2 0"
                Background="Transparent">
            <TextBlock x:Name="comboCode"
                   Margin="2 0 2 0"
                       MaxWidth="35"
                       Text="{Binding Path=SelectedValue, ElementName=comboBox, Mode=OneWay}"
                   Foreground="Blue"
                   TextAlignment="Right"
                   VerticalAlignment="Center">
            </TextBlock>
        </Border>
        <ComboBox DockPanel.Dock="Right"
                 x:Name="comboBox" 
                 Height="22"
                 VerticalAlignment="Center" 
                 VerticalContentAlignment="Center"
                 Margin="3 3 2 3"
                 SelectedValue="{Binding RelativeSource={RelativeSource AncestorType=local:Combo}, Path=Value, Mode=TwoWay}"
                 KeyDown="comboBox_KeyDown"
                 GotFocus="comboBox_GotFocus"
                 LostFocus="comboBox_LostFocus" FontFamily="DotumChe" />
    </DockPanel>
</UserControl>
