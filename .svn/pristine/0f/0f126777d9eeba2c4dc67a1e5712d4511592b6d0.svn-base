<%@ Control Language="C#" AutoEventWireup="true" CodeFile="ItsTree.ascx.cs" Inherits="ItsTree" %>
<!-- ItsGrid -->
<div <% if (_ID != "") { %>id="<%= _ID %>" <% } %>
    class="ItsTree"
    style="<% if (_Float == "right") { %>float:right; <% } %>
    <% if (_Width != 0) { %>width:<%= _Width%>px; <% } %>" 
    <% if (_Height != 0) { %>height:<%= _Height%>px; <% } %>">
</div>