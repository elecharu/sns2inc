        if (startAddress.Contains("DW")) _Read_MEL_DW(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, false);
        else _Read_MEL(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, false);
    }
