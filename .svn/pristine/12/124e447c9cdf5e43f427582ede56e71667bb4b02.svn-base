        int ret_Leng = 4 * Convert.ToInt32(rtnObtainByte);

        if (rtnStr.Length >= 20)                            //20자리 이상일 경우엔 PLC와 제대로 통신이 된경우...
        {
            rtnStr = rtnStr.Substring(5, ret_Leng);
