    public static void Read_MEL_TCP(string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd)
    {
        Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
        socket.ReceiveTimeout = 3000;
        socket.SendTimeout = 3000;
        if (startAddress.Contains("DW")) _Read_MEL_DW(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, true);
        else _Read_MEL(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, true);
    }
    public static void Read_MEL_UDP(string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd)
    {
        Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);
        socket.ReceiveTimeout = 3000;
        socket.SendTimeout = 3000;
        if (startAddress.Contains("DW")) _Read_MEL_DW(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, true);
        else _Read_MEL(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, true);
    }
