    }
    public static string Read_MEL_TCP_SW(string ip, int port, string startAddress, string endAddress, string plctype)
    {
        Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);
        socket.ReceiveTimeout = 3000;
        socket.SendTimeout = 3000;
        Read_MEL_SW(socket, ip, port, startAddress, endAddress, plctype, false);
        return Read_MEL_SW(socket, ip, port, startAddress, endAddress, plctype, false); ;
    }
    public static void Read_MEL_A(string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd)
    {
        Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);
        socket.ReceiveTimeout = 3000;
        socket.SendTimeout = 3000;
        _Read_MEL_A(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, true);
    }
    public static void Read_NETEYE(string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd)
    {
        Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);
        socket.ReceiveTimeout = 3000;
        socket.SendTimeout = 3000;
        _Read_NETEYE(socket, ip, port, startAddress, endAddress, ref plcdata, plccd, true);
    }

    private static void _Read_MEL(Socket socket, string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd, bool isNum)
    {
        byte[] sendBuffer = new byte[21];
        sendBuffer[0] = 0x50;
        sendBuffer[1] = 0x00;
        sendBuffer[2] = 0x00;
        sendBuffer[3] = 0xFF;
        sendBuffer[4] = 0xFF;
        sendBuffer[5] = 0x03;
        sendBuffer[6] = 0x00;
        sendBuffer[7] = 0x0C;
        sendBuffer[8] = 0x00;
        sendBuffer[9] = 0x10;
        sendBuffer[10] = 0x00;
        sendBuffer[11] = 0x01;
        sendBuffer[12] = 0x04;
        sendBuffer[13] = 0x00;
        sendBuffer[14] = 0x00;

        int sInt = int.Parse(startAddress.ToUpper().Replace("D", "").Replace("W", ""));
        int eInt = int.Parse(endAddress.ToUpper().Replace("D", "").Replace("W", ""));

        byte[] b = BitConverter.GetBytes(sInt);

        Array.Reverse(b);

        sendBuffer[15] = b[3];
        sendBuffer[16] = b[2];
        sendBuffer[17] = b[1];
        sendBuffer[18] = 0xA8;
        sendBuffer[19] = (byte)(eInt - sInt + 1);
        sendBuffer[20] = (byte)((eInt - sInt + 1) >> 8);

        try
        {
            socket.SendTimeout = 5000;
            socket.Connect(ip, port);
            socket.Send(sendBuffer, 0, sendBuffer.Length, 0);

            byte[] receiveByte = new byte[1024];
            socket.ReceiveTimeout = 5000;
            int receiveLength = socket.Receive(receiveByte, receiveByte.Length, 0); //수신데이터 길이
            if (receiveLength > 0)
            {
                for (int i = sInt; i <= eInt; i++)
                {
                    string key = "0000" + i;
                    key = key.Substring(key.Length - 4, 4);
                    // 2018-03-20 추가 ( dictionary 관련 ) ----------------
                    string plckey = plccd + "D" + key;
                    if (!plcdata.ContainsKey(plckey)) continue;
                    //string plcValue = ((char)receiveByte[11 + (i - sInt) * 2]).ToString();
                    string plcValue = ((char)receiveByte[11 + (i - sInt) * 2]).ToString() + ((char)receiveByte[11 + (i - sInt) * 2 + 1]).ToString();
                    if (isNum)
                    {
                        //plcValue = string.Format("{0:x2}", receiveByte[11 + (i - sInt) * 2]);
                        plcValue = string.Format("{0:x2}", receiveByte[11 + (i - sInt) * 2 + 1]) + string.Format("{0:x2}", receiveByte[11 + (i - sInt) * 2]);
                        plcValue = Convert.ToInt32(plcValue, 16).ToString();
                    }
                    plcdata[plckey] = plcValue;
                    // ---------------------------------------------------
                }
            }
        }
        catch(Exception ex)
        {
            MessageBox.Show(ex.Message);
        }

        try
        {
            socket.Close();
        }
        catch(Exception ex)
        {
            MessageBox.Show(ex.Message);
        }
    }
    private static void _Read_MEL_DW(Socket socket, string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd, bool isNum)
    {
        Dictionary<string, string> AA = new Dictionary<string, string>();

        int sInt = int.Parse(startAddress.ToUpper().Replace("D", "").Replace("W", ""));
        int eInt = int.Parse(startAddress.ToUpper().Replace("D", "").Replace("W", ""))+1;

        for (int i = sInt; i <= eInt; i++)
        {

            AA.Add("D" + i, "");
            ItsPlcNet.Read_MEL_TCP(ip, port, "D" + i, "D" + i, ref AA, null);
        }

        string BB = "";
        string CC = "";

        BB += AA["D" + sInt];
        CC += AA["D" + eInt];

        int BI = Convert.ToInt32(BB);
        int CI = Convert.ToInt32(CC);

        //BB = Convert.ToString(BI, 2);
        //CC = Convert.ToString(CI, 2);

        //string RSTR = CC + BB;
        //int RINT = Convert.ToInt32(RSTR, 2);
        //string RVSTR = Convert.ToString(RINT);

        BB = Convert.ToString(BI, 16);
        CC = Convert.ToString(CI, 16);
        
        string RVSTR = Convert.ToInt32(CC + BB, 16).ToString();

        int key = sInt;
        string plckey = plccd + "DW" + key;

        plcdata[plckey] = RVSTR;
    }

    private static void _Read_MEL_A(Socket socket, string ip, int port, string startAddress, string endAddress, ref Dictionary<string, string> plcdata, string plccd, bool isNum)
    {
        string rtnStr = "";  // 통신결과
        //string rtnCardName = MELSEC-A; //차종코드..?(타입설정)
        string s_cmd = ""; //통신명령어
        string rtnKuck = "00"; //국번호
        string rtnAddInitial = ""; //시작이니셜
        string rtnAddNum = ""; //시작번지
        string rtnObtainByte = ""; //바이트수

        // 데이터 파싱
        if (startAddress.Length.Equals(6))
        {
            rtnAddInitial = "DW";
        }
        else
        {
            rtnAddInitial = "D";
        }
        rtnAddNum = startAddress.Replace("D", "").Replace("W", "");

        int sInt = int.Parse(startAddress.ToUpper().Replace("D", "").Replace("W", ""));
        int eInt = int.Parse(endAddress.ToUpper().Replace("D", "").Replace("W", ""));

        int rCount = eInt - sInt + 2;

        rtnObtainByte = 0 + Convert.ToString(rCount);
        rtnObtainByte = "05";

        //Buffer
        byte[] sendBuffer = null;
        byte[] receiveBuffer = null;

        //결과값 초기화
        rtnStr = "";

        int Convet_value = 0;
        s_cmd = "01FF000A" + Convet_value.ToString(string.Format("{0:X}", Convert.ToInt32(rtnAddInitial[0]))) + "2000000" + Convert.ToString(Convert.ToInt32(rtnAddNum), 16) + rtnObtainByte + "00";

        Socket clientSocket = null;
        //통신용 소켓 선언
        clientSocket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);

        // 소켓통신시 값을 전송하는 최대시간 설정 1000 = 1초
        clientSocket.SetSocketOption(SocketOptionLevel.Socket, SocketOptionName.SendTimeout, 3000);

        // 소켓통신시 값이 되돌아 오는 최대시간 설정 1000 = 1초
        clientSocket.SetSocketOption(SocketOptionLevel.Socket, SocketOptionName.ReceiveTimeout, 3000);


        // 서버(PLC) IP 셋팅
        IPAddress iPAddress = IPAddress.Parse(ip);
        IPEndPoint serverEP = new IPEndPoint(iPAddress, Convert.ToInt32(port));

        clientSocket.Connect(serverEP);                 //PLC에 접속

        // 버퍼 할당
        sendBuffer = new byte[2048];
        receiveBuffer = new byte[2048];

        sendBuffer = Encoding.ASCII.GetBytes(s_cmd);        // sendBuffer에 s_cmd 인코딩 후 입력

        clientSocket.Send(sendBuffer);         // 소켓을 통해 sendBuffer 전송

        int receivedSize = clientSocket.Receive(receiveBuffer, 2048, SocketFlags.None); //PLC에서 결과값 Receive

        rtnStr = Encoding.ASCII.GetString(receiveBuffer, 0, receivedSize);              //저장된 결과값 string 형식으로 변환	

        clientSocket.Close(); // 소켓 닫음

        sendBuffer = null;
        receiveBuffer = null;

        //할당된 바이트수에 따른 길이 생성
        int ret_Leng = 4 * Convert.ToInt32(rtnObtainByte);

        if (rtnStr.Length >= 20)                            //20자리 이상일 경우엔 PLC와 제대로 통신이 된경우...
        {
            rtnStr = rtnStr.Substring(4, ret_Leng);
        }

        int j = 0;

        for (int i = sInt; i <= eInt; i++)
        {
            string key = "0000" + i;
            key = key.Substring(key.Length - 4, 4);
            // 2018-03-20 추가 ( dictionary 관련 ) ----------------
            string plckey = plccd + "D" + key;
            if (!plcdata.ContainsKey(plckey)) continue;
            //string plcValue = ((char)receiveByte[11 + (i - sInt) * 2]).ToString();
            string plcValue = rtnStr.Substring(j * 4, 4);
            plcValue = Convert.ToInt32(plcValue, 16).ToString();

            plcdata[plckey] = plcValue;
            // ---------------------------------------------------
            j++;
        }
    }

