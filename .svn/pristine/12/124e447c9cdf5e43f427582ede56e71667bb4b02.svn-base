            // 2018-03-20 추가 ( dictionary 관련 ) ----------------
            string plckey = plccd + "D" + key;
            if (!plcdata.ContainsKey(plckey)) continue;
            //string plcValue = ((char)receiveByte[11 + (i - sInt) * 2]).ToString();
            string plcValue = rtnStr.Substring(j * 4, 4);
            plcValue = Convert.ToInt32(plcValue, 16).ToString();

            plcdata[plckey] = plcValue;
            // ---------------------------------------------------
            j = j + 1;
        }
    }

    private static string GetSumCheckCode(string strInputCmd)
    {
        try
        {
            char[] arTemp = strInputCmd.ToCharArray();
            int iTemp = 0;
            string sTemp = "";
            foreach (char cRecive in arTemp)
            {
                if (!cRecive.Equals((char)5))
                {
                    iTemp += Convert.ToInt32(cRecive);
                }
            }
            sTemp = Convert.ToString(iTemp, 16);

            return sTemp.ToUpper().Substring(sTemp.Length - 2);
        }
        catch
        {
            return "";
        }
    }
    private static string Read_MEL_SW(Socket socket, string ip, int port, string startAddress, string endAddress, string plctype, bool isNum)
    {
        // 변수 선언
        string rtnStr = "";  // 통신결과
        string rtnCardName = plctype; //차종코드..?(타입설정)
        string s_cmd = ""; //통신명령어
        string rtnKuck = "00"; //국번호
        string rtnAddInitial = ""; //시작이니셜
        string rtnAddNum = ""; //시작번지
        string rtnObtainByte = ""; //바이트수

        // 데이터 파싱
        if (startAddress.Length.Equals(6))
        {
            rtnAddInitial = "DW";
        }
        else
        {
            rtnAddInitial = "D";
        }
        rtnAddNum = startAddress.Replace("D", "").Replace("W", "");
        rtnObtainByte = endAddress;

        //Buffer
        byte[] sendBuffer = null;
        byte[] receiveBuffer = null;

        //결과값 초기화
        rtnStr = "";

        //PLC에 각 TYPE에 따른 명령문 작성
        if (rtnCardName == "Q")
        {
            s_cmd = "500000FF03FF" + rtnKuck + "0018000A04010000" + rtnAddInitial + "*" + rtnAddNum + "00" + rtnObtainByte;
        }
        else if (rtnCardName == "A")    //A-시리즈(cf.A-시리즈 명령어를 이용 Q-시리즈에서 사용해도 동일한 결과값을 얻을수 있다.)
        {
            int Convet_value = 0;
            s_cmd = "01FF000A" + Convet_value.ToString(string.Format("{0:X}", Convert.ToInt32(rtnAddInitial[0]))) + "2000000" + Convert.ToString(Convert.ToInt32(rtnAddNum), 16) + rtnObtainByte + "00";
        }
        else if (rtnCardName == "NETEYE")
        {
            s_cmd = (char)5 + "00FFWR0" + rtnAddInitial + rtnAddNum + rtnObtainByte;
        }
        else if (rtnCardName == "M0J2")    //M0J2(도시락 타입)
        {
            s_cmd = (char)5 + rtnKuck + "FFWR0" + rtnAddInitial + rtnAddNum + rtnObtainByte;   //명령어조합=> FFWR0:시작번지가 4자리일경우

            string summ = GetSumCheckCode(s_cmd);

            s_cmd = s_cmd + summ;                                  //SUM CHECK CODE 할당
        }
        else if (rtnCardName == "MasterK")     // NEYEYE - MASTER-K 통신 데이터
        {
            // 블럭수(데이터영역과 번지의 길이)
            string DataLan = string.Format("{0:00}", ("%" + rtnAddInitial + "W" + rtnAddNum).Length);

            s_cmd = (char)5 + rtnKuck + "RSB" + DataLan + "%" + rtnAddInitial + "W" + rtnAddNum + rtnObtainByte + (char)4;

            string summ = GetSumCheckCode(s_cmd);

            s_cmd = s_cmd + summ;                                  //SUM CHECK CODE 할당
        }

        Socket clientSocket = null;
        //통신용 소켓 선언
        clientSocket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);

        // 소켓통신시 값을 전송하는 최대시간 설정 1000 = 1초
        clientSocket.SetSocketOption(SocketOptionLevel.Socket, SocketOptionName.SendTimeout, 40000);

        // 소켓통신시 값이 되돌아 오는 최대시간 설정 1000 = 1초
        clientSocket.SetSocketOption(SocketOptionLevel.Socket, SocketOptionName.ReceiveTimeout, 40000);


        // 서버(PLC) IP 셋팅
        IPAddress iPAddress = IPAddress.Parse(ip);
        IPEndPoint serverEP = new IPEndPoint(iPAddress, Convert.ToInt32(port));

        clientSocket.Connect(serverEP);                 //PLC에 접속

        // 버퍼 할당
        sendBuffer = new byte[2048];
        receiveBuffer = new byte[2048];

        sendBuffer = Encoding.ASCII.GetBytes(s_cmd);        // sendBuffer에 s_cmd 인코딩 후 입력

        clientSocket.Send(sendBuffer);         // 소켓을 통해 sendBuffer 전송

        int receivedSize = clientSocket.Receive(receiveBuffer, 2048, SocketFlags.None); //PLC에서 결과값 Receive

        rtnStr = Encoding.ASCII.GetString(receiveBuffer, 0, receivedSize);              //저장된 결과값 string 형식으로 변환	

        clientSocket.Close(); // 소켓 닫음

        sendBuffer = null;
        receiveBuffer = null;

        //할당된 바이트수에 따른 길이 생성
        int ret_Leng = 4 * Convert.ToInt32(rtnObtainByte);

        if (rtnStr.Length >= 20)                            //20자리 이상일 경우엔 PLC와 제대로 통신이 된경우...
        {
            if (rtnCardName == "NETEYE")                //Net-Eye방식일땐 5자리에서 20자리까지 끊어서 반환
            {
                rtnStr = rtnStr.Substring(5, ret_Leng);
            }
            else if (rtnCardName == "Q")                //Q-시리즈 일경우엔 22자리에서 20자리까지 끊어서 반환
            {
                rtnStr = rtnStr.Substring(22, ret_Leng);
            }
            else if (rtnCardName == "A")                //A-시리즈
            {
                rtnStr = rtnStr.Substring(4, ret_Leng);
            }
            else if (rtnCardName == "M0J2")              //M0J2카드(도시락 타입)는 6자리에서 할당된 번지갯수 만큼 반환
            {
                rtnStr = rtnStr.Substring(5, ret_Leng);
            }
            else if (rtnCardName == "MasterK")              //Master
            {
                rtnStr = rtnStr.Substring(10, ret_Leng);
            }
        }
        return rtnStr;              // 결과값 리턴
    }

    public static string _Read_MEL_DW_SINGLE(string ip, int port, string startAddress, string endAddress, string plccd, bool isNum)
    {
        Socket socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
        socket.ReceiveTimeout = 3000;
        socket.SendTimeout = 3000;

        Dictionary<string, string> AA = new Dictionary<string, string>();

        int sInt = int.Parse(startAddress.ToUpper().Replace("D", "").Replace("W", ""));
        int eInt = int.Parse(startAddress.ToUpper().Replace("D", "").Replace("W", "")) + 1;

        for (int i = sInt; i <= eInt; i++)
        {

            AA.Add("D" + i, "");
            ItsPlcNet.Read_MEL_TCP(ip, port, "D" + i, "D" + i, ref AA, null);
        }

        string BB = "";
        string CC = "";

        BB += AA["D" + sInt];
        CC += AA["D" + eInt];

        int BI = Convert.ToInt32(BB);
        int CI = Convert.ToInt32(CC);

        //BB = Convert.ToString(BI, 2);
        //CC = Convert.ToString(CI, 2);
        BB = Convert.ToString(BI, 16);
        CC = Convert.ToString(CI, 16);

        string RSTR = Convert.ToInt32(CC + BB, 16).ToString();

        int key = sInt;
        string plckey = plccd + "DW" + key;

        //plcdata[plckey] = RVSTR;

        return RSTR;
    }

