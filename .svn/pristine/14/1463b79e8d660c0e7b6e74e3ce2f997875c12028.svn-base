<UserControl x:Class="ITSLIB.Number"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             Height="28" MinHeight="28" MaxHeight="28"
             Width="200" MinWidth="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="KEY_NUM" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="#333333" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_COMMON" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="SeaGreen" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_MOVE" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="SteelBlue" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_CLOSE" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="IndianRed" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ICON_KEYPAD" TargetType="{x:Type UserControl}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Silver"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Popup x:Name="popup" 
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=numericBox}">
            <DockPanel Background="Silver">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_NUM}" Content="1" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="2" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="3" />
                            <Label Style="{DynamicResource KEY_COMMON}" Content="Clear" Width="50" />
                            <Label Style="{DynamicResource KEY_CLOSE}" Content="✖" Width="30" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_NUM}" Content="4" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="5" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="6" />
                            <Label Style="{DynamicResource KEY_COMMON}" Content="Backspace" Width="82" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_NUM}" Content="7" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="8" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="9" />
                            <Label Style="{DynamicResource KEY_COMMON}" Content="Delete" Width="82" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 2 2">
                            <Label Style="{DynamicResource KEY_NUM}" Content="0" Width="82" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="." />
                            <Label Style="{DynamicResource KEY_MOVE}" Content="◀" Width="40" />
                            <Label Style="{DynamicResource KEY_MOVE}" Content="▶" Width="40" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Popup>
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap"
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="DotumChe" />
        <TextBlock DockPanel.Dock="Right" 
                   x:Name="textUnit"
                   TextWrapping="Wrap" 
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
        <UserControl DockPanel.Dock="Right"
                     x:Name="keyPadIcon"
                     Width="20" Height="20" 
                     HorizontalAlignment="Right"
                     Style="{DynamicResource ICON_KEYPAD}"
                     MouseUp="canvas_MouseUp">
            <Canvas x:Name="canvas" 
                    Width="16" 
                    Height="16">
                <Line X1="2" Y1="1" X2="14" Y2="1" Stroke="Gray" StrokeThickness="2"/>
                <Line X1="2" Y1="0" X2="2" Y2="16" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="14" Y1="0" X2="14" Y2="16" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="2" Y1="5.5" X2="14" Y2="5.5" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="2" Y1="8" X2="14" Y2="8" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="2" Y1="10.5" X2="14" Y2="10.5" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="2" Y1="13" X2="14" Y2="13" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="2" Y1="15.5" X2="14" Y2="15.5" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="5" Y1="5" X2="5" Y2="15.5" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="8" Y1="5" X2="8" Y2="15.5" Stroke="Gray" StrokeThickness="1"/>
                <Line X1="11" Y1="5" X2="11" Y2="15.5" Stroke="Gray" StrokeThickness="1"/>
            </Canvas>
        </UserControl>
        <dxe:SpinEdit x:Name="numericBox" 
                      DockPanel.Dock="Right"
                      Mask="###,###,###,##0.0000" 
                      DisplayFormatString="###,###,###,##0.0000"
                      NullValue="0"
                      MaxValue="999999999999" 
                      MinValue="0"
                      Height="22"
                      BorderBrush="Silver"
                      BorderThickness="1"
                      VerticalAlignment="Center" 
                      VerticalContentAlignment="Center"
                      Margin="3"
                      EditValueChanged="numericBox_ValueChanged"
                      MouseDoubleClick="numericBox_MouseDoubleClick"
                      GotFocus="numericBox_GotFocus"
                      LostFocus="numericBox_LostFocus" FontFamily="DotumChe">
        </dxe:SpinEdit>
    </DockPanel>
</UserControl>
