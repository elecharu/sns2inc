.SplitVBar {
    display: inline-block;
    float: left;
    height: 100%;
    min-height: 20px;
    border-left: 1px solid rgba(0, 0, 0, 0.05);
    border-right: 1px solid rgba(0, 0, 0, 0.05);
    background-color: #FAFAFA;
}
.SplitVBar.resizeableSplit {
    cursor:col-resize;
    background: url(../../images/SplitBar/img_splitbar_y.png) no-repeat #FAFAFA;
    background-size: 6px 17px;
    background-position-y: center;
    background-position-x: right;
    /*image-rendering: -webkit-optimize-contrast;*/
} 
.SplitHBar {
    display: block;
    width:100%;
    /*box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.1);*/
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    background-color:#FAFAFA;
}
.SplitHBar.resizeableSplit {
    cursor:row-resize;
    background: url(../../images/SplitBar/img_splitbar_x.png) no-repeat #FAFAFA;
    background-size: 16px 7px;
    background-position-y: center;
    background-position-x: center;
} 
.SplitVBar.resizeableSplit:hover {
    border-left: 1px solid rgba(0, 163, 255, 0.25);
    border-right: 1px solid rgba(0, 163, 255, 0.25);
}
.SplitHBar.resizeableSplit:hover {
    border-top: 1px solid rgba(0, 163, 255, 0.25);
    border-bottom: 1px solid rgba(0, 163, 255, 0.25);
}