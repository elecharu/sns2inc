<UserControl x:Class="ITSLIB.FileManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             MinHeight="28" MaxHeight="28" Height="28"
             Width="200" MinWidth="100">
    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Right" LastChildFill="True">
            <Canvas Width="20" Height="20" x:Name="DELETE"
                    MouseDown="DELETE_MouseDown"
                    Visibility="Visible"
                    DockPanel.Dock="Right" Margin="2 1 2 0" Background="Silver">
                <Line X1="3" Y1="3" X2="17" Y2="17" Stroke="IndianRed" StrokeThickness="2"></Line>
                <Line X1="3" Y1="17" X2="17" Y2="3" Stroke="IndianRed" StrokeThickness="2"></Line>
            </Canvas>
            <Canvas Width="20" Height="20" x:Name="UPLOAD"
                    MouseDown="UPLOAD_MouseDown"
                    Visibility="Visible"
                    DockPanel.Dock="Right" Margin="2 1 0 0" Background="Silver">
                <Line X1="2" Y1="10" X2="10" Y2="2" Stroke="SteelBlue" StrokeThickness="2"></Line>
                <Line X1="10" Y1="2" X2="18" Y2="10" Stroke="SteelBlue" StrokeThickness="2"></Line>
                <Line X1="10" Y1="2" X2="10" Y2="18" Stroke="SteelBlue" StrokeThickness="2"></Line>
            </Canvas>
            <Canvas Width="20" Height="20" x:Name="DOWNLOAD"
                    MouseDown="DOWNLOAD_MouseDown"
                    Visibility="Visible"
                    DockPanel.Dock="Right" Margin="2 1 0 0" Background="Silver">
                <Line X1="2" Y1="10" X2="10" Y2="18" Stroke="SteelBlue" StrokeThickness="2"></Line>
                <Line X1="10" Y1="18" X2="18" Y2="10" Stroke="SteelBlue" StrokeThickness="2"></Line>
                <Line X1="10" Y1="2" X2="10" Y2="18" Stroke="SteelBlue" StrokeThickness="2"></Line>
            </Canvas>
            <Canvas Width="20" Height="20" x:Name="OPEN"
                    MouseDown="OPEN_MouseDown"
                    Visibility="Visible"
                    DockPanel.Dock="Right" Margin="2 1 0 0" Background="Silver">
                <Line X1="2" Y1="10" X2="18" Y2="10" Stroke="SeaGreen" StrokeThickness="2"></Line>
                <Line X1="10" Y1="2" X2="10" Y2="18" Stroke="SeaGreen" StrokeThickness="2"></Line>
            </Canvas>
        </DockPanel>
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   Text="파일"
                   TextWrapping="Wrap" 
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="DotumChe" />
        <TextBlock x:Name="ERRMSG" DockPanel.Dock="Right" 
                           Visibility="Collapsed" 
                           Foreground="Red"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center">업로드하세요.</TextBlock>
        <TextBox DockPanel.Dock="Left"
                 x:Name="textBox"
                 Margin="5 0 0 0"
                 Background="LightYellow"
                 TextAlignment="Left"
                 IsReadOnly="True"
                 MouseDown="textBox_MouseDown"
                 VerticalAlignment="Center" />
    </DockPanel>
</UserControl>
