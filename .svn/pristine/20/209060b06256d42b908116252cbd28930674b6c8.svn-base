/// <reference path="../../Script/reference.js" />

/* 페이지 로드 시 수행 */
ItsPage.Load = function () {
    
    /* 그리드 생성 */
    ItsGrid.Create('grid1', { isCheckBoxGrid: false }, [
        
        column.create("모품목ID", "MITEMID", { width: 100, align: 'center' }),
        column.create("모품명", "MITEMNM", { width: 250 }),
        column.create("모품목유형", "MITEMCG", { width: 100, align: 'center', columnType: enumColumnTypes.combo, gpcd: 'DM100' }),
        column.create("자품목ID", "CITEMID", { width: 100, align: 'center' }),
        column.create("자품명", "CITEMNM", { width: 250 }), 
        column.create("자품목유형", "CITEMCG", { width: 100, align: 'center', columnType: enumColumnTypes.combo, gpcd: 'DM100' }),
        column.create("작업순번", "PRCSEQ", { width: 100, align: 'center' }),
        column.create("소요수량", "MUSAGE", { width: 100, align: 'center' }),
        column.create("LOSS수량", "LUSAGE", { width: 100, align: 'center' }),
        column.create("실소요량", "CUSAGE", { width: 100, align: 'center' }),
        column.create("단위", "BOMUNIT", { width: 100, align: 'center', columnType: enumColumnTypes.combo, gpcd: 'DM150' }),
        //column.create("공급구분", "SRC_BC", { width: 100, align: 'center' }),
        //column.create("출고구분", "USE_BC", { width: 100, align: 'center' }),
        //column.create("생산공정", "PRCCD", { width: 100, align: 'center' }),
        //column.create("적용시작일", "USEFRDT", { width: 100, align: 'center' }),
        //column.create("적용종료", "USETODT", { width: 100, align: 'center' }),
        //column.create("도면번호", "DRAWNO", { width: 100, align: 'center' }),
        //column.create("ECO번호", "ECONO", { width: 100, align: 'center' }),
        column.create("등록ID", "REGID", { width: 100, align: 'center', columnType: enumColumnTypes.number }),
        column.create("사용여부", "USEYN", { width: 100, align: 'center', columnType: enumColumnTypes.check }),
        column.create("비고", "REMARK", { width: 100, align: 'center' }),
        column.split()
    ]);
};

/* 조회 */
ItsButton.EventSearch = function () {

    var maria = new ItsMaria('MST1001_R03', 'SEL_BOM');
    maria.AddPanel('sdiv1');
    maria.CallProc();
    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid1', maria.store.YnToBool('USEYN'));
    ItsMsg.Toast(maria.store.Length() + '건이 조회되었습니다.');
    ItsGrid.Get('grid1').autoSizeColumns();
};









