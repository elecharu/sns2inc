using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;

namespace ITSSCHEDULER
{
    public partial class MainForm : Form
    {
        public static string _VALUE11 = "";
        public static string _VALUE12 = "";
        public static string _VALUE21 = "";
        public static string _VALUE22 = "";
        public static string _VALUE31 = "";
        public static string _VALUE32 = "";

        public static string _ERRMSG = "";

        System.Timers.Timer _serialTimer = new System.Timers.Timer();
        System.Windows.Forms.Timer _formTimer = new System.Windows.Forms.Timer();
        public MainForm()
        {
            InitializeComponent();

            // 중복 실행 확인
            bool isRun = false;
            System.Diagnostics.Process currentProcess = System.Diagnostics.Process.GetCurrentProcess();
            System.Diagnostics.Process[] processess = System.Diagnostics.Process.GetProcesses();
            foreach (System.Diagnostics.Process process in processess)
            {
                if (currentProcess.Id != process.Id)
                {
                    if (currentProcess.ProcessName == process.ProcessName)
                    {
                        isRun = true;
                        break;
                    }
                }
            }
            if (isRun)
            {
                MessageBox.Show("프로그램이 이미 실행중입니다.\n\n트레이 아이콘을 확인하세요.");
                this.Close();
            }
            else
            {
                // 시리얼 설정
                if (!System.IO.File.Exists("PLCPORT.txt"))
                {
                    System.IO.File.WriteAllText("PLCPORT.txt", "COM1", Encoding.UTF8);
                }
                ItsSerial.SerialPlc.Close();
                ItsSerial.SerialPlc.PortName = System.IO.File.ReadAllText("PLCPORT.txt", Encoding.UTF8);
                ItsSerial.SerialPlc.BaudRate = 9600;
                ItsSerial.SerialPlc.DataBits = 8;
                ItsSerial.SerialPlc.RtsEnable = false;
                ItsSerial.SerialPlc.ReceivedBytesThreshold = 1;
                ItsSerial.SerialPlc.Parity = System.IO.Ports.Parity.None;
                ItsSerial.SerialPlc.StopBits = System.IO.Ports.StopBits.One;

                // 입출수 온도 업데이트
                _serialTimer.Interval = 5 * 1000; // 5초간격
                _serialTimer.Elapsed += serialTimer_Elapsed;
                _serialTimer.Enabled = true;
                serialTimer_Elapsed(_serialTimer, null);
                _serialTimer.Start();

                // 값 화면에 표시
                _formTimer.Interval = 1 * 1000; // 1초 간격
                _formTimer.Tick += FormTimer_Tick;
                _formTimer.Enabled = true;
                _formTimer.Start();
            }
        }

        private void FormTimer_Tick(object sender, EventArgs e)
        {
            lbl_value11.Text = _VALUE11;
            lbl_value12.Text = _VALUE12;
            lbl_value21.Text = _VALUE21;
            lbl_value22.Text = _VALUE22;
            lbl_value31.Text = _VALUE31;
            lbl_value32.Text = _VALUE32;

            label_errmsg.Text = _ERRMSG;
            if (label_errmsg.Text.Trim() == "")
            {
                label_errmsg.Visible = false;
            }
            else
            {
                label_errmsg.BringToFront();
                label_errmsg.Visible = true;
            }
        }

        private void serialTimer_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            (sender as System.Timers.Timer).Stop();

            decimal VALUE11 = 0m;
            decimal VALUE12 = 0m;
            decimal VALUE21 = 0m;
            decimal VALUE22 = 0m;
            decimal VALUE31 = 0m;
            decimal VALUE32 = 0m;

            decimal RUN1 = 0m;
            decimal RUN2 = 0m;

            decimal TIME1 = 0m;
            decimal TIME2 = 0m;

            decimal MAX_IN_1 = 0m;
            decimal MAX_OUT_1 = 0m;
            decimal MAX_IN_2 = 0m;
            decimal MAX_OUT_2 = 0m;

            ItsSerial.SerialPlc.Close();
            ItsSerial.SerialPlc.PortName = System.IO.File.ReadAllText("PLCPORT.txt", Encoding.UTF8);

            try
            {
                VALUE11 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0101", 1); // 왼쪽 입수온도
                VALUE12 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0111", 1); // 오른쪽 입수온도

                VALUE21 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0102", 1); // 왼쪽 출수 온도
                VALUE22 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0112", 1); // 오른쪽 출수온도

                VALUE31 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0103", 1); // 왼쪽 고무 온도
                VALUE32 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0113", 1); // 오른쪽 고무 온도

                RUN1 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0104", 1); // 가동상태
                RUN2 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0114", 1); // 가동상태

                TIME1 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0105", 1); // 가동시간
                TIME2 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0115", 1); // 가동시간

                //MAX_IN_1 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0410", 1); // 왼쪽 입수 상한
                //MAX_OUT_1 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0411", 1); // 왼쪽 출수 상한

                MAX_IN_2 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0400", 1); // 오른쪽 입수 상한
                MAX_OUT_2 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0401", 1); // 오른쪽 출수 상한
            }
            catch
            {
                _ERRMSG = "시리얼 포트를 연결할 수 없습니다. " + ItsSerial.SerialPlc.PortName;
                (sender as System.Timers.Timer).Start();
                return;
            }

            _VALUE11 = VALUE11.ToString("###,###,##0.0") + "℃";
            _VALUE12 = VALUE12.ToString("###,###,##0.0") + "℃";
            _VALUE21 = VALUE21.ToString("###,###,##0.0") + "℃";
            _VALUE22 = VALUE22.ToString("###,###,##0.0") + "℃";
            _VALUE31 = VALUE31.ToString("###,###,##0.0") + "℃";
            _VALUE32 = VALUE32.ToString("###,###,##0.0") + "℃";

            ItsMaria.Set("PLC_GATHERING", "UP_CUR");
            ItsMaria.AddOne("PLCCD", "MIX02");
            ItsMaria.AddList("ADDRLIST", "DW0101");
            ItsMaria.AddList("VALUELIST", VALUE11);
            ItsMaria.AddList("ADDRLIST", "DW0111");
            ItsMaria.AddList("VALUELIST", VALUE12);
            ItsMaria.AddList("ADDRLIST", "DW0102");
            ItsMaria.AddList("VALUELIST", VALUE21);
            ItsMaria.AddList("ADDRLIST", "DW0112");
            ItsMaria.AddList("VALUELIST", VALUE22);
            ItsMaria.AddList("ADDRLIST", "DW0103");
            ItsMaria.AddList("VALUELIST", VALUE31);
            ItsMaria.AddList("ADDRLIST", "DW0113");
            ItsMaria.AddList("VALUELIST", VALUE32);

            ItsMaria.AddList("ADDRLIST", "DW0400");
            ItsMaria.AddList("VALUELIST", MAX_IN_2);
            ItsMaria.AddList("ADDRLIST", "DW0401");
            ItsMaria.AddList("VALUELIST", MAX_OUT_2);

            ItsMaria.AddList("ADDRLIST", "DW0104");
            ItsMaria.AddList("VALUELIST", RUN1);
            ItsMaria.AddList("ADDRLIST", "DW0114");
            ItsMaria.AddList("VALUELIST", RUN2);

            ItsMaria.AddList("ADDRLIST", "DW0105");
            ItsMaria.AddList("VALUELIST", TIME1);
            ItsMaria.AddList("ADDRLIST", "DW0115");
            ItsMaria.AddList("VALUELIST", TIME2);

            DataSet ds = ItsMaria.Call();
            if (ItsMaria.IsError)
            {
                _ERRMSG = "MariaDB에 입출수정보를 업데이트하지 못했습니다. " + ItsMaria.Addr + "," + ItsMaria.Port;
            }
            else
            {
                _ERRMSG = "";
            }

            foreach (DataTable dt in ds.Tables)
            {
                dt.Dispose();
            }
            ds.Dispose();

            (sender as System.Timers.Timer).Start();
        }

        private void MainForm_Load(object sender, EventArgs e)
        {
            panel_config.Visible = false;
            label_errmsg.Visible = false;
        }
        private bool IsClose = false;
        private void MainForm_FormClosing(object sender, FormClosingEventArgs e)
        {
            if (IsClose == true) return;

            e.Cancel = true;
            this.Visible = false;
        }

        private void notifyIcon1_DoubleClick(object sender, EventArgs e)
        {
            this.Visible = true;
        }

        private void notifyIcon1_Click(object sender, EventArgs e)
        {
            this.Visible = true;
        }

        private void closeToolStripMenuItem_Click(object sender, EventArgs e)
        {
            this.IsClose = true;
            this.Close();
        }

        private void btnConfig_Click(object sender, EventArgs e)
        {
            _serialTimer.Stop();

            _ERRMSG = "";

            panel_config.BringToFront();
            panel_config.Dock = DockStyle.Fill;
            panel_config.Visible = true;

            GetStt();
        }

        private void btnConfigClose_Click(object sender, EventArgs e)
        {
            panel_config.Visible = false;

            _serialTimer.Start();
            serialTimer_Elapsed(_serialTimer, null);
        }

        private void btnConfigSave_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("입출수 표준값을 수정하시겠습니까?", "ITSCO", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.Yes)
            {
                ItsSerial.SerialPlc.Close();
                ItsSerial.SerialPlc.PortName = System.IO.File.ReadAllText("PLCPORT.txt", Encoding.UTF8);

                bool isOk = true;
                if (isOk == true)
                {
                    isOk = ItsSerial.Write(ItsSerial.SerialPlc, "DW0400", ((int)(NUM_STD_1_IN.Value)).ToString());
                }
                if (isOk == true)
                {
                    ItsSerial.Write(ItsSerial.SerialPlc, "DW0401", ((int)(NUM_STD_1_OUT.Value)).ToString());
                }

                if (isOk == true)
                {
                    _ERRMSG = "";
                    btnConfigClose_Click(null, null);
                }
                else
                {
                    _ERRMSG = "표준값을 저장하지 못했습니다. \n\n시리얼포트 연결을 확인하세요.";
                }
            }
        }

        private void GetStt()
        {
            ItsSerial.SerialPlc.Close();
            ItsSerial.SerialPlc.PortName = System.IO.File.ReadAllText("PLCPORT.txt", Encoding.UTF8);

            try
            {
                NUM_STD_1_IN.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0400", 1); 
                NUM_STD_1_OUT.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0401", 1); 
            }
            catch
            {
                _ERRMSG = "시리얼 포트를 연결할 수 없습니다. " + ItsSerial.SerialPlc.PortName;
            }
        }
    }
}
