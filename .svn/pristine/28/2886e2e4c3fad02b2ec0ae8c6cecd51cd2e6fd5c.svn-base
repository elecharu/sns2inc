::-webkit-scrollbar {width: 8px; height: 8px; border: 4px solid #fff; }
::-webkit-scrollbar-button:start:decrement, ::-webkit-scrollbar-button:end:increment {display: block; height: 10px; background: #efefef}
::-webkit-scrollbar-track {background-color: #F0F0F0; border-radius:3px;}
::-webkit-scrollbar-thumb {height: 50px;width: 50px;background-color:#C0C0C0;-webkit-border-radius: 3px;border-radius: 8px;-webkit-box-shadow: inset 0 0 4px rgba(0,0,0,.1);}
::-webkit-scrollbar-thumb:hover {height: 50px; width: 50px; background-color:#4774B9; -webkit-border-radius: 3px; border-radius: 3px; -webkit-box-shadow: inset 0 0 4px rgba(0,0,0,.1)}
.msgbox-modal { background-color:transparent !important; }
html {  margin:0px; padding:0px;  }
@charset "utf-8";
@font-face { src: url("/fonts/SpoqaHanSansNeo_TTF_original/SpoqaHanSansNeo-Regular.ttf");    font-family: "SpoqaHanSansNeo_R"; }
@font-face { src: url("/fonts/SpoqaHanSansNeo_TTF_original/SpoqaHanSansNeo-Medium.ttf");    font-family: "SpoqaHanSansNeo_M"; }
@font-face { src: url("/fonts/SpoqaHanSansNeo_TTF_original/SpoqaHanSansNeo-Bold.ttf");    font-family: "SpoqaHanSansNeo_B"; }
@media screen and (max-width:1200px) {
    #MAIN_INFO > #MAIN_PATH > #MAIN_MENUPATH {
        display: none;
    }
}
body { 
    /*margin-left:12px; 
    margin-right:12px;*/ 
    padding: 0px; 
    background-color: #F3F3F3; 
    font-family: 'SpoqaHanSansNeo_R', 'sans-serif'; 
    overflow: hidden;
    /*min-width: 1000px;*/
}
#MAIN_INFO {
    height:100px;
    display:flex;
    background-color:#F3F3F3;
    border-left: 6px solid #4774B9;
    border-top-right-radius:5px;
    border-bottom-right-radius:5px;
    box-shadow: 1px 1px 10px rgba(0,0,0,0.1);
}
#MAIN_INFO_SPLIT  { 
    width:4px; 
    height:40px; 
    background-color:#FFFFFF;  
}
#MAIN_INFO_SPLIT2 { 
    width:4px; 
    height:40px; 
    background-color: #F3F3F3; 
    border: 1px solid #F3F3F3;
    /*border-bottom-right-radius: 10px;*/  
    position: relative; 
}
/* 타이틀 및 커스텀버튼영역 */
#MAIN_INFO > #MAIN_TITLE {
    float:left; 
    height:40px;
    font-family: 'SpoqaHanSansNeo_B';
    font-size:18px;
    color:#4774B9;
    background-color:white;
    display: inline-block;
    min-width:453px;
    border-top-right-radius:5px;
    border-bottom-right-radius:5px;
    padding-right:15px;
}
#MAIN_INFO > #MAIN_TITLE > #MAIN_TITLE_TEXT { 
    margin-top: 8px;
    margin-left:25px; 
    width: 210px; 
    height: 40px; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    display: inline-block; 
}
#MAIN_INFO > #MAIN_TITLE > #MAIN_CUSTOM_BUTTON { 
    height:40px; 
    margin-top:8px; 
    display: inline-block; 
    float:right;
}
/* 화면정보 영역 */
#MAIN_TOAST {
    /*width: calc(100% - 400px);*/
    height: 40px;
    margin-left:8px;
    padding-left:38px;
    display:inline-block;
    font-size:14px;
    font-family: 'SpoqaHanSansNeo_M';
    font-style:normal;
    color:#565656;
    position: relative;
    background: url(../../images/TitleBar/ic_titlebar_helper.png?ver=1.0) no-repeat; 
    background-size: 32px 32px;
    background-position-x:left;
    background-position-y:center;
}
#MAIN_TOAST > div {
    top: 50%;
    transform: translateY(-50%);
    position: relative
}
#MAIN_INFO > #MAIN_PATH { 
    background-color:white; 
    flex-grow: 1; 
    height: 40px;
    border-top-left-radius:5px; 
    border-bottom-left-radius: 5px;
    overflow:hidden;  
}
#MAIN_INFO > #MAIN_PATH > #MAIN_MENUPATH { 
    float:right;
    background-color: white;
    padding-top: 12px;
    height:100%;
    font-family: 'SpoqaHanSansNeo_M'; 
    font-size:12px; 
    color:#727171; 
    padding-right:20px; 
}
#MAIN_INFO > #MAIN_PATH > #MAIN_PAGENAME { 
    float:right; 
    background-color: white;
    padding-top: 12px;
    height:100%;
    color:#B8B8B8; 
    padding-right:4px; 
}
#COMMON_HELP { 
    margin: 0px 10px;
    height:100%;
    background: url(../../images/TabBar/ic_tab_info.png) no-repeat white;    
    background-size: 24px 24px; 
    background-position-x:center; 
    background-position-y:center;
}
#COMMON_HELP > .ItsButton_table {
    width:24px;
    height:37px;
    line-height:37px;
}

#MAIN_BODY {
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background-color: white;
    position: fixed !important;
}
div.SearchPanel {
    background-color: #FAFAFA !important;
    padding: 10px 0px;
    /*border-top: 2px solid #A3A3A3;*/
    border-bottom: 4px solid #DDDDDD;
    height: 70px;
}
#MAIN_POP {  }

/* 공통 버튼 */
#MAIN_BUTTON { 
    background-color:white; 
    min-width: 450px;
    height:70px;    
    border-bottom-left-radius:5px;    
    border-bottom-right-radius:5px;    
    box-shadow: 0px 1px 10px rgba(0,0,0,0.1); 
}
#COMMON_SEARCH                    { background: url(../../images/ButtonBar/ic_button_search.png) no-repeat;    background-size: 38px 38px; background-position-x:center; background-position-y:5px; margin-left:10px !important; }
#COMMON_INIT                      { background: url(../../images/ButtonBar/ic_button_reset.png) no-repeat;     background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_ADD                       { background: url(../../images/ButtonBar/ic_button_add.png) no-repeat;       background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_SAVE                      { background: url(../../images/ButtonBar/ic_button_save.png) no-repeat;      background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_DELETE                    { background: url(../../images/ButtonBar/ic_button_delete.png) no-repeat;    background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_PRINT                     { background: url(../../images/ButtonBar/ic_button_print.png) no-repeat;     background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_EXPORT                    { background: url(../../images/ButtonBar/ic_button_reset.png) no-repeat;     background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_CLOSE                     { background: url(../../images/ButtonBar/ic_button_close.png) no-repeat;     background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_SEARCH.ItsButton_disabled { background: url(../../images/ButtonBar/ic_button_search_d.png) no-repeat;  background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_INIT.ItsButton_disabled   { background: url(../../images/ButtonBar/ic_button_reset_d.png) no-repeat;   background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_ADD.ItsButton_disabled    { background: url(../../images/ButtonBar/ic_button_add_d.png) no-repeat;     background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_SAVE.ItsButton_disabled   { background: url(../../images/ButtonBar/ic_button_save_d.png) no-repeat;    background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_DELETE.ItsButton_disabled { background: url(../../images/ButtonBar/ic_button_delete_d.png) no-repeat;  background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_PRINT.ItsButton_disabled  { background: url(../../images/ButtonBar/ic_button_print_d.png) no-repeat;   background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_EXPORT.ItsButton_disabled { background: url(../../images/ButtonBar/ic_button_reset_d.png) no-repeat;   background-size: 38px 38px; background-position-x:center; background-position-y:5px; }
#COMMON_CLOSE.ItsButton_disabled  { background: url(../../images/ButtonBar/ic_button_close_d.png) no-repeat;   background-size: 38px 38px; background-position-x:center; background-position-y:5px; }

#COMMON_SEARCH, #COMMON_INIT, #COMMON_ADD, #COMMON_SAVE, #COMMON_DELETE, #COMMON_PRINT, #COMMON_EXPORT, #COMMON_CLOSE {
    margin-top:4px; margin-bottom:6px; margin-left:0px; margin-right:0px; width:60px; height:58px;
}
#MAIN_BUTTON .ItsButton_span {  
    position: relative; 
    bottom: -22px; 
}
#MAIN_BUTTON > .ItsButton:active:not(.ItsButton_disabled) {  
    background-color: #F3F3F3; 
    box-shadow: inset 2px 2px 6px rgba(0, 0, 0, 0.1); 
    border-radius:3px; 
}
#MAIN_BUTTON .ItsButton_table { 
    border:none; 
    background-color: transparent; 
    width:60px; 
    height:58px;
    user-select: none; 
}

/* 기타 */
.tooltip-inner { max-width: 100% !important; }
div#DebugPanel { display:none;         background-color:white; font-weight:bold; padding:5px; border: 2px solid red; }
div#DebugClose { display:inline-block; background-color:red;   color:white; margin-right:2px; padding:3px 5px; border: 1px solid black; }
div.DebugError { display:inline-block; background-color:white; color:red; margin-right:5px; padding:3px 5px; border:1px solid black; }

#SplitDragV { display:none; position: absolute; height: 100%; width: 2px; top: 0px; cursor:col-resize; background-color: skyblue; z-index: 999999; }
#SplitDragH { display:none; position: absolute; height: 2px; width: 100%; left:0px; cursor:row-resize; background-color: skyblue; z-index: 999999; }
#SplitDragF { position:absolute; visibility:visible; z-index:-999999; opacity:0; width:0px; height:0px; left:0px; top:0px; }
