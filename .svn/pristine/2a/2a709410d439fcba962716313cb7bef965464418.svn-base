                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '27', IF(PLAN_W_LIST.PLANSTOP_DAY = 'Y', 1, 0), 0)) AS PLANSTOP_27_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '27', IF(PLAN_W_LIST.PLANSTOP_NIGHT = 'Y', 1, 0), 0)) AS PLANSTOP_27_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '28', PLAN_W_LIST.PLANQTY_DAY, 0)) AS PLANQTY_28_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '28', PLAN_W_LIST.PLANQTY_NIGHT, 0)) AS PLANQTY_28_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '28', IF(PLAN_W_LIST.PLANSTOP_DAY = 'Y', 1, 0), 0)) AS PLANSTOP_28_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '28', IF(PLAN_W_LIST.PLANSTOP_NIGHT = 'Y', 1, 0), 0)) AS PLANSTOP_28_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '29', PLAN_W_LIST.PLANQTY_DAY, 0)) AS PLANQTY_29_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '29', PLAN_W_LIST.PLANQTY_NIGHT, 0)) AS PLANQTY_29_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '29', IF(PLAN_W_LIST.PLANSTOP_DAY = 'Y', 1, 0), 0)) AS PLANSTOP_29_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '29', IF(PLAN_W_LIST.PLANSTOP_NIGHT = 'Y', 1, 0), 0)) AS PLANSTOP_29_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '30', PLAN_W_LIST.PLANQTY_DAY, 0)) AS PLANQTY_30_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '30', PLAN_W_LIST.PLANQTY_NIGHT, 0)) AS PLANQTY_30_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '30', IF(PLAN_W_LIST.PLANSTOP_DAY = 'Y', 1, 0), 0)) AS PLANSTOP_30_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '30', IF(PLAN_W_LIST.PLANSTOP_NIGHT = 'Y', 1, 0), 0)) AS PLANSTOP_30_NIGHT
  
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '31', PLAN_W_LIST.PLANQTY_DAY, 0)) AS PLANQTY_31_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '31', PLAN_W_LIST.PLANQTY_NIGHT, 0)) AS PLANQTY_31_NIGHT
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '31', IF(PLAN_W_LIST.PLANSTOP_DAY = 'Y', 1, 0), 0)) AS PLANSTOP_31_DAY
                        , SUM(IF(RIGHT(PLAN_W_LIST.PDATE, 2) = '31', IF(PLAN_W_LIST.PLANSTOP_NIGHT = 'Y', 1, 0), 0)) AS PLANSTOP_31_NIGHT
                      FROM (
                              SELECT
                                  PRDPLAN_W.PDATE
                                , PRDPLAN_W.ITEMID    
                                , PRDPLAN_W.EQMCD
                                , PRDPLAN_W.PLANQTY_DAY
                                , PRDPLAN_W.PLANQTY_NIGHT
                                , PRDPLAN_W.PLANSTOP_DAY
                                , PRDPLAN_W.PLANSTOP_NIGHT
                              FROM PRDPLAN_W 
                              WHERE PRDPLAN_W.PMONTH = LEFT($SDATE, 7) 
                                AND PRDPLAN_W.PDATE BETWEEN $SDATE AND $EDATE  
                           ) AS PLAN_W_LIST
                      GROUP BY PLAN_W_LIST.ITEMID, PLAN_W_LIST.EQMCD
                   ) AS PLAN_W2
            ) AS PLAN_W -- 주간생산계획
    ON PLAN_W.ITEMID = RESULT2.ITEMID
   AND PLAN_W.EQMCD = RESULT2.EQMCD

  LEFT JOIN (
              SELECT
                  SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '01', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_1_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '01', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_1_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '02', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_2_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '02', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_2_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '03', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_3_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '03', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_3_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '04', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_4_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '04', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_4_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '05', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_5_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '05', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_5_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '06', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_6_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '06', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_6_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '07', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_7_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '07', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_7_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '08', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_8_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '08', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_8_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '09', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_9_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '09', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_9_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '10', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_10_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '10', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_10_NIGHT
            
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '11', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_11_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '11', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_11_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '12', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_12_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '12', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_12_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '13', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_13_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '13', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_13_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '14', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_14_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '14', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_14_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '15', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_15_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '15', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_15_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '16', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_16_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '16', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_16_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '17', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_17_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '17', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_17_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '18', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_18_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '18', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_18_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '19', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_19_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '19', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_19_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '20', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_20_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '20', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_20_NIGHT
            
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '21', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_21_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '21', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_21_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '22', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_22_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '22', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_22_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '23', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_23_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '23', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_23_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '24', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_24_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '24', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_24_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '25', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_25_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '25', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_25_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '26', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_26_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '26', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_26_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '27', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_27_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '27', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_27_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '28', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_28_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '28', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_28_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '29', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_29_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '29', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_29_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '30', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_30_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '30', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_30_NIGHT
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '31', (PRDWORKTIME.DAYTIME + PRDWORKTIME.OVERTIME_DY), 0)) AS WORKTIME_31_DAY
                , SUM(IF(RIGHT(PRDWORKTIME.WORKDATE, 2) = '31', (PRDWORKTIME.NIGHTTIME + PRDWORKTIME.OVERTIME_NT), 0)) AS WORKTIME_31_NIGHT
              FROM PRDWORKTIME
              WHERE PRDWORKTIME.WORKMONTH = LEFT($SDATE, 7) 
            ) AS WORKTIME
    ON 1=1

  ORDER BY RESULT2.LINECD, RESULT2.PRCCD, RESULT2.EQMCD, RESULT2.ITEMCD
  ;

  -- 근무시간
  SELECT
      WORKDATE
    , DAYTIME + OVERTIME_DY AS WORKTIME_DAY
    , NIGHTTIME + OVERTIME_NT AS WORKTIME_NIGHT
  FROM PRDWORKTIME
  WHERE WORKMONTH = LEFT($SDATE, 7) 
  ;

  DROP TABLE IF EXISTS TEMP_END;
  DROP TABLE IF EXISTS TEMP_CUR;
-- ****************************************************************************
END CASE; END