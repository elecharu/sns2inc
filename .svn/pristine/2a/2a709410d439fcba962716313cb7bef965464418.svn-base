CREATE DEFINER = 'root'@'%'
PROCEDURE MES_SNS2.PRD1001_R02(
  -- *****************************************************************************
-- Comment: 주간생산계획 등록
-- Create: 2026-10-01 신정수 
-- Modify: 
-- *****************************************************************************
  IN $SDATE VARCHAR(10),      
  IN $EDATE VARCHAR(10),      
  IN $FACTORYCD VARCHAR(100),   -- 공장코드
  IN $ITEMID INT,              -- 품목번호
  IN $ITEMCD VARCHAR(100),      -- 품목코드   

-- *****************************************************************************
 IN $CALLTYPE VARCHAR(50), IN $KEYWORD VARCHAR(1000))
PROC: BEGIN -- @CALLEMP, @CALLPRG, @CALLHOST, @CALLIP, @CALLMAC
-- SET @DEBUGLOGYN = 'Y'; 
-- *****************************************************************************
  DECLARE _$PRODUCT_LIST MEDIUMTEXT;
  DECLARE _$ITEMID_PRODUCT INT;
  DECLARE _$COUNT INT;
-- ****************************************************************************
CASE $CALLTYPE
-- ****************************************************************************
WHEN 'LIST_WEEKPLAN' THEN  -- 주간 생산계획 조회 

  IF LEFT($SDATE, 7) != LEFT($EDATE, 7) THEN
    CALL COMERR('시작일과 종료일의 월이 다르게 조회할 수는 없습니다.');
    LEAVE PROC;
  END IF;

  IF NOT EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = LEFT($SDATE, 7) AND APPYN = 'Y') THEN
    CALL COMERR(CONCAT('확정된 월생산계획이 없습니다.'
                      , '\n- 계획월: ', LEFT($SDATE, 7)
                      )
               );
    LEAVE PROC;
  END IF;

  -- 주간 생산계획 만들 반제품 찾기 (열전, 열후, 롤링, 조립, 절단 공정만)
  DROP TABLE IF EXISTS TEMP_END;
  CREATE TEMPORARY TABLE TEMP_END (
    LEVEL  DECIMAL(20, 0) NOT NULL,
    ENDYN  VARCHAR(1) NOT NULL,
    IDX    VARCHAR(1000) NOT NULL,
    PIDX   VARCHAR(1000) NOT NULL,
    MITEMID VARCHAR(100) NOT NULL,
    ITEMID VARCHAR(100) NOT NULL,
    MUSAGE DECIMAL(20, 8),
    CUSAGE DECIMAL(20, 8),
    MPLANQTY DECIMAL(20, 8),
    CPLANQTY DECIMAL(20, 8),
    PRCCD VARCHAR(100) NOT NULL,
    BOMSEQ INT 
  );

  DROP TABLE IF EXISTS TEMP_CUR;
  CREATE TEMPORARY TABLE TEMP_CUR (
    IDX    VARCHAR(1000) NOT NULL,
    PIDX   VARCHAR(1000) NOT NULL,
    MITEMID VARCHAR(100) NOT NULL,
    ITEMID VARCHAR(100) NOT NULL,
    MUSAGE DECIMAL(20, 8),
    CUSAGE DECIMAL(20, 8),
    MPLANQTY DECIMAL(20, 8),
    CPLANQTY DECIMAL(20, 8),
    PRCCD VARCHAR(100) NOT NULL,
    BOMSEQ INT 
  );

  SET _$PRODUCT_LIST = IFNULL((
                                SELECT
                                  GROUP_CONCAT(PLAN_M.ITEMID ORDER BY ITEMID ASC SEPARATOR '»')
                                FROM PRDPLAN_M AS PLAN_M
                                WHERE PLAN_M.PMONTH = LEFT($SDATE, 7)
                                  AND PLAN_M.APPYN = 'Y'
                              ), '');


  WHILE LENGTH(_$PRODUCT_LIST) > 0 DO
    CALL COMSPLIT(_$PRODUCT_LIST, _$ITEMID_PRODUCT);

    INSERT INTO TEMP_END (LEVEL, ENDYN, IDX, PIDX, MITEMID, ITEMID, BOMSEQ,  PRCCD, CPLANQTY)
    SELECT 0, 'N', MSTITEM.ITEMID, '', '', MSTITEM.ITEMID, 0, '', PLAN_M.PLANQTY
    FROM MSTITEM
    INNER JOIN PRDPLAN_M AS PLAN_M
      ON PLAN_M.ITEMID = MSTITEM.ITEMID
    WHERE MSTITEM.ITEMID = _$ITEMID_PRODUCT;
  
    SET _$COUNT = 1;
  
    WHILE _$COUNT < 20 DO
  
      TRUNCATE TABLE TEMP_CUR;
      INSERT INTO TEMP_CUR (IDX,  PIDX, 
        MITEMID, ITEMID, 
        MUSAGE, CUSAGE, BOMSEQ,
        MPLANQTY, CPLANQTY,
        PRCCD
      )
      SELECT 
        CONCAT(TEMP_END.IDX, '      ' , MSTBOM.CITEMID),   TEMP_END.IDX,     
        MSTBOM.MITEMID,  MSTBOM.CITEMID,    
        IF(MSTBOM.MUSAGE IN (NULL, 0), 1, MSTBOM.MUSAGE), IF(MSTBOM.CUSAGE IN (NULL, 0), 1, MSTBOM.CUSAGE), MSTBOM.PRCSEQ,
        TEMP_END.CPLANQTY, TEMP_END.CPLANQTY * (IF(MSTBOM.CUSAGE IN (NULL, 0), 1, MSTBOM.CUSAGE) / IF(MSTBOM.MUSAGE IN (NULL, 0), 1, MSTBOM.MUSAGE)),
        MSTBOM.PRCCD
      FROM TEMP_END
      INNER JOIN MSTBOM 
       ON TEMP_END.ITEMID = MSTBOM.MITEMID
      WHERE TEMP_END.ENDYN = 'N'
      ;
  
      UPDATE TEMP_END SET ENDYN = 'Y';
  
      INSERT INTO TEMP_END (LEVEL, ENDYN, IDX, PIDX, MITEMID, ITEMID, MUSAGE, CUSAGE, MPLANQTY, CPLANQTY, BOMSEQ, PRCCD)
      SELECT _$COUNT, 'N', IDX, PIDX, MITEMID, ITEMID, MUSAGE, CUSAGE, MPLANQTY, CPLANQTY, BOMSEQ, PRCCD
      FROM TEMP_CUR;
  
      SET _$COUNT = _$COUNT + 1;   
    END WHILE;
  END WHILE;



  SELECT
      RESULT2.LINECD
    , RESULT2.LINENM
    , RESULT2.ITEMID
    , RESULT2.ITEMCD
    , RESULT2.ITEMNM
    , RESULT2.ITEMSPEC
    , RESULT2.ROUTCD
    , RESULT2.PRCCD
    , RESULT2.PRCNM
    , RESULT2.EQMCD
    , RESULT2.EQMNM
    , RESULT2.CT
    , RESULT2.EFFI
    , ROUND(RESULT2.UPH, 1) AS UPH
    , ROUND(RESULT2.UPH * 9) AS ONESQTY -- 1S 수량 = 한 작업조 CAPA = ROUND(9시간 * UPH, 0)
    , RESULT2.PLANQTY 
    , RESULT2.GOODQTY
    , RESULT2.ADDSALQTY
    , RESULT2.ADDPLANQTY
    , RESULT2.LEFTPLANQTY
    , PLAN_W.PLAN_1_DAY
    , PLAN_W.PLAN_1_NIGHT
    , PLAN_W.PLAN_2_DAY
    , PLAN_W.PLAN_2_NIGHT
    , PLAN_W.PLAN_3_DAY
    , PLAN_W.PLAN_3_NIGHT
    , PLAN_W.PLAN_4_DAY
    , PLAN_W.PLAN_4_NIGHT
    , PLAN_W.PLAN_5_DAY
    , PLAN_W.PLAN_5_NIGHT
    , PLAN_W.PLAN_6_DAY
    , PLAN_W.PLAN_6_NIGHT
    , PLAN_W.PLAN_7_DAY
    , PLAN_W.PLAN_7_NIGHT
    , PLAN_W.PLAN_8_DAY
    , PLAN_W.PLAN_8_NIGHT
    , PLAN_W.PLAN_9_DAY
    , PLAN_W.PLAN_9_NIGHT
    , PLAN_W.PLAN_20_DAY
    , PLAN_W.PLAN_20_NIGHT

    , PLAN_W.PLAN_11_DAY
    , PLAN_W.PLAN_11_NIGHT
    , PLAN_W.PLAN_12_DAY
    , PLAN_W.PLAN_12_NIGHT
    , PLAN_W.PLAN_13_DAY
    , PLAN_W.PLAN_13_NIGHT
    , PLAN_W.PLAN_14_DAY
    , PLAN_W.PLAN_14_NIGHT
    , PLAN_W.PLAN_15_DAY
    , PLAN_W.PLAN_15_NIGHT
    , PLAN_W.PLAN_16_DAY
    , PLAN_W.PLAN_16_NIGHT
    , PLAN_W.PLAN_17_DAY
    , PLAN_W.PLAN_17_NIGHT
    , PLAN_W.PLAN_18_DAY
    , PLAN_W.PLAN_18_NIGHT
    , PLAN_W.PLAN_19_DAY
    , PLAN_W.PLAN_19_NIGHT
    , PLAN_W.PLAN_20_DAY
    , PLAN_W.PLAN_20_NIGHT

    , PLAN_W.PLAN_21_DAY
    , PLAN_W.PLAN_21_NIGHT
    , PLAN_W.PLAN_22_DAY
    , PLAN_W.PLAN_22_NIGHT
    , PLAN_W.PLAN_23_DAY
    , PLAN_W.PLAN_23_NIGHT
    , PLAN_W.PLAN_24_DAY
    , PLAN_W.PLAN_24_NIGHT
    , PLAN_W.PLAN_25_DAY
    , PLAN_W.PLAN_25_NIGHT
    , PLAN_W.PLAN_26_DAY
    , PLAN_W.PLAN_26_NIGHT
    , PLAN_W.PLAN_27_DAY
    , PLAN_W.PLAN_27_NIGHT
    , PLAN_W.PLAN_28_DAY
    , PLAN_W.PLAN_28_NIGHT
    , PLAN_W.PLAN_29_DAY
    , PLAN_W.PLAN_29_NIGHT
    , PLAN_W.PLAN_30_DAY
    , PLAN_W.PLAN_30_NIGHT
    , PLAN_W.PLAN_31_DAY
    , PLAN_W.PLAN_31_NIGHT

    , WORKTIME.WORKTIME_1_DAY
    , WORKTIME.WORKTIME_1_NIGHT
    , WORKTIME.WORKTIME_2_DAY
    , WORKTIME.WORKTIME_2_NIGHT
    , WORKTIME.WORKTIME_3_DAY
    , WORKTIME.WORKTIME_3_NIGHT
    , WORKTIME.WORKTIME_4_DAY
    , WORKTIME.WORKTIME_4_NIGHT
    , WORKTIME.WORKTIME_5_DAY
    , WORKTIME.WORKTIME_5_NIGHT
    , WORKTIME.WORKTIME_6_DAY
    , WORKTIME.WORKTIME_6_NIGHT
    , WORKTIME.WORKTIME_7_DAY
    , WORKTIME.WORKTIME_7_NIGHT
    , WORKTIME.WORKTIME_8_DAY
    , WORKTIME.WORKTIME_8_NIGHT
    , WORKTIME.WORKTIME_9_DAY
    , WORKTIME.WORKTIME_9_NIGHT
    , WORKTIME.WORKTIME_10_DAY
    , WORKTIME.WORKTIME_10_NIGHT

    , WORKTIME.WORKTIME_11_DAY
    , WORKTIME.WORKTIME_11_NIGHT
    , WORKTIME.WORKTIME_12_DAY
    , WORKTIME.WORKTIME_12_NIGHT
    , WORKTIME.WORKTIME_13_DAY
    , WORKTIME.WORKTIME_13_NIGHT
    , WORKTIME.WORKTIME_14_DAY
    , WORKTIME.WORKTIME_14_NIGHT
    , WORKTIME.WORKTIME_15_DAY
    , WORKTIME.WORKTIME_15_NIGHT
    , WORKTIME.WORKTIME_16_DAY
    , WORKTIME.WORKTIME_16_NIGHT
    , WORKTIME.WORKTIME_17_DAY
    , WORKTIME.WORKTIME_17_NIGHT
    , WORKTIME.WORKTIME_18_DAY
    , WORKTIME.WORKTIME_18_NIGHT
    , WORKTIME.WORKTIME_19_DAY
    , WORKTIME.WORKTIME_19_NIGHT
    , WORKTIME.WORKTIME_20_DAY
    , WORKTIME.WORKTIME_20_NIGHT

    , WORKTIME.WORKTIME_21_DAY
    , WORKTIME.WORKTIME_21_NIGHT
    , WORKTIME.WORKTIME_22_DAY
    , WORKTIME.WORKTIME_22_NIGHT
    , WORKTIME.WORKTIME_23_DAY
    , WORKTIME.WORKTIME_23_NIGHT
    , WORKTIME.WORKTIME_24_DAY
    , WORKTIME.WORKTIME_24_NIGHT
    , WORKTIME.WORKTIME_25_DAY
    , WORKTIME.WORKTIME_25_NIGHT
    , WORKTIME.WORKTIME_26_DAY
    , WORKTIME.WORKTIME_26_NIGHT
    , WORKTIME.WORKTIME_27_DAY
    , WORKTIME.WORKTIME_27_NIGHT
    , WORKTIME.WORKTIME_28_DAY
    , WORKTIME.WORKTIME_28_NIGHT
    , WORKTIME.WORKTIME_29_DAY
    , WORKTIME.WORKTIME_29_NIGHT
    , WORKTIME.WORKTIME_30_DAY
    , WORKTIME.WORKTIME_30_NIGHT
    , WORKTIME.WORKTIME_31_DAY
    , WORKTIME.WORKTIME_31_NIGHT
  FROM (
          SELECT
              RESULT.LINECD
            , RESULT.LINENM
            , RESULT.ITEMID
            , RESULT.ITEMCD
            , RESULT.ITEMNM
            , RESULT.ITEMSPEC
            , RESULT.ROUTCD
            , RESULT.PRCCD
            , RESULT.PRCNM
            , MSTSTD_LAST.EQMCD
            , MSTLINE_EQM.EQMNM
            , MSTSTD_LAST.CT
            , MSTSTD_LAST.EFFI
            , IF(   MSTSTD_LAST.CT * MSTSTD_LAST.EFFI IS NULL OR MSTSTD_LAST.CT * MSTSTD_LAST.EFFI = 0
                  , 0
                  , 3600 / MSTSTD_LAST.CT * (MSTSTD_LAST.EFFI/100)) AS UPH
            , RESULT.PLANQTY  -- 월생산계획수량_반제품 
            , RESULT.ADDSALQTY  -- 추가수주_반제품   
            , IFNULL(RSTMONTH.GOODQTY, 0) AS GOODQTY  -- 월생산수량_반제품    
            , IFNULL(W_ADDPLAN.ADDPLANQTY, 0) AS ADDPLANQTY  -- 추가생산계획수량_반제품     
            , RESULT.PLANQTY
              - IFNULL(RSTMONTH.GOODQTY, 0)
              - RESULT.ADDSALQTY
              - IFNULL(W_ADDPLAN.ADDPLANQTY, 0) AS LEFTPLANQTY -- 월생산계획 잔량
          FROM (
                  SELECT
                      SUBITEM_LIST.LINECD
                    , SUBITEM_LIST.LINENM
                    , SUBITEM_LIST.ITEMID
                    , SUBITEM_LIST.ITEMCD
                    , SUBITEM_LIST.ITEMNM
                    , SUBITEM_LIST.ITEMSPEC
                    , SUBITEM_LIST.ROUTCD
                    , SUBITEM_LIST.PRCCD
                    , SUBITEM_LIST.PRCNM        
                    , SUBITEM_LIST.CPLANQTY AS PLANQTY  -- 월생산계획수량_반제품 
                    , IFNULL(ADDSALODRD.ADDSALQTY, 0) AS ADDSALQTY -- 추가수주_반제품        
                  FROM (
                          SELECT
                              MSTLINE.LINECD
                            , MSTLINE.LINENM
                            , TEMP_END.ITEMID
                            , MSTITEM.ITEMCD
                            , MSTITEM.ITEMNM
                            , MSTITEM.ITEMSPEC
                            , MSTROUT_DETAIL.ROUTCD
                            , MSTPRC.PRCCD
                            , MSTPRC.PRCNM
                            , SUM(TEMP_END.CPLANQTY) AS CPLANQTY
                          FROM TEMP_END
                          INNER JOIN MSTITEM
                            ON MSTITEM.ITEMID = TEMP_END.ITEMID
                          INNER JOIN MSTROUT_MATCH
                            ON MSTROUT_MATCH.ITEMID = MSTITEM.ITEMID
                           AND MSTROUT_MATCH.BASEYN = 'Y'
                          INNER JOIN MSTROUT_DETAIL
                            ON MSTROUT_DETAIL.ROUTCD = MSTROUT_MATCH.ROUTCD
                          INNER JOIN MSTPRC
                            ON MSTPRC.PRCCD = MSTROUT_DETAIL.PRCCD
                          INNER JOIN MSTLINE
                            ON MSTLINE.LINECD = MSTROUT_DETAIL.LINCD     
                          WHERE MSTPRC.USEYN = 'Y'
                            AND MSTPRC.FACTORYCD = '07'
                            AND MSTPRC.WEEKPLANYN = 'Y' -- 주간생산계획 내리는 공정만     
                          GROUP BY  MSTLINE.LINECD
                                  , TEMP_END.ITEMID            
                       ) AS SUBITEM_LIST
        
        
                  LEFT JOIN (
                              SELECT
                                  SALODRD.ITEMID
                                , SUM(SALODRD.SALQTY) AS ADDSALQTY
                              FROM SALODR
                              INNER JOIN SALODRD
                                ON SALODRD.SALODRKEY = SALODR.SALODRKEY
                              INNER JOIN MSTITEM
                                ON MSTITEM.ITEMID = SALODRD.ITEMID
                              INNER JOIN MSTITEM_FACTORY AS ITEM_FAC
                                ON ITEM_FAC.ITEMID = MSTITEM.ITEMID
                              INNER JOIN MSTROUT_MATCH
                                ON MSTROUT_MATCH.ITEMID = SALODRD.ITEMID
                               AND MSTROUT_MATCH.BASEYN = 'Y'
                              INNER JOIN MSTROUT
                                ON MSTROUT.ROUTCD = MSTROUT_MATCH.ROUTCD
                               AND MSTROUT.USEYN = 'Y'
                              INNER JOIN MSTROUT_DETAIL
                                ON MSTROUT_DETAIL.ROUTCD = MSTROUT_MATCH.ROUTCD
                              INNER JOIN MSTLINE
                                ON MSTLINE.LINECD = MSTROUT_DETAIL.LINCD    
                              LEFT JOIN PRDPLAN_M_SALODRD
                                ON PRDPLAN_M_SALODRD.SALODRKEY = SALODRD.SALODRKEY
                               AND PRDPLAN_M_SALODRD.ODRSEQ = SALODRD.ODRSEQ
                              WHERE LEFT(SALODR.ODRDATE, 7) = LEFT($SDATE, 7) 
                                AND ITEM_FAC.FACTORYCD = $FACTORYCD -- 수주품목이 2공장
                                AND MSTITEM.ITEMCG = 'DM100100' -- 제품
                                AND MSTITEM.ITEMSRC = 'DM160100' -- 제조         
                                AND MSTLINE.USEYN = 'Y'
                                AND MSTLINE.FACTORYCD = $FACTORYCD 
                                AND MSTLINE.OSCCUSTCD = ''  -- 외주작업장 제외 
                                AND PRDPLAN_M_SALODRD.PMONTH IS NULL
                              GROUP BY SALODRD.ITEMID
                            ) AS ADDSALODRD -- 추가수주건 (월생산계획에 포함안된 수주)
                    ON ADDSALODRD.ITEMID = SUBITEM_LIST.ITEMID
               ) AS RESULT
          LEFT JOIN (
                      SELECT
                          MSL_VALUE.ITEMID
                        , MSL_VALUE.LINECD
                        , MSL_VALUE.EQMCD
                        , MSL_VALUE.SDT
                        , MSL_VALUE.PRCCD
                        , MSL_VALUE.CT
                        , MSL_VALUE.EFFI
                      FROM (
                              SELECT
                                  MSTSTD.FACTORYCD
                                , MSTSTD.ITEMID
                                , MSTSTD.LINECD
                                , MSTSTD.EQMCD
                                , MAX(MSTSTD.SDT) AS SDT_LAST
                              FROM MSTSTD
                              INNER JOIN MSTPRC
                                ON MSTPRC.PRCCD = MSTSTD.PRCCD  
                              WHERE MSTSTD.FACTORYCD = $FACTORYCD
                                AND MSTPRC.USEYN = 'Y'
                              GROUP BY MSTSTD.FACTORYCD
                                     , MSTSTD.ITEMID
                                     , MSTSTD.LINECD
                                     , MSTSTD.EQMCD
                           ) AS MSL
                      INNER JOIN MSTSTD AS MSL_VALUE
                        ON MSL_VALUE.FACTORYCD = MSL.FACTORYCD
                       AND MSL_VALUE.ITEMID = MSL.ITEMID
                       AND MSL_VALUE.LINECD = MSL.LINECD
                       AND MSL_VALUE.EQMCD = MSL.EQMCD
                       AND MSL_VALUE.SDT = MSL.SDT_LAST
                    ) AS MSTSTD_LAST  -- 반제품 라인별 CT, 설비종합효율
            ON MSTSTD_LAST.ITEMID = RESULT.ITEMID
           AND MSTSTD_LAST.LINECD = RESULT.LINECD
           AND MSTSTD_LAST.PRCCD = RESULT.PRCCD
          LEFT JOIN MSTLINE_EQM
            ON MSTLINE_EQM.EQMCD = MSTSTD_LAST.EQMCD
        
          LEFT JOIN (
                      SELECT
                          PRDRST.ITEMID
                        , PRDRST.EQMCD
                        , SUM(PRDRST.GOODQTY) AS GOODQTY
                      FROM PRDRST
                      INNER JOIN MSTPRC
                        ON MSTPRC.PRCCD = PRDRST.PRCCD
                      WHERE LEFT(PRDRST.RSTTIME, 7) = LEFT($SDATE, 7)
                        AND MSTPRC.USEYN = 'Y'
                        AND MSTPRC.FACTORYCD = '07'
                        AND MSTPRC.WEEKPLANYN = 'Y' -- 주간생산계획 내리는 공정만 
                      GROUP BY PRDRST.ITEMID, PRDRST.EQMCD
                    ) AS RSTMONTH   -- 생산실적 집계       
            ON RSTMONTH.ITEMID = MSTSTD_LAST.ITEMID
           AND RSTMONTH.EQMCD = MSTSTD_LAST.EQMCD
        
          LEFT JOIN (
                      SELECT
                          ADDPLAN.ITEMID
                        , ADDPLAN.EQMCD
                        , SUM(ADDPLAN.ADDPLANQTY) AS ADDPLANQTY
                      FROM PRDPLAN_W_ADDPLAN AS ADDPLAN
                      WHERE LEFT(ADDPLAN.ADDDATE, 7) = LEFT($SDATE, 7)                
                    ) AS W_ADDPLAN  -- 추가 생산계획 
            ON W_ADDPLAN.ITEMID = MSTSTD_LAST.ITEMID
           AND W_ADDPLAN.EQMCD = MSTSTD_LAST.EQMCD
       ) AS RESULT2
  LEFT JOIN (
              SELECT
                  PLAN_W2.ITEMID
                , PLAN_W2.EQMCD
                , IF(PLAN_W2.PLANSTOP_01_DAY > 0, '계획정지', PLAN_W2.PLANQTY_01_DAY) AS PLAN_1_DAY
                , IF(PLAN_W2.PLANSTOP_01_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_01_NIGHT) AS PLAN_1_NIGHT
                , IF(PLAN_W2.PLANSTOP_02_DAY > 0, '계획정지', PLAN_W2.PLANQTY_02_DAY) AS PLAN_2_DAY
                , IF(PLAN_W2.PLANSTOP_02_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_02_NIGHT) AS PLAN_2_NIGHT
                , IF(PLAN_W2.PLANSTOP_03_DAY > 0, '계획정지', PLAN_W2.PLANQTY_03_DAY) AS PLAN_3_DAY
                , IF(PLAN_W2.PLANSTOP_03_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_03_NIGHT) AS PLAN_3_NIGHT
                , IF(PLAN_W2.PLANSTOP_04_DAY > 0, '계획정지', PLAN_W2.PLANQTY_04_DAY) AS PLAN_4_DAY
                , IF(PLAN_W2.PLANSTOP_04_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_04_NIGHT) AS PLAN_4_NIGHT
                , IF(PLAN_W2.PLANSTOP_05_DAY > 0, '계획정지', PLAN_W2.PLANQTY_05_DAY) AS PLAN_5_DAY
                , IF(PLAN_W2.PLANSTOP_05_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_05_NIGHT) AS PLAN_5_NIGHT
                , IF(PLAN_W2.PLANSTOP_06_DAY > 0, '계획정지', PLAN_W2.PLANQTY_06_DAY) AS PLAN_6_DAY
                , IF(PLAN_W2.PLANSTOP_06_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_06_NIGHT) AS PLAN_6_NIGHT
                , IF(PLAN_W2.PLANSTOP_07_DAY > 0, '계획정지', PLAN_W2.PLANQTY_07_DAY) AS PLAN_7_DAY
                , IF(PLAN_W2.PLANSTOP_07_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_07_NIGHT) AS PLAN_7_NIGHT
                , IF(PLAN_W2.PLANSTOP_08_DAY > 0, '계획정지', PLAN_W2.PLANQTY_08_DAY) AS PLAN_8_DAY
                , IF(PLAN_W2.PLANSTOP_08_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_08_NIGHT) AS PLAN_8_NIGHT
                , IF(PLAN_W2.PLANSTOP_09_DAY > 0, '계획정지', PLAN_W2.PLANQTY_09_DAY) AS PLAN_9_DAY
                , IF(PLAN_W2.PLANSTOP_09_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_09_NIGHT) AS PLAN_9_NIGHT
                , IF(PLAN_W2.PLANSTOP_10_DAY > 0, '계획정지', PLAN_W2.PLANQTY_10_DAY) AS PLAN_10_DAY
                , IF(PLAN_W2.PLANSTOP_10_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_10_NIGHT) AS PLAN_10_NIGHT
  
                , IF(PLAN_W2.PLANSTOP_11_DAY > 0, '계획정지', PLAN_W2.PLANQTY_11_DAY) AS PLAN_11_DAY
                , IF(PLAN_W2.PLANSTOP_11_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_11_NIGHT) AS PLAN_11_NIGHT
                , IF(PLAN_W2.PLANSTOP_12_DAY > 0, '계획정지', PLAN_W2.PLANQTY_12_DAY) AS PLAN_12_DAY
                , IF(PLAN_W2.PLANSTOP_12_NIGHT > 0, '계획정지', PLAN_W2.PLANQTY_12_NIGHT) AS PLAN_12_NIGHT
