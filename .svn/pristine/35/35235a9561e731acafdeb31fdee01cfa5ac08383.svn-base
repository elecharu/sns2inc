                        <BezierSegment Point1="-2,4" Point2="4,10" Point3="10,15"/>
                    </PathFigure>
                    <PathFigure StartPoint="8,0" IsFilled="False">
                        <LineSegment Point="11,4"/>
                        <LineSegment Point="8,8"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </WrapPanel>

</Window>
