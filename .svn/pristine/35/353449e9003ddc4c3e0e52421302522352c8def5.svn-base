<its:ItsPageOffice x:Class="SYS0000.R01"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:SYS0000"
        xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
        xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
        mc:Ignorable="d" 
        d:DesignHeight="1000" d:DesignWidth="1700"
        Title="R01">
    <DockPanel>
        <StackPanel Height="35" Background="SeaGreen" DockPanel.Dock="Top"></StackPanel>
        <StackPanel DockPanel.Dock="Top" Background="MintCream">
            <Viewbox Stretch="Fill">
                <StackPanel Orientation="Horizontal">
                    <Label Content="(주)영진산업 스마트팩토리 MES시스템" Width="1500" Height="100" FontSize="32" FontWeight="Bold" Foreground="IndianRed" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                    <Label Content="조회기준 : D-30 ~ D-DAY" FontSize="15" Foreground="DimGray" HorizontalAlignment="Right" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"></Label>
                </StackPanel>
            </Viewbox>
            <UserControl Width="5000" Height="3" Background="SeaGreen"></UserControl>
        </StackPanel>
        <Viewbox Stretch="Fill">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="450"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical" Margin="0,15,0,0">
                            <Label Content="설비종합효율" FontSize="24" Foreground="DimGray" Width="240" Background="White" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            <dxga:CircularGaugeControl x:Name="OEE_GUAGE" MaxHeight="180" MaxWidth="280" EnableAnimation="True" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <dxga:CircularGaugeControl.Model>
                                    <dxga:CircularDefaultModel/>
                                </dxga:CircularGaugeControl.Model>
                                <dxga:CircularGaugeControl.Scales>
                                    <dxga:ArcScale HorizontalAlignment="Center" StartAngle="180" EndAngle="360" MajorIntervalCount="5">
                                        <dxga:ArcScale.Layers>
                                            <dxga:ArcScaleLayer/>
                                            <dxga:ArcScaleLayer/>
                                        </dxga:ArcScale.Layers>
                                        <dxga:ArcScale.Needles>
                                            <dxga:ArcScaleNeedle Value="{Binding OEE}"/>
                                        </dxga:ArcScale.Needles>
                                        <dxga:ArcScale.RangeBars>
                                            <dxga:ArcScaleRangeBar Value="{Binding OEE}">
                                                <dxga:ArcScaleRangeBar.Presentation>
                                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding OEE_BACK}"/>
                                                </dxga:ArcScaleRangeBar.Presentation>
                                            </dxga:ArcScaleRangeBar>
                                        </dxga:ArcScale.RangeBars>
                                        <dxga:ArcScale.Ranges>
                                            <dxga:ArcScaleRange StartValue="81%" EndValue="100%"/>
                                            <dxga:ArcScaleRange StartValue="51%" EndValue="80%"/>
                                            <dxga:ArcScaleRange StartValue="0%" EndValue="50%"/>

                                        </dxga:ArcScale.Ranges>
                                    </dxga:ArcScale>
                                </dxga:CircularGaugeControl.Scales>
                            </dxga:CircularGaugeControl>
                            <Label Height="10"/>
                            <Label Content="{Binding OEE}" FontSize="24" Foreground="White" Background="CornflowerBlue" Width="200" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,15,0,0">
                            <Label Content="시간가동율" FontSize="24" Foreground="DimGray" Width="240" Background="White" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            <dxga:CircularGaugeControl x:Name="AVAILABILITY_GUAGE" MaxHeight="180" MaxWidth="280" EnableAnimation="True" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <dxga:CircularGaugeControl.Model>
                                    <dxga:CircularDefaultModel/>
                                </dxga:CircularGaugeControl.Model>
                                <dxga:CircularGaugeControl.Scales>
                                    <dxga:ArcScale HorizontalAlignment="Center" StartAngle="180" EndAngle="360" MajorIntervalCount="5">
                                        <dxga:ArcScale.Layers>
                                            <dxga:ArcScaleLayer/>
                                            <dxga:ArcScaleLayer/>
                                        </dxga:ArcScale.Layers>
                                        <dxga:ArcScale.Needles>
                                            <dxga:ArcScaleNeedle Value="{Binding AVAILABILITY}"/>
                                        </dxga:ArcScale.Needles>
                                        <dxga:ArcScale.RangeBars>
                                            <dxga:ArcScaleRangeBar Value="{Binding AVAILABILITY}">
                                                <dxga:ArcScaleRangeBar.Presentation>
                                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding AVAILABILITY_BACK}"/>
                                                </dxga:ArcScaleRangeBar.Presentation>
                                            </dxga:ArcScaleRangeBar>
                                        </dxga:ArcScale.RangeBars>
                                        <dxga:ArcScale.Ranges>
                                            <dxga:ArcScaleRange StartValue="81%" EndValue="100%"/>
                                            <dxga:ArcScaleRange StartValue="61%" EndValue="80%"/>
                                            <dxga:ArcScaleRange StartValue="0%" EndValue="60%"/>
                                        </dxga:ArcScale.Ranges>
                                    </dxga:ArcScale>
                                </dxga:CircularGaugeControl.Scales>
                            </dxga:CircularGaugeControl>
                            <Label Height="10"/>
                            <Label Content="{Binding AVAILABILITY}" FontSize="24" Foreground="White" Background="CornflowerBlue" Width="200" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,15,0,0">
                            <Label Content="생산효율" FontSize="24" Foreground="DimGray" Width="240" Background="White" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            <dxga:CircularGaugeControl x:Name="PERFORMANCE_GUAGE" MaxHeight="180" MaxWidth="280" EnableAnimation="True" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <dxga:CircularGaugeControl.Model>
                                    <dxga:CircularDefaultModel/>
                                </dxga:CircularGaugeControl.Model>
                                <dxga:CircularGaugeControl.Scales>
                                    <dxga:ArcScale HorizontalAlignment="Center" StartAngle="180" EndAngle="360" MajorIntervalCount="5">
                                        <dxga:ArcScale.Layers>
                                            <dxga:ArcScaleLayer/>
                                            <dxga:ArcScaleLayer/>
                                        </dxga:ArcScale.Layers>
                                        <dxga:ArcScale.Needles>
                                            <dxga:ArcScaleNeedle Value="{Binding PERFORMANCE}"/>
                                        </dxga:ArcScale.Needles>
                                        <dxga:ArcScale.RangeBars>
                                            <dxga:ArcScaleRangeBar Value="{Binding PERFORMANCE}">
                                                <dxga:ArcScaleRangeBar.Presentation>
                                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding PERFORMANCE_BACK}"/>
                                                </dxga:ArcScaleRangeBar.Presentation>
                                            </dxga:ArcScaleRangeBar>
                                        </dxga:ArcScale.RangeBars>
                                        <dxga:ArcScale.Ranges>
                                            <dxga:ArcScaleRange StartValue="91%" EndValue="100%"/>
                                            <dxga:ArcScaleRange StartValue="81%" EndValue="90%"/>
                                            <dxga:ArcScaleRange StartValue="0%" EndValue="80%"/>
                                        </dxga:ArcScale.Ranges>
                                    </dxga:ArcScale>
                                </dxga:CircularGaugeControl.Scales>
                            </dxga:CircularGaugeControl>
                            <Label Height="10"/>
                            <Label Content="{Binding PERFORMANCE}" FontSize="24" Foreground="White" Background="CornflowerBlue" Width="200" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,15,0,0">
                            <Label Content="양품율" FontSize="24" Foreground="DimGray" Width="240" Background="White" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            <dxga:CircularGaugeControl x:Name="QUALITY_GUAGE" MaxHeight="180" MaxWidth="280" EnableAnimation="True" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <dxga:CircularGaugeControl.Model>
                                    <dxga:CircularDefaultModel/>
                                </dxga:CircularGaugeControl.Model>
                                <dxga:CircularGaugeControl.Scales>
                                    <dxga:ArcScale HorizontalAlignment="Center" StartAngle="180" EndAngle="360" MajorIntervalCount="5">
                                        <dxga:ArcScale.Layers>
                                            <dxga:ArcScaleLayer/>
                                            <dxga:ArcScaleLayer/>
                                        </dxga:ArcScale.Layers>
                                        <dxga:ArcScale.Needles>
                                            <dxga:ArcScaleNeedle Value="{Binding QUALITY}"/>
                                        </dxga:ArcScale.Needles>
                                        <dxga:ArcScale.RangeBars>
                                            <dxga:ArcScaleRangeBar Value="{Binding QUALITY}">
                                                <dxga:ArcScaleRangeBar.Presentation>
                                                    <dxga:DefaultArcScaleRangeBarPresentation Fill="{Binding QUALITY_BACK}"/>
                                                </dxga:ArcScaleRangeBar.Presentation>
                                            </dxga:ArcScaleRangeBar>
                                        </dxga:ArcScale.RangeBars>
                                        <dxga:ArcScale.Ranges>
                                            <dxga:ArcScaleRange StartValue="91%" EndValue="100%"/>
                                            <dxga:ArcScaleRange StartValue="51%" EndValue="90%"/>
                                            <dxga:ArcScaleRange StartValue="0%" EndValue="50%"/>
                                        </dxga:ArcScale.Ranges>
                                    </dxga:ArcScale>
                                </dxga:CircularGaugeControl.Scales>
                            </dxga:CircularGaugeControl>
                            <Label Height="10"/>
                            <Label Content="{Binding QUALITY}" FontSize="24" Foreground="White" Background="CornflowerBlue" Width="200" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel Background="LightGray" Grid.Row="1"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <StackPanel Width="10"></StackPanel>
                        <StackPanel Orientation="Vertical" Width="400">
                            <Label Height="20"></Label>
                            <dxc:ChartControl  HorizontalAlignment="Left" Height="310">
                                <dxc:ChartControl.Titles>
                                    <dxc:Title Content="비가동유형 TOP5" Foreground="Orange" Dock="Top" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" Visible="True" FontSize="24" Margin="0"/>
                                </dxc:ChartControl.Titles>
                                <dxc:XYDiagram2D>
                                    <dxc:BarSideBySideSeries2D Name ="CHART_NON" LabelsVisibility="True">
                                        <dxc:BarSideBySideSeries2D.Model>
                                            <dxc:SimpleBar2DModel/>
                                        </dxc:BarSideBySideSeries2D.Model>
                                        <dxc:BarSideBySideSeries2D.Label>
                                            <dxc:SeriesLabel dxc:BarSideBySideSeries2D.LabelPosition="Outside"/>
                                        </dxc:BarSideBySideSeries2D.Label>
                                    </dxc:BarSideBySideSeries2D>
                                </dxc:XYDiagram2D>
                            </dxc:ChartControl>
                            <Label Height="20"></Label>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP1" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding NON_TOP1}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP2" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding NON_TOP2}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP3" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding NON_TOP3}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP4" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding NON_TOP4}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP5" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding NON_TOP5}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Width="5"></StackPanel>
                        <StackPanel Orientation="Vertical" Width="400">
                            <Label Height="20" FontSize="10"></Label>
                            <dxc:ChartControl x:Name="CHART_PERF" HorizontalAlignment="Left" Height="310">
                                <dxc:ChartControl.Titles>
                                    <dxc:Title Content="생산성" Foreground="MediumOrchid" Dock="Top" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" Visible="True" FontSize="24" Margin="0"/>
                                </dxc:ChartControl.Titles>
                                <dxc:SimpleDiagram2D>
                                    <dxc:PieSeries2D DisplayName="Series 1" LabelsVisibility="True">
                                        <dxc:PieSeries2D.Label>
                                            <dxc:SeriesLabel dxc:PieSeries.LabelPosition="Inside" TextPattern="{}{VP:0%}"/>
                                        </dxc:PieSeries2D.Label>
                                        <dxc:PieSeries2D.Model>
                                            <dxc:BorderlessFlatPie2DModel/>
                                        </dxc:PieSeries2D.Model>
                                        <dxc:SeriesPoint x:Name="CHART_PERF_ARG1" Argument="1" Value="70"/>
                                        <dxc:SeriesPoint x:Name="CHART_PERF_ARG2" Argument="2" Value="30"/>
                                    </dxc:PieSeries2D>
                                </dxc:SimpleDiagram2D>
                            </dxc:ChartControl>
                            <Label Height="20"></Label>
                            <StackPanel Orientation="Horizontal" Height="58">
                                <Label Content="실제생산량" Width="160" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding RSTQTY}" Width="240" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="58">
                                <Label Content="시간대비 작업수량" Width="160" Background="LemonChiffon" FontSize="17" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding POSSIBLEQTY}" Width="240" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="59">
                                <Label Content="생산성(%)" Width="160" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding PERFORMANCE}" Width="240" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Width="5"></StackPanel>
                        <StackPanel Orientation="Vertical" Width="400">
                            <Label Height="20"></Label>
                            <dxc:ChartControl HorizontalAlignment="Left" Height="310">
                                <dxc:ChartControl.Titles>
                                    <dxc:Title Content="불량유형별 TOP5" Foreground="CornflowerBlue" Dock="Top" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" Visible="True" FontSize="24" Margin="0"/>
                                </dxc:ChartControl.Titles>
                                <dxc:XYDiagram2D>
                                    <dxc:BarSideBySideSeries2D Name ="CHART_BAD" LabelsVisibility="True">
                                        <dxc:BarSideBySideSeries2D.Model>
                                            <dxc:SimpleBar2DModel/>
                                        </dxc:BarSideBySideSeries2D.Model>
                                        <dxc:BarSideBySideSeries2D.Label>
                                            <dxc:SeriesLabel dxc:BarSideBySideSeries2D.LabelPosition="Outside"/>
                                        </dxc:BarSideBySideSeries2D.Label>
                                    </dxc:BarSideBySideSeries2D>
                                </dxc:XYDiagram2D>
                            </dxc:ChartControl>
                            <Label Height="20"></Label>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP1" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding BAD_TOP1}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP2" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding BAD_TOP2}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP3" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding BAD_TOP3}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP4" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding BAD_TOP4}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="35">
                                <Label Content="TOP5" Width="130" Background="LemonChiffon" FontSize="20" Foreground="DimGray" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                <Label Content="{Binding BAD_TOP5}" Width="270" Background="Ivory" FontSize="20" Foreground="DimGray" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Width="10"></StackPanel>
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Column="1" Background="LightGray"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="420"></RowDefinition>
                        <RowDefinition Height="3"></RowDefinition>
                        <RowDefinition Height="420"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Vertical">
                            <Label Content="재단숙성실" Height="40" 
                                   Background="SteelBlue"
                                   Foreground="White" FontSize="25" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Vertical" Width="225">
                                    <Label Content="온  도" Width="220" Background="White" Foreground="DimGray" FontSize="20" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                    <dxga:LinearGaugeControl x:Name="TEMP_GAUGE" Height="290" MaxWidth="180" EnableAnimation="True" Margin="0,5,0,5">
                                        <dxga:LinearGaugeControl.Model>
                                            <dxga:LinearDefaultModel/>
                                        </dxga:LinearGaugeControl.Model>
                                        <dxga:LinearGaugeControl.Scales>
                                            <dxga:LinearScale HorizontalAlignment="Center" StartValue="-10" EndValue="40">
                                                <dxga:LinearScale.Layers>
                                                    <dxga:LinearScaleLayer/>
                                                    <dxga:LinearScaleLayer/>
                                                </dxga:LinearScale.Layers>
                                                <dxga:LinearScale.LevelBars>
                                                    <dxga:LinearScaleLevelBar Value="{Binding TEMP}"/>
                                                </dxga:LinearScale.LevelBars>
                                                <dxga:LinearScale.Markers>
                                                    <dxga:LinearScaleMarker Value="{Binding TEMP}">
                                                        <dxga:LinearScaleMarker.Presentation>
                                                            <dxga:DefaultLinearScaleMarkerPresentation Fill="Red"/>
                                                        </dxga:LinearScaleMarker.Presentation>
                                                        <dxga:LinearScaleMarker.Options>
                                                            <dxga:LinearScaleMarkerOptions Offset="-10" Orientation="Normal"/>
                                                        </dxga:LinearScaleMarker.Options>
                                                    </dxga:LinearScaleMarker>
                                                </dxga:LinearScale.Markers>
                                                <dxga:LinearScale.Ranges>
                                                    <dxga:LinearScaleRange StartValue="51%" EndValue="70%" />
                                                    <dxga:LinearScaleRange StartValue="0%" EndValue="50%">
                                                        <dxga:LinearScaleRange.Presentation>
                                                            <dxga:DefaultLinearScaleRangePresentation Fill="#EAA0AC"/>
                                                        </dxga:LinearScaleRange.Presentation>
                                                    </dxga:LinearScaleRange>
                                                    <dxga:LinearScaleRange StartValue="71%" EndValue="100%" >
                                                        <dxga:LinearScaleRange.Presentation>
                                                            <dxga:DefaultLinearScaleRangePresentation Fill="#EAA0AC"/>
                                                        </dxga:LinearScaleRange.Presentation>
                                                    </dxga:LinearScaleRange>
                                                </dxga:LinearScale.Ranges>
                                            </dxga:LinearScale>
                                        </dxga:LinearGaugeControl.Scales>
                                    </dxga:LinearGaugeControl>
                                    <Label Content="{Binding TEMP}"  Width="220" Height="40" Background="Plum" Foreground="White" FontSize="25" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Width="225">
                                    <Label Content="습  도" Width="220" Background="White" Foreground="DimGray" FontSize="20" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                    <dxga:LinearGaugeControl x:Name="HUMI_GAUGE" Height="290" MaxWidth="180" EnableAnimation="True" Margin="0,10,0,1">
                                        <dxga:LinearGaugeControl.Model>
                                            <dxga:LinearDefaultModel/>
                                        </dxga:LinearGaugeControl.Model>
                                        <dxga:LinearGaugeControl.Scales>
                                            <dxga:LinearScale HorizontalAlignment="Center">
                                                <dxga:LinearScale.Layers>
                                                    <dxga:LinearScaleLayer/>
                                                    <dxga:LinearScaleLayer/>
                                                </dxga:LinearScale.Layers>
                                                <dxga:LinearScale.LevelBars>
                                                    <dxga:LinearScaleLevelBar Value="{Binding HUMI}"/>
                                                </dxga:LinearScale.LevelBars>
                                                <dxga:LinearScale.Markers>
                                                    <dxga:LinearScaleMarker Value="{Binding HUMI}">
                                                        <dxga:LinearScaleMarker.Presentation>
                                                            <dxga:DefaultLinearScaleMarkerPresentation Fill="Red"/>
                                                        </dxga:LinearScaleMarker.Presentation>
                                                        <dxga:LinearScaleMarker.Options>
                                                            <dxga:LinearScaleMarkerOptions Offset="-10" Orientation="Normal"/>
                                                        </dxga:LinearScaleMarker.Options>
                                                    </dxga:LinearScaleMarker>
                                                </dxga:LinearScale.Markers>
                                                <dxga:LinearScale.Ranges>
                                                    <dxga:LinearScaleRange StartValue="0%" EndValue="69%" />
                                                    <dxga:LinearScaleRange StartValue="69%" EndValue="69%" />
                                                    <dxga:LinearScaleRange StartValue="70%" EndValue="100%" >
                                                        <dxga:LinearScaleRange.Presentation>
                                                            <dxga:DefaultLinearScaleRangePresentation Fill="#EAA0AC"/>
                                                        </dxga:LinearScaleRange.Presentation>
                                                    </dxga:LinearScaleRange>
                                                </dxga:LinearScale.Ranges>
                                            </dxga:LinearScale>
                                        </dxga:LinearGaugeControl.Scales>
                                    </dxga:LinearGaugeControl>
                                    <Label Content="{Binding HUMI}" Width="220" Height="40" Background="CornflowerBlue" Foreground="White" FontSize="25" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Grid.Row="1" Background="LightGray"></WrapPanel>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Vertical">
                            <Label Content="B동 숙성실" Height="40" 
                                   Background="SeaGreen"
                                   Foreground="White" FontSize="25" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Vertical" Width="225">
                                    <Label Content="온  도" Width="220" Background="White" Foreground="DimGray" FontSize="20" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                    <dxga:LinearGaugeControl x:Name="TEMP_GAUGE_B" Height="290" MaxWidth="180" EnableAnimation="True" Margin="0,5,0,5">
                                        <dxga:LinearGaugeControl.Model>
                                            <dxga:LinearDefaultModel/>
                                        </dxga:LinearGaugeControl.Model>
                                        <dxga:LinearGaugeControl.Scales>
                                            <dxga:LinearScale HorizontalAlignment="Center" StartValue="-10" EndValue="40">
                                                <dxga:LinearScale.Layers>
                                                    <dxga:LinearScaleLayer/>
                                                    <dxga:LinearScaleLayer/>
                                                </dxga:LinearScale.Layers>
                                                <dxga:LinearScale.LevelBars>
                                                    <dxga:LinearScaleLevelBar Value="{Binding TEMP_B}"/>
                                                </dxga:LinearScale.LevelBars>
                                                <dxga:LinearScale.Markers>
                                                    <dxga:LinearScaleMarker Value="{Binding TEMP_B}">
                                                        <dxga:LinearScaleMarker.Presentation>
                                                            <dxga:DefaultLinearScaleMarkerPresentation Fill="Red"/>
                                                        </dxga:LinearScaleMarker.Presentation>
                                                        <dxga:LinearScaleMarker.Options>
                                                            <dxga:LinearScaleMarkerOptions Offset="-10" Orientation="Normal"/>
                                                        </dxga:LinearScaleMarker.Options>
                                                    </dxga:LinearScaleMarker>
                                                </dxga:LinearScale.Markers>
                                                <dxga:LinearScale.Ranges>
                                                    <dxga:LinearScaleRange StartValue="51%" EndValue="70%" />
                                                    <dxga:LinearScaleRange StartValue="0%" EndValue="50%">
                                                        <dxga:LinearScaleRange.Presentation>
                                                            <dxga:DefaultLinearScaleRangePresentation Fill="#EAA0AC"/>
                                                        </dxga:LinearScaleRange.Presentation>
                                                    </dxga:LinearScaleRange>
                                                    <dxga:LinearScaleRange StartValue="71%" EndValue="100%" >
                                                        <dxga:LinearScaleRange.Presentation>
                                                            <dxga:DefaultLinearScaleRangePresentation Fill="#EAA0AC"/>
                                                        </dxga:LinearScaleRange.Presentation>
                                                    </dxga:LinearScaleRange>
                                                </dxga:LinearScale.Ranges>
                                            </dxga:LinearScale>
                                        </dxga:LinearGaugeControl.Scales>
                                    </dxga:LinearGaugeControl>
                                    <Label Content="{Binding TEMP_B}" Width="220" Height="40" Background="Plum" Foreground="White" FontSize="25" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Width="225">
                                    <Label Content="습  도" Width="220" Background="White" Foreground="DimGray" FontSize="20" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                    <dxga:LinearGaugeControl x:Name="HUMI_GAUGE_B" Height="290" MaxWidth="180" EnableAnimation="True" Margin="0,5,0,5">
                                        <dxga:LinearGaugeControl.Model>
                                            <dxga:LinearDefaultModel/>
                                        </dxga:LinearGaugeControl.Model>
                                        <dxga:LinearGaugeControl.Scales>
                                            <dxga:LinearScale HorizontalAlignment="Center">
                                                <dxga:LinearScale.Layers>
                                                    <dxga:LinearScaleLayer/>
                                                    <dxga:LinearScaleLayer/>
                                                </dxga:LinearScale.Layers>
                                                <dxga:LinearScale.LevelBars>
                                                    <dxga:LinearScaleLevelBar Value="{Binding HUMI_B}"/>
                                                </dxga:LinearScale.LevelBars>
                                                <dxga:LinearScale.Markers>
                                                    <dxga:LinearScaleMarker Value="{Binding HUMI_B}">
                                                        <dxga:LinearScaleMarker.Presentation>
                                                            <dxga:DefaultLinearScaleMarkerPresentation Fill="Red"/>
                                                        </dxga:LinearScaleMarker.Presentation>
                                                        <dxga:LinearScaleMarker.Options>
                                                            <dxga:LinearScaleMarkerOptions Offset="-10" Orientation="Normal"/>
                                                        </dxga:LinearScaleMarker.Options>
                                                    </dxga:LinearScaleMarker>
                                                </dxga:LinearScale.Markers>
                                                <dxga:LinearScale.Ranges>
                                                    <dxga:LinearScaleRange StartValue="0%" EndValue="69%" />
                                                    <dxga:LinearScaleRange StartValue="69%" EndValue="69%" />
                                                    <dxga:LinearScaleRange StartValue="70%" EndValue="100%" >
                                                        <dxga:LinearScaleRange.Presentation>
                                                            <dxga:DefaultLinearScaleRangePresentation Fill="#EAA0AC"/>
                                                        </dxga:LinearScaleRange.Presentation>
                                                    </dxga:LinearScaleRange>
                                                </dxga:LinearScale.Ranges>
                                            </dxga:LinearScale>
                                        </dxga:LinearGaugeControl.Scales>
                                    </dxga:LinearGaugeControl>
                                    <Label Content="{Binding HUMI_B}" Width="220" Height="40" Background="CornflowerBlue" Foreground="White" FontSize="25" FontWeight="Bold" BorderBrush="WhiteSmoke" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"></Label>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </DockPanel>
</its:ItsPageOffice>
