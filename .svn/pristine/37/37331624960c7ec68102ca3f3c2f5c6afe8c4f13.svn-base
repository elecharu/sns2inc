<%@ Page Language="C#" AutoEventWireup="true" CodeFile="ErrPage.aspx.cs" Inherits="ErrPage" %>
<div style="background-color:white; padding:50px 50px 0px 50px; width:100%; height:500px; display:block;">
    <div style="display:block; font-size:16px; margin-bottom:20px;">
        <span>发生错误, 页面无法显示 !!</span>
    </div>
    <span style="display:block;font-size:16px;font-weight:bold;margin-bottom:50px;color:red;">
        <i class="fa fa-1x fa-warning"></i><%= errMsg %>
    </span>
    <a class="rj_button" onclick="window.history.back();">
        <i class="fa fa-1x fa-arrow-left"></i>返回上页
    </a>
</div>