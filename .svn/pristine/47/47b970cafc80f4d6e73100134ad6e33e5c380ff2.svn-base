<its:ItsPageOffice xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  x:Class="SYS0201.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0201"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">
    <DockPanel>

        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <its:Combo Label="패키지유형" Value="{Binding PKGTP}" GPCD="*PKGTP"></its:Combo>
                <its:Text Label="키워드" Width="300" Value="{Binding KEYWORD}"></its:Text>
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_A1">
                <!-- ################################# PANEL CONTENT: START -->
                <its:Combo Label="패키지유형" Value="{Binding PKGTP}" GPCD="PKGTP"/>
                <its:Text Label="화면코드" Value="{Binding PRGCD}"/>
                <its:Text Label="화면명" Value="{Binding PRGNM}"/>
                <UserControl Width="5000"/>
                <its:Text Label="비고" Width="600" Value="{Binding REMARK}"/>
                <!-- ################################# PANEL CONTENT: END -->
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource GRID}" Grid.Column="0">
            <its:Grid x:Name="GRID_G1">
                <its:Grid.Columns>
                    <!-- ################################# COLUMN FLEX: START -->
                    <its:Column Header="선택" IsRowCheck="True"></its:Column>
                    <its:Column Width="100" Header="패키지유형" FieldName="PKGTP" GPCD="PKGTP"></its:Column>
                    <its:Column Width="150" Header="화면코드" FieldName="PRGCD"></its:Column>
                    <its:Column Width="200" Header="화면명" ReadOnly="False" FieldName="PRGNM"></its:Column>
                    <its:Column Width="500" Header="비고" ReadOnly="False" FieldName="REMARK"></its:Column>
                    <!-- ################################# COLUMN FLEX: END -->
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

    </DockPanel>
</its:ItsPageOffice>
