public static class ItsOmronSerialFINS
{
    private static string START = "@";
    private static string UNIT_NO = "00";
    private static string HEADER = "FA";
    private static string RWT = "0";        // response wait time
    private static string ICF = "00";
    private static string DA2 = "00";
    private static string SA2 = "00";
    private static string SID = "00";
    private static string READ = "0101";
    private static string MA = "82";        // 메모리 영역 (D:82)
    private static string READ_ADDR = "";   // 읽을번지
    private static string WORD_READ = "00"; // 워드읽기(고정)
    private static string ADDR_COUNT = "0001";   // 읽을번지수량
    private static string FCS = "";         // FCS
    private static string END = "*\r";

    public static System.IO.Ports.SerialPort serialPort = new System.IO.Ports.SerialPort();


    //------ DM 읽기(1개 번지)----------------------------------------------------------------
    // 일단 변환 로직은 미작성
    public static string DM_READ(SerialPort serialPort, string comm_text)
    {
        if (!serialPort.IsOpen)
        {
            try
            {
                serialPort.Open();
            }
            catch
            {
                return "";
            }
        }

        // D를 일단 지우고 4자리가 아니면 탈출
        READ_ADDR = comm_text.Replace("D", "");
        if (READ_ADDR.Length != 4)
        {
            return "Addr Error!";
        }

        // 10회까지 시도
        int PLC_Loop = 0;
        string receive = "";
        Start:

        PLC_Loop = PLC_Loop + 1;
        if (PLC_Loop > 10)
        {
            return "";
        }

        // 명령어 생성
        string command = START + UNIT_NO + HEADER + RWT + ICF + DA2 + SA2 + SID + READ + MA + READ_ADDR + WORD_READ + ADDR_COUNT;

        FCS = CalcFCS(command).ToUpper();

        receive = serialPort.ReadExisting();

        // 명령어 전달
        serialPort.Write(command + FCS + END);

        System.Threading.Thread.Sleep(200);

        // 결과 수신
        receive = serialPort.ReadExisting();

        if (receive == "")
        {
            goto Start;
        }

        // 정상수신여부
        if (receive.Substring(7, 4).Equals("00"))
        {
            // hex -> dec
            return Convert.ToInt32(receive.Substring(7, 4), 16).ToString();
        }
        else
        {
            return "Error Code : " + receive.Substring(6, 2);
        }
        

    }
