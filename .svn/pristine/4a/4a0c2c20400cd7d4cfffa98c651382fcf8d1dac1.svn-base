<its:ItsPageOffice x:Class="SYS0301.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0301"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">

    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# MODEL_SEARCH : START -->
                <its:Text Label="키워드" Value="{Binding KEYWORD}"/>
                <its:Button Label="라벨디자인" Width="150" CommandName="LabelDesign"/>
                <!-- ################################# MODEL_SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_A1">
                <!-- ################################# MODEL_DETAIL: START -->
                <its:Text Label="라벨코드" Value="{Binding LABELCD}"/>
                <its:Text Label="라벨명" Value="{Binding LABELNM}"/>
                <its:Text Label="LOT포맷" Value="{Binding LOTFORMAT}"/>
                <its:Text Label="비고" Value="{Binding REMARK}"/>
                <!-- ################################# MODEL_DETAIL: END -->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource GRID}">
            <its:Grid x:Name="GRID_G1">
                <!-- ################################# MODEL_GRID: START -->
                <its:Grid.Columns>
                    <its:Column Width="100" Header="선택" IsRowCheck="True"/>
                    <its:Column Width="100" Header="라벨코드" FieldName="LABELCD"/>
                    <its:Column Width="100" Header="라벨명" FieldName="LABELNM" ReadOnly="False"/>
                    <its:Column Width="100" Header="LOT포맷" FieldName="LOTFORMAT" ReadOnly="False"/>
                    <its:Column Width="100" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                </its:Grid.Columns>
            </its:Grid>
            <!-- ################################# MODEL_GRID: END -->
        </UserControl>
    </DockPanel>
</its:ItsPageOffice>
