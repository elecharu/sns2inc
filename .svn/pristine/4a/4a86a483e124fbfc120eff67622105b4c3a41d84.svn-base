<its:ItsPageTml x:Class="TML1020.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
      xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
      xmlns:local="clr-namespace:TML1020"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="900" Height="480">
    <Canvas Background="Silver">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="900" Height="60">
                <its:Date Label="입고일자" Value="{Binding SDATE}"/>
                <its:Date Label="" LabelWidth="0" Width="120" Value="{Binding EDATE}"/>
                <its:Button Label="입고 조회" CommandName="SEL_MTRIN" Width="100"/>
                <UserControl Width="400"/>
                <its:Text Label="거래명세서번호" LabelWidth="70" Value="{Binding INVOICEKEY}" KeyDown="Text_KeyDown"/>
                <its:Button Label="거래명세서 조회" CommandName="SEL_INVOICEKEY" Width="100" BackColor="GREEN"/>
                <its:Button Label="발주별 입고등록" CommandName="ADD_MTRODR_IN" Width="100" BackColor="GREEN"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="60">
            <its:Grid x:Name="GRID_G1" Width="900" Height="420">
                <its:Grid.Columns>
                    <its:Column Header="입고일자" FieldName="INDATE" ALGIN="CENTER"/>
                    <its:Column Header="거래명세서 번호" FieldName="INVOICEKEY" ALGIN="CENTER"/>
                    <its:Column Header="입고등록번호" FieldName="MTRINKEY" ALGIN="CENTER" Visible="False"/>
                    <its:Column Header="거래처" FieldName="CUSTCD" ALGIN="CENTER" GPCD="CUSTCD"/>
                    <its:Column Header="품목코드" FieldName="ITEMCD" ALGIN="CENTER"/>
                    <its:Column Header="품명" FieldName="ITEMNM" ALGIN="CENTER"/>
                    <its:Column Header="입고수량" FieldName="INQTY" ALGIN="CENTER" DecimalPoint="0"/>
                    <its:Column Header="로트별 상세정보" FieldName="INDATE" ALGIN="CENTER" CellType="Button" ButtonText="보기" CommandName="LIST_MTRINLOT_LOTKEY"/>
                    <its:Column Header="입고취소" FieldName="INDATE" ALGIN="CENTER" CellType="Button" ButtonText="취소" CommandName="DEL_MTRIN"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Canvas.Left="100" Canvas.Top="30" Style="{DynamicResource TML_POP}" Width="700" Height="400" Visibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <its:WrapContent x:Name="PANEL_A1">
                    <its:Text Label="거래명세번호" Value="{Binding INVOICEKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주키" Value="{Binding MTRODRKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주상세키" Value="{Binding MTRODRSEQ}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="출고일자" Value="{Binding OUTDATE}" ReadOnly="True"/>
                    <TextBlock Text="▶▶▶" Width="280" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16"/>
                    <its:Text Label="입고일자" Value="{Binding INDATE}" ReadOnly="True"/>
                    <its:Text Label="출고처" Value="{Binding OUTCUSTCD}" ReadOnly="True"/>
                    <UserControl Width="280"/>
                    <its:Text Label="입고처" Value="{Binding INCUSTCD}" ReadOnly="True"/>
                </its:WrapContent>

                <its:WrapContent Grid.Row="1" >
                    <its:Grid x:Name="GRID_G2" Height="245" Width="695">
                        <its:Column FieldName="ITEMCD" Width="120" Header="품목코드" ALGIN="Center"/>
                        <its:Column FieldName="ITEMNM" Width="200" Header="품명" ALGIN="Center"/>
                        <its:Column FieldName="LOTKEY" Width="120" Header="로트번호" ALGIN="Center"/>
                        <its:Column FieldName="LOTQTY" Width="120" Header="로트수량" ALGIN="Center" DecimalPoint="0"/>
                        <its:Column FieldName="LOTTP"  Width="100" Header="로트구분" ALGIN="Center" GPCD="LOTTP"/>
                    </its:Grid>
                </its:WrapContent>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <its:WrapContent x:Name="PANEL_A2" >
                        <UserControl Width="100"/>
                        <its:Button Label="입고 등록" CommandName="ADD_MTRIN" FontWeight="Bold" Height="55" Width="100" BackColor="GREEN" x:Name="btnADD_MTRIN"/>
                    </its:WrapContent>
                    <its:WrapContent x:Name="PANEL_A3" Grid.Column="1">
                        <its:Combo Label="원자재 입고" GPCD="WARECD" Value="{Binding MATERWARECD}" x:Name="cbMATERWARECD"/>
                        <its:Combo Label="반제품 입고" GPCD="WARECD" Value="{Binding PRODUCTWARECD}" x:Name="cbPRODUCTWARECD"/>
                        <its:Combo Label="상품 입고" GPCD="WARECD" Value="{Binding GOODSWARECD}" x:Name="cbGOODSWARECD"/>
                        <its:Combo Label="시편 입고" GPCD="WARECD" Value="{Binding TESTWARECD}" x:Name="cbTESTWARECD"/>
                    </its:WrapContent>
                </Grid>
            </Grid>
        </UserControl>

        <UserControl Canvas.Left="100" Canvas.Top="30" Style="{DynamicResource TML_POP}" Width="700" Height="400" Visibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <its:WrapContent x:Name="PANEL_S2" Width="700" Height="60">
                    <its:Date Label="발주일자" Width="180" Value="{Binding SDATE}"/>
                    <its:Date HidenLabel="Y" Width="100"  Value="{Binding EDATE}"/>
                    <UserControl Width="300"/>
                    <its:Pop GPCD="CUSTCD" Width="250" Label="거래처코드" Value="{Binding CUSTCD}" ShowKeyPad="True"/>
                    <its:Pop GPCD="ITEMID" Width="250" Label="품목코드" Value="{Binding ITEMCD}" ShowKeyPad="True"/>
                    <UserControl Width="20"/>
                    <its:Button Label="발주 조회" Width="150" Height="30" CommandName="LIST_MTRODRD" FontWeight="Bold"/>
                </its:WrapContent>
                <its:Grid x:Name="GRID_G3" Width="700" Height="150" Grid.Row="1">
                    <its:Grid.Columns>
                        <its:Column Width="80" Header="발주일자" FieldName="MTRODRDATE" ALGIN="center"/>
                        <its:Column Width="120" Header="거래처" FieldName="CUSTCD" ALGIN="center" GPCD="CUSTCD"/>
                        <its:Column Width="100" Header="품목코드" FieldName="ITEMCD" ALGIN="center"/>
                        <its:Column Width="130" Header="품명" FieldName="ITEMNM"/>
                        <its:Column Width="130" Header="규격" FieldName="ITEMSPEC"/>
                        <its:Column Width="80" DecimalPoint="0" Header="발주수량" FieldName="ODRQTY"/>
                        <its:Column Width="80" Header="납기일자" FieldName="EXPDATE" ALGIN="center"/>
                        <its:Column Width="100" Header="발주키" FieldName="MTRODRKEY" Visible="False"/>
                        <its:Column Width="100" Header="발주상세키" FieldName="MTRODRSEQ" Visible="False"/>
                    </its:Grid.Columns>
                </its:Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <its:Grid x:Name="GRID_G4" Grid.Row="2">
                        <its:Grid.Columns>
                            <its:Column Width="80" Header="입고 일자" FieldName="MTRINTIME" ALGIN="center"/>
                            <its:Column Width="100" Header="로트번호" FieldName="LOTKEY" ALGIN="center"/>
                            <its:Column Width="70" Header="로트수량" FieldName="LOTQTY" DecimalPoint="0"/>
                            <its:Column Width="100" Header="입고창고" FieldName="WARECD" GPCD="WARECD" ALGIN="center"/>
                            <its:Column Width="100" Header="입고키" FieldName="MTRINKEY" Visible="False"/>
                            <its:Column Width="50" Header="재발행" CellType="Button" ButtonText="▤" CommandName="LABEL_REPRINT" />
                            <its:Column Width="80" Header="입고 삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_MTRINLOT" />
                        </its:Grid.Columns>
                    </its:Grid>
                    <its:WrapContent x:Name="PANEL_S3" Grid.Column="2">
                        <UserControl Height="40"/>
                        <its:Date x:Name="date_MTRINDATE" Label="입고일자" Width="200" Value="{Binding MTRINDATE}"/>
                        <its:Number x:Name="num_LOTQTY" Width="200" Label="로트수량" DecimalPoint="0" Value="{Binding LOTQTY}" ShowKeyPad="True" />
                        <its:Combo x:Name="cb_INWARE" Label="입고창고" GPCD="WARECD" Value="{Binding INWARE}"/>
                        <its:Button Label="입고 등록" Width="200" Height="50" FontSize="20" FontWeight="Bold" CommandName="ADD_MTRINLOT" BackColor="GREEN"/>
                    </its:WrapContent>
                </Grid>
            </Grid>
        </UserControl>

        <UserControl Canvas.Left="100" Canvas.Top="30" Style="{DynamicResource TML_POP}" Width="700" Height="400" Visibility="Hidden">
            <its:WrapContent x:Name="PANEL_A4">
                <its:Grid x:Name="GRID_G5" Width="695" Height="370" >
                    <its:Column FieldName="ITEMCD" Width="120" Header="품목코드" ALGIN="Center"/>
                    <its:Column FieldName="ITEMNM" Width="200" Header="품명" ALGIN="Center"/>
                    <its:Column FieldName="LOTKEY" Width="120" Header="로트번호" ALGIN="Center"/>
                    <its:Column FieldName="LOTQTY" Width="120" Header="로트수량" ALGIN="Center" DecimalPoint="0"/>
                    <its:Column FieldName="LOTTP"  Width="100" Header="로트구분" ALGIN="Center" GPCD="LOTTP"/>
                </its:Grid>
            </its:WrapContent>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
