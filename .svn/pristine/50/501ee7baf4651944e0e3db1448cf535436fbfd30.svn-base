        }

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsMsg.Toast(ItsMsg.CommonMsg.DeleteComplete());
        ItsGrid.Setkey('grid1', 'EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));
        ItsButton.EventSearch();
    });

};




///*********************************************************************************************************************************************************************************/
//정기점검 복사 팝업오픈
ItsButton.Event('bdiv3_btn_COPY').onClick = function () {
    var EQMCD = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD');

    if (!EQMCD) {
        return;
    }

    ItsPop.Open('pop_EQM02_COPY');

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM02')

    maria.AddParam('EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid7', maria.store);
};

ItsGrid.Event('grid7').onSelect = function () {
    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM02');

    maria.AddParam('EQMCD', ItsGrid.GetValue('grid7', ItsGrid.GetCurrentIndex('grid7'), 'EQMCD'));

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid8', maria.storeExtend1);
}


// 정기점검 복사팝업 저장버튼
ItsButton.Event('btn_COPY_EQM02').onClick = function () {
    var EQMCD = ItsGrid.GetValue('grid7', ItsGrid.GetCurrentIndex('grid7'), 'EQMCD')

    if (!EQMCD) {
        ItsMsg.Alert('검사항목을 선택해주세요');
        return;
    }

    ItsMsg.Confirm("선택한 항목을 복사하시겠습니까?", function () {
        var maria = new ItsMaria('EQM1001_R03', 'COPY_EQM02');

        maria.AddParam('EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));
        maria.AddParam('EQMCD_COPY', ItsGrid.GetValue('grid7', ItsGrid.GetCurrentIndex('grid7'), 'EQMCD'));

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        } else {
            ItsButton.Event('btn_CANCEL_COPY_EQM02').onClick();
            ItsMsg.Toast(ItsMsg.CommonMsg.AddComplete);
            ItsGrid.Setkey('grid1', 'EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));
            ItsButton.EventSearch();
        }
    });
}

// 정기점검 복사팝업 취소버튼
ItsButton.Event('btn_CANCEL_COPY_EQM02').onClick = function () {
    ItsGrid.Clear('grid7');
    ItsGrid.Clear('grid8');

    ItsPop.Close('pop_EQM02_COPY');
}
///*********************************************************************************************************************************************************************************/

ItsGrid.Event('grid9').onDoubleClick = function (rowIndex, field) {
    ItsGrid.Event('grid9').onKeydownEnter(rowIndex, field);
}

//품목구분, 품명 더블 클릭시 & 거래처코드, 거래처명 더블 클릭시,, 
ItsGrid.Event('grid9').onKeydownEnter = function (rowIndex, field) {
    if (field == 'M01' || field == 'M02' || field == 'M03' || field == 'M04' || field == 'M05' || field == 'M06' || field == 'M07' || field == 'M08' || field == 'M09' || field == 'M10' || field == 'M11' || field == 'M12') {
        var value = ItsGrid.GetValue('grid9', rowIndex, field);

        if (value === null || value === undefined || value === "") {
            ItsGrid.SetValue('grid9', rowIndex, field, "●");
        }
        else {
            ItsGrid.SetValue('grid9', rowIndex, field, '');
        }
        ItsGrid.CheckRow('grid9', rowIndex);
    }
}

//저장
ItsButton.Event('div_SAVE_CYCLE_EQM').onClick = function () {
    var hasChecked = false;

    for (var i = 0; i < ItsGrid.Length('grid9'); i++) {
        if (ItsGrid.IsChecked('grid9', i)) {
            hasChecked = true;
            break;
        }
    }

    if (!hasChecked) {
        ItsMsg.Toast('선택된 항목이 없습니다.');
        return;
    }

    ItsMsg.Confirm("선택한 항목을 수정하시겠습니까?", function () {
        var maria = new ItsMaria('EQM1001_R03', 'SAVE_CYCLE_EQMCD');

        for (var i = 0; i < ItsGrid.Length('grid9'); i++) {
            if (ItsGrid.IsChecked('grid9', i)) {
                maria.AddList('EQMCD_LIST', ItsGrid.GetValue('grid9', i, 'EQMCD'));

                maria.AddList('YEAR_LIST', ItsGrid.GetValue('grid9', i, 'YEAR'));

                maria.AddList('M01_LIST', ItsGrid.GetValue('grid9', i, 'M01'));
                maria.AddList('M02_LIST', ItsGrid.GetValue('grid9', i, 'M02'));
                maria.AddList('M03_LIST', ItsGrid.GetValue('grid9', i, 'M03'));
                maria.AddList('M04_LIST', ItsGrid.GetValue('grid9', i, 'M04'));
                maria.AddList('M05_LIST', ItsGrid.GetValue('grid9', i, 'M05'));
                maria.AddList('M06_LIST', ItsGrid.GetValue('grid9', i, 'M06'));
                maria.AddList('M07_LIST', ItsGrid.GetValue('grid9', i, 'M07'));
                maria.AddList('M08_LIST', ItsGrid.GetValue('grid9', i, 'M08'));
                maria.AddList('M09_LIST', ItsGrid.GetValue('grid9', i, 'M09'));
                maria.AddList('M10_LIST', ItsGrid.GetValue('grid9', i, 'M10'));
                maria.AddList('M11_LIST', ItsGrid.GetValue('grid9', i, 'M11'));
                maria.AddList('M12_LIST', ItsGrid.GetValue('grid9', i, 'M12'));
                maria.AddList('REMARK_LIST', ItsGrid.GetValue('grid9', i, 'REMARK'));
            }
        }

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsMsg.Toast(ItsMsg.CommonMsg.SaveComplete());
        ItsGrid.Setkey('grid1', 'EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));
        ItsButton.EventSearch();

    })
};

// 정기점검 삭제버튼
ItsButton.Event('div_DEL_CYCLE_EQM').onClick = function () {
    var hasChecked = false;

    for (var i = 0; i < ItsGrid.Length('grid9'); i++) {
        if (ItsGrid.IsChecked('grid9', i)) {
            hasChecked = true;
            break;
        }
    }

    if (!hasChecked) {
        ItsMsg.Toast('선택된 항목이 없습니다.');
        return;
    }

    ItsMsg.Confirm("선택한 항목을 삭제하시겠습니까?", function () {
        var maria = new ItsMaria('EQM1001_R03', 'DELETE_CYCLE_EQMCD');

        for (var i = 0; i < ItsGrid.Length('grid9'); i++) {
            if (ItsGrid.IsChecked('grid9', i)) {
                maria.AddList('EQMCD_LIST', ItsGrid.GetValue('grid9', i, 'EQMCD'));
                maria.AddList('YEAR_LIST', ItsGrid.GetValue('grid9', i, 'YEAR'));
            }
        }

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsMsg.Toast(ItsMsg.CommonMsg.DeleteComplete());
        ItsGrid.Setkey('grid9', 'EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid9'), 'EQMCD'));
        ItsButton.EventSearch();
    })
};
