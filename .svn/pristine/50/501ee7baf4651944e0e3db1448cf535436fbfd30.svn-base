/************************************************************************************************************************************
 * 조회 */
ItsButton.EventSearch = function () {
    //ItsGrid.Clear('grid1');
    if (ItsTab.GetIndex('tab1') == 0) {
        ItsGrid.Clear('grid2');
        ItsGrid.Clear('grid3');

        var maria = new ItsMaria('EQM1001_R03', 'LIST_MSTEQM');

        maria.AddPanel('div_EQM');

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsGrid.SetStore('grid1', maria.store.YnToBool('EQM01').YnToBool('EQM02'));
        ItsGrid.Get('grid1').autoSizeColumns();
    }
    else if (ItsTab.GetIndex('tab1') == 1) {
        //ItsGrid.Clear('grid9');        
        var maria = new ItsMaria('EQM1001_R03', 'LIST_CYCLE_EQMCD');

        maria.AddPanel('div_CYCLE_EQM');

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsGrid.SetStore('grid9', maria.store);
    }
};

// 일상점검 조회
ItsGrid.Event('grid1').onSelect = function () {
    var maria = new ItsMaria('EQM1001_R03', 'LIST_MSTEQM_EQM01');

    maria.AddParam('EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid2', maria.store.YnToBool('USEYN').YnToBool('WORKSTD_YN'));

    var maria = new ItsMaria('EQM1001_R03', 'LIST_MSTEQM_EQM02');

    maria.AddParam('EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid3', maria.store.YnToBool('USEYN'));
}


///*********************************************************************************************************************************************************************************/
//일상점검 복사 팝업오픈
ItsButton.Event('bdiv2_btn_COPY').onClick = function () {
    var EQMCD = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD')

    if (!EQMCD) {
        return;
    }

    ItsPop.Open('pop_EQM01_COPY');

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM01')

    maria.AddParam('EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid5', maria.store)
};

ItsGrid.Event('grid5').onSelect = function () {

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM01');

    maria.AddParam('EQMCD', ItsGrid.GetValue('grid5', ItsGrid.GetCurrentIndex('grid5'), 'EQMCD'));

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid6', maria.storeExtend1.YnToBool('WORKSTD_YN'));
}

// 일상점검 복사팝업 저장버튼
ItsButton.Event('btn_COPY_EQM01').onClick = function () {
    var EQMCD = ItsGrid.GetValue('grid5', ItsGrid.GetCurrentIndex('grid5'), 'EQMCD')

    if (!EQMCD) {
        ItsMsg.Alert('검사항목을 선택해주세요');
        return;
    }
    ItsMsg.Confirm("선택한 항목을 복사하시겠습니까?", function () {
        var maria = new ItsMaria('EQM1001_R03', 'COPY_EQM01');

        maria.AddParam('EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));
        maria.AddParam('EQMCD_COPY', ItsGrid.GetValue('grid5', ItsGrid.GetCurrentIndex('grid5'), 'EQMCD'));

        maria.CallProc();

        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        } else {
            ItsButton.Event('btn_CANCEL_COPY_EQM01').onClick();
            ItsMsg.Toast(ItsMsg.CommonMsg.AddComplete);
            ItsGrid.Setkey('grid1', 'EQMCD', ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'EQMCD'));
            ItsButton.EventSearch();
        }
    })
}

// 일상점검 복사팝업 취소버튼
ItsButton.Event('btn_CANCEL_COPY_EQM01').onClick = function () {
    ItsGrid.Clear('grid5');
    ItsGrid.Clear('grid6');

    ItsPop.Close('pop_EQM01_COPY');
}

