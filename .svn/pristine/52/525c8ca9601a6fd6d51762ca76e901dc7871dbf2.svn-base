CREATE DEFINER = 'root'@'%'
PROCEDURE MES_SNS2.PRD1001_R01(
  -- *****************************************************************************
-- Comment: 월간생산계획 등록
-- Create: 2026-09-23 신정수 
-- Modify: 
-- *****************************************************************************
  IN $SMONTH VARCHAR(10),      -- 조회년월
  IN $FACTORYCD VARCHAR(20),   -- 공장코드
  IN $ITEMID INT,              -- 품목번호
  IN $ITEMCD VARCHAR(20),      -- 품목코드   

  IN $ITEMID_LIST MEDIUMTEXT,
  IN $LINECD_LIST MEDIUMTEXT,
  IN $SALFUP_LIST MEDIUMTEXT,
  IN $UPH_LIST MEDIUMTEXT,
  IN $COUNTLINE_LIST MEDIUMTEXT,
  IN $WORKHOURS_LIST MEDIUMTEXT,

  IN $SUMQTY_LIST MEDIUMTEXT,
  IN $SAFEQTY_LIST MEDIUMTEXT,
  IN $CAPAQTY_LIST MEDIUMTEXT,
  IN $ODRQTY_LIST MEDIUMTEXT,
  IN $PLANQTY_LIST MEDIUMTEXT,
  IN $STOCKYN_LIST MEDIUMTEXT,
  IN $SALODRDKEY_LIST_LIST TEXT,
-- *****************************************************************************
 IN $CALLTYPE VARCHAR(50), IN $KEYWORD VARCHAR(1000))
PROC: BEGIN -- @CALLEMP, @CALLPRG, @CALLHOST, @CALLIP, @CALLMAC
-- SET @DEBUGLOGYN = 'Y'; 
-- *****************************************************************************
  DECLARE _$WORKHOURS_SMONTH DECIMAL(20, 8);

  DECLARE _$ITEMID VARCHAR(100);
  DECLARE _$LINECD VARCHAR(100);
  DECLARE _$SALFUP VARCHAR(100);
  DECLARE _$UPH VARCHAR(100);
  DECLARE _$COUNT_LINE VARCHAR(100);
  DECLARE _$WORKHOURS VARCHAR(100);
  DECLARE _$SUMQTY VARCHAR(100);
  DECLARE _$SAFEQTY VARCHAR(100);
  DECLARE _$CAPAQTY VARCHAR(100);
  DECLARE _$ODRQTY VARCHAR(100);
  DECLARE _$PLANQTY VARCHAR(100);
  DECLARE _$STOCKYN VARCHAR(100);
  DECLARE _$SALODRDKEY_LIST MEDIUMTEXT;
-- ****************************************************************************
CASE $CALLTYPE
-- ****************************************************************************
WHEN 'LIST_MONTHPLAN' THEN  -- 월생산계획 조회 

  IF EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH) THEN
    SELECT
        PLAN.LINECD
      , IFNULL(MSTLINE.LINENM, '') AS LINENM
      , CAST(PLAN.ITEMID AS CHAR) AS ITEMID
      , MSTITEM.ITEMCD
      , MSTITEM.ITEMNM
      , MSTITEM.ITEMSPEC      
      , PLAN.SALFUP
      , PLAN.UPH
      , PLAN.COUNT_LINE
      , PLAN.WORKHOURS
      , PLAN.SUMQTY
      , PLAN.SAFEQTY
      , PLAN.CAPAQTY
      , (PLAN.CAPAQTY * PLAN.SALFUP) AS CAPAAMT
      , PLAN.ODRQTY
      , (PLAN.ODRQTY * PLAN.SALFUP) AS ODRAMT
      , PLAN.STOCKYN
      , PLAN.PLANQTY
      , (PLAN.PLANQTY * PLAN.SALFUP) AS PLANAMT
      , IF(PLAN.CAPAQTY = 0, 0, ROUND(PLAN.PLANQTY / PLAN.CAPAQTY * 100, 1)) AS LOADFACTOR -- 부하율 = 월생산계획수량 / 생산CAPA수량 * 100
      , IF(PLAN.UPH = 0, 0, ROUND(PLAN.PLANQTY / (PLAN.UPH * 20), 1)) AS WORKDAYS_EXPECTED  -- 생산계획수량을 만드는데 필요한 근무일수 = 월생산계획수량 / (UPH * 20 hours)
      , PLAN.APPYN
      , CASE WHEN PLAN.APPYN = 'Y' THEN 'LIGHTGRAY' 
             WHEN PLAN.APPYN = 'N' THEN 'LIGHTCYAN' 
        END AS BACKGROUND
    FROM PRDPLAN_M AS PLAN
    INNER JOIN MSTITEM
      ON MSTITEM.ITEMID = PLAN.ITEMID
    LEFT JOIN MSTLINE
      ON MSTLINE.LINECD = PLAN.LINECD
    WHERE PLAN.PMONTH = $SMONTH
    ORDER BY PLAN.LINECD , MSTITEM.ITEMCD
    ;

    IF EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH AND APPYN = 'Y') THEN
      SELECT CONCAT('[', $SMONTH, '] 월 생산계획 확정됨') AS INFO;
    ELSE
      SELECT CONCAT('[', $SMONTH, '] 월 생산계획 저장됨') AS INFO;
    END IF;
  ELSE
    SET _$WORKHOURS_SMONTH = IFNULL((
                                        SELECT
                                          SUM(DAYTIME + NIGHTTIME + OVERTIME_DY + OVERTIME_NT) / 60
                                        FROM PRDWORKTIME
                                        WHERE LEFT(WORKDATE, 7) = $SMONTH
                                     ), 0);    

    SELECT
        RESULT.LINECD
      , RESULT.LINENM
      , CAST(RESULT.ITEMID AS CHAR) AS ITEMID
      , RESULT.ITEMCD
      , RESULT.ITEMNM
      , RESULT.ITEMSPEC
      , RESULT.SALFUP
      , RESULT.UPH
      , RESULT.COUNT_LINE
      , RESULT.WORKHOURS
      , RESULT.SUMQTY
      , RESULT.SAFEQTY
      , RESULT.CAPAQTY
      , RESULT.CAPAAMT
      , RESULT.ODRQTY
      , RESULT.ODRAMT
      , RESULT.PLANQTY
      , RESULT.PLANAMT
      , IF(RESULT.CAPAQTY = 0, 0, ROUND(RESULT.PLANQTY / RESULT.CAPAQTY * 100, 1)) AS LOADFACTOR -- 부하율 = 월생산계획수량 / 생산CAPA수량 * 100
      , IF(RESULT.UPH = 0, 0, ROUND(RESULT.PLANQTY / (RESULT.UPH * 20), 1)) AS WORKDAYS_EXPECTED  -- 생산계획수량을 만드는데 필요한 근무일수 = 월생산계획수량 / (UPH * 20 hours)
      , RESULT.SALODRDKEY_LIST
    FROM (
            SELECT
                MSTLINE.LINECD
              , MSTLINE.LINENM
              , SALODRD.ITEMID
              , MSTITEM.ITEMCD
              , MSTITEM.ITEMNM
              , MSTITEM.ITEMSPEC  
              , SALODRD.SALFUP
              , ITEM_FAC.UPH
              , IFNULL(MEI_ITEM.COUNT_LINE, 0) AS COUNT_LINE
              , _$WORKHOURS_SMONTH AS WORKHOURS
              , IFNULL(COMLOT_ITEM.SUMQTY, 0) AS SUMQTY
              , IFNULL(ITEM_FAC.SAFEQTY, 0) AS SAFEQTY
              , ITEM_FAC.UPH * _$WORKHOURS_SMONTH AS CAPAQTY
              , (ITEM_FAC.UPH * _$WORKHOURS_SMONTH) * SALODRD.SALFUP AS CAPAAMT
              , SUM(SALODRD.SALQTY) AS ODRQTY
              , SUM(SALODRD.SALQTY) * SALODRD.SALFUP AS ODRAMT
              , SUM(SALODRD.SALQTY) AS PLANQTY
              , SUM(SALODRD.SALQTY) * SALODRD.SALFUP AS PLANAMT
              , GROUP_CONCAT(CONCAT(SALODRD.SALODRKEY, '_', LPAD(CAST(SALODRD.ODRSEQ AS CHAR), 3, '0')) ORDER BY SALODRD.SALODRKEY, SALODRD.ODRSEQ SEPARATOR '>') AS SALODRDKEY_LIST
            FROM SALODR
            INNER JOIN SALODRD
              ON SALODRD.SALODRKEY = SALODR.SALODRKEY
            INNER JOIN MSTITEM
              ON MSTITEM.ITEMID = SALODRD.ITEMID
            INNER JOIN MSTITEM_FACTORY AS ITEM_FAC
              ON ITEM_FAC.ITEMID = MSTITEM.ITEMID
            INNER JOIN MSTROUT_MATCH
              ON MSTROUT_MATCH.ITEMID = SALODRD.ITEMID
             AND MSTROUT_MATCH.BASEYN = 'Y'
            INNER JOIN MSTROUT
              ON MSTROUT.ROUTCD = MSTROUT_MATCH.ROUTCD
             AND MSTROUT.USEYN = 'Y'
            INNER JOIN MSTROUT_DETAIL
              ON MSTROUT_DETAIL.ROUTCD = MSTROUT_MATCH.ROUTCD
            INNER JOIN MSTLINE
              ON MSTLINE.LINECD = MSTROUT_DETAIL.LINCD             
            LEFT JOIN (
                        SELECT
                            COMLOT.ITEMID
                          , SUM(COMLOT.LOTQTY) AS SUMQTY
                        FROM COMLOT
                        WHERE COMLOT.WARECD = '04S200_N'  -- 제품창고
                          AND LOTQTY > 0
                        GROUP BY COMLOT.ITEMID
                      ) AS COMLOT_ITEM  -- 제품별 현재고
              ON COMLOT_ITEM.ITEMID = MSTITEM.ITEMID
            LEFT JOIN (
                        SELECT
                            MEI.ITEMID
                          , COUNT(MEI.EQMCD) AS COUNT_LINE
                        FROM MSTLINE_EQM_ITEM AS MEI     
                        GROUP BY MEI.ITEMID
                      ) AS MEI_ITEM -- 제품별 생산라인수 
              ON MEI_ITEM.ITEMID = SALODRD.ITEMID
            WHERE LEFT(SALODR.ODRDATE, 7) = $SMONTH
              AND ITEM_FAC.FACTORYCD = $FACTORYCD -- 수주품목이 2공장
              AND MSTITEM.ITEMCG = 'DM100100' -- 제품
              AND MSTITEM.ITEMSRC = 'DM160100' -- 제조         
              AND MSTLINE.OSCCUSTCD = ''  -- 외주작업장 제외 
            GROUP BY SALODRD.ITEMID
         ) AS RESULT
    ORDER BY RESULT.LINECD, RESULT.ITEMCD
    ;

    SELECT CONCAT('[', $SMONTH, '] 월 생산계획 저장필요') AS INFO;
  END IF;

-- ****************************************************************************
WHEN 'SAVE_MONTHPLAN' THEN  -- 월생산계획 저장

  IF $SMONTH = '' THEN
    CALL COMERR('년월을 선택하세요.');
    LEAVE PROC;
  END IF;

  WHILE LENGTH($ITEMID_LIST) > 0 DO
    CALL COMSPLIT($ITEMID_LIST, _$ITEMID);
    CALL COMSPLIT($LINECD_LIST, _$LINECD);
    CALL COMSPLIT($SALFUP_LIST, _$SALFUP);
    CALL COMSPLIT($UPH_LIST, _$UPH);
    CALL COMSPLIT($COUNTLINE_LIST, _$COUNT_LINE);
    CALL COMSPLIT($WORKHOURS_LIST, _$WORKHOURS);
    CALL COMSPLIT($SUMQTY_LIST, _$SUMQTY);
    CALL COMSPLIT($SAFEQTY_LIST, _$SAFEQTY);
    CALL COMSPLIT($CAPAQTY_LIST, _$CAPAQTY);
    CALL COMSPLIT($ODRQTY_LIST, _$ODRQTY);
    CALL COMSPLIT($PLANQTY_LIST, _$PLANQTY);
    CALL COMSPLIT($STOCKYN_LIST, _$STOCKYN);
    CALL COMSPLIT($SALODRDKEY_LIST_LIST, _$SALODRDKEY_LIST);

    IF (SELECT APPYN FROM PRDPLAN_M WHERE PMONTH = $SMONTH AND ITEMID = CAST(_$ITEMID AS INT)) = 'Y' THEN
      CALL COMERR(CONCAT('확정된 생산계획은 수정이 불가능합니다.'
                        , '\n- 계획월: ', $SMONTH
                        , '\n- 품목코드: ', (SELECT * FROM MSTITEM WHERE ITEMID = CAST(_$ITEMID AS INT))
                        )
                 );
      LEAVE PROC;
    END IF;

    IF EXISTS (SELECT APPYN FROM PRDPLAN_M WHERE PMONTH = $SMONTH AND ITEMID = CAST(_$ITEMID AS INT))  THEN
      UPDATE PRDPLAN_M
      SET PLANQTY = CAST(_$PLANQTY AS DECIMAL(20, 8))
        , STOCKYN = _$STOCKYN
        , MTIME = CALLTIME()
        , MEMP = CALLEMP()
        , MPRG = CALLPRG()
      WHERE PMONTH = $SMONTH 
       AND ITEMID = CAST(_$ITEMID AS INT)
      ;
    ELSE
      INSERT INTO PRDPLAN_M(
          PMONTH
        , ITEMID
        , LINECD
        , SALFUP
        , COUNT_LINE
        , UPH
        , WORKHOURS
        , SUMQTY
        , SAFEQTY
        , CAPAQTY
        , ODRQTY
        , PLANQTY
        , APPYN
        , STOCKYN
        , RTIME, REMP, RPRG)
      VALUES (
          $SMONTH
        , CAST(_$ITEMID AS INT)
        , _$LINECD
        , CAST(_$SALFUP AS DECIMAL(20, 8))
        , CAST(_$COUNT_LINE AS DECIMAL(20, 8))
        , CAST(_$UPH AS DECIMAL(20, 8))
        , CAST(_$WORKHOURS AS DECIMAL(20, 8))
        , CAST(_$SUMQTY AS DECIMAL(20, 8))
        , CAST(_$SAFEQTY AS DECIMAL(20, 8))
        , CAST(_$CAPAQTY AS DECIMAL(20, 8))
        , CAST(_$ODRQTY AS DECIMAL(20, 8))
        , CAST(_$PLANQTY AS DECIMAL(20, 8))
        , 'N'
        , _$STOCKYN
        , CALLTIME(), CALLEMP(), CALLPRG()
      );

--       IF _$ITEMID = 374190 THEN
--         CALL COMERR(_$SALODRDKEY_LIST);
--         LEAVE PROC;
--       END IF;

      INSERT INTO PRDPLAN_M_SALODRD (
          PMONTH
        , SALODRKEY
        , ODRSEQ
        , CUSTCD
        , ITEMID
        , ITEMUNIT
        , SALQTY
        , SALFUP
        , DLVDT
        , RTIME, REMP, RPRG)
      SELECT 
          $SMONTH
        , SALODRD.SALODRKEY
        , SALODRD.ODRSEQ
        , SALODR.CUSTCD
        , SALODRD.ITEMID
        , SALODRD.ITEMUNIT
        , SALODRD.SALQTY
        , SALODRD.SALFUP
        , SALODRD.DLVDT
        , CALLTIME(), CALLEMP(), CALLPRG()
      FROM SALODRD
      INNER JOIN SALODR
        ON SALODR.SALODRKEY = SALODRD.SALODRKEY
      WHERE INSTR(_$SALODRDKEY_LIST, CONCAT(SALODRD.SALODRKEY, '_', LPAD(CAST(SALODRD.ODRSEQ AS CHAR), 3, '0'))) > 0
      ;
    END IF;
  END WHILE;

-- ****************************************************************************
WHEN 'DELETE_MONTHPLAN' THEN  -- 월생산계획 삭제

  IF $SMONTH = '' THEN
    CALL COMERR('년월을 선택하세요.');
    LEAVE PROC;
  END IF;

  IF EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH AND APPYN = 'Y') THEN
    CALL COMERR(CONCAT('확정된 생산계획은 삭제할 수 없습니다.'
                      , '\n- 계획월: ', $SMONTH
                      )
               );
    LEAVE PROC;
  END IF;

  DELETE FROM PRDPLAN_M WHERE PMONTH = $SMONTH;
  DELETE FROM PRDPLAN_M_SALODRD WHERE PMONTH = $SMONTH;
-- ****************************************************************************
WHEN 'CONFIRM_MONTHPLAN' THEN  -- 월생산계획 확정

  IF $SMONTH = '' THEN
    CALL COMERR('년월을 선택하세요.');
    LEAVE PROC;
  END IF;

  IF NOT EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH) THEN
    CALL COMERR(CONCAT('저장된 월생산계획이 없습니다.'
                      , '\n- 계획월: ', $SMONTH
                      )
               );
    LEAVE PROC;
  END IF;

  IF EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH AND APPYN = 'Y') THEN
    CALL COMERR(CONCAT('이미 확정되었습니다.'
                      , '\n- 계획월: ', $SMONTH
                      )
               );
    LEAVE PROC;
  END IF;

  UPDATE PRDPLAN_M
  SET APPYN = 'Y'
    , MTIME = CALLTIME()
    , MEMP = CALLEMP()
    , MPRG = CALLPRG()
  WHERE PMONTH = $SMONTH
  ;

-- ****************************************************************************
WHEN 'CANCEL_CONFIRM_MONTHPLAN' THEN  -- 월생산계획 확정취소

  IF $SMONTH = '' THEN
    CALL COMERR('년월을 선택하세요.');
    LEAVE PROC;
  END IF;

  IF NOT EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH) THEN
    CALL COMERR(CONCAT('저장된 월생산계획이 없습니다.'
                      , '\n- 계획월: ', $SMONTH
                      )
               );
    LEAVE PROC;
  END IF;

  IF NOT EXISTS (SELECT ITEMID FROM PRDPLAN_M WHERE PMONTH = $SMONTH AND APPYN = 'Y') THEN
    CALL COMERR(CONCAT('확정된 월생산계획이 없습니다.'
                      , '\n- 계획월: ', $SMONTH
                      )
               );
    LEAVE PROC;
  END IF;

  -- 주간계획에 등록된 월생산계획은 확정취소 안되도록 제한필요 


  UPDATE PRDPLAN_M
  SET APPYN = 'N'
    , MTIME = CALLTIME()
    , MEMP = CALLEMP()
    , MPRG = CALLPRG()
  WHERE PMONTH = $SMONTH
  ;
-- ****************************************************************************
END CASE; END