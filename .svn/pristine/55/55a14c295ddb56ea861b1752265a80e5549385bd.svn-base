<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
                x:Class="TML1010.R03"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="900" Height="480">
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="900" Height="60">
                <its:Pop GPCD="CUSTCD" Width="250" Label="거래처" Value="{Binding CUSTCD}" ShowKeyPad="True" x:Name="pop_CUSTCD"/>
                <its:Pop GPCD="ITEMID" Width="250" Label="품목" Value="{Binding ITEMID}" ShowKeyPad="True"/>
                <UserControl Width="20"/>
                <its:Button Label="소 재 재 고 조 회" Width="120" Height="30" CommandName="LIST_LOT" FontWeight="Bold"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="30">
            <its:Grid x:Name="GRID_G1" Width="900" Height="450">
                <its:Grid.Columns>
                    <its:Column Width="100" Header="거래처" FieldName="CUSTCD" GPCD="CUSTCD" Visible="False"/>
                    <its:Column Width="100" Header="창고" FieldName="WARECD" GPCD="WARECD" Visible="False"/>
                    <its:Column Width="100" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                    <its:Column Width="100" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="130" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="130" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="100" DecimalPoint="0" Header="재고수량" FieldName="LOTQTY"/>
                    <its:Column Width="80" Header="단위" FieldName="ITEMUNIT" ALGIN="center" GPCD="DM150"/>
                    <its:Column Width="100" Header="생산실적 등록" CellType="Button" CommandName="btn_ADD_RST" ButtonText="📝"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Canvas.Left="50" Canvas.Top="30" Style="{DynamicResource TML_POP}" Width="800" Height="425" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="365"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1">
                    <its:WrapContent x:Name="PANEL_A1">
                        <its:Combo Label=" ■ 생산 품목 " GPCD="MITEMID" FontWeight="Bold" Width="500" Value="{Binding MITEMID}" x:Name="cb_MITEMID"/>
                        <its:Text Label="자품목" Value="{Binding CITEMID}" Visibility="Collapsed"/>
                        <!--<its:Button Label="조 회" CommandName="SERECH_LOT_RST" Width="100"/>-->
                    </its:WrapContent>
                </Border>

                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2.5*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="Black" BorderThickness="1">
                            <its:WrapContent x:Name="PANEL_A2">
                                <UserControl Height="20"/>
                                <Label Content=" ■ 생산실적등록" FontWeight="Bold"/>
                                <its:Combo Label="주/야 구분" GPCD="PP161" Value="{Binding WGTP}" REF05="07"/>
                                <its:Date Label="시작일자" Value="{Binding SDATE}"/>
                                <its:Time Label="시작시간" Value="{Binding STIME}"/>
                                <its:Date Label="종료일자" Value="{Binding EDATE}"/>
                                <its:Time Label="종료시간" Value="{Binding ETIME}"/>
                                <its:Number Label="양품수량" Value="{Binding GOODQTY}" DecimalPoint="0"/>
                                <its:Number Label="시편수량" Value="{Binding TESTQTY}" DecimalPoint="0"/>
                                <its:Button Label="실 적 등 록" Width="225" Height="40" CommandName="ADD_RST" FontWeight="Bold" FontSize="50"/>
                            </its:WrapContent>
                        </Border>

                        <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="5*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="5*"/>
                                </Grid.RowDefinitions>

                                <its:WrapContent>
                                    <Label Content=" ■ 자재 투입" FontWeight="Bold"/>
                                </its:WrapContent>

                                <its:Grid Grid.Row="1" x:Name="GRID_G2">
                                    <its:Grid.Columns>
                                        <its:Column Width="100" Header="LOTNO" FieldName="LOTKEY"/>
                                        <its:Column Width="100" Header="HEATNO" FieldName="HEATNO"/>
                                        <its:Column Width="120" Header="품목코드" FieldName="ITEMCD"/>
                                        <its:Column Width="120" Header="품명" FieldName="ITEMNM"/>
                                        <its:Column Width="80" Header="수량" FieldName="LOTQTY" DecimalPoint="0"/>
                                    </its:Grid.Columns>
                                </its:Grid>

                                <its:WrapContent Grid.Row="2">
                                    <Label Content=" ■ 생산 실적" FontWeight="Bold"/>
                                </its:WrapContent>

                                <its:Grid Grid.Row="3" x:Name="GRID_G3">
                                    <its:Grid.Columns>
                                        <its:Column Width="120" Header="실적키" FieldName="OSCRSTKEY" Visible="False"/>
                                        <its:Column Width="120" Header="품목코드" FieldName="ITEMCD"/>
                                        <its:Column Width="100" Header="품명" FieldName="ITEMNM"/>
                                        <its:Column Width="80" Header="생산수량" FieldName="GOODQTY" DecimalPoint="0"/>
                                        <its:Column Width="60" Header="단위" FieldName="ITEMUNIT" GPCD="DM150"/>
                                        <its:Column Width="80" Header="시편수량" FieldName="TESTQTY" DecimalPoint="0"/>
                                        <its:Column Width="60" Header="삭제" CellType="Button" ButtonText="X" CommandName="DEL_RST"/>
                                    </its:Grid.Columns>
                                </its:Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </UserControl>
    </Canvas>
</its:ItsPageTml>