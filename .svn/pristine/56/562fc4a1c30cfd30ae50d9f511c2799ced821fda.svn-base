    public partial class Form1 : Form
    {

        string _rheoPath;
        string rheoDate;


        //string _rheoPath = itsRheoPath;

        System.Timers.Timer t1;
        List<string> _FileList = new List<string>();

        public Form1()
        {
            InitializeComponent();

            // 중복 실행 확인
            bool isRun = false;
            System.Diagnostics.Process currentProcess = System.Diagnostics.Process.GetCurrentProcess();
            System.Diagnostics.Process[] processess = System.Diagnostics.Process.GetProcesses();
            foreach (System.Diagnostics.Process process in processess)
            {
                if (currentProcess.Id != process.Id)
                {
                    if (currentProcess.ProcessName == process.ProcessName)
                    {
                        isRun = true;
                        break;
                    }
                }
            }
            if (isRun)
            {
                MessageBox.Show("프로그램이 이미 실행중입니다.\n\n트레이 아이콘을 확인하세요.");
                this.Close();
            }
            else
            {
                t1 = new System.Timers.Timer();
                t1.Interval = 1000 * 1;
                t1.Enabled = false;
                t1.Elapsed += T1_Elapsed;
            }


        }

        private bool IsClose = false;
        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            if (IsClose == true) return;

            e.Cancel = true;
            this.Visible = false;
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            ItsMaria.Set("IF_RHEO", "GET_FILELIST");
            DataTable dt = ItsMaria.Call().Tables[0];
            if (ItsMaria.IsError)
            {
                MessageBox.Show(ItsMaria.ErrMessage);
                return;
            }
            foreach (DataRow row in dt.Rows)
            {
                _FileList.Add(row["FILENAME"].ToString());
            }

            // t1.Start();

            btnStop.Enabled = false;
            btnStart.Select();
        }

        private void SearchFile(string filePath, DirectoryInfo dInfo)
        {
            FileInfo[] fileList = dInfo.GetFiles();
            foreach (FileInfo fInfo in fileList)
            {
                if (_stop) return;

                if (fInfo.Extension.ToUpper().Replace(".", "") == "DAT") //&& Convert.ToInt32(dInfo.ToString().Substring(0, 4)) >= 2023 && Convert.ToInt32(dInfo.ToString().Substring(4, 2)) >= 5)
                {
                    try
                    {
                        // 기준일자 이후 자료만 가져오자
                        DateTime sT = Convert.ToDateTime((dInfo.ToString().Substring(0, 4) + "-" + dInfo.ToString().Substring(4, 2) + "-01"));
                        DateTime eT = Convert.ToDateTime("2023-04-01");
                        int sub = DateTime.Compare(sT, eT);
                        if (sub > 0)
                        {
                            string rheoFullName = fInfo.FullName;
                            string changeFullName = "";

                            //try
                            //{
                            //    if (fInfo.FullName.ToUpper().IndexOf(".ZIP") <= 0)
                            //    {
                            //        changeFullName = rheoFullName + ".zip";
                            //        File.Copy(rheoFullName, changeFullName);
                            //    }
                            //    else
                            //    {
                            //        changeFullName = rheoFullName;
                            //    }

                            //    uploadFile(changeFullName, fInfo.Name);
                            //    File.Delete(changeFullName);
                            //}
                            //catch { }

                            string fileName = filePath + "/" + fInfo.Name;
                            if (!_FileList.Contains(fileName))
                            {
                                UPDATE_RHEO(filePath, fInfo);
                                _FileList.Add(fileName);
                            }
                        }
                    }
                    catch { }
                }
            }

            DirectoryInfo[] dirList = dInfo.GetDirectories();
            foreach (DirectoryInfo dirInfo in dirList)
            {
                SearchFile(filePath + "/" + dirInfo.Name, dirInfo);
            }
        }

        private void uploadFile(string rheoFilePath, string fileinfoName)
        {
            try
            {
                string ServerUrl = "http://daebong.optisco.com:8008/AAABIN/";

                string fileName = "Rheo: " + fileinfoName.Replace(".zip", "");
                byte[] fileData = System.IO.File.ReadAllBytes(rheoFilePath);
                string fileBase64 = Convert.ToBase64String(fileData);

                StringBuilder sb = new StringBuilder();
                byte[] byStr = Encoding.UTF8.GetBytes(fileBase64);
                for (int i = 0; i < byStr.Length; i++)
                {
                    sb.Append(@"%" + Convert.ToString(byStr[i], 16));
                }
                fileBase64 = sb.ToString();

                HttpWebRequest request = WebRequest.Create(ServerUrl + "FileUpload.aspx") as HttpWebRequest;
                request.Method = "POST";
                request.ContentType = "application/x-www-form-urlencoded";

                string param = "FILENAME=" + fileName + "&FILEDATA=" + fileBase64;
                byte[] paramByte = Encoding.UTF8.GetBytes(param);

                Stream requestStream = request.GetRequestStream();
                requestStream.Write(paramByte, 0, paramByte.Length);
                requestStream.Close();

                HttpWebResponse response = (HttpWebResponse)request.GetResponse();
                Stream responseStrem = response.GetResponseStream();
                StreamReader responseStremReader = new StreamReader(responseStrem, Encoding.UTF8);

                string fileKey = responseStremReader.ReadToEnd();
                if (fileKey.Substring(0, 6) == "ERROR:")
                {
                    MessageBox.Show(fileKey.Substring(6));
                    t1.Start();
                    return;
                }

                ItsMaria.Set("IF_RHEO", "UP_COMFILE");
                ItsMaria.AddOne("FILEKEY", fileKey);
                ItsMaria.Call();
                if (ItsMaria.IsError)
                {
                    MessageBox.Show(ItsMaria.ErrMessage);
                    t1.Start();
                    return;
                }
            }
            catch (Exception ex) { t1.Start(); }

        }

        private void UPDATE_RHEO(string filePath, FileInfo fInfo)
        {
            string[] fileDataList = System.IO.File.ReadAllLines(fInfo.FullName, Encoding.UTF8);

            string fileName = filePath + "/" + fInfo.Name;
            string LOTKEY = fileDataList[1];
            try
            {
               rheoDate = fInfo.Name.Substring(LOTKEY.Length + 1, 8);
               rheoDate = rheoDate.Substring(0, 4) + "-" + rheoDate.Substring(4, 2) + "-" + rheoDate.Substring(6, 2);

            }
            catch (ArgumentOutOfRangeException)
            {
                rheoDate = "1900-01-01";
            }
            if (fileDataList.Length >= 16)
            {
                // 파싱 및 업로드
                ItsMaria.Set("IF_RHEO", "ADD_RHEOFILE");
                ItsMaria.AddOne("RHEODATE", rheoDate + " " + fileDataList[14].Substring(7));
                ItsMaria.AddOne("FILENAME", fileName);
                ItsMaria.AddOne("RHEOEMP", fileDataList[16]);
                ItsMaria.AddOne("RHEOITEM", fileDataList[0]);
                ItsMaria.AddOne("RHEOKEY", fileDataList[1]);
                ItsMaria.AddOne("RHEORESULT", fileDataList[2]);
                ItsMaria.AddOne("RHEONO", fileDataList[3]);
                ItsMaria.AddOne("D01", fileDataList[4]);
                ItsMaria.AddOne("D02", fileDataList[5]);
                ItsMaria.AddOne("D03", fileDataList[6]);
                ItsMaria.AddOne("D04", fileDataList[7]);
                ItsMaria.AddOne("D05", fileDataList[8]);
                ItsMaria.AddOne("D06", fileDataList[9]);
                ItsMaria.AddOne("D07", fileDataList[10]);
                ItsMaria.AddOne("D08", fileDataList[11]);
                ItsMaria.AddOne("D09", fileDataList[12]);
                ItsMaria.AddOne("D10", fileDataList[13]);
                ItsMaria.AddOne("REMARK", fileDataList[17]);
                ItsMaria.Call();
                if (ItsMaria.IsError)
                {
                    MessageBox.Show(ItsMaria.ErrMessage);
                    t1.Start();
                    return;
                }
            }
            else
            {
                ItsMaria.Set("IF_RHEO", "ADD_FILE");
                ItsMaria.AddOne("FILENAME", fileName);
                try
                { ItsMaria.AddOne("RHEOKEY", fileDataList[1]); }
                catch (IndexOutOfRangeException) {   ItsMaria.AddOne("RHEOKEY", ""); }
                ItsMaria.Call();
                if (ItsMaria.IsError)
                {
                    MessageBox.Show(ItsMaria.ErrMessage);
                    t1.Start();
                    return;
                }
            }
        }

        private void T1_Elapsed(object sender, ElapsedEventArgs e)
        {
            t1.Stop();

            DirectoryInfo dirInfo = new DirectoryInfo(_rheoPath);
            SearchFile("", dirInfo);

            t1.Start();
        }

