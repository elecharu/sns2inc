    background-position-y:center; 

    display: inline-grid;
    align-content: center;    
}
.main_right_adminmenu > .loginifo span {
    margin-left: 53px;

    color:#FFFFFF;
    font-family: Roboto;
    font-weight: 700;
    font-size: 20px;
    line-height: 35.16px; 
}
.main_right_adminmenu > .logout_btn span {
    margin-left: 53px;
    color:#FFFFFF;
    font-family: Roboto;
    font-weight: 700;
    font-size: 20px;
    line-height: 35.16px;     
}

/* 열린 메뉴 탭 */
.wj-tabpanel > div > .wj-tabheaders > .wj-tabheader {
    /*height: 24px;
    line-height: 24px;
    display: initial;*/    
    color: #FFFFFF;
    background-color: #262938;

