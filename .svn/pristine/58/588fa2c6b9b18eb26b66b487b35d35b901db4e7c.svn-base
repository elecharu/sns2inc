}

.wj-tabpanel>div>.wj-tabheaders>.wj-tabheader:nth-child(2) {
    /*border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;*/
}
.wj-tabpanel > div > .wj-tabheaders > .wj-tabheader.wj-state-active:after {
    visibility: hidden;
}
