@charset "utf-8";
@font-face {
    src: url("/fonts/SpoqaHanSansNeo_TTF_original/SpoqaHanSansNeo-Regular.ttf");
    font-family: "SpoqaHanSansNeo_R";
}
@font-face {
    src: url("/fonts/SpoqaHanSansNeo_TTF_original/SpoqaHanSansNeo-Medium.ttf");
    font-family: "SpoqaHanSansNeo_M";
}
@font-face {
    src: url("/fonts/SpoqaHanSansNeo_TTF_original/SpoqaHanSansNeo-Bold.ttf");
    font-family: "SpoqaHanSansNeo_B";
}
body {
    font-family: 'SpoqaHanSansNeo_R', 'sans-serif';
    position: relative;
    background: #F3F3F3;
    display: flex;
    overflow: hidden;
}
.preloader {
    cursor: wait;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    display: flex;
    flex-flow: row nowrap;
    justify-content: center;
    align-items: center;
    background-color:transparent;
    /*background:none repeat scroll 0 0 #ffffff;*/
}
.spinner {
    border: 1px solid transparent;
    border-radius: 5px;
    position: relative;
}
.spinner:before {
    content: '';
    box-sizing: border-box;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 65px;
    height: 65px;
    margin-top: -68px;
    margin-left: -25px;
    border-radius: 50%;
    border: 2px solid #7691d9;
    border-top-color: #ffffff;
    animation: spinner 0.9s linear infinite;
}
@webkit-@keyframes spinner {
    to {
        transform: rotate(360deg);
    }
}
@keyframes spinner {
    to {
        transform: rotate(360deg);
    }
}
/* common */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    /*background: #262938;*/
}
a {
    color: inherit;
    text-decoration: none;
}
table {
    width: 100%;
    table-layout: fixed;
    word-break: break-all;
    border-collapse: collapse;
    border-spacing: 0;
}
img,
fieldset,
hr {
    border: 0 none;
}
ul,
li {
    list-style: none;
}
.logo_m {
    display: none;
}
#menuCollapseBtn {
    position: fixed;
    top: 50%;
    left: 220px;
    background-color:#D4D4D4;
    width:10px;
    height:40px;
    cursor:pointer;
}
#menuCollapseBtn > .fa-angle-left {
    padding: 11px 2px;
    color:#FFFFFF;
}
#menuCollapseBtn > .fa-angle-right {
    padding: 11px 3px;
    color:#FFFFFF;
}
#main_left_collapsed {
    display:none;
    width: 54px;
    height: 100vh;
    background-color: #FFFFFF;
    /*border-top-right-radius: 10px;*/
    border-bottom-right-radius: 10px;
}
#main_left_collapsed > img {
    width:42px;
    height:42px;
    margin-top:10px;
    margin-left:6px;
    user-select:none;
}
.main_left {
    width: 100%;
    height: 100vh;
    max-width: 220px;
    float: left;
    background: #FFFFFF;
    z-index: 5;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    box-shadow: 1px 1px 10px rgba(0, 0, 0, 0.1);
}
.main_left_top {
    margin-top: 10px;
    text-align: center;
}
.main_left_top > img {
    width: 78%;
    /*height: 45px;*/
}
.main_left .main_left_search {
    margin-top: 10px;
    text-align: center;
}
#main_left_menu_list_search {
    display: none;
}
#main_left_menu_list,
#main_left_menu_list_search {
    height: calc(100% - 110px);
    margin-top: -10px;
}
#main_left_menu_list,
#main_left_menu_list_search {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
}
#main_left_menu_list::-webkit-scrollbar,
#main_left_menu_list_search::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera*/
}
/* 좌측 메뉴 스타일 */
.wj-treeview {
    font-family: 'SpoqaHanSansNeo_M';
    color: #727171;
}
.wj-treeview .wj-node {
    padding: 0 6px 0 12px;
    white-space: unset;  
}
.wj-treeview .wj-node img {
    padding: 0;
}
.wj-treeview .wj-node:before {
    content: none;
}
.wj-treeview .wj-nodelist .wj-nodelist {
    padding-top: 3px;
    padding-bottom: 5px;
    padding-left: 15px;
}
.wj-treeview .wj-nodelist > .wj-node > img {
    width: 27px !important;
    height: 27px;
    margin-top: 4px;
    margin-right: 10px;
} /* 1차 메뉴 이미지 */
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-node > img {
    width: 22px !important;
    height: 22px;
    margin-top: 0px;
    margin-right: 5px;
} /* 2차 이상 메뉴 이미지 */
.wj-nodelist {
    background-color: #e7f4ff;
}
.wj-treeview .wj-nodelist > .wj-node {
    font-size: 15px;
    color: #727171;
    background-color: #FFFFFF;
    display: flex;
}
.wj-treeview .wj-nodelist > .wj-node span {
    line-height: 32px;
}
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-node span {
    line-height: 22px;
}
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-nodelist > .wj-node span {
    line-height: 20px;
}
.wj-treeview .wj-nodelist > .wj-node:not(.wj-state-collapsed) {
    color: #FFFFFF;
    background-color: #4774B9;
}
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-node,
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-nodelist {
    font-size: 13px;
    color: #727171;
    background-color: #e7f4ff;
}
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-nodelist > .wj-node,
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-nodelist > .wj-nodelist {
    font-size: 13px;
    color: #727171;
    background-color: #e7f4ff;
}
.wj-treeview .wj-nodelist > .wj-nodelist > .wj-nodelist > .wj-node.wj-state-selected {
    color: #4774B9;
}
/* 메뉴 검색 필드 */
#left_search_menu:hover {
    outline: none;
    background-color: #74A8F6;
    color: #FFFFFF;
}
#left_search_menu:hover + #left_search_img {
    background-image: url('../../images/menu/ic_menu_search_h.png');
    background-repeat: no-repeat;
    background-size: 20px 20px;
}
#left_search_menu:focus {
    outline: none;
    border: 2px solid #4774B9;
    background-color: #F4F4F4;
    color: #4774B9;
}
#left_search_menu::placeholder {
    color: #565656;
    font-family: 'SpoqaHanSansNeo_M';
    font-size: 15px;
}
#left_search_menu:hover::placeholder {
    color: #FFFFFF;
}
#left_search_menu {
    width: 183px;
    height: 34px;
    padding: 10px 18px;
    margin-left: 18px;
    margin-right: 18px;
    border: 1px solid transparent;
    border-radius: 20.5px;
    background-color: #F4F4F4;
    font-size: 13px;
    font-family: 'SpoqaHanSansNeo_M';
}
#left_search_img {
    float: right;
    top: -27px;
    right: 33px;
    width: 18px;
    height: 18px;
    position: relative;
    background-image: url('../../images/menu/ic_menu_search.png');
    background-repeat: no-repeat;
    background-size: 18px 18px;
    cursor: pointer;
}
.main_right {
    /*min-width: 1000px;*/
    flex-grow: 1; /* 부모가 flex 인 경우 너비 자동 계산 */
    background: #F3F3F3;
}


.main_right_tabmenu {
    /*position: absolute;
    top: 73px;*/
    height: 71px;
    background: #262938;
    width: calc(100vw);
    -ms-overflow-style:none;
}

#openedTabRight {
    position: fixed;
    top: 74.5px;
    right: 12px;
    height: 70px;
    color: white;
    z-index: 1;
    cursor: pointer;
    background-color: #4774B9;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    display:none;
    /*background: linear-gradient(90deg, rgba(71,116,185,0.75), #4774B9 40%);*/
}
#openedTabLeft i {
    padding: 0 3px;
    margin-top: 5px;
    -webkit-text-stroke: 0;
    font-size: 12px;
}
#openedTabRight i {
    padding: 0 3px;
    margin-top: 5px;
    -webkit-text-stroke: 0;
    font-size: 12px;
}
.wj-tabheader .fa-times {
    -webkit-text-stroke: 0;
    font-size: 13px;
    padding-left: 8px;
}
