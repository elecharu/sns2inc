#infoLayer {
    width: 370px;
    height: 100vh;
    position: fixed;
    right: 0;
    color: #565656;
    background-color: #FFFFFF;
    box-shadow: -5px 0 15px rgba(0, 0, 0, 0.15);
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    z-index: 999;
    padding-top: 100px;
}
.infoLayer_cancel {
    position: absolute;
    width: 20px;
    height: 20px;
    top: 20px;
    right: 20px;
    background: url('../../images/Login/ic_login_close.png') no-repeat;
    background-size: 14px 14px;
    cursor: pointer;
}
.infoLayer_top {    
    text-align: center;
}
.infoLayer_top .hello {
    font-size: 26px;
}
.infoLayer_top .user {
    margin-top: 30px;
    height: 120px;
    text-align: center;
}
.passwordform {
    margin: 40px 50px 0;
    font-size: 15px;
    font-family: 'SpoqaHanSansNeo_M';
    text-align: left;
}
.infoLayer_top input {
    width: 270px;
    height: 24px;
    border: 1px solid #C0C0C0;
    margin-top: 5px;
    margin-bottom: 10px;
    padding: 4px 10px 5px;
}
.infoLayer_top input::placeholder {
    color: #C0C0C0;
}
.infoLayer_top .passerr {
    margin-top: 0;
    height: 13px;
    color: #F34F4F;
    font-size: 11px;
}
.infoLayer_top .passwordBtn {
    margin-top: 9px;
    width: 270px;
    height: 35px;
    line-height: 35px;
    background-color: #FF9B48;
    color: #FFFFFF;
    font-size: 16px;
    text-align: center;
    vertical-align: middle;
    border-radius: 5px;
    cursor:pointer;
}
.infoLayer_top .mymenuBtn {
    margin-top: 10px;
    width: 270px;
    height: 35px;
    line-height: 35px;
    background-color: #FFFFFF;
    color: #727171;
    font-size: 16px;
    text-align: center;
    vertical-align: middle;
    border: 1px solid #C0C0C0;
    border-radius: 5px;
    cursor:pointer;
    background: url('../../images/login/ic_login_mymenu.png') no-repeat;
    background-size: 26px 26px;
    background-position-x: 73px;
    background-position-y: center;
}
.infoLayer_top .mymenuBtn > div {
    margin-left:25px;
}
.infoLayer_top .user > div:nth-child(1) {
    background: url('../../images/ButtonBar/ic_button_id.png') no-repeat;
    background-size: 120px 120px;
    width: 100%;
    height: 120px;
    background-position-x: center;
    background-position-y: center;
}
.infoLayer_top .user > div:nth-child(2) {
    cursor: pointer;
    position: relative;
    width: 40px;
    height: 40px;
    top: -40px;
    left: 211px;
    background: url('../../images/Login/ic_login_edit.png') no-repeat, #C8C8C8;
    background-size: 22px 22px;
    background-position-x: center;
    background-position-y: center;
    border-radius: 40px;
}
.infoLayer_top .user > div:nth-child(2):hover {
    background: url('../../images/Login/ic_login_edit.png') no-repeat, #74A8F6;
    background-size: 22px 22px;
    background-position-x: center;
    background-position-y: center;
}
.infoLayer_top .user > div:nth-child(2):active {
    background: url('../../images/Login/ic_login_edit.png') no-repeat, #4773B9;
    background-size: 22px 22px;
    background-position-x: center;
    background-position-y: center;
}
.infoLayer_top .mail {
    margin-top: 10px;
    font-size: 14px;
    font-family: 'SpoqaHanSansNeo_M';
}
.infoLayer_bottom {
    position: absolute;
    bottom: 0;
    width: 100%;
}
.infoLayer_bottom_info {
    margin-left: 30px;
    font-size: 12px;
}
.infoLayer_bottom_info .optisco {
    width: 91px;
    height: 19px;
    background: url('../../images/Login/logo_optisco.png') no-repeat;
    background-size: 91px 19px;
}
.infoLayer_bottom_info .curVersion {
    margin-top: 10px;
    margin-bottom: 5px;
    color: #565656;
    font-family: 'SpoqaHanSansNeo_M';
}
.infoLayer_bottom_info .curVersion > div:nth-child(1) {
    width: 90px;
    display: inline-block;
    text-align: right;
}
.infoLayer_bottom_info .curVersion > div:nth-child(2) {
    margin-left: 20px;
    display: inline-block;
    color: #4774B9;
}
.infoLayer_bottom_info .lastVersion {
    margin-bottom: 10px;
    color: #565656;
    font-family: 'SpoqaHanSansNeo_M';
    display: inline-block;
}
.infoLayer_bottom_info .lastVersion > div:nth-child(1) {
    width: 90px;
    display: inline-block;
    text-align: right;
}
.infoLayer_bottom_info .lastVersion > div:nth-child(2) {
    margin-left: 20px;
    display: inline-block;
    color: #4774B9;
}
.infoLayer_bottom_info .copyright {
    font-size: 11px;
    margin-bottom: 5px;
    color: #A3A3A3;
    font-family: 'SpoqaHanSansNeo_M';
}
.infoLayer_bottom_info .itsco {
    font-size: 11px;
    margin-bottom: 15px;
    color: #A3A3A3;
    font-family: 'SpoqaHanSansNeo_M';
}
.infoLayer_bottom_depth {
    background-color: #727171;
    color: #FFFFFF;
    height: 33px;
    border-bottom-left-radius: 10px;
    background: url('../../images/Login/logo_itsco.png') no-repeat, #727171;
    background-position-x: center;
    background-position-y: center;
    background-size: 40px 19px;
}
#modalLayer {
    display: none;
}
#modalLayer .modalContent {
    position: absolute;
    width: 430px;
    height: 450px;
    left: 50%;
    top: 50%;
    margin: -215px 0px 0px -225px;
    background: #FFFFFF;
    box-shadow: 0px 0px 20px 5px rgb(0 0 0 / 15%);
    border-radius: 26px;
    z-index: 11;
}
.modalContent #cancel_login {
    background: url(../images/Login/ic_cancel.png) no-repeat;
    border: none;
    position: absolute;
    width: 23px;
    height: 23px;
    right: 27px;
    top: 26px;
}
.modalContent #login_pop_img {
    display: block;
    margin: 0 auto;
    width: 70px;
    height: 70px;
    margin-top: 60px;
}

.modalContent #login_pop_txt {
    display: block;
    margin: 0 auto;
    width: 400px;
    height: 46px;
    margin-top: 20px;
    margin-bottom: 3px;
    font-family: NanumSquare_ac;
    font-style: normal;
    font-weight: 800;
    font-size: 20px;
    line-height: 22px;
    text-align: center;
}
.modalContent #login_id_pop_img {
    position: absolute;
    left: 95px;
    top: 244px;
}
.modal_bottom #login_id_pop {
    display: block;
    margin: 0 auto;
    width: 297px;
    height: 46px;
    border: 2px solid rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
    border-radius: 23px;
    margin-top: 35px;
}
.modal_bottom input[type="text"] {
    padding-left: 71px;
    font-family: NanumSquare_ac;
    font-style: normal;
    font-weight: normal;
    font-size: 16px;
    line-height: 18px;
    color: #444444;
}
.modal_bottom > div:nth-child(2) {
    margin-top: 15px;
}
.modalContent #login_pw_pop_img {
    position: absolute;
    left: 95px;
    top: 300px;
}
.modal_bottom #login_pw_pop {
    display: block;
    margin: 0 auto;
    width: 297px;
    height: 46px;
    border: 2px solid rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
    border-radius: 23px;
    margin-top: -5px;
}
.modal_bottom input[type="password"] {
    padding-left: 71px;
    font-family: NanumSquare_ac;
    font-style: normal;
    font-weight: normal;
    font-size: 16px;
    line-height: 18px;
    color: #444444;
}
.modalContent a {
    display: block;
    margin: 0 auto;
    width: 297px;
    height: 50px;
    background: #0096FF;
    border-radius: 23px;
    margin-top: 10px;
}
.modalContent #login_pop_btn_txt {
    display: block;
    padding-top: 15px;
    font-family: NanumSquare_ac;
    font-style: normal;
    font-weight: 800;
    font-size: 18px;
    line-height: 20px;
    text-align: center;
    color: #FFFFFF;
}
.modalContent #login_errMsg_pop {
    display: block;
    margin: 0 auto;
    margin-top: 5px;
    padding: 10px;
    color: red;
}
.wj-listbox .wj-listbox-item {
    font-size:13px;
}
.wj-state-selected, .wj-state-last-selected {
    background: initial;
    color: black;
}
@media screen and (max-width:1080px) {
    .loginifo {
        width: 40px !important;
    }
    .loginifo > span {
        display: none;
    }
    .logout_btn {
        width: 40px !important;
    }
    .logout_btn > span {
        display: none;
    }
    body {
        overflow: hidden;
    }
}
@media screen and (max-width:900px) {
    .loginifo {
        display: none !important;
    }
    .logout_btn {
        display: none !important;
    }
    body {
        overflow: hidden;
    }
}
@media screen and (max-height:790px) {
    .infoLayer_bottom_info{
        display:none;
    }
}
@media screen and (max-height:665px) {
    .infoLayer_bottom_info{
        display:none;
    }
    .infoLayer_bottom_depth {
        display:none;
    }
}


.msgbox-container {
    left: 41.5% !important;
    top: 45% !important;
}

.msgbox-ui {
    position: static !important;
}

