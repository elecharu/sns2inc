<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MobileMaster.master.cs" Inherits="MobileMaster" %>
<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" >
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <title>그룹웨어</title>
    <%-- Thrid Part --%>
    <link rel="stylesheet" type="text/css" href="../../PAGECOM/fonts/font.css?ver=<%= BasePage.srcVersion %>" media="none" onload="this.media='all'" />
    <script type="text/javascript" src="../../Script/FullCalendar-v3.9.0/moment.min.js"></script>
    <script src="../../Script/jquery-3.3.1/jquery-3.3.1.min.js"></script>
