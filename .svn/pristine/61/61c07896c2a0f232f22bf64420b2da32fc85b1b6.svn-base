                       <li><a href="../GWM2001/GWM2001_R02.aspx" style="text-shadow: rgba(0, 0, 0, 0.35) 0px 1px 1px;"><div class="mn_icon"><img src="../../images/mn_icon04.png"></div><span style="border-color: rgba(0, 0, 0, 0.35);">근태신청</span></a></li>
				       <li><a href="../GWM7001/GWM7001_S01.aspx" style="text-shadow: rgba(0, 0, 0, 0.35) 0px 1px 1px;"><div class="mn_icon"><img src="../../images/mn_icon11.png"></div><span style="border-color: rgba(0, 0, 0, 0.35);">작업지시</span></a></li>
                       <li><a href="../GWM8001/GWM8001_S01.aspx" style="text-shadow: rgba(0, 0, 0, 0.35) 0px 1px 1px;"><div class="mn_icon"><img src="../../images/mn_icon11.png"></div><span style="border-color: rgba(0, 0, 0, 0.35);">재고조회</span></a></li>
				    </ul>
			    </div>
            </div>		
