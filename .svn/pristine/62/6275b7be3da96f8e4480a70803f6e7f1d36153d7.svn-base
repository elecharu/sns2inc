<Page x:Class="TML0000.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML0000"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      Height="400" Width="600"
      Title="R01">
    <Grid>
        <DockPanel x:Name="PAGE_MAIN" DockPanel.Dock="Top">
            <its:WrapContent Orientation="Vertical">
                <UserControl Width="600" Height="60"/>
                <TextBlock TextAlignment="Center" Foreground="IndianRed" FontSize="30" FontWeight="Bold"></TextBlock>
                <UserControl Width="150" Height="30"/>
                <TextBlock TextAlignment="Center" Foreground="SteelBlue" FontSize="24" FontWeight="Bold" Visibility="Hidden">Smart Factory</TextBlock>
                <TextBlock TextAlignment="Center" Foreground="SteelBlue" FontSize="24" FontWeight="Bold" Visibility="Hidden">MES System</TextBlock>
                <UserControl Width="200" Height="30"/>
            </its:WrapContent>
        </DockPanel>
    </Grid>
</Page>
