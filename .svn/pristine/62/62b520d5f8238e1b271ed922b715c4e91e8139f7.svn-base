        private string copyPath = @"C:\3DFILE_COPY\";   // 원본파일 복사해두는 폴더
        //private string rootPath = @"C:\Users\DK\Desktop\TEST";   // 내부 테스트 용
        //private string saveTextPath = @"C:\Users\DK\Desktop\TEST\TEST_FROM\FILEPATH.txt"; // 설비파일이 저장되는 경로가 적힌 txt
