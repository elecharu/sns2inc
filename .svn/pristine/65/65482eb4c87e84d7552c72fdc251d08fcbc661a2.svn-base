    if (!sourceEquipmentCode) {
        ItsGrid.Clear('grid8');
        return;
    }

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM02');
    maria.AddParam('FANO', sourceEquipmentCode);
