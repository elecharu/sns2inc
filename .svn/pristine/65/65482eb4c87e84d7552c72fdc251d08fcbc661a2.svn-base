            return;
        }

        ItsMsg.Toast(ItsMsg.CommonMsg.SaveComplete());
        ItsGrid.Setkey('grid9', 'FANO', ItsGrid.GetValue('grid9', ItsGrid.GetCurrentIndex('grid9'), 'FANO'));
