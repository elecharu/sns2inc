<its:ItsPageOffice x:Class="SYS0204.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0204"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">

    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# MODEL_SEARCH : START -->
                <its:Text Label="키워드" Width="300" Value="{Binding KEYWORD}"></its:Text>
                <!-- ################################# MODEL_SEARCH : END -->
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_A1">
                <!-- ################################# MODEL_DETAIL: START -->
                <its:Pop Label="사원코드" Width="250" Value="{Binding EMPCD}" GPCD="EMPCD"/>
                <its:Text Label="로그인ID" Value="{Binding USERID}"/>
                <its:Text Label="비밀번호" Value="{Binding USERPASS}"/>
                <its:Check Label="잠금여부" Width="100" Value="{Binding LOCKYN}"/>
                <UserControl Width="5000"/>
                <its:Combo Label="권한코드" Width="200" Value="{Binding AUTCD}" GPCD="*AUTCD"/>
                <its:Text Label="비고" Width="300" Value="{Binding REMARK}"/>
                <!-- ################################# MODEL_DETAIL: END -->
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource GRID}">
            <its:Grid x:Name="GRID_G1">
                <!-- ################################# MODEL_GRID: START -->
                <its:Grid.Columns>
                    <its:Column Width="100" Header="선택" IsRowCheck="True"/>
                    <its:Column Width="100" Header="사원코드" FieldName="EMPCD" ReadOnly="True"/>
                    <its:Column Width="100" Header="사원명" FieldName="EMPNM" ReadOnly="True"/>
                    <its:Column Width="100" Header="로그인ID" FieldName="USERID"/>
                    <its:Column Width="100" Header="비밀번호" FieldName="USERPASS" ReadOnly="False"/>
                    <its:Column Width="100" Header="잠금여부" FieldName="LOCKYN" ReadOnly="False" CellType="Check"/>
                    <its:Column Width="100" Header="권한코드" FieldName="AUTCD" ReadOnly="False" GPCD="AUTCD"/>
                    <its:Column Width="300" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                </its:Grid.Columns>
            </its:Grid>
            <!-- ################################# MODEL_GRID: END -->
        </UserControl>
    </DockPanel>
</its:ItsPageOffice>
