<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.R02"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="800" Height="533">
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0" Height="80">
            <its:WrapContent x:Name="PANEL_S1" Width="800" Margin="0,0,0,10">
                <its:Text Name="txt_MOVEKEY"  Label="이동전표번호" Width="200" Value="{Binding MOVEKEY}"
                           KeyDown="MOVEKEY_KeyDown"/>
                <its:Button Label="이동전표 조회" Width="133" Height="36" CommandName="LIST_MOVE" 
                            FontWeight="Bold" />
                <UserControl Width="5000"/>
                <its:Date Label="출고일자" Width="200" Value="{Binding OUTDATE}" 
                          RenderTransformOrigin="-0.456,1.179"
                          Name="dt_OUTDATE" ReadOnly="True" />
                <its:Pop GPCD="CUSTCD"  Width="280" Label="출고처" Value="{Binding CUSTCD}" ShowKeyPad="True"
                          Name="pop_CUSTCD" ReadOnly="True"/>
                <UserControl Width="20"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="70">
            <its:Grid x:Name="GRID_G1" Width="600" Height="190">
                <its:Grid.Columns>
                    <its:Column Width="60" Header="구분" FieldName="GUBUN" ALGIN="center"/>
                    <its:Column Width="100" Header="LOTNO" FieldName="LOTKEY" ALGIN="center"/>
                    <its:Column Width="150" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="150" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="80" DecimalPoint="0" Header="수량" FieldName="LOTQTY"/>
                    <its:Column Width="100" Header="발주상세키" FieldName="MTRODRDKEY" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="600" Canvas.Top="70" Height="190">
            <its:WrapContent x:Name="PANEL_S3" Width="200">
                
            </its:WrapContent>
        </UserControl>


        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="260">
            <its:Grid x:Name="GRID_G2" Width="600" Height="273">
                <its:Grid.Columns>

                    <its:Column Width="60" Header="구분" FieldName="GUBUN" ALGIN="center"/>
                    <its:Column Width="100" Header="LOTNO" FieldName="LOTKEY" ALGIN="center"/>
                    <its:Column Width="150" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="150" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="80" DecimalPoint="0" Header="수량" FieldName="LOTQTY"/>

                    <its:Column Width="100" Header="발주상세키" FieldName="MTRODRDKEY" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="600" Canvas.Top="260" Height="273">
            <its:WrapContent x:Name="PANEL_S2" Width="200">

                <UserControl Width="200" Height="30"/>

                <its:Text x:Name="txt_MOVEKEY1"  Label="이동전표번호" Width="200" Value="{Binding MOVEKEY}"
                    ReadOnly="True"/>
                <its:Combo x:Name="cmb_GOODWARE" Label="양품입고창고" GPCD="WARECD_GOOD" Value=""/>
                <its:Combo x:Name="cmb_BADWARE" Label="불량입고창고" GPCD="WARECD_BAD" Value=""/>
                <UserControl Width="200" Height="30"/>
                <its:Button Label="입고 등록" Width="200" Height="50" FontSize="20" FontWeight="Bold"
                            CommandName="ADD_LOT"/>
                <its:Button Label="입고 삭제" Width="200" Height="50" FontSize="20" FontWeight="Bold"
                    CommandName="DEL_LOT"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Canvas.Left="192" Canvas.Top="80" Style="{DynamicResource TML_POP}" Width="325" Height="357">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="321" />
                </Grid.RowDefinitions>

                <its:WrapContent x:Name="PANEL_A1" >
                    <its:Text Width="280" Label="병합LOT" ReadOnly="True" Value="{Binding LOTKEY}"  />
                    <its:Pop GPCD="ITEMCD"  Width="280" Label="품목" Value="{Binding ITEMCD}" ShowKeyPad="True"
                          Name="pop_ITEMCD" ReadOnly="True"/>
                </its:WrapContent>

                <its:WrapContent Grid.Row="1" Grid.ColumnSpan="2">
                    <its:Grid x:Name="GRID_G3" Width="322" Height="270">
                        <its:Column Width="134" FieldName="LOTKEY" Header="LOTNO" ALGIN="Center"/>
                        <its:Column Width="133" DecimalPoint="0" FieldName="LOTQTY" Header="재고수량"/>
                    </its:Grid>
                </its:WrapContent>

            </Grid>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
