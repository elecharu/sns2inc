div.ItsDateRange {
    float:left;
    display:inline-block;
    margin-top:2px;
    margin-bottom:2px;
    background-color:transparent;
}
div.ItsDateRange_table {
    background-color:transparent;
}
div.ItsDateRange_table > span {
    vertical-align:middle;
    display:inline-block;
    text-align:right;
    background-color:transparent; 
    white-space: normal;
    font-family: 'SpoqaHanSansNeo_M';
    color:#565656;
}
div.ItsDateRange_box {
    vertical-align:middle;
    display:inline-block;
}
div.ItsDateRange_box > input {
    outline: none;
    padding:0px 4px 0px 4px;
    vertical-align:middle;
    height:20px;
    border:1px solid #C0C0C0;
    border-right: 1px solid transparent;
    box-sizing: border-box;
    line-height: 11px;
    font-weight:normal;
    font-size:12px;
    color:#565656;
}
div.ItsDateRange_button {
    cursor:pointer;
    display:inline-block;
    overflow:hidden;
    vertical-align:middle;
    height:20px;
    width:22px;
    text-align:center;
    margin-left: -5px;
    border:1px solid #C0C0C0;
    background-color:white;
    background: url(../images/UserControl/ic_calendar_n.png) no-repeat, #FFFFFF;
    background-size: 20px;
}
div.ItsDateRange_box > input:focus {
    border: 1px solid #4774B9;
}
div.ItsDateRange_box > input:read-only {
    border: 1px solid #C0C0C0;
    background-color:#F0F0F0;
    color:#A3A3A3;
}
div.ItsDateRange_box > input:hover ~ div.ItsDateRange_button  {
    border: 1px solid #4774B9;
    background: url(../images/UserControl/ic_calendar_h.png) no-repeat, #FFFFFF;
    background-size: 20px;
}
div.ItsDateRange_box > div.ItsDateRange_button:hover  {
    border: 1px solid #4774B9;
    background: url(../images/UserControl/ic_calendar_h.png) no-repeat, #FFFFFF;
    background-size: 20px;
}
div.ItsDateRange_box > input:focus ~ div.ItsDateRange_button  {
    border: 1px solid #4774B9;
    background: url(../images/UserControl/ic_calendar_p.png) no-repeat, #FFFFFF;
    background-size: 20px;
    background-color:#4774B9;
}
div.ItsDateRange_box > input:read-only ~ div.ItsDateRange_button  {
    border: 1px solid #C0C0C0;
    background: url(../images/UserControl/ic_calendar_d.png) no-repeat, #F0F0F0;
    background-size: 20px;
    background-color:#F0F0F0;
}
div.ItsDateRange_box > input.ItsDateRange_F {
    padding:0px 4px 0px 4px;
}
div.ItsDateRange_box > input.ItsDateRange_T {
    padding:0px 4px 0px 4px;
    margin-left:-5px;
}
div.ItsDateRange_box > input.ItsDateRange_F:focus ~ input.ItsDateRange_T  {
    border: 1px solid #4774B9;
}
div.ItsDateRange_box > input.ItsDateRange_T:focus ~ input.ItsDateRange_F  {
    border: 1px solid #4774B9;
}
div.ItsDateRange_box > div.ItsControl_pop {
    visibility:visible;
    padding:0px;
    margin:0px;
    position:fixed;
    list-style:none;
    z-index:99999999;
    max-height:600px;
    overflow-x:hidden;
    overflow-y:auto;
    background-color:white;
    width:412px;
    border:1px solid #4774B9;
    border-radius: 3px;
}
div.ItsDateRange_box.readonly div.ItsDateRange_button {
    color:silver;
}

div.ItsDateRange_calendar_F, div.ItsDateRange_calendar_T {
    display:table-cell;
    height:250px;
}

div.ItsDateRange_close {
    display: inline-block;
    padding: 2px 6px;
    margin: 0px 5px 3px 0px;
    border: 1px solid #C0C0C0;    
    background-color: #FFFFFF;
    color:#565656;
    font-size:9px;
    font-weight:800;
    cursor:pointer;
    float:right;
    border-radius: 3px;
    user-select: none;
}
div.ItsDateRange_innerbtn {
    display: inline-block;
    padding: 2px 6px;
    margin: 0px 0px 3px 5px;
    border: 1px solid #C0C0C0;    
    background-color: #FFFFFF;
    color:#565656;
    font-size:9px;
    font-weight:800;
    cursor:pointer;
    float:left;
    border-radius: 3px;
    user-select: none;
}
.dropdown-menu {
    font-size:11px;
}
div.ItsDateRange_innerbtn:hover {
    background-color: #4774B9;
    color: white;
}
div.ItsDateRange_innerbtn_div {
    padding: 5px 0px;
    text-align: center;
    background-color: #F0F0F0;
    height: 33px;
}
div.ItsDateRange .datetimepicker {
    border: 1px solid transparent;
    padding:0px;
    margin-top: -6px;
    margin-left: -6px;
}
div.ItsDateRange .table-condensed {
    margin:5px;
}