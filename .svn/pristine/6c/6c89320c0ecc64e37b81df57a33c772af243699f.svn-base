<its:ItsPageOffice x:Class="SYS0199.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
      xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
      xmlns:local="clr-namespace:SYS0199"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">
    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <UserControl Style="{DynamicResource GRID}" Grid.Column="0">
                <its:Grid x:Name="GRID_G1">
                    <its:Grid.Columns>
                        <!-- ################################# COLUMN FLEX: START -->
                        <its:Column Width="100" Header="프로그램ID" FieldName="PRGCD"/>
                        <its:Column Width="100" Header="프로그램명" FieldName="PRGNM"/>
                        <!-- ################################# COLUMN FLEX: END -->
                    </its:Grid.Columns>
                </its:Grid>
            </UserControl>
            <GridSplitter Grid.Column="1"/>
            <DockPanel Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UserControl Background="HoneyDew" Grid.Row="0">
                        <its:WrapContent x:Name="PANEL_P1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- ################################# PANEL CONTENT: START -->
                            <CheckBox Content="태국어" IsChecked="True" Checked="CN_Checked" Unchecked="CN_Unchecked" Margin="20 0 0 0"/>
                            <CheckBox Content="인도네시아어" IsChecked="True" Checked="JP_Checked" Unchecked="JP_Unchecked" Margin="20 0 0 0"/>
                            <CheckBox Content="영어" IsChecked="True" Checked="EN_Checked" Unchecked="EN_Unchecked" Margin="20 0 0 0"/>
                            <!-- ################################# PANEL CONTENT: END -->
                        </its:WrapContent>
                    </UserControl>
                    <UserControl Style="{DynamicResource GRID}" Grid.Row="1">
                        <its:Grid x:Name="GRID_G2">
                            <its:Grid.Columns>
                                <!-- ################################# COLUMN FLEX: START -->
                                <its:Column Width="70" Header="선택" IsRowCheck="True"/>
                                <its:Column Width="120" Header="KEY" FieldName="LANGKEY" Visible="False"/>
                                <its:Column Width="120" Header="한국어" FieldName="KR"/>
                                <its:Column Width="120" Header="태국어" FieldName="CN" ReadOnly="False"/>
                                <its:Column Width="120" Header="인도네시아어" FieldName="JP" ReadOnly="False"/>
                                <its:Column Width="120" Header="영어" FieldName="EN" ReadOnly="False"/>
                                <!-- ################################# COLUMN FLEX: END -->
                            </its:Grid.Columns>
                        </its:Grid>
                    </UserControl>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</its:ItsPageOffice>
