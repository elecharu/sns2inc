/* 정기점검 복사 버튼 */
// 2026-09-16 정기점검항목 복사 모달(pop_EQM02_COPY) 열기 및 복사 가능한 타 설비목록(grid7) 조회
ItsButton.Event('bdiv3_btn_COPY').onClick = function () {
