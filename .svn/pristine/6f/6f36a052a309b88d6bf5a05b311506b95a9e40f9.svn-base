/// <reference path="../../Script/reference.js" />

/* 페이지 로드 시 수행 */
ItsPage.Load = function () {

    // 2026-09-16 1번째 탭 좌측 설비목록 그리드(grid1) 생성
    ItsGrid.Create('grid1', { isCheckBoxGrid: false, isSubTotalGrid: false }, [
        column.create('일상점검', 'EQM01', { width: 60, columnType: enumColumnTypes.check, readOnly: true }),
        column.create('정기점검', 'EQM02', { width: 60, columnType: enumColumnTypes.check, readOnly: true }),
        column.create('설비코드', 'FANO', { width: 80, align: 'center' }),
        column.create('설비명', 'EQMNM', { width: 200 }),
        column.split()
    ]);

    // 2026-09-16 1번째 탭 우상단 일상점검 그리드(grid2) 생성
    ItsGrid.Create('grid2', { isCheckBoxGrid: true, isSubTotalGrid: false }, [
        column.create('점검코드', 'CHKKNDCD', { width: 80, align: 'center' }),
        column.create('점검명', 'CHKKNDNM', { width: 300, readOnly: true }),
        column.create('점검항목', 'CHKLOC', { width: 130, columnType: enumColumnTypes.combo, gpcd: 'CHKLOC', align: 'center', readOnly: true }),
        column.create('점검방법', 'CHKMTH', { width: 100, columnType: enumColumnTypes.combo, gpcd: 'CHKMTH', align: 'center', readOnly: true }),
        column.create('점검값구분', 'CHKVALTP', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKVALTP', align: 'center', readOnly: true }),
        column.create('점검주기', 'CHKCYCLE', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKCYCLE', align: 'center', readOnly: true }),
        column.create('사용여부', 'USEYN', { width: 60, columnType: enumColumnTypes.check, readOnly: false }),
        column.create('정렬순서', 'SORTNO', { width: 60, columnType: enumColumnTypes.number, decimalPrecision: 0, readOnly: false }),
        column.split()
    ]);

    // 2026-09-16 1번째 탭 우하단 정기점검 그리드(grid3) 생성
    ItsGrid.Create('grid3', { isCheckBoxGrid: true, isSubTotalGrid: false }, [
        column.create('점검코드', 'CHKKNDCD', { width: 80, align: 'center' }),
        column.create('점검명', 'CHKKNDNM', { width: 300 }),
        column.create('점검항목', 'CHKLOC', { width: 130, columnType: enumColumnTypes.combo, gpcd: 'CHKLOC', align: 'center' }),
        column.create('점검방법', 'CHKMTH', { width: 100, columnType: enumColumnTypes.combo, gpcd: 'CHKMTH', align: 'center' }),
        column.create('점검값구분', 'CHKVALTP', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKVALTP', align: 'center' }),
        column.create('사용여부', 'USEYN', { width: 70, columnType: enumColumnTypes.check, readOnly: false }),
        column.create('정렬순서', 'SORTNO', { width: 80, columnType: enumColumnTypes.number, decimalPrecision: 0, readOnly: false }),
        column.split()
    ]);

    // 2026-09-16 일상점검항목 추가 팝업(pop_EQM01_ADD) 점검종류 그리드(grid4) 생성
    ItsGrid.Create('grid4', { isCheckBoxGrid: true, isSubTotalGrid: false }, [
        column.create('점검코드', 'CHKKNDCD', { width: 70, align: 'center' }),
        column.create('점검명', 'CHKKNDNM', { width: 300 }),
        column.create('점검항목', 'CHKLOC', { width: 130, columnType: enumColumnTypes.combo, gpcd: 'CHKLOC', align: 'center' }),
        column.create('점검방법', 'CHKMTH', { width: 100, columnType: enumColumnTypes.combo, gpcd: 'CHKMTH', align: 'center' }),
        column.create('점검값구분', 'CHKVALTP', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKVALTP', align: 'center' }),
        column.create('점검주기', 'CHKCYCLE', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKCYCLE', align: 'center', readOnly: true }),
        column.split()
    ]);

    // 2026-09-16 일상점검 복사 팝업(pop_EQM01_COPY) 좌측 설비목록 그리드(grid5) 생성
    ItsGrid.Create('grid5', { isCheckBoxGrid: false, isSubTotalGrid: false }, [
        column.create('설비코드', 'FANO', { width: 80, align: 'center' }),
        column.create('설비명', 'EQMNM', { width: 200 }),
        column.split()
    ]);

    // 2026-09-16 일상점검 복사 팝업(pop_EQM01_COPY) 우측 점검항목 그리드(grid6) 생성
    ItsGrid.Create('grid6', { isCheckBoxGrid: false, isSubTotalGrid: false }, [
        column.create('점검코드', 'CHKKNDCD', { width: 70, align: 'center' }),
        column.create('점검명', 'CHKKNDNM', { width: 300 }),
        column.create('점검항목', 'CHKLOC', { width: 130, columnType: enumColumnTypes.combo, gpcd: 'CHKLOC', align: 'center' }),
        column.create('점검방법', 'CHKMTH', { width: 100, columnType: enumColumnTypes.combo, gpcd: 'CHKMTH', align: 'center' }),
        column.create('점검값구분', 'CHKVALTP', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKVALTP', align: 'center' }),
        column.create('점검주기', 'CHKCYCLE', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKCYCLE', align: 'center', readOnly: true }),
        column.split()
    ]);

    // 2026-09-16 정기점검 복사 팝업(pop_EQM02_COPY) 좌측 설비목록 그리드(grid7) 생성
    ItsGrid.Create('grid7', { isCheckBoxGrid: false, isSubTotalGrid: false }, [
        column.create('설비코드', 'FANO', { width: 100, readOnly: false }),
        column.create('설비명', 'EQMNM', { width: 150, readOnly: false }),
        column.split()
    ]);

    // 2026-09-16 정기점검 복사 팝업(pop_EQM02_COPY) 우측 점검항목 그리드(grid8) 생성
    ItsGrid.Create('grid8', { isCheckBoxGrid: false, isSubTotalGrid: false }, [
        column.create('점검코드', 'CHKKNDCD', { width: 70, align: 'center' }),
        column.create('점검명', 'CHKKNDNM', { width: 300 }),
        column.create('점검항목', 'CHKLOC', { width: 130, columnType: enumColumnTypes.combo, gpcd: 'CHKLOC', align: 'center' }),
        column.create('점검방법', 'CHKMTH', { width: 100, columnType: enumColumnTypes.combo, gpcd: 'CHKMTH', align: 'center' }),
        column.create('점검값구분', 'CHKVALTP', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKVALTP', align: 'center' }),
        column.split()
    ]);

    // 2026-09-16 2번째 탭: 정기점검 주기관리 설비별 연간 월별 점검계획 그리드(grid9) 생성
    ItsGrid.Create('grid9', { isCheckBoxGrid: true }, [
        column.create('설비코드', 'FANO', { width: 100, align: 'center' }),
        column.create('설비명', 'EQMNM', { width: 220 }),
        column.create('년도', 'YEAR', { width: 80, align: 'center' }),

        column.create('1월', 'M01', { width: 80, align: 'center', readOnly: true }),
        column.create('2월', 'M02', { width: 80, align: 'center', readOnly: true }),
        column.create('3월', 'M03', { width: 80, align: 'center', readOnly: true }),
        column.create('4월', 'M04', { width: 80, align: 'center', readOnly: true }),
        column.create('5월', 'M05', { width: 80, align: 'center', readOnly: true }),
        column.create('6월', 'M06', { width: 80, align: 'center', readOnly: true }),
        column.create('7월', 'M07', { width: 80, align: 'center', readOnly: true }),
        column.create('8월', 'M08', { width: 80, align: 'center', readOnly: true }),
        column.create('9월', 'M09', { width: 80, align: 'center', readOnly: true }),
        column.create('10월', 'M10', { width: 80, align: 'center', readOnly: true }),
        column.create('11월', 'M11', { width: 80, align: 'center', readOnly: true }),
        column.create('12월', 'M12', { width: 80, align: 'center', readOnly: true }),
        column.split()
    ]);

    // 2026-09-16 정기점검항목 추가 팝업(pop_EQM02_ADD) 점검종류 그리드(grid10) 생성
    ItsGrid.Create('grid10', { isCheckBoxGrid: true, isSubTotalGrid: false }, [
        column.create('점검코드', 'CHKKNDCD', { width: 70, align: 'center' }),
        column.create('점검명', 'CHKKNDNM', { width: 300 }),
        column.create('점검항목', 'CHKLOC', { width: 130, columnType: enumColumnTypes.combo, gpcd: 'CHKLOC', align: 'center' }),
        column.create('점검방법', 'CHKMTH', { width: 100, columnType: enumColumnTypes.combo, gpcd: 'CHKMTH', align: 'center' }),
        column.create('점검값구분', 'CHKVALTP', { width: 90, columnType: enumColumnTypes.combo, gpcd: 'CHKVALTP', align: 'center' }),
        column.split()
    ]);

    // 조회년도 콤보 기본값 설정 (현재 년도)
    ItsCombo.SetValueByIndex('cmb_SYEAR', 4);
};

/* 상단 메인 조회 버튼 */
// 2026-09-16 활성 탭에 따른 데이터 조회 (0: 설비점검계획 설비목록, 1: 정기점검 연간주기계획)
ItsButton.EventSearch = function () {
    if (ItsTab.GetIndex('tab1') == 0) {
        ItsGrid.Clear('grid1');
        ItsGrid.Clear('grid2');
        ItsGrid.Clear('grid3');

        var maria = new ItsMaria('EQM1001_R03', 'LIST_MSTEQM');
        maria.AddPanel('div_EQM');
        maria.CallProc();
        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsGrid.SetStore('grid1', maria.store.YnToBool('EQM01').YnToBool('EQM02'));
        ItsGrid.Get('grid1').autoSizeColumns();
        ItsMsg.Toast(ItsMsg.CommonMsg.SearchComplete(maria.store.Length()));
    }
    else if (ItsTab.GetIndex('tab1') == 1) {
        ItsGrid.Clear('grid9');

        var maria = new ItsMaria('EQM1001_R03', 'LIST_CYCLE_EQMCD');
        maria.AddPanel('div_CYCLE_EQM');
        maria.CallProc();
        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsGrid.SetStore('grid9', maria.store);
        ItsMsg.Toast(ItsMsg.CommonMsg.SearchComplete(maria.store.Length()));
    }
};

/* 1번째 탭: 좌측 설비목록 행 선택 이벤트 */
// 2026-09-16 좌측 설비 그리드(grid1) 행 선택 시 선택 설비코드(FANO) 기준으로 우측 일상점검/정기점검 점검종류 목록 조회
ItsGrid.Event('grid1').onSelect = function () {
    var FANO = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');
    if (!FANO) {
        ItsGrid.Clear('grid2');
        ItsGrid.Clear('grid3');
        return;
    }

    var maria1 = new ItsMaria('EQM1001_R03', 'LIST_MSTEQM_EQM01');
    maria1.AddParam('FANO', FANO);
    maria1.CallProc();
    if (maria1.isError) {
        maria1.ShowErrMsg();
        return;
    }
    ItsGrid.SetStore('grid2', maria1.store.YnToBool('USEYN').YnToBool('WORKSTD_YN'));

    var maria2 = new ItsMaria('EQM1001_R03', 'LIST_MSTEQM_EQM02');
    maria2.AddParam('FANO', FANO);
    maria2.CallProc();
    if (maria2.isError) {
        maria2.ShowErrMsg();
        return;
    }
    ItsGrid.SetStore('grid3', maria2.store.YnToBool('USEYN'));
};

/* 일상점검 (EQM01) 영역 이벤트 */

/* 일상점검 추가 버튼 */
// 2026-09-16 일상점검항목 추가 모달(pop_EQM01_ADD) 열기 및 미등록 점검항목 목록(grid4) 조회
ItsButton.Event('bdiv2_btn_ADD').onClick = function () {
    var FANO = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');
    if (!FANO) {
        ItsMsg.Toast('설비를 먼저 선택해주세요.');
        return;
    }

    ItsGrid.Clear('grid4');
    ItsPop.Open('pop_EQM01_ADD');

    var maria = new ItsMaria('EQM1001_R03', 'LIST_EQM01');
    maria.AddParam('FANO', FANO);
    maria.CallProc();
    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }
    ItsGrid.SetStore('grid4', maria.store);
};

/* 일상점검 추가 팝업 내 저장 버튼 */
// 2026-09-16 일상점검항목 추가 모달(pop_EQM01_ADD)에서 체크된 항목을 해당 설비의 일상점검항목으로 등록
ItsButton.Event('btn_ADD_EQM01').onClick = function () {
    var hasChecked = false;
    for (var i = 0; i < ItsGrid.Length('grid4'); i++) {
        if (ItsGrid.IsChecked('grid4', i)) {
            hasChecked = true;
            break;
        }
    }

    if (!hasChecked) {
        ItsMsg.Toast('선택된 항목이 없습니다.');
        return;
    }

    var FANO = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');
    var maria = new ItsMaria('EQM1001_R03', 'REG_EQM01');
    maria.AddParam('FANO', FANO);

    for (var i = 0; i < ItsGrid.Length('grid4'); i++) {
        if (ItsGrid.IsChecked('grid4', i)) {
            maria.AddList('CHKKNDCD_LIST', ItsGrid.GetValue('grid4', i, 'CHKKNDCD'));
            maria.AddList('REMARK_LIST', ItsGrid.GetValue('grid4', i, 'REMARK'));
        }
    }

    maria.CallProc();
    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsButton.Event('btn_CANCEL_EQM01').onClick();
    ItsMsg.Toast(ItsMsg.CommonMsg.AddComplete);
    ItsGrid.Setkey('grid1', 'FANO', FANO);
    ItsButton.EventSearch();
};

/* 일상점검 추가 팝업 내 취소 버튼 */
// 2026-09-16 일상점검항목 추가 모달(pop_EQM01_ADD) 닫기 및 그리드(grid4) 초기화
ItsButton.Event('btn_CANCEL_EQM01').onClick = function () {
    ItsGrid.Clear('grid4');
    ItsPop.Close('pop_EQM01_ADD');
};

/* 일상점검 저장 버튼 */
// 2026-09-16 일상점검 그리드(grid2)에서 체크된 항목의 사용여부/정렬순서 수정 저장
ItsButton.Event('bdiv2_btn_SAVE').onClick = function () {
    var hasChecked = false;
    for (var i = 0; i < ItsGrid.Length('grid2'); i++) {
        if (ItsGrid.IsChecked('grid2', i)) {
            hasChecked = true;
            break;
        }
    }

    if (!hasChecked) {
        ItsMsg.Toast('선택된 항목이 없습니다.');
        return;
    }

    var FANO = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');

    ItsMsg.Confirm('선택하신 항목을 저장하시겠습니까?', function () {
        var maria = new ItsMaria('EQM1001_R03', 'SAVE_EQM01');
        maria.AddParam('FANO', FANO);

        for (var i = 0; i < ItsGrid.Length('grid2'); i++) {
            if (ItsGrid.IsChecked('grid2', i)) {
                maria.AddList('CHKKNDCD_LIST', ItsGrid.GetValue('grid2', i, 'CHKKNDCD'));
                maria.AddList('SORTNO_LIST', ItsGrid.GetValue('grid2', i, 'SORTNO'));
                maria.AddList('REMARK_LIST', ItsGrid.GetValue('grid2', i, 'REMARK'));
                if (ItsGrid.GetValue('grid2', i, 'USEYN', false) == 'Y')
                    maria.AddList('USEYN_LIST', 'Y');
                else
                    maria.AddList('USEYN_LIST', 'N');
            }
        }

        maria.CallProc();
        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsMsg.Toast(ItsMsg.CommonMsg.SaveComplete());
        ItsGrid.Setkey('grid1', 'FANO', FANO);
        ItsButton.EventSearch();
    }, function () {
        ItsMsg.Toast('저장이 취소되었습니다.');
    });
};

/* 일상점검 삭제 버튼 */
// 2026-09-16 일상점검 그리드(grid2)에서 체크된 항목 삭제 처리
ItsButton.Event('bdiv2_btn_DEL').onClick = function () {
    var hasChecked = false;
    for (var i = 0; i < ItsGrid.Length('grid2'); i++) {
        if (ItsGrid.IsChecked('grid2', i)) {
            hasChecked = true;
            break;
        }
    }

    if (!hasChecked) {
        ItsMsg.Toast('선택된 항목이 없습니다.');
        return;
    }

    var FANO = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');

    ItsMsg.Confirm('선택한 항목을 삭제하시겠습니까?', function () {
        var maria = new ItsMaria('EQM1001_R03', 'DEL_EQM01');
        maria.AddParam('FANO', FANO);

        for (var i = 0; i < ItsGrid.Length('grid2'); i++) {
            if (ItsGrid.IsChecked('grid2', i)) {
                maria.AddList('CHKKNDCD_LIST', ItsGrid.GetValue('grid2', i, 'CHKKNDCD'));
            }
        }

        maria.CallProc();
        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsMsg.Toast(ItsMsg.CommonMsg.DeleteComplete());
        ItsGrid.Setkey('grid1', 'FANO', FANO);
        ItsButton.EventSearch();
    }, function () {
        ItsMsg.Toast('삭제가 취소되었습니다.');
    });
};

/* 일상점검 복사 버튼 */
// 2026-09-16 일상점검항목 복사 모달(pop_EQM01_COPY) 열기 및 복사 가능한 타 설비목록(grid5) 조회
ItsButton.Event('bdiv2_btn_COPY').onClick = function () {
    var FANO = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');
    if (!FANO) {
        ItsMsg.Toast('설비를 먼저 선택해주세요.');
        return;
    }

    ItsGrid.Clear('grid5');
    ItsGrid.Clear('grid6');
    ItsPop.Open('pop_EQM01_COPY');

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM01');
    maria.AddParam('FANO', FANO);
    maria.CallProc();
    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid5', maria.store);
};

/* 일상점검 복사 팝업 내 타 설비 선택 이벤트 */
// 2026-09-16 일상점검 복사 모달의 설비목록(grid5) 선택 시 해당 설비의 일상점검항목(grid6) 미리보기 조회
ItsGrid.Event('grid5').onSelect = function () {
    var FANO = ItsGrid.GetValue('grid5', ItsGrid.GetCurrentIndex('grid5'), 'FANO');
    if (!FANO) {
        ItsGrid.Clear('grid6');
        return;
    }

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM01');
    maria.AddParam('FANO', FANO);
    maria.CallProc();
    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid6', maria.storeExtend1.YnToBool('WORKSTD_YN'));
};

/* 일상점검 복사 팝업 내 저장 버튼 */
// 2026-09-16 선택된 타 설비(FANO_COPY)의 일상점검 항목을 현재 대상 설비(FANO)로 복사 실행
ItsButton.Event('btn_COPY_EQM01').onClick = function () {
    var FANO_COPY = ItsGrid.GetValue('grid5', ItsGrid.GetCurrentIndex('grid5'), 'FANO');
    var FANO_TARGET = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');

    if (!FANO_COPY) {
        ItsMsg.Toast('복사 대상 설비를 선택해주세요.');
        return;
    }

    ItsMsg.Confirm('선택한 항목을 복사하시겠습니까?', function () {
        var maria = new ItsMaria('EQM1001_R03', 'COPY_EQM01');
        maria.AddParam('FANO', FANO_TARGET);
        maria.AddParam('FANO_COPY', FANO_COPY);
        maria.CallProc();
        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsButton.Event('btn_CANCEL_COPY_EQM01').onClick();
        ItsMsg.Toast(ItsMsg.CommonMsg.CopyComplete());
        ItsGrid.Setkey('grid1', 'FANO', FANO_TARGET);
        ItsButton.EventSearch();
    }, function () {
        ItsMsg.Toast('복사가 취소되었습니다.');
    });
};

/* 일상점검 복사 팝업 내 취소 버튼 */
// 2026-09-16 일상점검항목 복사 모달(pop_EQM01_COPY) 닫기 및 그리드(grid5, grid6) 초기화
ItsButton.Event('btn_CANCEL_COPY_EQM01').onClick = function () {
