/* 정기점검 복사 팝업 내 타 설비 선택 이벤트 */
// 2026-09-16 정기점검 복사 모달의 설비목록(grid7) 선택 시 해당 설비의 정기점검항목(grid8) 미리보기 조회
ItsGrid.Event('grid7').onSelect = function () {
    var FANO = ItsGrid.GetValue('grid7', ItsGrid.GetCurrentIndex('grid7'), 'FANO');
    if (!FANO) {
        ItsGrid.Clear('grid8');
        return;
    }

    var maria = new ItsMaria('EQM1001_R03', 'LIST_COPY_EQM02');
    maria.AddParam('FANO', FANO);
    maria.CallProc();
    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid8', maria.storeExtend1);
};

/* 정기점검 복사 팝업 내 저장 버튼 */
// 2026-09-16 선택된 타 설비(FANO_COPY)의 정기점검 항목을 현재 대상 설비(FANO)로 복사 실행
ItsButton.Event('btn_COPY_EQM02').onClick = function () {
    var FANO_COPY = ItsGrid.GetValue('grid7', ItsGrid.GetCurrentIndex('grid7'), 'FANO');
    var FANO_TARGET = ItsGrid.GetValue('grid1', ItsGrid.GetCurrentIndex('grid1'), 'FANO');

    if (!FANO_COPY) {
        ItsMsg.Toast('복사 대상 설비를 선택해주세요.');
        return;
    }

    ItsMsg.Confirm('선택한 항목을 복사하시겠습니까?', function () {
        var maria = new ItsMaria('EQM1001_R03', 'COPY_EQM02');
        maria.AddParam('FANO', FANO_TARGET);
        maria.AddParam('FANO_COPY', FANO_COPY);
        maria.CallProc();
        if (maria.isError) {
            maria.ShowErrMsg();
            return;
        }

        ItsButton.Event('btn_CANCEL_COPY_EQM02').onClick();
        ItsMsg.Toast(ItsMsg.CommonMsg.CopyComplete());
        ItsGrid.Setkey('grid1', 'FANO', FANO_TARGET);
        ItsButton.EventSearch();
    }, function () {
        ItsMsg.Toast('복사가 취소되었습니다.');
    });
};

/* 정기점검 복사 팝업 내 취소 버튼 */
