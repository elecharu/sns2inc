        public readonly static DependencyProperty ValueProperty =
            DependencyProperty.Register("Value",
                typeof(string),
                typeof(Pop),
                new FrameworkPropertyMetadata("", FrameworkPropertyMetadataOptions.BindsTwoWayByDefault, valueChangedCallback));
        private static void valueChangedCallback(DependencyObject sender, DependencyPropertyChangedEventArgs e)
        {
            ((Pop)(sender)).textCode.Text = e.NewValue.ToString();
        }

        private void ListShow()
        {
            if (this.ModelPanel != null)
            {
                _REF01 = this.ModelPanel._REF01[this.FieldName];
                _REF02 = this.ModelPanel._REF02[this.FieldName];
                _REF03 = this.ModelPanel._REF03[this.FieldName];
                _REF04 = this.ModelPanel._REF04[this.FieldName];
                _REF05 = this.ModelPanel._REF05[this.FieldName];
            }

            string keyword = textCode.Text.Trim();

            StringBuilder query = new StringBuilder();
            query.Append("CALL DC_POP('" + this.GPCD + "_LIST', '" + keyword + "', '");
            query.Append(this.REF01 + "', '");
            query.Append(this.REF02 + "', '");
            query.Append(this.REF03 + "', '");
            query.Append(this.REF04 + "', '");
            query.Append(this.REF05 + "')");
            DataTable dt = ItsMaria.Query(query.ToString()).Tables[0];

            MODEL_POP.SetData(dt);

            popupSearch.IsOpen = true;

            popupKeypad.IsOpen = false;
            textCode.Select(textCode.Text.Length, 0);

            gridView.Focus();
            //gridView.MaxHeight = 20;
            gridView.MaxHeight = 5000;

            textCode.Focus();

        }

        private void ListHide()
        {
            foreach (Column col in gridView.Columns)
            {
                gridView.ClearColumnFilter(col);
            }
            gridView.ClearSorting();
            popupSearch.IsOpen = false;
            textCode.Select(textCode.Text.Length, 0);
            textCode.Focus();
        }

        public string ShowKeyPad
        {
            set
            {
                if (value.Length > 0)
                {
                    keyPadIcon.MaxWidth = 1000;
                    canvasKeypad.Visibility = Visibility.Visible;
                }
                else
                {
                    keyPadIcon.MaxWidth = 0;
                    canvasKeypad.Visibility = Visibility.Hidden;
                }
            }
        }

        public string ShowTmlPad
        {
            set
            {
                if (value.Length > 0)
                {
                    tmlPadIcon.MaxWidth = 1000;
                    TmlCanvasKeypad.Visibility = Visibility.Visible;
                }
                else
                {
                    tmlPadIcon.MaxWidth = 0;
                    TmlCanvasKeypad.Visibility = Visibility.Collapsed;
                }
            }
        }

        private void textCode_GotFocus(object sender, RoutedEventArgs e)
        {
            textCode.BorderBrush = Brushes.Black;
            textCode.BorderThickness = new Thickness(1d);
            if (!textCode.IsReadOnly)
            {
                textCode.Background = Brushes.MintCream;
            }
        }

        private void textCode_LostFocus(object sender, RoutedEventArgs e)
        {
            textCode.BorderBrush = Brushes.Silver;
            textCode.BorderThickness = new Thickness(1d);
            if (!textCode.IsReadOnly)
            {
                textCode.Background = Brushes.White;
            }
        }

        private void textCode_TextChanged(object sender, TextChangedEventArgs e)
        {
            ListHide();

            string code = "";
            string name = "";
            if (textCode.Text.Trim() == "")
            {
                code = "";
                name = "";
            }
            else if (this.ModelPanel != null)
            {
                try
                {
                    if (this.FieldName == "")
                        this.FieldName = BindingOperations.GetBinding(this, ITSLIB.Pop.ValueProperty).Path.Path;
                }
                catch { }

                this.ModelPanel.SetPopInfo(this.FieldName, textCode.Text);
                code = this.ModelPanel.GetPopCode(this.FieldName);
                name = this.ModelPanel.GetPopName(this.FieldName);
            }
            else
            {
                StringBuilder query = new StringBuilder();
                query.Append("CALL DC_POP('" + GPCD + "_INFO', '" + textCode.Text + "', '");
                query.Append(REF01 + "', '");
                query.Append(REF02 + "', '");
                query.Append(REF03 + "', '");
                query.Append(REF04 + "', '");
                query.Append(REF05 + "');");
                DataTable dt = ItsMaria.Query(query.ToString()).Tables[0];

                code = ItsData.GetText(dt, 0, "CODE");
                name = ItsData.GetText(dt, 0, "NAME");
            }

            if (code != "")
            {
                textCode.Text = code;
                textName.Text = name;
                //textCode.Visibility = Visibility.Collapsed;
            } 
            else
            {
                textName.Text = "";
                //textCode.Visibility = Visibility.Visible;
            }

            SetValue(ValueProperty, textCode.Text);
            textCode.SelectionStart = textCode.Text.Length;

            double maxWidth = this.Width - textBlock.Width - textCode.MinWidth;
            if (searchIcon.Visibility == Visibility.Visible)
            {
                maxWidth = maxWidth - searchIcon.Width;
            }
            if (keyPadIcon.Visibility == Visibility.Visible)
            {
                maxWidth = maxWidth - searchIcon.Width;
            }
            textName.MaxWidth = maxWidth;
        }

        private void textCode_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Enter)
            {
                if (popupSearch.IsOpen == false)
                {
                    e.Handled = true;
                    ListShow();
                }
                else
                {
                    Select_Click(null, null);
                }
                return;
            }

            // if (gridView.ModelCount == 0) return;

            if (e.Key == Key.Up)
            {
                if (popupSearch.IsOpen == false)
                {
                    e.Handled = true;
                    ListShow();
                }

                if (gridView.GetIndex() > 0)
                {
                    gridView.SelectedItem = MODEL_POP.DefaultView[gridView.GetIndex() - 1];
                    gridView.CurrentItem = gridView.SelectedItem;
                }
                textCode.Select(textCode.Text.Length, 0);
                textCode.Focus();
                return;
            }

            if (e.Key == Key.Down)
            {
                if (popupSearch.IsOpen == false)
                {
                    e.Handled = true;
                    ListShow();
                }

                if (gridView.GetIndex() < gridView.RowCount - 1)
                {
                    gridView.SelectedItem = MODEL_POP.DefaultView[gridView.GetIndex() + 1];
                    gridView.CurrentItem = gridView.SelectedItem;
                }
                textCode.Select(textCode.Text.Length, 0);
                textCode.Focus();
                return;
            }
        }

        private void Close_Click(object sender, RoutedEventArgs e)
        {
            ListHide();
        }

        private void Clear_Click(object sender, RoutedEventArgs e)
        {
            // ListHide();
            Value = "";
            ListShow();
        }

        private void Select_Click(object sender, RoutedEventArgs e)
        {
            string sCODE = "";
            try
            {
                sCODE = (gridView.SelectedItem as DataRowView).Row["CODE"].ToString();
            }
            catch
            {
                if (gridView.RowCount > 0)
                {
                    sCODE = MODEL_POP.Rows[0]["CODE"].ToString();
                }
            }

            if (sCODE != "")
            {
                textCode.Text = sCODE;
            }

            ListHide();
            textCode.SelectionStart = textCode.Text.Length;
        }

        private void KEY_PreviewMouseDown(object sender, MouseButtonEventArgs e)
        {
            textCode.Focus();

            string keyCode = (e.Source as Label).Content.ToString();

            if (keyCode == "공백") SendKeys.Send(textCode, " ");
            else if (keyCode == "삭제") SendKeys.Send(textCode, "{BACKSPACE}");
            else if (keyCode == "◀") SendKeys.Send(textCode, "{LEFT}");
            else if (keyCode == "▶") SendKeys.Send(textCode, "{RIGHT}");
            else if (keyCode == "전부삭제")
            {
                textCode.Text = "";
            }
            else if (keyCode == "✖")
            {
                popupKeypad.IsOpen = false;
                tmlKeypad.IsOpen = false;
            }
            else if (keyCode == "대")
            {
                DockPanel dockPanel = ItsElement.FindParent<DockPanel>(sender as Label);
                List<Label> labelList = ItsElement.FindChild<Label>(dockPanel);
                foreach (Label label in labelList)
                {
                    if (label.Content.ToString().Length == 1)
                    {
                        label.Content = label.Content.ToString().ToUpper();
                    }
                }
            }
            else if (keyCode == "소")
            {
                DockPanel dockPanel = ItsElement.FindParent<DockPanel>(sender as Label);
                List<Label> labelList = ItsElement.FindChild<Label>(dockPanel);
                foreach (Label label in labelList)
                {
                    if (label.Content.ToString().Length == 1)
                    {
                        label.Content = label.Content.ToString().ToLower();
                    }
                }
            }
            else if (keyCode == "특")
            {
                DockPanel dockPanel = ItsElement.FindParent<DockPanel>(sender as Label);
                List<Label> labelList = ItsElement.FindChild<Label>(dockPanel);
                foreach (Label label in labelList)
                {
                    if (label.Content.ToString().Length == 1 && "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789◀▶대소특삭제전부삭제공백✖".IndexOf(label.Content.ToString().ToUpper()) == -1)
                    {
                        if (label.Content.ToString() == "+") label.Content = "[";
                        else if (label.Content.ToString() == "-") label.Content = "]";
                        else if (label.Content.ToString() == "*") label.Content = "(";
                        else if (label.Content.ToString() == "/") label.Content = ")";

                        else if (label.Content.ToString() == "=") label.Content = ":";
                        else if (label.Content.ToString() == "?") label.Content = ";";

                        else if (label.Content.ToString() == "~") label.Content = "_";
                        else if (label.Content.ToString() == "!") label.Content = "&";
                        else if (label.Content.ToString() == "@") label.Content = "{";
                        else if (label.Content.ToString() == "#") label.Content = "}";
                        else if (label.Content.ToString() == "$") label.Content = ".";
                        else if (label.Content.ToString() == "%") label.Content = ",";

                        else if (label.Content.ToString() == "^") label.Content = "`";

                        // 역으로 교체
                        else if (label.Content.ToString() == "[") label.Content = "+";
                        else if (label.Content.ToString() == "]") label.Content = "-";
                        else if (label.Content.ToString() == "(") label.Content = "*";
                        else if (label.Content.ToString() == ")") label.Content = "/";

                        else if (label.Content.ToString() == ":") label.Content = "=";
                        else if (label.Content.ToString() == ";") label.Content = "?";

                        else if (label.Content.ToString() == "_") label.Content = "~";
                        else if (label.Content.ToString() == "&") label.Content = "!";
                        else if (label.Content.ToString() == "{") label.Content = "@";
                        else if (label.Content.ToString() == "}") label.Content = "#";
                        else if (label.Content.ToString() == ".") label.Content = "$";
                        else if (label.Content.ToString() == ",") label.Content = "%";

                        else if (label.Content.ToString() == "`") label.Content = "^";

                        else label.Content = "";
                    }
                }
            }
            else
            {
                int curSelLength = textCode.SelectionStart;
                textCode.Text = textCode.Text.Substring(0, curSelLength) + keyCode + textCode.Text.Substring(curSelLength);
                textCode.SelectionStart = curSelLength + keyCode.Length;
                textCode.SelectionLength = 0;
            }

            textCode.Focus();
        }

        private void keyPad_MouseUp(object sender, MouseButtonEventArgs e)
        {
            popupSearch.IsOpen = false;
            if (popupKeypad.IsOpen) popupKeypad.IsOpen = false;
            else popupKeypad.IsOpen = true;
        }

        private void keyPad2_MouseUp(object sender, MouseButtonEventArgs e)
        {
            popupSearch.IsOpen = false;
            if (tmlKeypad.IsOpen) tmlKeypad.IsOpen = false;
            else tmlKeypad.IsOpen = true;
        }

        private void search_MouseUp(object sender, MouseButtonEventArgs e)
        {
            popupKeypad.IsOpen = false;
            tmlKeypad.IsOpen = false;
            if (popupSearch.IsOpen) ListHide();
            else ListShow();
        }

        private void gridView_MouseDoubleClick(object sender, MouseButtonEventArgs e)
        {
            Select_Click(null, null);
        }
    }
