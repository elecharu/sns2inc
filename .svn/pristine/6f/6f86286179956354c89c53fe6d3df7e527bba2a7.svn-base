        private string _GPCD = "";
        public string GPCD
        {
            get { return _GPCD; }
            set
            {
                if (value == "") return;
                _GPCD = value;

                StringBuilder query = new StringBuilder();
                query.Append("CALL DC_POP('" + _GPCD + "_HEAD', '', '', '', '', '', '')");
                DataSet ds = ItsMaria.Query(query.ToString());

                while(gridView.Columns.Count > 0)
                {
                    gridView.Columns.RemoveAt(0);
                }
                for (int i = 0; i < ds.Tables[0].Columns.Count; i++)
                {
                    ITSLIB.Column column = new ITSLIB.Column();
                    column.Header = ds.Tables[0].Rows[0][i].ToString();
                    column.Width = new GridColumnWidth(double.Parse(ds.Tables[1].Rows[0][i].ToString()));
                    column.FieldName = ds.Tables[0].Columns[i].ColumnName;
                    gridView.Columns.Add(column);
                }
            }
        }

        private void textCode_PreviewMouseDoubleClick(object sender, MouseButtonEventArgs e)
        {
            textCode.Focus();
            textCode.SelectAll();
        }

        public bool ReadOnly
        {
            get { return textCode.IsReadOnly; }
            set
            {
                textCode.IsReadOnly = value;
                if (value)
                {
                    textCode.Background = Brushes.LavenderBlush;
                    searchIcon.Visibility = Visibility.Collapsed;
                }
                else
                {
                    textCode.Background = Brushes.White;
                    searchIcon.Visibility = Visibility.Visible;
                }
            }
        }

        public string Label
        {
            get { return textBlock.Text; }
            set { textBlock.Text = value; }
        }

        public string HidenLabel
        {
            set
            {
                if (value.Length > 0)
                {
                    this.Width = this.Width - textBlock.Width;
                    textBlock.Width = 0;
                    textBlock.Visibility = Visibility.Hidden;
                }
            }
        }

        public double LabelWidth
        {
            get { return textBlock.Width; }
