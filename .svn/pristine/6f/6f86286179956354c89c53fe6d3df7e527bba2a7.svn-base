        public ItsModelPanel ModelPanel = null;
        public string FieldName = "";
        ItsModelGrid MODEL_POP = new ItsModelGrid();
        public Pop()
        {
            InitializeComponent();

            MODEL_POP.Binding(gridView);
            MODEL_POP.CellType("CODE", ItsEnums.CellTypes.Text);
            MODEL_POP.CellType("NAME", ItsEnums.CellTypes.Text);
            MODEL_POP.CellType("REF01", ItsEnums.CellTypes.Text);
            MODEL_POP.CellType("REF02", ItsEnums.CellTypes.Text);
            MODEL_POP.CellType("REF03", ItsEnums.CellTypes.Text);
            MODEL_POP.CellType("REF04", ItsEnums.CellTypes.Text);
            MODEL_POP.CellType("REF05", ItsEnums.CellTypes.Text);

            this.Loaded += Pop_Loaded;

            textCode.BorderBrush = Brushes.Silver;
            textCode.BorderThickness = new Thickness(1d);
            textCode.PreviewMouseDoubleClick += textCode_PreviewMouseDoubleClick;

            foreach (Column col in gridView.Columns)
            {
                gridView.ClearColumnFilter(col);
            }
            gridView.ClearSorting();

            (gridView.View as TableView).AllowEditing = false;
            (gridView.View as TableView).BestFitMode = DevExpress.Xpf.Core.BestFitMode.AllRows;
            gridView.SelectionMode = MultiSelectMode.Row;


            //borderName.Visibility = Visibility.Collapsed;
            ShowKeyPad = "";
            ShowTmlPad = "";
        }

        private void Pop_Loaded(object sender, RoutedEventArgs e)
        {
            this.Loaded -= Pop_Loaded;

            textCode.MaxWidth = this.Width - 115;
            try
            {
                this.FieldName = BindingOperations.GetBinding(this, ITSLIB.Pop.ValueProperty).Path.Path;
            }
            catch { }
        }
