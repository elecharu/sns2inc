<Window x:Class="ITSLOGIN.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="500" Height="350"
        Background="Transparent" AllowsTransparency="True" 
        WindowStyle="None" BorderThickness="8"
        Icon="icon_office.ico">
    <Window.Effect>
        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="1" />
    </Window.Effect>
    <Window.Resources>
        <ResourceDictionary>
            <!-- 로그인 버튼  -->
            <Color x:Key="LocalButtonLeave">#4472c4</Color>
            <Color x:Key="LocalButtonEnter">Silver</Color>
            <Storyboard x:Key="ButtonEnterStory">
                <ColorAnimation To="{DynamicResource LocalButtonEnter}" Duration="0:0:0.2" 
                                                    Storyboard.TargetName="borderBackground"
                                                    Storyboard.TargetProperty="Color"/>
                <ColorAnimation To="Black" Duration="0:0:0.1" 
                                                    Storyboard.TargetName="textForeground"
                                                    Storyboard.TargetProperty="Color"/>
            </Storyboard>
            <Storyboard x:Key="ButtonLeaveStory">
                <ColorAnimation To="{DynamicResource LocalButtonLeave}" Duration="0:0:0.2" 
                                                    Storyboard.TargetName="borderBackground"
                                                    Storyboard.TargetProperty="Color"/>
                <ColorAnimation To="White" Duration="0:0:0.1" 
                                                    Storyboard.TargetName="textForeground"
                                                    Storyboard.TargetProperty="Color"/>
            </Storyboard>

            <!-- 최소, 최대, 복원 아이콘 -->
            <Style x:Key="MainIconCom" TargetType="Canvas">
                <Setter Property="Margin" Value="5 0 5 0"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource MainTitleBack}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="SteelBlue"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 창 닫기 아이콘 -->
            <Style x:Key="MainIconClose" TargetType="Canvas">
                <Setter Property="Margin" Value="0 0 15 0"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource MainTitleBack}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="IndianRed"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Background="WhiteSmoke">
        <DockPanel x:Name="TITLE" DockPanel.Dock="Top" Background="#4472c4" Height="60">
            <Canvas x:Name="ICON_CLOSE" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{DynamicResource MainIconClose}"
                        MouseDown="ICON_CLOSE_MouseDown">
                <Line X1="5" Y1="5" X2="19" Y2="19" Stroke="White" StrokeThickness="4"></Line>
                <Line X1="5" Y1="19" X2="19" Y2="5" Stroke="White" StrokeThickness="4"></Line>
            </Canvas>
            <Canvas x:Name="ICON_MIN" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{DynamicResource MainIconCom}"
                        MouseDown="ICON_MIN_MouseDown">
                <Line X1="4" Y1="18" X2="20" Y2="18" Stroke="White" StrokeThickness="4"></Line>
            </Canvas>
            <UserControl Background="#4472c4" MouseLeftButtonDown="TITLE_MouseLeftButtonDown">
                <TextBlock Margin="5 0 0 0" FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="White" FontWeight="Bold">
                    SnSinc - 외주처 MES 시스템
                </TextBlock>
            </UserControl>
        </DockPanel>

        <DockPanel x:Name="LOGIN">
            <UserControl Height="60" DockPanel.Dock="TOP"/>
            <DockPanel DockPanel.Dock="Top" Margin="0 10 100 0">
                <TextBox x:Name="LOGINID" 
                         VerticalContentAlignment="Center" FontSize="16"
                         Width="200" Height="25" DockPanel.Dock="Right"
                         KeyDown="LOGINPASS_KeyDown"></TextBox>
                <TextBlock FontSize="16" Margin="0 0 10 0" 
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right">아이디:</TextBlock>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0 10 100 0">
            <PasswordBox x:Name="LOGINPASS" FontSize="16"
                            VerticalContentAlignment="Center"
                            Width="200" Height="25" DockPanel.Dock="Right"
                            KeyDown="LOGINPASS_KeyDown"></PasswordBox>
                <TextBlock FontSize="16" Margin="0 0 10 0" 
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">패스워드:</TextBlock>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0 10 100 0">
                <Border x:Name="LOGIN_BUTTON" Margin="3" CornerRadius="0"
                        DockPanel.Dock="Right"
                        MouseEnter="LOGIN_BUTTON_MouseEnter"
                        MouseLeave="LOGIN_BUTTON_MouseLeave"
                        MouseDown="LOGIN_BUTTON_MouseDown">
                    <Border.Background>
                        <SolidColorBrush x:Name="borderBackground" Color="{DynamicResource LocalButtonLeave}"></SolidColorBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="40">
                        <TextBlock x:Name="textBlock" 
                            Margin="20 0 20 0"
                            Text="로그인"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="textForeground" Color="White"></SolidColorBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" 
                            Margin="0 10 20 0"
                            HorizontalAlignment="Right">
                    <CheckBox x:Name="SAVE_ID" FontSize="14">아이디저장</CheckBox>
                    <!--<CheckBox x:Name="SAVE_PASS" FontSize="14">패스워드저장</CheckBox>-->
                </StackPanel>
            </DockPanel>
            <UserControl Height="50" Width="5000" DockPanel.Dock="Top"></UserControl>
            <UserControl Width="500" Background="Silver" FontWeight="Bold"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                <!--COPY RIGHT 2024 (C) SnSinc-->
            </UserControl>
        </DockPanel>
    </DockPanel>
</Window>
