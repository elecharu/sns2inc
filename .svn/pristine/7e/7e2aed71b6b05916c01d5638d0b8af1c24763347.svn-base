using PLC_GATHERING_Prj.ViewModel;
using System;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Threading;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Forms;
using System.Windows.Input;
using System.Windows.Media;
using Application = System.Windows.Application;
using ContextMenu = System.Windows.Forms.ContextMenu;
using MessageBox = System.Windows.MessageBox;

namespace PLC_GATHERING_Prj
{
    /// <summary>
    /// MainWindow.xaml에 대한 상호 작용 논리
    /// </summary>
    public partial class MainWindow : Window
    {       
        private static MainWindow _mainWindow = null;
        public static MainWindow mainWindow
        {
            get
            {
                return _mainWindow;
            }
        }
        
        public MainWindow()
        {
            InitializeComponent();

            // 중복 실행 확인
            bool isRun = false;
            System.Diagnostics.Process currentProcess = System.Diagnostics.Process.GetCurrentProcess();
            System.Diagnostics.Process[] processess = System.Diagnostics.Process.GetProcesses();
            foreach (System.Diagnostics.Process process in processess)
            {
                if (currentProcess.Id != process.Id)
                {
                    if (currentProcess.ProcessName == process.ProcessName)
                    {
                        isRun = true;
                        break;
                    }
                }
            }
            if (isRun)
            {
                MessageBox.Show("프로그램이 이미 실행중입니다.\n\n트레이 아이콘을 확인하세요.");
                this.Close();
            }

            _mainWindow = this;
            this.Title = "PLC Gethering Program [Ver." + Workspace.This.Version() + "]";
        }

        public NotifyIcon notify;

        private void Window_Loaded(object sender, RoutedEventArgs e)
        {
            string icoFilePath = AppDomain.CurrentDomain.BaseDirectory + "icon_office.ico";

            ContextMenu menu = new ContextMenu();

            notify = new NotifyIcon();
            notify.Icon = new Icon(icoFilePath);
            notify.Visible = true;
            notify.ContextMenu = menu;
            notify.Text = "Test";

            notify.DoubleClick += Notify_DoubleClick;

            System.Windows.Forms.MenuItem item1 = new System.Windows.Forms.MenuItem();
            menu.MenuItems.Add(item1);
            item1.Index = 0;
            item1.Text = "프로그램 종료";
            item1.Click += delegate (object click, EventArgs eClick)
            {
                System.Windows.Application.Current.Shutdown();
                notify.Dispose();
            };

            ItsMaria.Set("PLC_GATHERING", "LIST_PLC");

            DataSet ds = ItsMaria.Call();

            if (ItsMaria.IsError)
            {
                MessageBox.Show(ItsMaria.ErrMessage);
                Environment.Exit(0);
            }

            for (int i = 0; i < ds.Tables[0].Rows.Count; i++)
            {
                cbPLCList.Items.Add(ds.Tables[0].Rows[i]["EQMCD"]);
            }

            cbPLCList.SelectedIndex = 0;
            cbPLCList.SelectionChanged += cbPLCList_SelectionChanged;

            tbMaintext.Text = "::::PLC DATA 수집 프로그램::::";

            Workspace.This.LoadSetting();

            btnRun.IsEnabled = true;
            btnStop.IsEnabled = false;
            cbPLCList.IsEnabled = true;
            rbLS_XGT.IsChecked = true;

            btnRun_Sub();
            this.Close();      
        }

        private void cbPLCList_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                ItsMariaThread itsMariaThread = new ItsMariaThread();

                itsMariaThread.Set("PLC_GATHERING", "LIST_PLC");

                DataSet ds = itsMariaThread.Call();

                if (ds.Tables[1].Rows.Count > 0)
                {
                    MainWindow.mainWindow.cbMachin.Items.Clear();

                    for (int i = 0; i < ds.Tables[1].Rows.Count; i++)
                    {
                        MainWindow.mainWindow.cbMachin.Items.Add(ds.Tables[1].Rows[i]["MACHIN_LIST"]);
                    }

                    MainWindow.mainWindow.cbMachin.SelectedIndex = 0;
                }
            }
            catch (Exception ex)
            {
                Log.This.DB_HistLog_Write("cbPLCList_SelectionChanged", ex.Message);
            }
        }

        private void Notify_DoubleClick(object sender, EventArgs e)
        {
            this.Show();
            this.WindowState = WindowState.Normal;
            this.Visibility = Visibility.Visible;
        }

        protected override void OnClosing(System.ComponentModel.CancelEventArgs e)
        {
            e.Cancel = true;
            this.Hide();
            base.OnClosing(e);
        }

        private void cbMachin_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (cbMachin.SelectedItem != null)
                {
                    string selectedPLCNM = cbMachin.SelectedItem.ToString();

                    string[] info = selectedPLCNM.Split('■');
                    textBox_ip.Text = info[1];
                    textBox_port.Text = info[2];
                    if (info[3] == "XG_TCP")
                    {
                        rbLS_XGT.IsChecked = true;
                        rbMEL_Q.IsChecked = false;
                        rbMEL_A.IsChecked = false;
                        rbNETEYE.IsChecked = false;
                    }
                    if (info[3] == "MEL_TCP")
                    {
                        rbMEL_Q.IsChecked = true;
                        rbLS_XGT.IsChecked = false;
                        rbMEL_A.IsChecked = false;
                        rbNETEYE.IsChecked = false;
                    }
                    if (info[3] == "MEL_A")
                    {
                        rbMEL_A.IsChecked = true;
                        rbMEL_Q.IsChecked = false;
                        rbLS_XGT.IsChecked = false;
                        rbNETEYE.IsChecked = false;
                    }
                    if (info[3] == "NETEYE")
                    {
                        rbNETEYE.IsChecked = true;
                        rbMEL_A.IsChecked = false;
                        rbMEL_Q.IsChecked = false;
                        rbLS_XGT.IsChecked = false;
                    }
                }
            }
            catch (Exception ex)
            {
                Log.This.DB_HistLog_Write("cbMachin_SelectionChanged", ex.Message);
            }
        }

        private void btnRun_Click(object sender, RoutedEventArgs e)
        {
            btnRun_Sub();
        }

        private void btnRun_Sub()
        {
            try
            {
                dgPLCList.ItemsSource = null;

                btnStop.IsEnabled = true;
                btnRun.IsEnabled = false;
                cbPLCList.IsEnabled = false;
                btRead.IsEnabled = false;
                btnWrite.IsEnabled = false;

                ItsMariaThread itsMariaThread = new ItsMariaThread();

                itsMariaThread.Set("PLC_GATHERING", "LIST_PLC");

                DataSet ds = itsMariaThread.Call();

                string line = string.Empty;

                Workspace.This.PLCAddListThread = new Thread[ds.Tables[0].Rows.Count];

                for (int i = 0; i < ds.Tables[0].Rows.Count; i++)
                {
                    line = ds.Tables[0].Rows[i]["EQMCD"].ToString();

                    //Log.This.ErrLog_main(
                    //                        "btnRun_Click => " + "\r\n" +
                    //                        line
                    //                        );

                    itsMariaThread.Set("PLC_GATHERING", "LIST_PLC_SINGLE");
                    itsMariaThread.AddOne("EQMCD", line.ToString());
                    DataSet ds1 = itsMariaThread.Call();

                    try
                    {
                        Workspace.This._GlobalSet.Add(line, ds1);

                        foreach (DataRow row in ds1.Tables[0].Rows)
                        {
                            string plckey = row["PLCKEY"].ToString();
                            if (!Workspace.This.plcdata.ContainsKey(plckey))
                            {
                                Workspace.This.plcdata.Add(plckey, row["PLCVALUE"].ToString());
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Log.This.DB_HistLog_Write("btnRun_Click", ex.Message);
                    }

                    string threadid = "0000" + i;
                    threadid = threadid.Substring(threadid.Length - 4, 4);

                    Workspace.This.PLCAddListThread[i] = new Thread(new ParameterizedThreadStart(ViewModel.clThread.This.Work));
                    Workspace.This.PLCAddListThread[i].IsBackground = true;
                    Workspace.This.PLCAddListThread[i].Start(threadid + line.ToString());
                }

                Workspace.This.PLCListThread = new Thread(ViewModel.clThread.This.SavePLCData);
                Workspace.This.PLCListThread.IsBackground = true;
                Workspace.This.PLCListThread.Start();
            }
            catch (Exception ex)
            {
                Log.This.DB_HistLog_Write("btnRun_Click", ex.Message);
            }
            finally
            {
                MainWindow.mainWindow.tbstatusText.Text = "-- 수집 중 --";
                MainWindow.mainWindow.bdstatusColor.Background = new SolidColorBrush(Colors.CadetBlue);

                Workspace.This.DB_USEYN_CHECK(true);
            }
        }

        private void btnStop_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                btnRun.IsEnabled = true;
                btnStop.IsEnabled = false;

                btRead.IsEnabled = true;
                btnWrite.IsEnabled = true;
                //cbPLCList.IsEnabled = true;

                if (Workspace.This.PLCAddListThread.Count() != 0)
                {
                    for (int i = 0; i < Workspace.This.PLCAddListThread.Length; i++)
                    {
                        if (Workspace.This.PLCAddListThread[i] != null)
                        {
                            try
                            {
                                Workspace.This.PLCAddListThread[i].Abort();
                            }
                            catch(Exception ex)
                            {
                                Log.This.DB_HistLog_Write("btnStop_Click_" + Workspace.This.PLCAddListThread[i], ex.Message);
                            }
                        }
                    }

                    try
                    {
                        Workspace.This.PLCListThread.Abort();
                    }
                    catch (Exception ex)
                    {
                        clThread.This.ReduceMemory();
                        Log.This.DB_HistLog_Write("btnStop_Click_ReduceMemory", ex.Message);
                    }
                }             
            }
            catch (Exception ex)
            {
                Log.This.DB_HistLog_Write("btnStop_Click", ex.Message);
            }
            finally
            {
                MainWindow.mainWindow.tbstatusText.Text = "-- 수집 대기 --";
                MainWindow.mainWindow.bdstatusColor.Background = new SolidColorBrush(Colors.Orange);
                Workspace.This.DB_USEYN_CHECK(false);
            }
        }

        private void btRead_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (rbMEL_Q.IsChecked == true) // 멜섹Q
                {
                    if (!Workspace.This.plcdata1.ContainsKey("A" + textBox_addr.Text))
                    {
                        Workspace.This.plcdata1.Add("A" + textBox_addr.Text, "");
                    }
                    ItsPlcNet.Read_MEL_TCP(textBox_ip.Text, Convert.ToInt32(textBox_port.Text), textBox_addr.Text, textBox_addr.Text, ref Workspace.This.plcdata1, "A");
                    textBox_value.Text = Workspace.This.plcdata1["A" + textBox_addr.Text].ToString();
                }
                else if (rbMEL_A.IsChecked == true) //멜섹A
                {
                    if (!Workspace.This.plcdata1.ContainsKey("A" + textBox_addr.Text))
                    {
                        Workspace.This.plcdata1.Add("A" + textBox_addr.Text, "");
                    }
                    textBox_value.Text = ItsPlcNet._Read_MEL_A_SINGLE(textBox_ip.Text, Convert.ToInt32(textBox_port.Text), textBox_addr.Text, textBox_addr.Text, "", true);
                }
                else if (rbNETEYE.IsChecked == true) //NETEYE
                {
                    if (!Workspace.This.plcdata1.ContainsKey("A" + textBox_addr.Text))
                    {
                        Workspace.This.plcdata1.Add("A" + textBox_addr.Text, "");
                    }
                    textBox_value.Text = ItsPlcNet._Read_NETEYE_SINGLE(textBox_ip.Text, Convert.ToInt32(textBox_port.Text), textBox_addr.Text, textBox_addr.Text, "", true);
                }
                else //XGT
                {
                    if (!Workspace.This.plcdata1.ContainsKey("A" + textBox_addr.Text))
                    {
                        Workspace.This.plcdata1.Add("A" + textBox_addr.Text, "");
                    }

                    ItsPlcNet.Read_XG_TCP(textBox_ip.Text, textBox_port.Text, textBox_addr.Text, textBox_addr.Text, ref Workspace.This.plcdata1, "A");
                    textBox_value.Text = Workspace.This.plcdata1["A" + textBox_addr.Text].ToString();
                }
            }
            catch (Exception ex)
            {
                Log.This.DB_HistLog_Write("btRead_Click", ex.Message);
            }
        }

        private void btnWrite_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                string mode = string.Empty;

                if (rbMEL_Q.IsChecked == true)
                {
                    mode = "MELSEC1";

                    ItsPlcNet.Write_MEL_TCP(textBox_ip.Text, Int32.Parse(textBox_port.Text), textBox_addr.Text, textBox_value.Text);
                }
                else
                {
                    mode = "XGT";

                    ItsPlcNet.Write_XG_TCP(textBox_ip.Text, Int32.Parse(textBox_port.Text), textBox_addr.Text, textBox_value.Text);
                }
            }
            catch (Exception ex)
            {
                Log.This.DB_HistLog_Write("btnWrite_Click", ex.Message);
            }   
        }

        private void CommandBinding_CanExecute(object sender, CanExecuteRoutedEventArgs e)
        {
            e.CanExecute = true;
        }

        private void Window_Closed(object sender, EventArgs e)
        {
            Application.Current.Shutdown();
        }
    }
}
