namespace ITSSCHEDULER
{
    public partial class MainForm : Form
    {
        
        System.Timers.Timer _updateTimer = new System.Timers.Timer();
        System.Timers.Timer _stockTimer = new System.Timers.Timer();

        public MainForm()
        {
            InitializeComponent();

            // 중복 실행 확인
            bool isRun = false;
            System.Diagnostics.Process currentProcess = System.Diagnostics.Process.GetCurrentProcess();
            System.Diagnostics.Process[] processess = System.Diagnostics.Process.GetProcesses();
            foreach (System.Diagnostics.Process process in processess)
            {
                if (currentProcess.Id != process.Id)
                {
                    if (currentProcess.ProcessName == process.ProcessName)
                    {
                        isRun = true;
                        break;
                    }
                }
            }
            if (isRun)
            {
                MessageBox.Show("프로그램이 이미 실행중입니다.\n\n트레이 아이콘을 확인하세요.");
                this.Close();
            }
            else
            {
                // PLC값 업데이트
                _updateTimer.Interval = 10000;
                _updateTimer.Elapsed += updateTimer_Elapsed;
                _updateTimer.Stop();

                // 재고 업데이트
                _stockTimer.Interval = 60000;
                _stockTimer.Elapsed += _stockTimer_Elapsed;
                _stockTimer.Stop();
            }
        }

        private void _stockTimer_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            (sender as System.Timers.Timer).Stop();

            ItsMariaThread maria = new ItsMariaThread();
            maria.Query("CALL IO_STOCK_UPDATE('A')");
            if (ItsMaria.IsError)
            {
                ShowErrMsg(ItsMaria.ErrMessage + "stock" + " " + DateTime.Now.ToString());
                (sender as System.Timers.Timer).Start();
                return;
            }

            (sender as System.Timers.Timer).Start();
        }

        private void ShowErrMsg(string errmsg)
        {
            //lbl_err.Visible = true;
            //lbl_err.Text = errmsg;
            err_log(ItsMaria.ErrMessage);
            // lbl_err.Visible = true;
        }

        private void err_log(string text)
        {
            string filePath = "log.txt";
            System.IO.File.AppendAllText(filePath, "\r\n" + text, Encoding.UTF8);
        }

        private void HiddenErrMsg()
        {
            // lbl_err.Visible = false;
        }

        private void updateTimer_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            (sender as System.Timers.Timer).Stop();

                //HiddenErrMsg();

            // plc 목록 조회
            ItsMaria.Set("PLC_GATHERING_NET", "LIST_PLC");
            DataSet ds = ItsMaria.Call();
            if (ItsMaria.IsError)
            {
                ShowErrMsg(ItsMaria.ErrMessage);
                (sender as System.Timers.Timer).Start();
                return;
            }
            //ShowErrMsg(DateTime.Now.ToString() + "  LIST_PLC");
            DataTable addr_list = ds.Tables[0];
            Dictionary<string, string> plcdata = new Dictionary<string, string>();
            foreach (DataRow row in addr_list.Rows)
            {
                plcdata.Add(row["PLCKEY"].ToString(), row["PLCVALUE"].ToString());
            }

            DataTable plc_list = ds.Tables[1];

            foreach (DataRow row in plc_list.Rows)
            {
                string plccd = row["PLCCD"].ToString();
                string plcip = row["PLCIP"].ToString();
                string plcport = row["PLCPORT"].ToString();
                string saddr = row["SADDR"].ToString();
                string eaddr = row["EADDR"].ToString();
                if (saddr.IndexOf("DW") > -1)
                {
                    ItsPlcNet.Read_XG_TCP(plcip, plcport, saddr, eaddr, ref plcdata, plccd);
                }
                else
                {
                    ItsPlcNet.Read_XG_TCP_S(plcip, plcport, saddr, eaddr, ref plcdata, plccd);
                }

            }

            ItsMaria.Set("PLC_GATHERING_NET", "UP_CUR");
            foreach (string plckey in plcdata.Keys)
            {
                ItsMaria.AddList("ADDRKEYLIST", plckey);
                ItsMaria.AddList("VALUELIST", plcdata[plckey]);
            }
            DataSet ds_siren = ItsMaria.Call();
            if (ItsMaria.IsError)
            {
                ShowErrMsg(ItsMaria.ErrMessage);
                (sender as System.Timers.Timer).Start();
                return;
            }
            //ShowErrMsg(DateTime.Now.ToString() + "  UP_CUR");
            //btnSearch_Click(null, null);
            DataTable dt_siren = ds_siren.Tables[0];
            foreach (DataRow row in dt_siren.Rows)
            {
                string plcip = row["PLCIP"].ToString();
                string plcport = row["PLCPORT"].ToString();
                string address = row["PLCADDR"].ToString();
                string data = row["WRITEVALUE"].ToString();

                ItsPlcNet.Write_XG_TCP(plcip, Int32.Parse(plcport), address, data);
            }

            (sender as System.Timers.Timer).Start();
        }

