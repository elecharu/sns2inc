        private void button_rTest_Click(object sender, EventArgs e)
        {
            Dictionary<string, string> plcdata1 = new Dictionary<string, string>();
            //textBoxValue.Text = ItsPlc.ItsPlc.Read(textBoxIp.Text, textBoxPort.Text, "XGT", textBoxAddr.Text, "1");
            if (!plcdata1.ContainsKey("A" + textBoxAddr.Text))
            {
                plcdata1.Add("A" + textBoxAddr.Text, "");
            }
            ItsPlcNet.Read_XG_TCP(textBoxIp.Text, textBoxPort.Text, textBoxAddr.Text, textBoxAddr.Text, ref plcdata1, "A");
            textBoxValue.Text = plcdata1["A" + textBoxAddr.Text].ToString();
        }

