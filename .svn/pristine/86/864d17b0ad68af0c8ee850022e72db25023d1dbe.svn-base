<UserControl x:Class="ITSLIB.Date"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             MinHeight="28" MaxHeight="28" Height="28"
             Width="200" MinWidth="100">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap" 
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="DotumChe" />
        <Grid DockPanel.Dock="Left">
            <dxe:DateEdit x:Name="dateEdit"
                          DisplayFormatString="yyyy-MM-dd"
                          Mask="yyyy-MM-dd"
                          Margin="3"
                          Height="22"
                          EditValueChanged="dateEdit_EditValueChanged"
                          GotFocus="dateEdit_GotFocus"
                          LostFocus="dateEdit_LostFocus" FontFamily="DotumChe"/>
            <UserControl Width="20" Height="18" Background="White" Margin="0 0 4 0"
                         HorizontalAlignment="Right">
                <Canvas x:Name="canvas" 
                    Width="16" 
                    Height="16" 
                    Background="White"
                    MouseUp="canvas_MouseUp">
                    <Canvas Width="16" Height="16">
                        <Line X1="0" Y1="2" X2="16" Y2="2" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="1" Y1="2" X2="1" Y2="15" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="15" Y1="2" X2="15" Y2="15" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="0" Y1="15" X2="16" Y2="15" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="5" Y1="0" X2="5" Y2="4" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="11" Y1="0" X2="11" Y2="4" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="1" Y1="6" X2="15" Y2="6" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="11" Y1="0" X2="11" Y2="4" Stroke="Gray" StrokeThickness="2"></Line>
                        <Line X1="3.5" Y1="9" X2="5.5" Y2="9" Stroke="Gray" StrokeThickness="1.5"></Line>
                        <Line X1="7" Y1="9" X2="9" Y2="9" Stroke="Gray" StrokeThickness="1.5"></Line>
                        <Line X1="10.5" Y1="9" X2="12.5" Y2="9" Stroke="Gray" StrokeThickness="1.5"></Line>
                        <Line X1="3.5" Y1="12" X2="5.5" Y2="12" Stroke="Gray" StrokeThickness="1.5"></Line>
                        <Line X1="7" Y1="12" X2="9" Y2="12" Stroke="Gray" StrokeThickness="1.5"></Line>
                        <Line X1="10.5" Y1="12" X2="12.5" Y2="12" Stroke="Gray" StrokeThickness="1.5"></Line>
                    </Canvas>
                </Canvas>
            </UserControl>
        </Grid>
    </DockPanel>
</UserControl>
