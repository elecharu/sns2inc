.ui-dialog {
    padding: 0px;
    margin-top:100px;
}
.ui-widget.ui-widget-content {
    border: 0px solid transparent;
    border-radius: 3px;
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.15);
}
.ui-widget-header{
    background:#4774B9;
    border-color: #7691d9;
    color: white;
    font-size: 14px;
    font-family: 'SpoqaHanSansNeo_M';
    font-weight: normal;
    border-radius: 0px;
    border-top-left-radius:3px;
    border-top-right-radius:3px;
}
.ui-dialog-buttonset .ui-button{
    background:transparent;
}
.ui-widget-overlay{
    z-index: 900;
    top: 147px;
    margin: 0px 12px;
    width: calc(100% - 24px);
    background-color: black;
    opacity:0.3;
}
.ui-dialog .ui-dialog-content {
    padding: 0px;
    overflow: hidden;
}
.ui-dialog .ui-dialog-titlebar {
    padding: .5em 1em;
    height:40px;
}
.ui-dialog .ui-dialog-titlebar-close {
    border:0px;
    background-color:transparent;
}

.ItsPopButtons {
    width: 100%;
    height:48px;
    text-align: center; 
    overflow: hidden; 
    background-color:#FCFBFC; 
    border-top:1px solid #EEEEEE;
    position:absolute;
    left: 0px;
    bottom:0px;
}
.ItsButton.addPop {
    display: block;
    margin: 8px 2px;
    
}
.ItsButton.addPop:hover {
    box-shadow:none;
}
.ItsButton.addPop:active {
    box-shadow:none;
}
.ItsPopButtonsInner {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
}
.ItsButton.addPop .ItsButton_table {
    width: 70px;
    height:28px;
    cursor: pointer;
    font-size: 12px;
    font-family: SpoqaHanSansNeo_B;
    margin: 10px 5px 10px auto;

    border: 1px solid #C9C9C9 !important;
    border-radius: 5px;
    background-color: #FFFFFF;
    color: #565656;
}
.ItsButton.addPop .ItsButton_table:hover {
    color: #4774B9;
    border: 1px solid #4774B9 !important;
    text-decoration: none !important;
}
.ItsButton.addPop .ItsButton_table:active {
    color: #FFFFFF !important;
    border: 1px solid #4774B9 !important;
    background-color: #4774B9;
}
