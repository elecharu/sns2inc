div.ItsTextArea {
    float:left;
    display:inline-block;
    margin-top:2px;
    margin-bottom:2px;
    background-color:transparent;
}
div.ItsTextArea_table {
    background-color:transparent;
}

div.ItsTextArea_table > span {
    vertical-align:middle;
    display:inline-block;
    text-align:right;
    background-color:transparent; 
    white-space: normal;
    font-family: 'SpoqaHanSansNeo_M';
    color:#565656;
}
div.ItsTextArea_table > textarea {
    resize:none;
    outline: none;
    text-align:left;
    padding:4px 4px 4px 4px;
    vertical-align:middle;
    height:20px;
    border:1px solid #C0C0C0;
    box-sizing: border-box;
    line-height: 15px;
    font-weight:normal;
    font-size:12px;
    color:#565656;
}
div.ItsTextArea_table > textarea:focus {
    border:1px solid #4774B9;
}
div.ItsTextArea_table > textarea:read-only {
    border:1px solid #C0C0C0;
    background-color:#F0F0F0;
    color:#A3A3A3;
}