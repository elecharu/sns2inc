<its:ItsPageOffice x:Class="SYS0104.S01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0104"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="S01">
    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START-->
                <its:Text Label="품목코드" Value="{Binding ITEMCD}"/>
                <its:Text Label="품명" Value="{Binding ITEMNM}"/>
                <its:Text Label="규격" Value="{Binding ITEMSPEC}"/>
                <!-- ################################# PANEL SEARCH : END-->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource GRID}">
            <its:Grid x:Name="GRID_G1">
                <its:Grid.Columns>
                    <!-- ################################# COLUMN FLEX: START -->
                    <its:Column Width="100" Header="프로그램코드" FieldName="PRGCD"/>
                    <its:Column Width="100" Header="프로그램명" FieldName="PRGNM"/>
                    <its:Column Width="100" Header="조회" FieldName="SEARCHYN"/>
                    <its:Column Width="100" Header="추가" FieldName="INSERTYN"/>
                    <its:Column Width="100" Header="저장" FieldName="UPDATEYN"/>
                    <its:Column Width="100" Header="삭제" FieldName="DELETEYN"/>
                    <!-- ################################# COLUMN FLEX: END -->
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>
    </DockPanel>
</its:ItsPageOffice>
