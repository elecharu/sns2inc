/**********************************************************************************************************************************************************/
/* 조회 */
ItsButton.EventSearch = function () {
    ItsGrid.Clear('grid1');

    var maria = new ItsMaria('PRD1001_R02', 'LIST_WEEKPLAN');

    maria.AddPanel('sdiv1');

    maria.CallProc();

    if (maria.isError) {
        maria.ShowErrMsg();
        return;
    }

    ItsGrid.SetStore('grid1', maria.store.YnToBool('APPYN').YnToBool('STOCKYN'));
    //ItsGrid.Get('grid1').autoSizeColumns();    

    ItsMsg.Toast(ItsMsg.CommonMsg.SearchComplete(maria.store.Length()));

    SET_BANDNAME();
};

SET_BANDNAME = function () {
    var week = new Array("(일)", "(월)", "(화)", "(수)", "(목)", "(금)", "(토)");
    var SDATE = new Date(ItsDateRange.GetValueFrom('dateR'));
    var EDATE = new Date(ItsDateRange.GetValueTo('dateR'));
    var firstDay = new Date(SDATE.getFullYear(), SDATE.getMonth(), 1);
    var lastDay = new Date(SDATE.getFullYear(), SDATE.getMonth() + 1, 0);

    // 컬럼 헤더 변경
    for (var i = 0; i < 31; i++) {
        var day = new Date(firstDay);
        day.setDate(day.getDate() + i);
        var daystring = new Date(day).format('MM/dd') + ' ' + week[day.getDay()];

        ItsGrid.Get('grid1').columnHeaders.setCellData(0, ItsGrid.$colIndex('grid1', 'PLAN_' + (i + 1) + '_DAY'), daystring);
        ItsGrid.Get('grid1').columnHeaders.setCellData(0, ItsGrid.$colIndex('grid1', 'PLAN_' + (i + 1) + '_NIGHT'), daystring);

        var isBetween = (day.toLocaleDateString('en-CA') >= SDATE.toLocaleDateString('en-CA') && day.toLocaleDateString('en-CA') <= EDATE.toLocaleDateString('en-CA'));

        if (isBetween) {
            ItsGrid.Get('grid1').columns[ItsGrid.$colIndex('grid1', 'PLAN_' + (i + 1) + '_DAY')].visible = true;
            ItsGrid.Get('grid1').columns[ItsGrid.$colIndex('grid1', 'PLAN_' + (i + 1) + '_NIGHT')].visible = true;

            if (ItsGrid.Length('grid1') > 0) {
                var WORKTIME_DAY = ItsGrid.GetValue('grid1', 0, 'WORKTIME_' + (i + 1) + '_DAY');

                if (WORKTIME_DAY > 0) {
                    ItsGrid.SetReadOnly('grid1', 'PLAN_' + (i + 1) + '_DAY', false);
                    ItsGrid.SetColumnBackColor('grid1', 'PLAN_' + (i + 1) + '_DAY', 'white');
                }
                else {
                    ItsGrid.SetReadOnly('grid1', 'PLAN_' + (i + 1) + '_DAY', true);
                }                   

                var WORKTIME_NIGHT = ItsGrid.GetValue('grid1', 0, 'WORKTIME_' + (i + 1) + '_NIGHT');

                if (WORKTIME_DAY > 0) {
                    ItsGrid.SetReadOnly('grid1', 'PLAN_' + (i + 1) + '_NIGHT', false);
                    ItsGrid.SetColumnBackColor('grid1', 'PLAN_' + (i + 1) + '_NIGHT', 'white');
                }
                else {
                    ItsGrid.SetReadOnly('grid1', 'PLAN_' + (i + 1) + '_NIGHT', true);
                }
                    
            }
            
        }
        else {
            ItsGrid.Get('grid1').columns[ItsGrid.$colIndex('grid1', 'PLAN_' + (i + 1) + '_DAY')].visible = false;
            ItsGrid.Get('grid1').columns[ItsGrid.$colIndex('grid1', 'PLAN_' + (i + 1) + '_NIGHT')].visible = false;
        };
    }

    ItsGrid.Get('grid1').refresh();
}
/**********************************************************************************************************************************************************/
ItsGrid.Event('grid1').onButtonClick = function (rowindex, field) {
    if (field == 'OPENPOP_ADDPLAN') {
        ItsPop.Open('pop_ADDPLAN');
    }
};
