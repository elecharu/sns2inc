        private void checkBox1_CheckedChanged(object sender, EventArgs e)
        {
            if (checkBox1.Checked) checkBox2.Checked = false;
        }

        private void checkBox2_CheckedChanged(object sender, EventArgs e)
        {
            if (checkBox2.Checked) checkBox1.Checked = false;
        }


        private void Cmb_PLC_SelectedValueChanged(object sender, EventArgs e)
        {
            ItsMaria.Set("PLC_GATHERING_NET", "LIST_PLC");
            ItsMaria.AddOne("EQMCD", cmb_PLC.SelectedValue);    // PLC선택시 코드 전송
            DataSet ds = ItsMaria.Call();
            if (ds.Tables[2].Rows.Count > 0)
            {
                comboBox_MECH.DataSource = ds.Tables[2];
                comboBox_MECH.DisplayMember = "PLCNM";
                comboBox_MECH.ValueMember = "PLCCD";
            }
        }
    }
