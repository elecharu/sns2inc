        int _ScrollValue = 0;
        private void dgvVehicles_Scroll(object sender, ScrollEventArgs e)
        {
            if (e.ScrollOrientation == ScrollOrientation.VerticalScroll)
            {
                _ScrollValue = e.NewValue;
            }
        }
        int _ScrollValue1 = 0;
        private void dgvVehicles_Scroll1(object sender, ScrollEventArgs e)
        {
            if (e.ScrollOrientation == ScrollOrientation.VerticalScroll)
            {
                _ScrollValue1 = e.NewValue;
            }
        }

        private void ReduceMemory()
        {
            Process A = Process.GetCurrentProcess();
            A.MaxWorkingSet = Process.GetCurrentProcess().MaxWorkingSet;
            A.Dispose();
        }

        private void comboBox_MECH_SelectedIndexChanged(object sender, EventArgs e)
        {
            try
            {
                string[] info = comboBox_MECH.Text.Split('■');
                textBox_ip.Text = info[2];
                textBox_port.Text = info[3];
                if (info[4] == "XG_TCP")
                {
                    radioButton_3.Checked = true;
                    radioButton_1.Checked = false;
                    radioButton_2.Checked = false;
                    radioButton_4.Checked = false;
                }
                if (info[4] == "MEL_TCP")
                {
                    radioButton_1.Checked = true;
                    radioButton_3.Checked = false;
                    radioButton_2.Checked = false;
                    radioButton_4.Checked = false;
                }
                if (info[4] == "MEL_A")
                {
                    radioButton_2.Checked = true;
                    radioButton_1.Checked = false;
                    radioButton_3.Checked = false;
                    radioButton_4.Checked = false;
                }
                if (info[4] == "NETEYE")
                {
                    radioButton_4.Checked = true;
                    radioButton_2.Checked = false;
                    radioButton_1.Checked = false;
                    radioButton_3.Checked = false;
                }
            }
            catch { }
        }

        private void dataGridView1_CellClick(object sender, DataGridViewCellEventArgs e)
