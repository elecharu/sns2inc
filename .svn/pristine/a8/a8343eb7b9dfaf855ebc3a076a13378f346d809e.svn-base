<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="800" Height="533">
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="800" Height="60">
                <its:Date Label="발주일자" Width="180" Value="{Binding SDATE}"/>
                <its:Date HidenLabel="Y" Width="100"  Value="{Binding EDATE}"/>
                <UserControl Width="50"/>
                <UserControl Width="5000"/>
                <its:Pop GPCD="CUSTCD" Width="250" Label="거래처코드" Value="{Binding CUSTCD}" ShowKeyPad="True"/>
                <its:Pop GPCD="ITEMID" Width="250" Label="품목코드" Value="{Binding ITEMID}" ShowKeyPad="True"/>
                <UserControl Width="20"/>
                <its:Button Label="발주 조회" Width="150" Height="30" CommandName="LIST_MTRODRD" FontWeight="Bold"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="60">
            <its:Grid x:Name="GRID_G1" Width="800" Height="200">
                <its:Grid.Columns>
                    <its:Column Width="80" Header="발주일자" FieldName="MTRODRDATE" ALGIN="center"/>
                    <its:Column Width="120" Header="거래처" FieldName="CUSTNM" ALGIN="center"/>
                    <its:Column Width="100" Header="품목ID" FieldName="ITEMID" ALGIN="center" Visible="False"/>
                    <its:Column Width="100" Header="품목코드" FieldName="ITEMCD" ALGIN="center"/>
                    <its:Column Width="130" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="80" Header="품목유형" FieldName="ITEMCG" GPCD="DM100" ALGIN="center"/>
                    <its:Column Width="130" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="80" DecimalPoint="0" Header="발주수량" FieldName="ODRQTY"/>
                    <its:Column Width="80" Header="납기일자" FieldName="EXPDATE" ALGIN="center"/>
                    <its:Column Width="100" Header="발주키" FieldName="MTRODRKEY" Visible="False"/>
                    <its:Column Width="100" Header="발주상세키" FieldName="MTRODRSEQ" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>      

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="260">
            <its:Grid x:Name="GRID_G2" Width="600" Height="273">
                <its:Grid.Columns>
                    <its:Column Width="80" Header="입고 일자" FieldName="MTRINDATE" ALGIN="center"/>
                    <its:Column Width="100" Header="로트번호" FieldName="LOTKEY" ALGIN="center"/>
                    <its:Column Width="70" Header="로트수량" FieldName="LOTQTY" DecimalPoint="0"/>
                    <its:Column Width="100" Header="거래처 로트번호" FieldName="CUSTLOTKEY" ALGIN="center"/>
                    <its:Column Width="100" Header="입고창고" FieldName="INWARENM" ALGIN="center" />
                    <its:Column Width="100" Header="입고창고" FieldName="INWARE" ALGIN="center" Visible="False"/>
                    <its:Column Width="100" Header="입고키" FieldName="MTRINKEY" Visible="False"/>
                    <its:Column Width="50" Header="재발행" CellType="Button" ButtonText="▤" CommandName="LABEL_REPRINT" />
                    <its:Column Width="80" Header="입고 삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_MTRINLOT" />                   
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="600" Canvas.Top="260">
            <its:WrapContent x:Name="PANEL_S2" Width="200" Height="273">
                <UserControl Width="200" Height="35"/>
                <its:Date x:Name="date_MTRINDATE" Label="입고일자" Width="200"
                          Value="{Binding MTRINDATE}"/>
                <UserControl Width="200" Height="3"/>
                <its:Number x:Name="num_LOTQTY" Width="200" Label="로트수량" DecimalPoint="0" 
                            Value="{Binding LOTQTY}" ShowKeyPad="True" />
                <its:Combo x:Name="cmb_INWARE" Label="입고창고" GPCD="MTRIN_WARECD"
                           Value="EM_MT_GD"/>
                <its:Check x:Name="chk_LABEL_YN" Label="라벨 출력유무" 
                    FontWeight="Bold" Width="200" LabelWidth="170" Value="False" Canvas.Left="640" Canvas.Top="386"/>
                <UserControl Width="200" Height="20"/>
                <its:Button Label="입고 등록" Width="200" Height="50" FontSize="20" FontWeight="Bold" 
                            CommandName="ADD_MTRINLOT"/>
                <UserControl Width="200" Height="20"/>
            </its:WrapContent>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
