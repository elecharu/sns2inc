<Window x:Class="ITSLIB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:its="clr-namespace:ITSLIB" 
        xmlns:shell="clr-namespace:Microsoft.Windows.Shell;assembly=Microsoft.Windows.Shell"
        FontSize="12"
        mc:Ignorable="d" Width="1000" Height="700"
        Background="Transparent" AllowsTransparency="False" 
        WindowStyle="None" BorderThickness="0">
    <Window.Effect>
        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="1" />
    </Window.Effect>
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="DockMain" TargetType="DockPanel">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DockTitle" TargetType="DockPanel">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DockMenu" TargetType="DockPanel">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DockBar" TargetType="DockPanel">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DockContent" TargetType="DockPanel">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="WhiteSmoke"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 메뉴 아이콘 -->
            <Style x:Key="MainIconMenu" TargetType="Canvas">
                <Setter Property="Margin" Value="5 0 5 0"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="LightSteelBlue"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 메뉴 숨기기 아이콘 -->
            <Style x:Key="MainIconHide" TargetType="Canvas">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="LightSteelBlue"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 최소, 최대, 복원 아이콘 -->
            <Style x:Key="MainIconCom" TargetType="Canvas">
                <Setter Property="Margin" Value="5 0 5 0"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="Transparent"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="LightSteelBlue"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- 메뉴 검색 아이콘 -->
            <Style x:Key="MenuSearchIcon" TargetType="Canvas">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="Transparent"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="LightSteelBlue"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- 창 닫기 아이콘 -->
            <Style x:Key="MainIconClose" TargetType="Canvas">
                <Setter Property="Margin" Value="5 0 0 0"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="Transparent"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="IndianRed"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 그리드 SPLIT -->
            <Style x:Key="MainGridSpliter" TargetType="GridSplitter">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ColorMainTitle}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="GridSplitter.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="IndianRed"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel x:Name="DOCK_MAIN" Style="{DynamicResource DockMain}" >
        <Grid x:Name="MAIN_GRID"> <!-- 좌우 나누기 그리드 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"></ColumnDefinition>
                <ColumnDefinition Width="2"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <!-- 좌측 메뉴 영역 -->
            <DockPanel x:Name="DOCK_MENU" Grid.Column="0">

                <!-- 상단 사용자 정보 영역 -->
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0 5 0 5">
                        <Canvas x:Name="ICON_CONFIG" DockPanel.Dock="Left" Width="24" Height="24"
                            Style="{DynamicResource MainIconCom}"
                            MouseUp="ICON_CONFIG_MouseUp">
                            <Ellipse Width="6" Height="6" Stroke="White" StrokeThickness="2" Canvas.Top="9" Canvas.Left="9"/>
                            <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2" Canvas.Top="6" Canvas.Left="6"/>
                            <Line X1="6" Y1="6" X2="8" Y2="8" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="4" Y1="12" X2="7" Y2="12" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="6" Y1="18" X2="8" Y2="16" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="12" Y1="20" X2="12" Y2="17" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="16" Y1="16" X2="18" Y2="18" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="16" Y1="12" X2="20" Y2="12" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="16" Y1="8" X2="18" Y2="6" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="12" Y1="4" X2="12" Y2="7" Stroke="White" StrokeThickness="3"></Line>
                        </Canvas>
                        <TextBlock x:Name="TEXT_EMPNM" DockPanel.Dock="Left"
                                   Language="none"
                                   VerticalAlignment="Center" 
                                   Foreground="Yellow"
                                   FontSize="16"
                                   FontWeight="Bold">[관리자]</TextBlock>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Language="none"
                                   VerticalAlignment="Bottom" 
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="5 0 0 0"
                                   FontWeight="Bold">님</TextBlock>
                    </StackPanel>
                    <DockPanel>
                        <Canvas x:Name="ICON_HIDE" 
                                DockPanel.Dock="Right"
                                Width="40" Height="40"
                                Style="{DynamicResource MainIconHide}" 
                                MouseUp="ICON_HIDE_MouseUp">
                            <Ellipse Width="30" Height="30" Stroke="White" Canvas.Left="5" Canvas.Top="5" StrokeThickness="3"></Ellipse>
                            <Line X1="13" Y1="20" X2="20" Y2="13" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="12" Y1="20" X2="28" Y2="20" Stroke="White" StrokeThickness="3"></Line>
                            <Line X1="13" Y1="20" X2="20" Y2="28" Stroke="White" StrokeThickness="3"></Line>
                        </Canvas>
                        <TextBlock DockPanel.Dock="Top" Margin="5 0 0 0"
                                   Language="none"
                                   x:Name="TEXT_DATE"
                                   VerticalAlignment="Center" 
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold">접속일자: 2016-12-15</TextBlock>
                        <TextBlock DockPanel.Dock="Top" Margin="5 0 0 0"
                                   Language="none"
                                   x:Name="TEXT_TIME"
                                   VerticalAlignment="Center" 
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold">접속시간: 12:25:26</TextBlock>
                    </DockPanel>
                </DockPanel>
                
                <!-- 메뉴 조회 옵션 -->
                <UserControl DockPanel.Dock="Top" Margin="0 5 0 10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" 
                                       Margin="10 0 0 0"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" 
                                       Text="검색"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center">
                        </TextBlock>
                        <Canvas DockPanel.Dock="Right"
                                Width="20" 
                                Height="20" 
                                Style="{DynamicResource MenuSearchIcon}" 
                                MouseLeftButtonDown="MENU_SEARCH_MouseUp"
                                HorizontalAlignment="Right" 
                                Margin="3 0 6 0">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="White" StrokeThickness="2"></Ellipse>
                            <Line X1="13" Y1="13" X2="18" Y2="18" Stroke="White" StrokeThickness="2"></Line>
                        </Canvas>
                        <TextBox x:Name="MENU_KEYWORD" 
                                     Height="22"
                                     Width="Auto"
                                     BorderBrush="Gray"
                                     BorderThickness="1"
                                     HorizontalContentAlignment="Left"
                                     VerticalAlignment="Top" 
                                     VerticalContentAlignment="Center"
                                     KeyDown="MENU_KEYWORD_KeyDown"
                                     Margin="3 3 0 3"
                                     TextWrapping="NoWrap">
                        </TextBox>
                    </DockPanel>
                </UserControl>
                
                <!-- 최상위 메뉴 -->
                <DockPanel DockPanel.Dock="Top">
                    <WrapPanel x:Name="PANEL_MENU_PKG" Background="WhiteSmoke" Margin="2 0 0 2">
                        <UserControl x:Name="TOP_MENU0" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown" Visibility="Hidden" Width="0" Margin="0">My메뉴</UserControl>
                        <UserControl x:Name="TOP_MENU1" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU2" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU3" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU4" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU5" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU6" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU7" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU8" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl x:Name="TOP_MENU9" Style="{DynamicResource TOP_MENU}" MouseLeftButtonDown="TOP_MENU_MouseLeftDown"></UserControl>
                        <UserControl Width="5000" Height="3"></UserControl>
                    </WrapPanel>
                </DockPanel>
                
                <!-- 하위 메뉴 -->
                <DockPanel Margin="2 0 0 2" Background="WhiteSmoke">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DockPanel>
                            <DockPanel x:Name="PANEL_MENU_SUB0" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB1" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB2" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB3" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB4" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB5" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB6" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB7" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB8" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SUB9" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                            <DockPanel x:Name="PANEL_MENU_SEARCH" Margin="0" Background="WhiteSmoke" DockPanel.Dock="Top"/>
                        </DockPanel>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <!-- 좌우 SPLITTER -->
            <!-- GridSplitter x:Name="GRID_SPLITTER" Grid.Column="1"
                          Style="{DynamicResource MainGridSpliter}"></ -->

            <!-- 우측 컨텐츠 -->
            <DockPanel Grid.Column="2" Background="#4472C4">
                <!-- 상단 타이틀 -->
                <DockPanel x:Name="DOCK_TITLE" DockPanel.Dock="Top" Style="{DynamicResource DockTitle}">
                    <UserControl x:Name="UC_MENU">
                        <Canvas x:Name="ICON_MENU" Width="24" Height="24"
                        Style="{DynamicResource MainIconMenu}" 
                        MouseUp="ICON_MENU_MouseUp">
                            <Line X1="4" Y1="6" X2="6" Y2="6" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="8" Y1="6" X2="20" Y2="6" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="4" Y1="10" X2="6" Y2="10" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="8" Y1="10" X2="20" Y2="10" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="4" Y1="14" X2="6" Y2="14" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="8" Y1="14" X2="20" Y2="14" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="4" Y1="18" X2="6" Y2="18" Stroke="White" StrokeThickness="2"></Line>
                            <Line X1="8" Y1="18" X2="20" Y2="18" Stroke="White" StrokeThickness="2"></Line>
                        </Canvas>
                    </UserControl>
                    <Canvas x:Name="ICON_LOGO" DockPanel.Dock="Left" Width="24" Height="24" 
                        Style="{DynamicResource MainIconCom}"
                        MouseLeftButtonDown="ICON_HOME_MouseUp">
                        <Line X1="4.5" Y1="12.5" X2="13" Y2="4.5" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="11.5" Y1="4.5" X2="19.5" Y2="12.5" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="4" Y1="12.5" X2="7.5" Y2="12.5" Stroke="White" StrokeThickness="2"/>
                        <Line X1="16.5" Y1="12.5" X2="20" Y2="12.5" Stroke="White" StrokeThickness="2"/>
                        <Line X1="9" Y1="12.5" X2="15" Y2="12.5" Stroke="White" StrokeThickness="2"/>
                        <Line X1="6" Y1="19" X2="10" Y2="19" Stroke="White" StrokeThickness="2"/>
                        <Line X1="14" Y1="19" X2="17" Y2="19" Stroke="White" StrokeThickness="2"/>
                        <Line X1="6.5" Y1="13" X2="6.5" Y2="20" Stroke="White" StrokeThickness="2"/>
                        <Line X1="10" Y1="13" X2="10" Y2="20" Stroke="White" StrokeThickness="2"/>
                        <Line X1="14" Y1="13" X2="14" Y2="20" Stroke="White" StrokeThickness="2"/>
                        <Line X1="17.5" Y1="13" X2="17.5" Y2="20" Stroke="White" StrokeThickness="2"/>
                    </Canvas>
                    <Canvas x:Name="ICON_CLOSE" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{DynamicResource MainIconClose}"
                        MouseLeftButtonDown="ICON_CLOSE_MouseLeftDown">
                        <Line X1="5" Y1="5" X2="19" Y2="19" Stroke="White" StrokeThickness="4"></Line>
                        <Line X1="5" Y1="19" X2="19" Y2="5" Stroke="White" StrokeThickness="4"></Line>
                    </Canvas>
                    <Canvas x:Name="ICON_MAX" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{DynamicResource MainIconCom}"
                        MouseLeftButtonDown="ICON_MAX_MouseLeftDown">
                        <Line X1="5" Y1="6" X2="5" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="19" Y1="5" X2="19" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="4" Y1="6" X2="20" Y2="6" Stroke="White" StrokeThickness="4"></Line>
                        <Line X1="4" Y1="19" X2="20" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                    </Canvas>
                    <Canvas x:Name="ICON_NOR" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{DynamicResource MainIconCom}"
                        MouseLeftButtonDown="ICON_NOR_MouseLeftDown">
                        <Line X1="8" Y1="6" X2="19" Y2="6" Stroke="White" StrokeThickness="4"/>
                        <Line X1="19" Y1="4" X2="19" Y2="15" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="9" Y1="4" X2="9" Y2="10" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="5" Y1="12" X2="5" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="15" Y1="12" X2="15" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="4" Y1="12" X2="16" Y2="12" Stroke="White" StrokeThickness="4"></Line>
                        <Line X1="4" Y1="19" X2="16" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="16" Y1="14" X2="18" Y2="14" Stroke="White" StrokeThickness="2"/>
                    </Canvas>
                    <Canvas x:Name="ICON_MIN" DockPanel.Dock="Right" Width="24" Height="24"
                        Style="{DynamicResource MainIconCom}"
                        MouseLeftButtonDown="ICON_MIN_MouseLeftDown">
                        <Line X1="4" Y1="18" X2="20" Y2="18" Stroke="White" StrokeThickness="4"></Line>
                    </Canvas>
                    <Label Visibility="Hidden" x:Name="LABEL_TIME" DockPanel.Dock="Right" Content="2016-11-26 24:12:11" VerticalAlignment="Center" Foreground="White"/>
                    <Canvas Visibility="Hidden" DockPanel.Dock="Right" Width="16" Height="16">
                        <Line X1="8" Y1="8" X2="12" Y2="8" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="8" Y1="3.5" X2="8" Y2="9" Stroke="White" StrokeThickness="2"></Line>
                        <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="2" Canvas.Top="1" Canvas.Left="1"></Ellipse>
                        <Line X1="3" Y1="16" X2="5" Y2="13" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="11" Y1="13" X2="13" Y2="16" Stroke="White" StrokeThickness="2"></Line>
                        <Ellipse Width="4" Height="4" Stroke="White" StrokeThickness="2" Canvas.Left="1"/>
                        <Ellipse Width="4" Height="4" Stroke="White" StrokeThickness="2" Canvas.Left="12"/>
                    </Canvas>

                    <Label x:Name="LABEL_TITLE" Content="" VerticalAlignment="Center" 
                           MouseLeftButtonDown="LABEL_TITLE_MouseLeftDown"
                        Foreground="White"></Label>

                </DockPanel>

                <!-- 공지메뉴바 -->
                <DockPanel x:Name="DOCK_STATE" DockPanel.Dock="Bottom"
                   Style="{DynamicResource DockBar}">
                    <Button x:Name="button3" Content="Button" HorizontalAlignment="Right" Width="55"/>
                    <Button x:Name="button3_Copy" Content="Button" HorizontalAlignment="Right" Width="55"/>
                </DockPanel>

                <!-- TAB 컨트롤 -->
                <DockPanel x:Name="DOCK_CONTENT" Style="{DynamicResource DockContent}">
                    <dx:DXTabControl x:Name="TAB_MAIN" Margin="0 2 0 0" 
                                    TabRemoving="TAB_MAIN_TabRemoving"
                                    TabRemoved="TAB_MAIN_TabRemoved">
                        <dx:DXTabControl.View>
                            <dx:TabControlMultiLineView HeaderLocation="Top"
                                                    HideButtonShowMode="InAllTabs"
                                                    RemoveTabItemsOnHiding="True"
                                                    ShowVisibleTabItemsInHeaderMenu="True"/>
                        </dx:DXTabControl.View>
                    </dx:DXTabControl>
                </DockPanel>
                
            </DockPanel>
            
            <!-- 환경설정 ( 비밀번호 변경 ) -->
            <Popup IsOpen="False" StaysOpen="True" Width="220"
                   PlacementTarget="{Binding ElementName=DOCK_TITLE}"
                   HorizontalOffset="200"
                   VerticalOffset="200"
                   Placement="Bottom">
                <its:PopContent 
                    x:Name="POP_CONFIG"
                    IconType="Config" 
                    Title="환경설정 ( 비밀번호 변경 )" 
                    TitleColor="Black">
                    <StackPanel>
                        <its:Text Label="사원코드" x:Name="CONFIG_EMPCD" ReadOnly="True"></its:Text>
                        <its:Text Label="사원명" x:Name="CONFIG_EMPNM" ReadOnly="True"></its:Text>
                        <its:Text Label="로그인ID" x:Name="CONFIG_USERID" ReadOnly="True"></its:Text>
                        <UserControl Height="1" Margin="0 3 0 0" Background="Black"></UserControl>
                        <DockPanel DockPanel.Dock="Top" Margin="5">
                            <TextBlock FontSize="12" 
                                           Margin="0 0 5 0"
                                           Width="75"
                                           TextWrapping="Wrap"
                                           DockPanel.Dock="Left"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center">기존비번</TextBlock>
                            <PasswordBox FontSize="12" x:Name="CONFIG_OLDPASS"
                                             VerticalContentAlignment="Center"
                                             Height="22"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="5 0 5 5">
                            <TextBlock FontSize="12" 
                                           Margin="0 0 5 0"
                                           Width="75"
                                           TextWrapping="Wrap"
                                           DockPanel.Dock="Left"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center">신규비번</TextBlock>
                            <PasswordBox FontSize="12" x:Name="CONFIG_NEWPASS"
                                             VerticalContentAlignment="Center"
                                             PreviewKeyDown="CONFIG_NEWPASS_PreviewKeyDown"
                                             Height="22"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="5 0 5 5">
                            <TextBlock FontSize="12" 
                                           Margin="0 0 5 0"
                                           Width="75"
                                           TextWrapping="Wrap"
                                           DockPanel.Dock="Left"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center">확인비번</TextBlock>
                            <PasswordBox FontSize="12" x:Name="CONFIG_CHKPASS"
                                             VerticalContentAlignment="Center"
                                             Height="22"/>
                        </DockPanel>
                        <its:Button x:Name="CONFIG_SAVE" CommandName="MAIN_CONFIG_SAVE" Height="35" Label="저장"></its:Button>
                    </StackPanel>
                </its:PopContent>
            </Popup>
        </Grid>
     </DockPanel>
</Window>
