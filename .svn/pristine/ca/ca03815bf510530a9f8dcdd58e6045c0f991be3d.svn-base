<its:ItsPageOffice x:Class="SYS0103.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0103"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">
    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <its:Text Label="테이블코드" Value="{Binding TABLECD}"/>
                <its:Text Label="테이블명" Value="{Binding TABLENM}"/>
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <UserControl Style="{DynamicResource GRID}" Grid.Column="0">
                <its:Grid x:Name="GRID_G1">
                    <its:Grid.Columns>
                        <!-- ################################# COLUMN FLEX: START -->
                        <its:Column Width="100" Header="테이블코드" FieldName="TABLECD"/>
                        <its:Column Width="100" Header="테이블명" FieldName="TABLENM"/>
                        <!-- ################################# COLUMN FLEX: END -->
                    </its:Grid.Columns>
                </its:Grid>
            </UserControl>
            <GridSplitter Grid.Column="1"/>
            <UserControl Style="{DynamicResource GRID}" Grid.Column="2">
                <its:Grid x:Name="GRID_G2">
                    <its:Grid.Columns>
                        <!-- ################################# COLUMN FLEX: START -->
                        <its:Column Width="100" Header="컬럼명" FieldName="COLUMNNM"/>
                        <its:Column Width="100" Header="컬럼타입" FieldName="COLUMNTYPE"/>
                        <its:Column Width="100" Header="컬럼길이" FieldName="COLUMNLENGTH"/>
                        <!-- ################################# COLUMN FLEX: END -->
                    </its:Grid.Columns>
                </its:Grid>
            </UserControl>
        </Grid>
    </DockPanel>
</its:ItsPageOffice>
