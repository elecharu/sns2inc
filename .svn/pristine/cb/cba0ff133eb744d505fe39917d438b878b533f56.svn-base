<UserControl x:Class="ITSLIB.Pass"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             Height="28" MinHeight="28" MaxHeight="28"
             Width="200" MinWidth="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="KEY_Black" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="7" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_SeaGreen" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="7" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_SteelBlue" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Background" Value="SteelBlue"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="7" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_IndianRed" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Background" Value="IndianRed"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="4" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ICON_KEYPAD" TargetType="{x:Type UserControl}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Silver"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Popup x:Name="keypop" 
                   StaysOpen="True"
                   PlacementTarget="{Binding ElementName=Text}">
            <DockPanel Background="Silver">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="1" />
                            <Label Style="{DynamicResource KEY_Black}" Content="2" />
                            <Label Style="{DynamicResource KEY_Black}" Content="3" />
                            <Label Style="{DynamicResource KEY_Black}" Content="4" />
                            <Label Style="{DynamicResource KEY_Black}" Content="5" />
                            <Label Style="{DynamicResource KEY_Black}" Content="6" />
                            <Label Style="{DynamicResource KEY_Black}" Content="7" />
                            <Label Style="{DynamicResource KEY_Black}" Content="8" />
                            <Label Style="{DynamicResource KEY_Black}" Content="9" Width="18"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="A" />
                            <Label Style="{DynamicResource KEY_Black}" Content="B" />
                            <Label Style="{DynamicResource KEY_Black}" Content="C" />
                            <Label Style="{DynamicResource KEY_Black}" Content="D" />
                            <Label Style="{DynamicResource KEY_Black}" Content="E" />
                            <Label Style="{DynamicResource KEY_Black}" Content="F" />
                            <Label Style="{DynamicResource KEY_Black}" Content="G" />
                            <Label Style="{DynamicResource KEY_SeaGreen}" Content="삭제"  />
                            <Label Style="{DynamicResource KEY_Black}" Content="0" Width="18"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="H" />
                            <Label Style="{DynamicResource KEY_Black}" Content="I" />
                            <Label Style="{DynamicResource KEY_Black}" Content="J" />
                            <Label Style="{DynamicResource KEY_Black}" Content="K" />
                            <Label Style="{DynamicResource KEY_Black}" Content="L" />
                            <Label Style="{DynamicResource KEY_Black}" Content="M" />
                            <Label Style="{DynamicResource KEY_Black}" Content="N" />
                            <Label Style="{DynamicResource KEY_SeaGreen}" Content="전부삭제" Width="42"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="O" />
                            <Label Style="{DynamicResource KEY_Black}" Content="P" />
                            <Label Style="{DynamicResource KEY_Black}" Content="Q" />
                            <Label Style="{DynamicResource KEY_Black}" Content="R" />
                            <Label Style="{DynamicResource KEY_Black}" Content="S" />
                            <Label Style="{DynamicResource KEY_Black}" Content="T" />
                            <Label Style="{DynamicResource KEY_Black}" Content="U" />
                            <Label Style="{DynamicResource KEY_SeaGreen}" Content="공백" Width="42" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 2 2">
                            <Label Style="{DynamicResource KEY_Black}" Content="V" />
                            <Label Style="{DynamicResource KEY_Black}" Content="W" />
                            <Label Style="{DynamicResource KEY_Black}" Content="X" />
                            <Label Style="{DynamicResource KEY_Black}" Content="Y" />
                            <Label Style="{DynamicResource KEY_Black}" Content="Z" />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="◀" Width="22" Height="12"/>
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="▶" Width="22" Height="12"/>
                            <Label Style="{DynamicResource KEY_IndianRed}" Content="✖" Width="42" Height="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Popup>
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap" 
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="DotumChe" />
        <TextBlock DockPanel.Dock="Right" 
                   x:Name="textUnit"
                   TextWrapping="Wrap" 
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
        <PasswordBox
            DockPanel.Dock="Right"
                 x:Name="passBox" 
                 Height="22"
                 BorderBrush="Gray"
                 BorderThickness="1"
                 VerticalAlignment="Center" 
                 VerticalContentAlignment="Center"
                 Margin="3"
                 PasswordChanged="passBox_TextChanged"
                 PreviewMouseDown="passBox_PreviewMouseDown"
                 MouseDoubleClick="passBox_MouseDoubleClick"
                 KeyDown="passBox_KeyDown"
                 GotFocus="passBox_GotFocus"
                 LostFocus="passBox_LostFocus" FontFamily="DotumChe">
        </PasswordBox>
    </DockPanel>
</UserControl>
