<%@ Control Language="C#" AutoEventWireup="true" CodeFile="ItsImage.ascx.cs" Inherits="ItsImage" %>
<!-- image -->
<div style="width:<%= _WIDTH %>px;height:<%= _HEIGHT %>px;line-height:<%= _HEIGHT %>px; text-align:center; <% if (_SCROLL == "false") { %>overflow:hidden; <% } %>">
    <img <% if (_ID != "") { %>id="<%= _ID %>" <% } %> 
        style ="max-width: 100%; max-height: 100%; vertical-align:middle;" 
        src="../../UploadFiles/404IMAGE.jpg" 
        class="ItsImage" />
</div>