<?xml version="1.0" encoding="UTF-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <httpRuntime requestValidationMode="2.0"/>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="WindowsBase, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <pages validateRequest="false">
      <controls>
        <add tagPrefix="Its" tagName="div" src="~/UserControl/ItsDiv.ascx"></add>
        <add tagPrefix="Its" tagName="grid" src="~/UserControl/ItsGrid.ascx"></add>
        <add tagPrefix="Its" tagName="newline" src="~/UserControl/ItsNewLine.ascx"></add>
        <add tagPrefix="Its" tagName="text" src="~/UserControl/ItsText.ascx"></add>
        <add tagPrefix="Its" tagName="combo" src="~/UserControl/ItsCombo.ascx"></add>
        <add tagPrefix="Its" tagName="button" src="~/UserControl/ItsButton.ascx"></add>
        <add tagPrefix="Its" tagName="split" src="~/UserControl/ItsSplit.ascx"></add>
        <add tagPrefix="Its" tagName="pop" src="~/UserControl/ItsPop.ascx"></add>
        <add tagPrefix="Its" tagName="tab" src="~/UserControl/ItsTab.ascx"></add>
        <add tagPrefix="Its" tagName="rptViewer" src="~/UserControl/ItsRptViewer.ascx"></add>
        <add tagPrefix="Its" tagName="img" src="~/UserControl/ItsImage.ascx"></add>
        <add tagPrefix="Its" tagName="fileManager" src="~/UserControl/ItsFileManager.ascx"></add>
        <add tagPrefix="Its" tagName="date" src="~/UserControl/ItsDate.ascx"></add>
        <add tagPrefix="Its" tagName="dateRange" src="~/UserControl/ItsDateRange.ascx"></add>
	      <add tagPrefix="Its" tagName="month" src="~/UserControl/ItsMonth.ascx"></add>
        <add tagPrefix="Its" tagName="num" src="~/UserControl/ItsNum.ascx"></add>
        <add tagPrefix="Its" tagName="find" src="~/UserControl/ItsFind.ascx"></add>
        <add tagPrefix="Its" tagName="display" src="~/UserControl/ItsDisplay.ascx"></add>
        <add tagPrefix="Its" tagName="onoff" src="~/UserControl/ItsOnoff.ascx"></add>
        <add tagPrefix="Its" tagName="textarea" src="~/UserControl/ItsTextArea.ascx"></add>
        <add tagPrefix="Its" tagName="TaxfileManager" src="~/UserControl/ItsTaxFileManager.ascx"></add>
        <add tagPrefix="Its" tagName="Radio" src="~/UserControl/ItsRadio.ascx"></add>
        <add tagPrefix="Its" tagName="check" src="~/UserControl/ItsCheck.ascx"></add>
        <add tagPrefix="Its" tagName="label" src="~/UserControl/ItsLabel.ascx"></add>
      </controls>
    </pages>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>