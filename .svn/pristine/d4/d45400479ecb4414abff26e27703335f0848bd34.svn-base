<UserControl x:Class="ITSLIB.Date"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             MinHeight="28" MaxHeight="28" Height="28"
             Width="200" MinWidth="100">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap" 
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="Fonts/#Roboto Medium.ttf"/>
        <Grid DockPanel.Dock="Left">
            <dxe:DateEdit x:Name="dateEdit"
                          DisplayFormatString="yyyy-MM-dd"
                          Mask="yyyy-MM-dd"
                          Margin="3"
                          Height="22"
                          EditValueChanged="dateEdit_EditValueChanged"
                          GotFocus="dateEdit_GotFocus" ShowEditorButtons="False"
                          LostFocus="dateEdit_LostFocus" FontFamily="Fonts/#Roboto Medium.ttf"/>
            <!--<Line X1="100" Y1="4" X2="100" Y2="24" Stroke="#C6C6C6" StrokeThickness="1"></Line>-->

            <UserControl Width="20" Height="20" Background="Transparent" Margin="0,4,4,4"
                         HorizontalAlignment="Right">
                <Canvas x:Name="canvas" Margin="1" 
                    Width="18" 
                    Height="18" 
                    Background="White" 
                    MouseUp="canvas_MouseUp"                    
                        >
                    <Canvas Width="16" Height="16" Margin="1">
                        <!--<Canvas.Background>
                            <ImageBrush ImageSource="../Images/HNS_field_ic_calender_n.png"/>
                        </Canvas.Background>-->
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Style.Triggers>
                                    <Trigger Property="Canvas.IsMouseOver"  Value="true">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Grid>
                                                            <Rectangle Fill="#262938" />
                                                            <Image Source="../Images/HNS_field_ic_calender_p.png" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="Canvas.IsMouseOver"  Value="false">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="../Images/HNS_field_ic_calender_n.png"  Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="Canvas.IsEnabled"  Value="false">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="../Images/HNS_field_ic_calender_d.png"  Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <!--<Line X1="0" Y1="3" X2="16" Y2="3" Stroke="#2E2E2E" StrokeThickness="2.5"></Line>
                        <Line X1="1" Y1="2" X2="1" Y2="15" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="15" Y1="2" X2="15" Y2="15" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="0" Y1="15" X2="16" Y2="15" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="5" Y1="0" X2="5" Y2="4" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="11" Y1="0" X2="11" Y2="4" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="1" Y1="4" X2="15" Y2="4" Stroke="#2E2E2E" StrokeThickness="2.5"></Line>
                        <Line X1="11" Y1="0" X2="11" Y2="4" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="3.5" Y1="8" X2="5.5" Y2="8" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="7" Y1="8" X2="9" Y2="8" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="10.5" Y1="8" X2="12.5" Y2="8" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="3.5" Y1="11.5" X2="5.5" Y2="11.5" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="7" Y1="11.5" X2="9" Y2="11.5" Stroke="#2E2E2E" StrokeThickness="2"></Line>
                        <Line X1="10.5" Y1="11.5" X2="12.5" Y2="11.5" Stroke="#2E2E2E" StrokeThickness="2"></Line>-->
                    </Canvas>
                </Canvas>
            </UserControl>
        </Grid>
    </DockPanel>
</UserControl>
