/* @section: design-system */
:root {
    color-scheme: dark;
    --bg: #0b1018;
    --bg-deep: #080c12;
    --surface: #141b26;
    --surface-raised: #182231;
    --surface-soft: #111822;
    --border: #273447;
    --border-soft: #1e2a3a;
    --text: #f3f6fa;
    --text-soft: #cbd3de;
    --muted: #8f9bac;
    --accent: #67c487;
    --accent-strong: #79d397;
    --accent-soft: rgba(103, 196, 135, 0.12);
    --danger: #db7a7e;
    --warning: #d0a15e;
    --track: #394354;
    --radius: 8px;
    --radius-small: 5px;
    --font: "Pretendard", "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
    /* theme-sensitive component tokens */
    --shell-glow: rgba(92, 133, 178, 0.08);
    --shell-grad-top: #0d121b;
    --card-grad-1: rgba(25, 35, 49, .96);
    --card-grad-2: rgba(19, 27, 39, .98);
    --panel-grad-1: rgba(22, 30, 43, .97);
    --panel-grad-2: rgba(16, 23, 34, .98);
    --panel-shadow: rgba(0, 0, 0, .13);
    --order-grad-1: rgba(23, 32, 46, .98);
    --order-grad-2: rgba(17, 24, 35, .98);
    --order-hover-border: #3a4d63;
    --order-hover-grad-1: rgba(26, 36, 51, .99);
    --order-hover-grad-2: rgba(19, 27, 39, .99);
    --order-header-wash: rgba(255, 255, 255, .012);
    --thead-bg: rgba(40, 56, 75, .94);
    --row-alt: rgba(255, 255, 255, .012);
    --row-hover: rgba(103, 196, 135, .055);
    --grid-line: rgba(151, 166, 185, .19);
    --chip-border: rgba(103, 196, 135, .28);
    --chip-text: #9eddb4;
    --dd-bg: rgba(5, 10, 17, .34);
    --donut-center: #141c28;
    --donut-ring: rgba(255, 255, 255, .025);
    --bar-grad-2: #4ca96d;
}

    :root[data-theme="light"] {
        color-scheme: light;
        --bg: #eef1f6;
        --bg-deep: #e4e8ef;
        --surface: #ffffff;
        --surface-raised: #ffffff;
        --surface-soft: #f5f7fa;
        --border: #d8dee6;
        --border-soft: #e1e6ed;
        --text: #1b2430;
        --text-soft: #4a5568;
        --muted: #74808f;
        --accent: #2f9e63;
        --accent-strong: #247a4c;
        --accent-soft: rgba(47, 158, 99, 0.12);
        --danger: #c94b50;
        --warning: #b9791f;
        --track: #e2e6ec;
        --shell-glow: rgba(59, 130, 246, 0.06);
        --shell-grad-top: #f4f6fa;
        --card-grad-1: rgba(255, 255, 255, .98);
        --card-grad-2: rgba(246, 248, 251, .98);
        --panel-grad-1: rgba(255, 255, 255, .98);
        --panel-grad-2: rgba(248, 250, 252, .98);
        --panel-shadow: rgba(15, 23, 42, .08);
        --order-grad-1: rgba(255, 255, 255, .98);
        --order-grad-2: rgba(248, 250, 252, .98);
        --order-hover-border: #c3ccd9;
        --order-hover-grad-1: rgba(255, 255, 255, 1);
        --order-hover-grad-2: rgba(243, 246, 250, 1);
        --order-header-wash: rgba(15, 23, 42, .02);
        --thead-bg: #eaf0f7;
        --row-alt: rgba(15, 23, 42, .03);
        --row-hover: rgba(47, 158, 99, .08);
        --grid-line: rgba(100, 116, 139, .22);
        --chip-border: rgba(47, 158, 99, .35);
        --chip-text: #1f7a4d;
        --dd-bg: rgba(15, 23, 42, .045);
        --donut-center: #ffffff;
        --donut-ring: rgba(15, 23, 42, .08);
        --bar-grad-2: #2f8f5c;
    }

* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    min-width: 320px;
    min-height: 100%;
    background: var(--bg);
}

body {
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    transition: background-color .2s ease, color .2s ease;
}

svg {
    display: block;
}

/* @section: monitoring-shell */
.monitoring-shell {
    width: 100%;
    min-height: 100vh;
    padding: clamp(16px, 1.55vw, 30px) clamp(18px, 2.05vw, 40px) clamp(18px, 2vw, 34px);
    background: radial-gradient(circle at 55% -20%, var(--shell-glow), transparent 36%), linear-gradient(180deg, var(--shell-grad-top) 0%, var(--bg) 42%, var(--bg-deep) 100%);
    transition: background-color .2s ease;
}

/* @section: top-header */
.top-header {
    height: 60px;
    display: grid;
    grid-template-columns: 156px minmax(630px, 1fr) 350px;
    align-items: center;
    gap: 28px;
    margin-bottom: 22px;
}

.brand {
    position: relative;
    width: 112px;
    height: 58px;
    text-align: center;
    filter: drop-shadow(0 7px 10px rgba(0, 0, 0, .35));
}

    .brand::before {
        content: "";
        position: absolute;
        inset: 8px 8px 3px;
        border-radius: 50%;
        background: linear-gradient(160deg, #285f9c 0%, #153866 76%);
        border: 1px solid rgba(126, 182, 232, .45);
        transform: perspective(70px) rotateX(16deg);
    }

.brand-arc {
    position: relative;
    z-index: 1;
    color: #f5f8fc;
    font-size: 16px;
    line-height: 20px;
    font-weight: 800;
    letter-spacing: .08em;
    transform: rotate(-8deg);
    text-shadow: 0 1px 3px #000;
}

.brand-core {
    position: relative;
    z-index: 1;
    margin-top: 5px;
    color: #fff;
    font-size: 19px;
    font-weight: 900;
    font-style: italic;
    letter-spacing: .03em;
    text-shadow: 0 2px 4px #06111f;
}

.kpi-group {
    height: 60px;
    display: grid;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 12px;
}

.kpi-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 0 20px;
    background: linear-gradient(135deg, var(--card-grad-1), var(--card-grad-2));
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
}

    .kpi-card::after {
        content: "";
        position: absolute;
        left: 0;
        top: 12px;
        bottom: 12px;
        width: 3px;
        border-radius: 0 2px 2px 0;
        background: var(--accent);
        opacity: .9;
    }

.kpi-label {
    padding-left: 4px;
    color: var(--text-soft);
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
}

.kpi-value {
    min-width: 110px;
    padding: 8px 13px;
    border-radius: var(--radius-small);
    color: var(--text);
    font-size: 18px;
    font-weight: 750;
    text-align: right;
    letter-spacing: .02em;
}

.datetime {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 15px;
    color: var(--text-soft);
    font-size: 21px;
    font-weight: 650;
    white-space: nowrap;
}

.search-icon {
    width: 25px;
    height: 25px;
    stroke: var(--text);
    stroke-width: 1.8;
    fill: none;
    cursor: pointer;
}

.theme-toggle {
    position: relative;
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
}

.theme-icon {
    grid-area: 1 / 1;
    width: 21px;
    height: 21px;
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition: opacity .18s ease, transform .18s ease;
}

.theme-icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(.6);
}

:root[data-theme="light"] .theme-icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(.6);
}

:root[data-theme="light"] .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
}

/* @section: common-section-heading */
.dashboard-section, .orders-section {
    min-width: 0;
}

.section-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 34px;
    margin-bottom: 10px;
}

    .section-heading h1, .section-heading h2 {
        margin: 0;
        color: var(--text);
        font-size: 20px;
        line-height: 1;
        font-weight: 720;
        letter-spacing: -.02em;
        white-space: nowrap;
    }

.section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
}

/* @section: quality-overview */
.quality-grid {
    display: grid;
    grid-template-columns: minmax(560px, .84fr) minmax(850px, 1.16fr);
    align-items: start;
    gap: 26px;
    margin-bottom: 18px;
}

.defect-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.chart-panel, .table-panel {
    height: 350px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--panel-grad-1), var(--panel-grad-2));
    box-shadow: 0 12px 30px var(--panel-shadow);
}

.defect-section .table-panel {
    height: 146px;
}

.downtime-table-panel {
    height: 146px;
}

/* @section: defect-chart */
.chart-panel {
    display: grid;
    grid-template-columns: 38px 1fr;
    padding: 24px 28px 20px 18px;
}

.y-axis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 10px 46px 0;
    color: var(--muted);
    font-size: 15px;
}

.plot-area {
    position: relative;
    min-width: 0;
}

.grid-lines {
    position: absolute;
    inset: 0 0 46px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

    .grid-lines i {
        height: 1px;
        background: var(--grid-line);
    }

.bars {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--bar-count, 7), minmax(0, 1fr));
    gap: clamp(6px, calc(140px / var(--bar-count, 7)), 22px);
    align-items: stretch;
}

.bar-item {
    min-width: 0;
    display: grid;
    grid-template-rows: 1fr 40px;
    row-gap: 6px;
    align-items: end;
    text-align: center;
}

.bar-track {
    position: relative;
    height: 100%;
}

.bar {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: clamp(10px, calc(196px / var(--bar-count, 7)), 28px);
    height: var(--value);
    min-height: 2px;
    transform: translateX(-50%);
    border-radius: 4px 4px 1px 1px;
    background: linear-gradient(180deg, var(--accent-strong), var(--bar-grad-2));
    box-shadow: 0 0 18px var(--accent-soft);
}

    .bar::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(90deg, rgba(255,255,255,.08), transparent 46%);
    }

    .bar span {
        position: absolute;
        left: 50%;
        top: -21px;
        transform: translateX(-50%);
        color: var(--text-soft);
        font-size: 13px;
        font-style: normal;
    }
    /* .bar-item:hover .bar span { opacity: 1; } */
    .bar.is-zero {
        background: var(--track);
        box-shadow: none;
    }

.bar-item em {
    align-self: start;
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1.2;
    font-style: normal;
    white-space: normal;
    word-break: break-all;
    padding-top: 2px;
}

/* @section: defect-table */
.table-panel {
    padding: 0;
}

table {
    width: 100%;
    height: 100%;
    table-layout: fixed;
    border-collapse: collapse;
}

thead {
    background: var(--thead-bg);
    box-shadow: inset 0 3px 0 var(--accent);
}

th {
    height: 34px;
    padding: 0 8px;
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
}

tbody tr {
    border-bottom: 1px solid var(--border-soft);
    transition: background .18s ease;
}

    tbody tr:nth-child(even) {
        background: var(--row-alt);
    }

    tbody tr:hover {
        background: var(--row-hover);
    }

td {
    height: 27px;
    overflow: hidden;
    padding: 0 8px;
    color: var(--text-soft);
    font-size: 14px;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.defect-table td {
    font-size: 15px;
}

    .defect-table th:nth-child(1), .defect-table td:nth-child(1) {
        width: 5%;
    }

    .defect-table th:nth-child(2), .defect-table td:nth-child(2) {
        width: 9%;
    }

    .defect-table th:nth-child(3), .defect-table td:nth-child(3) {
        width: 11%;
    }

    .defect-table th:nth-child(4), .defect-table td:nth-child(4) {
        width: 14%;
    }

    .defect-table th:nth-child(5), .defect-table td:nth-child(5) {
        width: 23%;
    }

    .defect-table th:nth-child(6), .defect-table td:nth-child(6) {
        width: 7%;
    }

    .defect-table th:nth-child(7), .defect-table td:nth-child(7) {
        width: 12%;
    }

    .defect-table th:nth-child(8), .defect-table td:nth-child(8) {
        width: 8%;
    }

    .defect-table th:nth-child(9), .defect-table td:nth-child(9) {
        width: 8%;
    }

.number {
    font-weight: 750;
    color: var(--text);
    text-align: right;
    padding-right: 22px;
}

.process-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 21px;
    padding: 0 8px;
    border: 1px solid var(--chip-border);
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--chip-text);
    font-size: 13px;
}

/* @section: downtime-table */
.downtime-table td {
    font-size: 15px;
}

    .downtime-table th:nth-child(1), .downtime-table td:nth-child(1) {
        width: 8%;
    }

    .downtime-table th:nth-child(2), .downtime-table td:nth-child(2) {
        width: 22%;
    }

    .downtime-table th:nth-child(3), .downtime-table td:nth-child(3) {
        width: 28%;
    }

    .downtime-table th:nth-child(4), .downtime-table td:nth-child(4) {
        width: 27%;
    }

    .downtime-table th:nth-child(5), .downtime-table td:nth-child(5) {
        width: 15%;
    }

/* @section: order-list */
.orders-heading {
    margin-bottom: 10px;
}

.orders-nav {
    display: flex;
    align-items: center;
    gap: 6px;
}

.orders-nav-btn {
    position: relative;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
    background: var(--surface-soft);
    color: var(--text);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
}

    .orders-nav-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

.orders-nav-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    margin-left: 4px;
    padding: 0 12px;
    border: 1px solid var(--border-soft);
    border-radius: 13px;
    background: var(--surface-soft);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
}

.orders-nav-current {
    color: var(--accent);
    font-style: normal;
    font-weight: 750;
}

.orders-nav-sep {
    margin: 0 3px;
    color: var(--muted);
    font-style: normal;
}

.orders-nav-total {
    color: var(--muted);
    font-style: normal;
    font-weight: 600;
}

.nav-icon {
    grid-area: 1 / 1;
    width: 12px;
    height: 12px;
    fill: currentColor;
}

.orders-nav-btn .icon-play {
    display: none;
}

.orders-nav-btn:not(.is-playing) .icon-pause {
    display: none;
}

.orders-nav-btn:not(.is-playing) .icon-play {
    display: block;
}

.orders-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(245px, 1fr));
    gap: 12px;
}

.order-card {
    height: 228px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    background: linear-gradient(145deg, var(--order-grad-1), var(--order-grad-2));
    transition: transform .18s ease, border-color .18s ease, background .18s ease;
}

    .order-card:hover {
        transform: translateY(-2px);
        border-color: var(--order-hover-border);
        background: linear-gradient(145deg, var(--order-hover-grad-1), var(--order-hover-grad-2));
    }

    .order-card header {
        height: 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        padding: 9px 14px 8px;
        border-bottom: 1px solid var(--border-soft);
        background: var(--order-header-wash);
    }

    .order-card h3 {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        color: var(--text);
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -.01em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-card p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

.order-body {
    height: 168px;
    display: grid;
    grid-template-columns: 112px 1fr;
    align-items: center;
    gap: 10px;
    padding: 12px 13px 13px;
}

.donut {
    --size: 92px;
    position: relative;
    width: var(--size);
    height: var(--size);
    margin: auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: conic-gradient(var(--accent) calc(var(--progress) * 1%), var(--track) 0);
    transform: rotate(-90deg);
}

    .donut::before {
        content: "";
        position: absolute;
        inset: 11px;
        border-radius: 50%;
        background: var(--donut-center);
        box-shadow: inset 0 0 0 1px var(--donut-ring);
    }

    .donut span {
        position: relative;
        z-index: 1;
        transform: rotate(90deg);
        color: var(--text);
        font-size: 22px;
        font-weight: 750;
    }

    .donut small {
        margin-left: 1px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 650;
    }

dl {
    margin: 0;
    display: grid;
    gap: 7px;
}

    dl > div {
        min-width: 0;
        display: grid;
        grid-template-columns: 72px 1fr;
        align-items: center;
        gap: 7px;
    }

dt {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
}

dd {
    min-width: 0;
    height: 27px;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 10px;
    border-radius: 4px;
    background: var(--dd-bg);
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
}

    dd.accent-value {
        color: var(--chip-text);
        background: var(--accent-soft);
    }

/* @section: responsive-layout */
@media (max-width: 1500px) {
    .top-header {
        grid-template-columns: 118px minmax(560px, 1fr) 290px;
        gap: 18px;
    }

    .datetime {
        font-size: 18px;
    }

    .quality-grid {
        grid-template-columns: minmax(460px, .75fr) minmax(720px, 1.25fr);
        gap: 16px;
    }

    .orders-grid {
        gap: 9px;
    }

    .order-card {
        height: 228px;
    }

    .order-body {
        grid-template-columns: 96px 1fr;
        padding-inline: 10px;
    }

    .donut {
        --size: 80px;
    }

    dl > div {
        grid-template-columns: 64px 1fr;
        gap: 5px;
    }
}

@media (max-width: 1180px) {
    .monitoring-shell {
        padding: 18px;
    }

    .top-header {
        height: auto;
        grid-template-columns: 110px 1fr;
    }

    .kpi-group {
        order: 3;
        grid-column: 1 / -1;
    }

    .datetime {
        justify-self: end;
    }

    .quality-grid {
        grid-template-columns: 1fr;
    }

    .chart-panel, .table-panel {
        height: 340px;
    }

    .downtime-table-panel {
        height: 176px;
    }

    .orders-grid {
        grid-template-columns: repeat(2, minmax(280px, 1fr));
    }
}

@media (max-width: 680px) {
    .monitoring-shell {
        padding: 14px;
    }

    .top-header {
        grid-template-columns: 82px 1fr;
        gap: 12px;
        margin-bottom: 20px;
    }

    .brand {
        transform: scale(.78);
        transform-origin: left center;
    }

    .datetime {
        gap: 7px;
        font-size: 14px;
    }

    .search-icon {
        width: 18px;
        height: 18px;
    }

    .kpi-group {
        height: auto;
        grid-template-columns: 1fr;
    }

    .kpi-card {
        height: 54px;
    }

    .quality-grid {
        gap: 18px;
    }

    .chart-panel {
        height: 310px;
        padding-inline: 10px;
    }

    .bars {
        gap: 4px;
    }

    .bar-item em {
        font-size: 12px;
    }

    .table-panel {
        overflow-x: auto;
    }

    .defect-table {
        min-width: 900px;
    }

    .downtime-table {
        min-width: 480px;
    }

    .orders-grid {
        grid-template-columns: 1fr;
    }

    .order-card {
        height: 228px;
    }

    .order-body {
        grid-template-columns: 112px 1fr;
    }

    .donut {
        --size: 88px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        scroll-behavior: auto !important;
        transition: none !important;
    }
}
