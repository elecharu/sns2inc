<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.S01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="900" Height="480">
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="900" Height="60">
                <its:Date Label="납기일자" Width="180" Value="{Binding SDATE}"/>
                <its:Date HidenLabel="Y" Width="100"  Value="{Binding EDATE}"/>
                <its:Pop GPCD="CUSTCD" Width="250" Label="거래처" Value="{Binding CUSTCD}" ShowKeyPad="True" x:Name="pop_CUSTCD"/>
                <its:Pop GPCD="ITEMID" Width="250" Label="품목" Value="{Binding ITEMID}" ShowKeyPad="True" />
                <its:Text Label="거래명세서" Value="{Binding INVOICEKEY}"/>
                <its:Button Label="조 회" Width="100" Height="30" CommandName="LIST_INVOICE" FontWeight="Bold"/>
                <its:Button Label="납 품 취 소" Width="100" Height="30" CommandName="DEL_INVOICE" FontWeight="Bold" BackColor="RED"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="60">
            <its:Grid x:Name="GRID_G1" Width="900" Height="420">
                <its:Grid.Columns>
                    <its:Column Width="50" Header="선택" CellType="Check" IsRowCheck="True"/>
                    <its:Column Width="100" Header="거래명세서 번호" FieldName="INVOICEKEY"/>
                    <its:Column Width="80" Header="납품일자" FieldName="INVOICEDATE" ALGIN="center"/>
                    <its:Column Width="100" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                    <its:Column Width="100" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="130" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="130" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="130" Header="업체" FieldName="CUSTCD"/>
                    <its:Column Width="100" Header="로트번호" FieldName="LOTKEY"/>
                    <its:Column Width="100" DecimalPoint="0" Header="로트수량" FieldName="LOTQTY"/>
                    <its:Column Width="80" Header="S&amp;S INC 2공장 입고일자" FieldName="MTRINTIME" ALGIN="center"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Canvas.Left="100" Canvas.Top="30" Style="{DynamicResource TML_POP}" Width="700" Height="400" Visibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <its:WrapContent x:Name="PANEL_A1">
                    <its:Text Label="거래명세번호" Value="{Binding INVOICEKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주키" Value="{Binding MTRODRKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주상세키" Value="{Binding MTRODRSEQ}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="출고일자" Value="{Binding OUTDATE}" ReadOnly="True"/>
                    <TextBlock Text="▶▶▶" Width="280" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16"/>
                    <its:Text Label="입고일자" Value="{Binding INDATE}" ReadOnly="True"/>
                    <its:Text Label="출고처" Value="{Binding OUTCUSTCD}" ReadOnly="True"/>
                    <UserControl Width="280"/>
                    <its:Text Label="입고처" Value="{Binding INCUSTCD}" ReadOnly="True"/>
                </its:WrapContent>

                <its:WrapContent Grid.Row="1" >
                    <its:Grid x:Name="GRID_G2" Height="250" Width="695">
                        <its:Column FieldName="ITEMCD" Width="120" Header="품목코드" ALGIN="Center"/>
                        <its:Column FieldName="ITEMNM" Width="200" Header="품명" ALGIN="Center"/>
                        <its:Column FieldName="LOTKEY" Width="120" Header="로트번호" ALGIN="Center"/>
                        <its:Column FieldName="LOTQTY" Width="120" Header="로트수량" ALGIN="Center"/>
                        <its:Column FieldName="LOTTP"  Width="100" Header="로트구분" ALGIN="Center"/>
                    </its:Grid>
                </its:WrapContent>

                <its:WrapContent Grid.Row="2" x:Name="PANEL_A2" >
                    <UserControl Width="220"/>
                    <its:Button Label="거래명세표 출력" CommandName="MTRCUST_INVOICE_PRINT" FontWeight="Bold" Height="50" Width="100" BackColor="GREEN"/>
                    <UserControl Width="50"/>
                    <its:Button Label="납품 취소" CommandName="MTRCUST_INVOICE_CANCEL" FontWeight="Bold" Height="50" Width="100" BackColor="RED"/>
                </its:WrapContent>
            </Grid>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
