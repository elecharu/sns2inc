        private DevExpress.XtraReports.UI.XRTableCell CreateCatCell(string text, int rowSpan)
        {
            DevExpress.XtraReports.UI.XRTableCell catCell = new DevExpress.XtraReports.UI.XRTableCell();
            catCell.Dpi = 100F;
            catCell.Font = new System.Drawing.Font("맑은 고딕", 9.5F, System.Drawing.FontStyle.Regular);
            catCell.Multiline = true;
            catCell.RowSpan = rowSpan;
            catCell.StylePriority.UseFont = false;
            catCell.StylePriority.UseTextAlignment = false;
            catCell.Text = text;
            catCell.TextAlignment = DevExpress.XtraPrinting.TextAlignment.MiddleCenter;
            catCell.WidthF = 32F;
            return catCell;
        }

        private DevExpress.XtraReports.UI.XRTableRow CreateSpecRow(DevExpress.XtraReports.UI.XRTableCell catCell, string labelText, DevExpress.XtraReports.UI.XRTableCell valCell, bool centerVal)
        {
            DevExpress.XtraReports.UI.XRTableRow row = new DevExpress.XtraReports.UI.XRTableRow();
            row.Dpi = 100F;
            row.Weight = 1D;

            if (catCell != null)
            {
                row.Cells.Add(catCell);
            }
            else
            {
                DevExpress.XtraReports.UI.XRTableCell dummyCell = new DevExpress.XtraReports.UI.XRTableCell();
                dummyCell.Dpi = 100F;
                dummyCell.WidthF = 32F;
                row.Cells.Add(dummyCell);
            }

            DevExpress.XtraReports.UI.XRTableCell lblCell = new DevExpress.XtraReports.UI.XRTableCell();
            lblCell.Dpi = 100F;
            lblCell.Text = labelText;
            lblCell.WidthF = 103F;
            lblCell.StylePriority.UseTextAlignment = false;
            lblCell.TextAlignment = DevExpress.XtraPrinting.TextAlignment.MiddleCenter;

            valCell.Dpi = 100F;
            valCell.Font = new System.Drawing.Font("맑은 고딕", 9F, System.Drawing.FontStyle.Bold);
            valCell.StylePriority.UseFont = false;
            valCell.WidthF = 220F;
            valCell.StylePriority.UseTextAlignment = false;
            if (centerVal)
            {
                valCell.TextAlignment = DevExpress.XtraPrinting.TextAlignment.MiddleCenter;
            }
            else
            {
                valCell.TextAlignment = DevExpress.XtraPrinting.TextAlignment.MiddleLeft;
                valCell.Padding = new DevExpress.XtraPrinting.PaddingInfo(4, 0, 0, 0, 100F);
            }

            row.Cells.AddRange(new DevExpress.XtraReports.UI.XRTableCell[] { lblCell, valCell });
            return row;
        }


        private DevExpress.XtraReports.UI.XRTableCell CreateHeaderCell(string text, float width)
        {
            DevExpress.XtraReports.UI.XRTableCell cell = new DevExpress.XtraReports.UI.XRTableCell();
            cell.Dpi = 100F;
            cell.Font = new System.Drawing.Font("맑은 고딕", 9F, System.Drawing.FontStyle.Regular);
            cell.StylePriority.UseFont = false;
            cell.Text = text;
            cell.WidthF = width;
            cell.StylePriority.UseTextAlignment = false;
            cell.TextAlignment = DevExpress.XtraPrinting.TextAlignment.MiddleCenter;
            return cell;
        }

        private void InitDataCell(DevExpress.XtraReports.UI.XRTableCell cell, string fieldName, float width, DevExpress.XtraPrinting.TextAlignment align, int leftPadding)
        {
            cell.Dpi = 100F;
            cell.Font = new System.Drawing.Font("맑은 고딕", 9F, System.Drawing.FontStyle.Regular);
            cell.StylePriority.UseFont = false;
            cell.WidthF = width;
            cell.DataBindings.AddRange(new DevExpress.XtraReports.UI.XRBinding[] {
                new DevExpress.XtraReports.UI.XRBinding("Text", null, fieldName)
            });
            cell.StylePriority.UseTextAlignment = false;
            cell.TextAlignment = align;
            cell.StylePriority.UsePadding = false;
            cell.Padding = new DevExpress.XtraPrinting.PaddingInfo(leftPadding, 0, 0, 0, 100F);
        }

