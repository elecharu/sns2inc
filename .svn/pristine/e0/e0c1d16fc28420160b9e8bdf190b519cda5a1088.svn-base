<UserControl x:Class="ITSLIB.Button"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             MinHeight="28" MinWidth="50"
             mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <Border x:Name="border" Margin="3" CornerRadius="10"
                DockPanel.Dock="Top"
                MouseEnter="Button_MouseEnter"
                MouseLeave="Button_MouseLeave"
                MouseDown="Button_MouseDown"
                MouseUp="Button_MouseUp">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="stackPanel" Cursor="Hand">
                <TextBlock x:Name="textBlock" 
                    Margin="3 0 3 0"
                    Text=""
                    Foreground="White"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    VerticalAlignment="Center" FontFamily="DotumChe">
                </TextBlock>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
