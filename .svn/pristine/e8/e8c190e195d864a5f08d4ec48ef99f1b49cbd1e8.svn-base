@charset "utf-8";

*
{
	max-height: 99999px;
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: 'nanum_gothic', 'tahoma','malgun gothic';	
	font-size: 1.4rem;
	letter-spacing: 0em;
	word-break: break-all;
	-webkit-text-size-adjust: none;
	outline: none;
}

*::after,
*::before
{
	box-sizing: border-box;
}


