<UserControl x:Class="ITSLIB.OnOff"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             Height="28" MinHeight="28" MaxHeight="28"
             Width="200" MinWidth="100">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap" 
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="Fonts/#Roboto Medium.ttf"/>
        <Border DockPanel.Dock="Left"
                x:Name="checkBackground"
                BorderThickness="2"
                BorderBrush="Silver"
                Background="White"
                Height="24"
                Margin="2"
                MouseDown="checkBackground_MouseDown"
                CornerRadius="12">
            <DockPanel x:Name="dockPanel">
                <Border DockPanel.Dock="Left"
                         x:Name="checkCircle"
                         HorizontalAlignment="Right"
                         CornerRadius="11"
                         Margin="1"
                         Width="18"
                         Height="18"
                         Background="Silver">            
                </Border>
                <TextBlock DockPanel.Dock="Left"
                           x:Name="checkText"
                           TextWrapping="Wrap" 
                           TextAlignment="Left"
                           Text="Off"
                           Margin="10 0 10 0"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock Width="50" DockPanel.Dock="Left"></TextBlock>
    </DockPanel>
</UserControl>
