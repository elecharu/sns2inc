using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Diagnostics;
using System.IO;
using System.Net;

public class ItsWait
{
    public static bool IsWait = false;
    public static bool Enable = true;
    public static void Start()
    {
        if (Enable == false)
        {
            Enable = true;
            return;
        }

        try
        {
            if (!File.Exists("ITSWAIT.exe"))
            {
                WebClient webClient = new WebClient();
                try
                {
                    // webClient.DownloadFile(ItsServerInfo.ServerUrl + "ITSWAIT.exe", "ITSWAIT.exe");
                    webClient.DownloadFile(ItsServerInfo.ServerUrl + "ITSWAIT.exe", "temptemptemp.exe");
                    System.IO.File.Copy("temptemptemp.exe", "ITSWAIT.exe", true);
                }
                catch { }
            }

            Process proc = new Process();
            proc.StartInfo.FileName = "ITSWAIT.exe";
            proc.Start();
        }
        catch { }

        IsWait = true;
    }
    public static void Stop()
    {
        try
        {
            Process[] myproc = Process.GetProcesses();
            foreach (Process item in myproc)
            {
                if (item.ProcessName == "ITSWAIT")
                {
                    item.Kill();
                }
            }
        }
        catch { }
        IsWait = false;
    }
}