                //string[] connList = System.IO.File.ReadAllLines("MssqlConfig.txt");
                //foreach (string conn in connList)
                //{
                //    if (conn.IndexOf("--host=") > -1)
                //    {
                //        Addr = conn.Replace("--host=", "").Trim();
                //    }
                //    else if (conn.IndexOf("--port=") > -1)
                //    {
                //        Port = conn.Replace("--port=", "").Trim();
                //    }
                //    else if (conn.IndexOf("--user=") > -1)
                //    {
                //        User = conn.Replace("--user=", "").Trim();
                //    }
                //    else if (conn.IndexOf("--password=") > -1)
                //    {
                //        Pass = conn.Replace("--password=", "").Trim();
                //    }
                //    else if (conn.IndexOf("--dbname=") > -1)
