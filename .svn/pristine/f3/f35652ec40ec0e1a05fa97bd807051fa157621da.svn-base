@charset "utf-8";

/********************/

* { margin:0; padding:0; box-sizing:border-box; font-family:'굴림'; font-size:12px; max-height:inherit}
html,body { width:100%; height:100%; color:#333; }
html { font-size:62.5%; overflow-y:scroll; overflow-x:scroll;}
body,input,select,textarea,button { line-height:1; letter-spacing:-0.00em; font-family:'굴림', Malgun Gothic; }
h1,h2,h3,h4,h5,h6 { font-size:100%; font-weight:normal; }
a { color:inherit; text-decoration:none; }
table { width:100%; table-layout:fixed; word-break:break-all; border-collapse:collapse; border-spacing:0; }
img,fieldset,hr { border:0 none; }
ul,li { list-style:none; }
address,em { font-style:normal; }

img,video,canvas { height:auto; }

[type="text"],[type="password"],[type="email"],select,textarea { padding: 0.5em; border:1px solid #ccc; }


/* font */
@font-face{font-family:'nanum_basicB';src:url('../fonts/NanumSquareB.woff') format('woff');}
@font-face{font-family:'nanum_basicL';src:url('../fonts/NanumSquareL.woff') format('woff');}
@font-face{font-family:'nanum_basicR';src:url('../fonts/NanumSquareR.woff') format('woff');}
@font-face{font-family:'nanumEB';src:url('../fonts/NanumSquareRoundEB.woff') format('woff');}
@font-face{font-family:'pt';src:url('../fonts/PT Sans Caption.woff') format('woff');}
@font-face{font-family:'pt_B';src:url('../fonts/PT Sans Caption Bold.woff') format('woff');}
@font-face{font-family: 'NotoKrM'; src: url('../fonts/NotoKR-Medium.ttf') format('truetype'), url('../fonts/NotoKR-Medium.eot');}
@font-face{font-family: 'GodoB'; src: url('../fonts/GodoB.ttf') format('truetype'), url('../fonts/GodoB.eot');}
@import url('https:/../../fonts.googleapis.com/css?family=PT+Sans+Caption');
@font-face{font-family:'nanum_gothic';src:local(NanumGothic);src:url('../fonts/NanumGothic.ttf') format('truetype');}
@font-face{font-family:'nanum_gothicL';src:local(NanumGothicL);src:url('../fonts/NanumGothicL.ttf') format('truetype');}
@font-face{font-family:'nanum_gothicB';src:local(NanumGothicBold);src:url('../fonts/NanumGothicBold.ttf') format('truetype');}
@font-face{font-family:'nanum_gothicEB';src:local(NanumGothicExtraBold);src:url('../fonts/NanumGothicExtraBold.ttf') format('truetype');}


.wrap{position:absolute; left:0; top:0; right:0; bottom:0; margin:0;  min-width:1500px !important;}


/* 상단메뉴 */
.header{position:relative; left:0; top:0px;  width:100%; z-index:9999;height:95px;}
.header_inner{position:fixed; width:100%; height:95px;  border-bottom:2px solid #dd1c1d; background:#f2f2f2; min-width:1500px !important;}
.logo{width:18%; height:95px; border-bottom:#1c58df 2px solid; text-align:center; float:left;}
.logo img{position:relative; top:25px; max-width:194px; max-height:94px; }

.header_MN{position:relative; top:42px; width:82%; float:left;}
.header_MN .header_MN_Box1 li a{position:relative; left:5%; float:left; font-size:1.8rem; margin-left:4%; font-family:'nanum_basicB'; color:#333;}
.header_MN .header_MN_Box1 li:hover a{color:#db0000;}
.header_MN .header_MN_Box2 li a{position:relative; right:3%; float:right; font-size:1.4rem; margin-right:1%;  font-family:'nanum_basicB'; letter-spacing:-0.05; top:3px;}
.header_MN .header_MN_Box2 .ERP a{background:#db0000; border-radius:3px; border:3px solid #db0000; color:#fff; padding:4px 10px; top:-3px;}


/*푸터*/
.footer{position:relative; top:0px; margin:0; left:0px; width:100%; background:#222733; height:95px; clear:both;}
.footer_inner{position:relative; left:80px; top:30px; width:90%; }
.footer_inner ul{position:absolute;left:220px; top:0px;}
.footer_inner li{color:#878993; line-height:1.5; font-size:12px;  font-family:'nanum_gothic';}



/*메인*/
.container{position:relative; width:100%; top:35px; left:0; bottom:0; min-height:750px;}
.Main_left{position:absolute; top:0px; width:310px; margin:0 30px;}
.Main_right{position:absolute; top:0px; left:370px; right:30px; overflow:hidden; max-width:1300px;}



/*서브*/
.Sub_container{position:relative; width:100%; top:0px; left:0; bottom:0; background:#5f5f5f; min-height:850px;}
.Sub_left{position:relative; top:0px; left:0; width:250px; float:left; height:100% }
.Sub_right{position:relative; top:0px; left:0; right:0px; bottom:0px; margin:0 0 0 250px; background:#fff; min-height:850px;}
.Sub_right:after{content:""; display:block; clear:both;}
.Sub_right_inner{position:relative; margin:0 40px; padding:50px 0 150px 0; min-width:1200px !important;}

.texthide {
    text-overflow: ellipsis;
    overflow-x: hidden;
    white-space:nowrap; 
}