<ResourceDictionary x:Class="ITSLIB.StyleTml"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
                    xmlns:its="clr-namespace:ITSLIB">

    <!-- ############################################################### MainGrid x:Key: PageMain -->
    <Style x:Key="TML" TargetType="{x:Type its:ItsPageBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="its:ItsPageBase">
                    <DockPanel>
                        <ContentPresenter x:Name="TML_CONTENT"></ContentPresenter>
                        <Popup IsOpen="False" 
                               StaysOpen="True"
                               VerticalOffset="300"
                               HorizontalOffset="100"
                               Placement="Top"
                               PlacementTarget="{Binding ElementName=TML_CONTENT}">
                            <its:PopContent x:Name="POP_CELL_CALC"
                                Title="선택 셀 정보" IconType="Info">
                                <StackPanel>
                                    <StackPanel Margin="10 10 10 0" Background="AliceBlue">
                                        <its:Number Label="선택셀" x:Name="CELLINFO_SEL_COUNT"
                                                        DecimalPoint="0" Margin="0 0 20 0"
                                                        Unit="EA "
                                                        ReadOnly="True"/>
                                        <its:Number Label="숫자셀" x:Name="CELLINFO_NUM_COUNT"
                                                        Unit="EA " Margin="0 0 20 0"
                                                        DecimalPoint="0" 
                                                        ReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Margin="10 10 10 0" Background="MintCream">
                                        <its:Number Label="합계값" x:Name="CELLINFO_SUM_VALUE"
                                                        DecimalPoint="2" Margin="0 0 20 0"
                                                        ReadOnly="True"/>
                                        <its:Number Label="평균값" x:Name="CELLINFO_AVE_VALUE"
                                                        DecimalPoint="2" Margin="0 0 20 0"
                                                        ReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Margin="10 10 10 10" Background="#ECECEC">
                                        <its:Number Label="최소값" x:Name="CELLINFO_MIN_VALUE"
                                                        DecimalPoint="2" Margin="0 0 20 0"
                                                        ReadOnly="True"/>
                                        <its:Number Label="최대값" x:Name="CELLINFO_MAX_VALUE"
                                                        DecimalPoint="2" Margin="0 0 20 0"
                                                        ReadOnly="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </its:PopContent>
                        </Popup>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ############################################################### TML_POP -->
    <Style x:Key="TML_POP" TargetType="{x:Type UserControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="UserControl">
                    <StackPanel>
                        <Border BorderThickness="1" BorderBrush="Black" Margin="1">
                            <DockPanel Background="WhiteSmoke">
                                <DockPanel Background="#262938" x:Name="TML_POP_TITLEBAR" DockPanel.Dock="Top" >
                                    <TextBlock Foreground="White" HorizontalAlignment="Left"
                                           Margin="5 -2 0 0"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold" x:Name="TML_POP_TITLE_TEXT"></TextBlock>
                                    <Canvas DockPanel.Dock="Right" Width="24" Height="24"
                                            MouseUp="TML_POP_CLOSE_MouseUp"
                                            MouseLeftButtonDown="TML_POP_CLOSE_MouseLeftDown">
                                        <Canvas.Style>
                                            <Style>
                                                <Setter Property="Canvas.Margin" Value="5 0 5 0"/>
                                                <Setter Property="Canvas.Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="#262938"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                                                        <Setter Property="Canvas.Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="Silver"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Line X1="6" Y1="6" X2="18" Y2="18" Stroke="White" StrokeThickness="3"></Line>
                                        <Line X1="6" Y1="18" X2="18" Y2="6" Stroke="White" StrokeThickness="3"></Line>
                                    </Canvas>
                                    <UserControl></UserControl>
                                </DockPanel>
                                <ContentPresenter DockPanel.Dock="Top"></ContentPresenter>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="TML_GRID" TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="WhiteSmoke"/>
    </Style>

    <Style x:Key="TML_PANEL" TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>

</ResourceDictionary>