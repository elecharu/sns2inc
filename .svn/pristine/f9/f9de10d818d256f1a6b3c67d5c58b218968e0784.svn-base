        private void GetStt()
        {
            ItsSerial.SerialPlc.Close();
            ItsSerial.SerialPlc.PortName = System.IO.File.ReadAllText("PLCPORT.txt", Encoding.UTF8);

            try
            {
                NUM_11B.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0101", 1) / 10; // 숙성실 하한온도
                NUM_11T.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0102", 1) / 10; // 숙성실 상한온도
                NUM_12B.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0103", 1) / 10; // 숙성실 하한습도
                NUM_12T.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0104", 1) / 10; // 숙성실 상한습도

                NUM_21B.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0111", 1) / 10; // CMB 하한온도
                NUM_21T.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0112", 1) / 10; // CMB 상한온도
                NUM_22B.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0113", 1) / 10; // CMB 하한습도
                NUM_22T.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0114", 1) / 10; // CMB 상한습도

                NUM_31B.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0121", 1) / 10; // 약품실 하한온도
                NUM_31T.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0122", 1) / 10; // 약품실 상한온도
                NUM_32B.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0123", 1) / 10; // 약품실 하한습도
                NUM_32T.Value = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0124", 1) / 10; // 약품실 상한습도

                decimal sttValue1 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0105", 1) / 10;
                if (sttValue1 > 0m)
                {
                    stt1.Text = "켜짐";
                    stt1.Tag = "on";
                    btnOnOff1.Text = "On";
                    btnOnOff1.BackColor = Color.Red;
                }
                else
                {
                    stt1.Text = "꺼짐";
                    stt1.Tag = "off";
                    btnOnOff1.Text = "Off";
                    btnOnOff1.BackColor = Color.DarkGray;
                }

                decimal sttValue2 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0115", 1) / 10;
                if (sttValue2 > 0m)
                {
                    stt2.Text = "켜짐";
                    stt2.Tag = "on";
                    btnOnOff2.Text = "On";
                    btnOnOff2.BackColor = Color.Red;
                }
                else
                {
                    stt2.Text = "꺼짐";
                    stt2.Tag = "off";
                    btnOnOff2.Text = "Off";
                    btnOnOff2.BackColor = Color.DarkGray;
                }

                decimal sttValue3 = ItsSerial.ReadHex(ItsSerial.SerialPlc, "DW0125", 1) / 10;
                if (sttValue3 > 0m)
                {
                    stt3.Text = "켜짐";
                    stt3.Tag = "on";
                    btnOnOff3.Text = "On";
                    btnOnOff3.BackColor = Color.Red;
                }
                else
                {
                    stt3.Text = "꺼짐";
                    stt3.Tag = "off";
                    btnOnOff3.Text = "Off";
                    btnOnOff3.BackColor = Color.DarkGray;
                }
            }
            catch
            {
                _ERRMSG = "시리얼 포트를 연결할 수 없습니다. " + ItsSerial.SerialPlc.PortName;
            }
        }

    }
}
