<UserControl x:Class="ITSLIB.ButtonCommon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Height="28" MinHeight="28" MaxHeight="28">
    <DockPanel LastChildFill="True">
        <Border x:Name="border" Margin="3" BorderThickness="1" CornerRadius="5" Cursor="Hand"
                MouseDown="border_MouseDown" 
                MouseMove="border_MouseMove"
                MouseLeave="border_MouseLeave">
            <Border.Background>
                <SolidColorBrush x:Name="borderBackground" Color="{DynamicResource ColorComButtonBackLeave}"></SolidColorBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="borderBrush" Color="{DynamicResource ColorComButtonBackLeave}"></SolidColorBrush>
            </Border.BorderBrush>
            <StackPanel DockPanel.Dock="Top" Margin="5 0 5 0"
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left">
                <Canvas x:Name="Search" Width="16" Height="16">
                    <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="2"></Ellipse>
                    <Line X1="11" Y1="11" X2="16" Y2="16" Stroke="White" StrokeThickness="2"></Line>
                </Canvas>
                <Canvas x:Name="Add" Width="16" Height="16">
                    <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="2"></Ellipse>
                    <Line X1="4" Y1="8" X2="12" Y2="8" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="8" Y1="4" X2="8" Y2="12" Stroke="White" StrokeThickness="2"></Line>
                </Canvas>
                <Canvas x:Name="Save" Width="16" Height="16">
                    <Rectangle Width="14" Height="15" Stroke="White" StrokeThickness="1" Canvas.Left="1" Canvas.Top="1"/>
                    <Line X1="2" Y1="1" X2="2" Y2="16" Stroke="White" StrokeThickness="3"/>
                    <Line X1="14" Y1="1" X2="14" Y2="16" Stroke="White" StrokeThickness="3"/>
                    <Line X1="2" Y1="6.5" X2="15" Y2="6.5" Stroke="White" StrokeThickness="2"/>
                    <Line X1="10" Y1="2.5" X2="10" Y2="5" Stroke="White" StrokeThickness="2"/>
                    <Line X1="4.5" Y1="11.25" X2="11.5" Y2="11.25" Stroke="White" StrokeThickness="5.5"/>
                </Canvas>
                <Canvas x:Name="Delete" Width="16" Height="16">
                    <Path Stroke="White" StrokeThickness="2">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="6,3">
                                    <BezierSegment Point1="7,0" Point2="9,0" Point3="10,3"></BezierSegment>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Rectangle Width="14" Height="6" Stroke="White" StrokeThickness="2" Canvas.Top="2" Canvas.Left="1"></Rectangle>
                    <Rectangle Width="10" Height="10" Stroke="White" StrokeThickness="2" Canvas.Top="6" Canvas.Left="3"></Rectangle>
                    <Line X1="7" Y1="8" X2="7" Y2="13" Stroke="White" StrokeThickness="1"></Line>
                    <Line X1="9" Y1="8" X2="9" Y2="13" Stroke="White" StrokeThickness="1"></Line>
                </Canvas>
                <Canvas x:Name="Print" Width="16" Height="16">
                    <Line X1="4" Y1="1" X2="13" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="4" Y1="0" X2="4" Y2="10" Stroke="White" StrokeThickness="2"/>
                    <Line X1="12" Y1="0" X2="12" Y2="10" Stroke="White" StrokeThickness="2"/>
                    <Line X1="1" Y1="8" X2="1" Y2="16" Stroke="White" StrokeThickness="2"/>
                    <Line X1="15" Y1="8" X2="15" Y2="16" Stroke="White" StrokeThickness="2"/>
                    <Line X1="0" Y1="9.5" X2="16" Y2="9.5" Stroke="White" StrokeThickness="3"/>
                    <Line X1="0" Y1="14" X2="16" Y2="14" Stroke="White" StrokeThickness="3"/>
                    <Line X1="6" Y1="4" X2="10" Y2="4" Stroke="White" StrokeThickness="1.5"/>
                    <Line X1="6" Y1="6.5" X2="10" Y2="6.5" Stroke="White" StrokeThickness="1.5"/>
                </Canvas>
                <Canvas x:Name="Capture" Width="16" Height="16">
                    <Line X1="0" Y1="2" X2="14" Y2="2" Stroke="White" StrokeThickness="2"/>
                    <Line X1="2" Y1="0" X2="2" Y2="14" Stroke="White" StrokeThickness="2"/>
                    <Line X1="14" Y1="1" X2="14" Y2="16" Stroke="White" StrokeThickness="2"/>
                    <Line X1="1" Y1="14" X2="16" Y2="14" Stroke="White" StrokeThickness="2"/>
                    <Ellipse Width="8" Height="8" Stroke="White" StrokeThickness="2" Canvas.Left="4" Canvas.Top="4"></Ellipse>
                </Canvas>
                <Canvas x:Name="Export" Width="16" Height="16">
                    <Path Stroke="White" StrokeThickness="2">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="6,12">
                                    <BezierSegment Point1="6,10" Point2="8,6" Point3="14,2"></BezierSegment>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Line X1="8" Y1="1" X2="15" Y2="1" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="15" Y1="0" X2="15" Y2="7" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="1" Y1="5" X2="1" Y2="15" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="15" Y1="10" X2="15" Y2="15" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="0" Y1="4" X2="6" Y2="4" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="0" Y1="15" X2="16" Y2="15" Stroke="White" StrokeThickness="2"></Line>
                </Canvas>
                <TextBlock x:Name="textBlock" Margin="5 0 5 0"
                    Text="{Binding RelativeSource={RelativeSource AncestorType=local:Button}, Path=Label, Mode=TwoWay}"
                    HorizontalAlignment="Center"
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <SolidColorBrush x:Name="textForeground" Color="White"></SolidColorBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </Border>
    </DockPanel>
    <UserControl.Resources>
        <Storyboard x:Key="ButtonEnterStory">
            <ColorAnimation To="{DynamicResource ColorComButtonBackEnter}" Duration="0:0:0.01" 
                                                    Storyboard.TargetName="borderBackground"
                                                    Storyboard.TargetProperty="Color"/>
            <ColorAnimation To="Black" Duration="0:0:0.01" 
                                                    Storyboard.TargetName="textForeground"
                                                    Storyboard.TargetProperty="Color"/>
        </Storyboard>
        <Storyboard x:Key="ButtonLeaveStory">
            <ColorAnimation To="{DynamicResource ColorComButtonBackLeave}" Duration="0:0:0.01" 
                                                    Storyboard.TargetName="borderBackground"
                                                    Storyboard.TargetProperty="Color"/>
            <ColorAnimation To="White" Duration="0:0:0.01" 
                                                    Storyboard.TargetName="textForeground"
                                                    Storyboard.TargetProperty="Color"/>
        </Storyboard>
    </UserControl.Resources>
</UserControl>
