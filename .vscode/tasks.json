{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start IIS Express",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start-iis.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "iisexpress",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting IIS Express \\.\\.\\.",
          "endsPattern": "^IIS Express is running\\."
        }
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Stop IIS Express",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Get-Process iisexpress -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 1"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    }
  ]
}