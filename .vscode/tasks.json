{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Web Server",
      "type": "shell",
      // Windows: IIS Express
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/start-iis.ps1"
        ]
      },
      // macOS: Docker 컨테이너 안의 Mono XSP4
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/xsp.sh",
          "start",
          "${config:iisexpress.port}"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "iisexpress",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting (IIS Express|XSP) \\.\\.\\.",
          "endsPattern": "^(IIS Express is running\\.|Listening on port: \\d+)"
        }
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Stop Web Server",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "Get-Process iisexpress -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 1"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/xsp.sh",
          "stop"
        ]
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    }
  ]
}
