<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (Number($('.signcnt.appr_cnt')[0].innerText) > 0) $('.signcnt.appr_cnt').show();
    if (Number($('.signcnt.ref_cnt')[0].innerText) > 0) $('.signcnt.ref_cnt').show();
    if (Number($('.signcnt.hold_cnt')[0].innerText) > 0) $('.signcnt.hold_cnt').show();
    if (Number($('.signcnt.myap_cnt')[0].innerText) > 0) $('.signcnt.myap_cnt').show();
    $('.signcnt.pre_cnt').show();
    var maria = new ItsMaria('GWS2000_R01', 'LIST_FAV');
    maria.CallProc();
    if(!maria.isError){
      var html = '';
      for(var i = 0; i < maria.store.Length(); i++){
        var data = maria.store.data[i];
        html += '<li>';
        html += '<a href="javascript:signdate('+data.SIGNDOCSEQ+')">';
        html += '<div class="Sub_left_mn_in">';
        html += '<img src="../../images/left_icon04_9.png" />';
        html += '</div>';
        html += '<span>' + data.DOCNM + '</span>';
        html += '</a>';
        html += '</li>';
      }
      if(i > 0){
        $('.fav ul').append(html);
        $('.fav').show();
      }
      var html2 = '';
      for(var x = 0; x < maria.storeExtend1.Length(); x++){
        var data1 = maria.storeExtend1.data[x];
        html2 += '<li>';
        html2 += '<a href="javascript:signbox('+data1.SIGNBOXSEQ+')">';
        html2 += '<div class="Sub_left_mn_in">';
        html2 += '<img src="../../images/icon_26.png" />';
        html2 += '</div>';
        html2 += '<span>' + data1.BOXNM + '</span>';
        html2 += '</a>';
        html2 += '</li>';
      }
      if(x > 0){
        $('.box ul').append(html2);
        $('.box').show();
      }
    }
  });
  function signdate(seq) {
    var form = document.createElement('form');
    var objs;
    objs = document.createElement('input');
    objs.setAttribute('name', 'seq');
    objs.setAttribute('value', seq);
    form.appendChild(objs);
    form.setAttribute('method', 'post');
    form.setAttribute('action', "/PAGEGWS/GWS2000/signdate.aspx");
    window.open("", "signdate", "width=300,height=200,top=80,left=90,noresizable,toolbar=no,status=no,scrollbars=yes,directory=n");
    form.setAttribute('target', 'signdate');
    document.body.appendChild(form);
    form.submit();
  }
  function signform(seq, date){
    var form = document.createElement('form');
    var objs, objs2;
    objs = document.createElement('input');
    objs.setAttribute('name', 'seq');
    objs.setAttribute('value', seq);
    form.appendChild(objs);
    objs2 = document.createElement('input');
    objs2.setAttribute('name', 'date');
    objs2.setAttribute('value', date);
    form.appendChild(objs2)
    form.setAttribute('method', 'post');
    form.setAttribute('action', "/PAGEGWS/GWS2001/GWS2001_R02.aspx");
    document.body.appendChild(form);
    form.submit();
  }
  function signbox(seq){
    var form = document.createElement('form');
    var objs;
    objs = document.createElement('input');
    objs.setAttribute('name', 'seq');
    objs.setAttribute('value', seq);
    form.appendChild(objs);
    form.setAttribute('method', 'post');
    form.setAttribute('action', "/PAGEGWS/GWS2002/GWS2002_S11.aspx");
    document.body.appendChild(form);
    form.submit();
  }
</script>
