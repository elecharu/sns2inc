<script>
document.addEventListener('DOMContentLoaded', function () {
  var maria = new ItsMaria('GWS7002_R01', 'LIST_BOARD');
  maria.CallProc();
  if(maria.isError){
    maria.ShowErrMsg();
    return;
  }else{
    var html = '';
    for(var i = 0; i < maria.store.Length(); i++){
      var data = maria.store.data[i];
      html += '<li class="position_R padding_L30 board_list">';
      html += '<a href="/PAGEGWS/GWS5001/GWS5001_S01.aspx?bd=' + data.BOARDTP + '" class="Sub_left_mn_PD">';
      html += '<div class="Sub_left_mn_in"><img src="../../images/icon_12.png" class="margin_L20 margin_B20"></div>';
      html += '<span>' + data.BOARDNAME + '</span>';
      html += '</a>';
      html += '</li>';
    }
    $('#board_title').after(html);
  }
});
</script>
