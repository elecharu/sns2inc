<UserControl x:Class="ITSLIB.Check"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             Height="28" MinHeight="28" MaxHeight="28"
             Width="200" MinWidth="100"  FontFamily="Fonts/#Roboto Medium.ttf"
             MouseDown="UserControl_MouseDown">
    
    <UserControl.Resources>
        <ControlTemplate x:Key="MyCheckBoxTemplate" TargetType="{x:Type CheckBox}">
            <Grid>
                <Image x:Name="PART_Image" Source="../Images/HNS_checkbox_off.png"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="PART_Image" Property="Source" Value="../Images/HNS_checkbox_on.png"/>
                </Trigger>
                <Trigger Property="IsEnabled"  Value="False">
                    <Setter TargetName="PART_Image" Property="Source" Value="../Images/HNS_checkbox_disabled.png"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    
    <DockPanel LastChildFill="False">
        <CheckBox DockPanel.Dock="Left"
                  x:Name="checkBox" 
                  Template="{StaticResource MyCheckBoxTemplate}"
                  Width="16" 
                  Margin="3"
                  Unchecked="checkBox_Unchecked"
                  Checked="checkBox_Checked"
                  HorizontalAlignment="Left"
                  VerticalContentAlignment="Center" />
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   FontFamily="Fonts/#Roboto Medium.ttf"
                   TextWrapping="Wrap" 
                   Width="75"
                   TextAlignment="Left"
                   VerticalAlignment="Center"  />        
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textComment"
                   Margin="3 0 0 0"
                   TextWrapping="Wrap" 
                   Foreground="Blue"
                   TextAlignment="Left"
                   VerticalAlignment="Center" />
    </DockPanel>
</UserControl>
