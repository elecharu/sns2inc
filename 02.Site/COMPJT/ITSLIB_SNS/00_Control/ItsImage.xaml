<UserControl x:Class="ITSLIB.Image"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Width="300" Height="250"
             Foreground="Black">
    <DockPanel LastChildFill="True">
        <Border BorderThickness="1" BorderBrush="Gray">
            <DockPanel LastChildFill="True" Background="MintCream" >
                <StackPanel x:Name="BUTTON" HorizontalAlignment="Center" Orientation="Horizontal" DockPanel.Dock="Bottom">
                    <Button x:Name="OPEN" Height="25" Width="98" Content="추가" Click="OPEN_Click" FontFamily="Fonts/#Roboto Medium.ttf"></Button>
                    <Button x:Name="UPLOAD" Height="25" Width="98" Content="업로드" Click="UPLOAD_Click" FontFamily="Fonts/#Roboto Medium.ttf"></Button>
                    <Button x:Name="DELETE" Height="25" Width="98" Content="삭제" Click="DELETE_Click" FontFamily="Fonts/#Roboto Medium.ttf"></Button>
                </StackPanel>
                <DockPanel Background="Gray" Height="1" DockPanel.Dock="Bottom"></DockPanel>
                <TextBlock x:Name="ERRMSG" DockPanel.Dock="Bottom" 
                           Visibility="Collapsed" Foreground="Red"
                           TextWrapping="Wrap"
                           FontSize="20"
                           HorizontalAlignment="Center">Image Source Error</TextBlock>
                <Image x:Name="IMAGE"
                       Stretch="None"
                       Source="pack://application:,,,/ITSLIB;component/00_Resource/empty.png" 
                       DockPanel.Dock="Top"></Image>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
