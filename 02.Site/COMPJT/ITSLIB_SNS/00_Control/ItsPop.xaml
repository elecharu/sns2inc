<UserControl x:Class="ITSLIB.Pop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             MinHeight="28" MaxHeight="28" Height="28"
             Width="200" MinWidth="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="KEY_Black" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseDown" Handler="KEY_PreviewMouseDown"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_SeaGreen" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseDown" Handler="KEY_PreviewMouseDown"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_SteelBlue" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseDown" Handler="KEY_PreviewMouseDown"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="SteelBlue"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_IndianRed" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseDown" Handler="KEY_PreviewMouseDown"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="IndianRed"/>
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ICON_KEYPAD" TargetType="{x:Type DockPanel}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Silver"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Popup x:Name="popupKeypad" 
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=Text}">
            <DockPanel Background="Silver">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="`" />
                            <Label Style="{DynamicResource KEY_Black}" Content="1" />
                            <Label Style="{DynamicResource KEY_Black}" Content="2" />
                            <Label Style="{DynamicResource KEY_Black}" Content="3" />
                            <Label Style="{DynamicResource KEY_Black}" Content="4" />
                            <Label Style="{DynamicResource KEY_Black}" Content="5" />
                            <Label Style="{DynamicResource KEY_Black}" Content="6" />
                            <Label Style="{DynamicResource KEY_Black}" Content="7" />
                            <Label Style="{DynamicResource KEY_Black}" Content="8" />
                            <Label Style="{DynamicResource KEY_Black}" Content="9" />
                            <Label Style="{DynamicResource KEY_Black}" Content="0" />
                            <Label Style="{DynamicResource KEY_IndianRed}" Content="✖" Width="40" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="Q" />
                            <Label Style="{DynamicResource KEY_Black}" Content="W" />
                            <Label Style="{DynamicResource KEY_Black}" Content="E" />
                            <Label Style="{DynamicResource KEY_Black}" Content="R" />
                            <Label Style="{DynamicResource KEY_Black}" Content="T" />
                            <Label Style="{DynamicResource KEY_Black}" Content="Y" />
                            <Label Style="{DynamicResource KEY_Black}" Content="U" />
                            <Label Style="{DynamicResource KEY_Black}" Content="I" />
                            <Label Style="{DynamicResource KEY_Black}" Content="O" />
                            <Label Style="{DynamicResource KEY_Black}" Content="P" />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="[" />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="]" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="A" />
                            <Label Style="{DynamicResource KEY_Black}" Content="S" />
                            <Label Style="{DynamicResource KEY_Black}" Content="D" />
                            <Label Style="{DynamicResource KEY_Black}" Content="F" />
                            <Label Style="{DynamicResource KEY_Black}" Content="G" />
                            <Label Style="{DynamicResource KEY_Black}" Content="H" />
                            <Label Style="{DynamicResource KEY_Black}" Content="J" />
                            <Label Style="{DynamicResource KEY_Black}" Content="K" />
                            <Label Style="{DynamicResource KEY_Black}" Content="L" />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content=";" />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="'" />
                            <Label x:Name="keyHanEng" Style="{DynamicResource KEY_Black}" Content="한/영" Width="40" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_Black}" Content="Z" />
                            <Label Style="{DynamicResource KEY_Black}" Content="X" />
                            <Label Style="{DynamicResource KEY_Black}" Content="C" />
                            <Label Style="{DynamicResource KEY_Black}" Content="V" />
                            <Label Style="{DynamicResource KEY_Black}" Content="B" />
                            <Label Style="{DynamicResource KEY_Black}" Content="N" />
                            <Label Style="{DynamicResource KEY_Black}" Content="M" />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="," />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="." />
                            <Label Style="{DynamicResource KEY_SteelBlue}" Content="/" />
                            <Label Style="{DynamicResource KEY_Black}" Content="◀" />
                            <Label Style="{DynamicResource KEY_Black}" Content="▶" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 2 2">
                            <Label Style="{DynamicResource KEY_Black}" Content="공백" Width="165" />
                            <Label Style="{DynamicResource KEY_Black}" Content="-" Width="40" />
                            <Label Style="{DynamicResource KEY_Black}" Content="=" Width="40" />
                            <Label Style="{DynamicResource KEY_IndianRed}" Background="SeaGreen" Content="대" Width="40" />
                            <Label Style="{DynamicResource KEY_IndianRed}" Background="SeaGreen" Content="소" Width="40" />
                            <Label Style="{DynamicResource KEY_IndianRed}" Background="SeaGreen" Content="특" Width="40" />
                            <Label Style="{DynamicResource KEY_Black}" Content="삭제" Width="40" />
                            <Label Style="{DynamicResource KEY_Black}" Content="전부삭제" Width="83"/>
                            
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Popup>
        <Popup x:Name="popupSearch" 
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=textBox}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Select" Height="22" Grid.Column="0"
                                Click="Select_Click">
                        <Canvas Height="16" Width="80" Background="Transparent">
                            <Line X1="3" Y1="5" X2="6" Y2="13" Stroke="SeaGreen" StrokeThickness="2"></Line>
                            <Line X1="5" Y1="13" X2="16" Y2="3" Stroke="SeaGreen" StrokeThickness="2"></Line>
                            <TextBlock Canvas.Left="20">선택</TextBlock>
                        </Canvas>
                    </Button>
                    <Button x:Name="Clear" Height="22" Grid.Column="1" Margin="-1 0 0 0"
                                Click="Clear_Click">
                        <Canvas Height="16" Width="50" Background="Transparent">
                            <Line X1="3" Y1="6" X2="6" Y2="1" Stroke="#666666" StrokeThickness="2"></Line>
                            <Line X1="5" Y1="2" X2="13" Y2="2" Stroke="#666666" StrokeThickness="2"></Line>
                            <Line X1="13" Y1="1" X2="13" Y2="8" Stroke="#666666" StrokeThickness="2"></Line>
                            <Line X1="3" Y1="5" X2="3" Y2="13" Stroke="#666666" StrokeThickness="2"></Line>
                            <Line X1="2" Y1="13" X2="8" Y2="13" Stroke="#666666" StrokeThickness="2"></Line>
                            <Line X1="10" Y1="10" X2="15" Y2="15" Stroke="IndianRed" StrokeThickness="2"></Line>
                            <Line X1="10" Y1="15" X2="15" Y2="10" Stroke="IndianRed" StrokeThickness="2"></Line>
                            <TextBlock Canvas.Left="16">지우기</TextBlock>
                        </Canvas>
                    </Button>
                    <Button x:Name="Close" Height="22" Grid.Column="2" Margin="-1 0 0 0"
                                Click="Close_Click">
                        <Canvas Height="16" Width="50" Background="Transparent">
                            <Line X1="3" Y1="3" X2="13" Y2="13" Stroke="IndianRed" StrokeThickness="2"></Line>
                            <Line X1="3" Y1="13" X2="13" Y2="3" Stroke="IndianRed" StrokeThickness="2"></Line>
                            <TextBlock Canvas.Left="16">닫기</TextBlock>
                        </Canvas>
                    </Button>
                </Grid>
                <local:Grid x:Name="gridView" MouseDoubleClick="gridView_MouseDoubleClick">
                    <local:Grid.Columns>
                        <local:Column FieldName="CODE" Header="코드" />
                        <local:Column FieldName="NAME" Header="명"/>
                        <local:Column FieldName="REF01" Header="참조1"/>
                        <local:Column FieldName="REF02" Header="참조2"/>
                        <local:Column FieldName="REF03" Header="참조3"/>
                    </local:Grid.Columns>
                </local:Grid>
            </DockPanel>
        </Popup>
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap" 
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="Fonts/#Roboto Medium.ttf">
        </TextBlock>
        <UserControl DockPanel.Dock="Right"
                     Background="Transparent"
                     x:Name="keyPadIcon"
                     Width="20" Height="20" 
                     HorizontalAlignment="Right"
                     MouseUp="keyPad_MouseUp">
            <DockPanel Style="{DynamicResource ICON_KEYPAD}">
                <Canvas x:Name="canvasKeypad" 
                        Margin="1,0,0,2"
                        Width="16" 
                        Height="16" VerticalAlignment="Bottom">
                    <Line X1="0.5" Y1="2" X2="0.5" Y2="14" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="3.5" Y1="2" X2="3.5" Y2="14" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="6.5" Y1="2" X2="6.5" Y2="14" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="9.5" Y1="2" X2="9.5" Y2="14" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="12.5" Y1="2" X2="12.5" Y2="14" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="15.5" Y1="2" X2="15.5" Y2="14" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="0" Y1="2.5" X2="16" Y2="2.5" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="0" Y1="5.5" X2="16" Y2="5.5" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="0" Y1="8.5" X2="16" Y2="8.5" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="0" Y1="11.5" X2="16" Y2="11.5" Stroke="Gray" StrokeThickness="1"/>
                    <Line X1="0" Y1="14.5" X2="16" Y2="14.5" Stroke="Gray" StrokeThickness="1"/>
                </Canvas>
            </DockPanel>
        </UserControl>
        <UserControl DockPanel.Dock="Right"
                     x:Name="searchIcon"
                     Background="Transparent"
                     Width="20" Height="22" 
                     Margin="0 0 0 0"
                     HorizontalAlignment="Right"
                     MouseUp="search_MouseUp">
            <Border BorderThickness="0 1 1 1" BorderBrush="Silver">
                <DockPanel Style="{DynamicResource ICON_KEYPAD}">
                    <Canvas x:Name="canvasSearch"
                        Width="18" 
                        Height="18" 
                        HorizontalAlignment="Right" 
                        Margin="1">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Style.Triggers>
                                    <Trigger Property="Canvas.IsMouseOver"  Value="true">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Grid>
                                                            <Rectangle Fill="#262938" />
                                                            <Image Source="../Images/HNS_field_ic_search_p.png"/>
                                                        </Grid>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="Canvas.IsMouseOver"  Value="false">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="../Images/HNS_field_ic_search_n.png"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="Canvas.IsEnabled"  Value="false">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="../Images/HNS_field_ic_search_d.png"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <!--<Ellipse Width="14" Height="14" Stroke="Gray" StrokeThickness="2"></Ellipse>
                        <Line X1="11" Y1="11" X2="16" Y2="16" Stroke="Gray" StrokeThickness="2"></Line>-->
                    </Canvas>
                </DockPanel>
            </Border>
        </UserControl>
        <TextBox x:Name="textCode" 
                 DockPanel.Dock="Left"
                    Height="22"
                    MinWidth="50"
                    BorderBrush="Silver"
                    BorderThickness="1"
                    HorizontalContentAlignment="Left"
                    VerticalAlignment="Top" 
                    VerticalContentAlignment="Center"
                    Margin="3 3 0 0"
                    TextWrapping="NoWrap" 
                    PreviewKeyDown="textCode_PreviewKeyDown"
                    TextChanged="textCode_TextChanged"
                    GotFocus="textCode_GotFocus"
                    LostFocus="textCode_LostFocus" FontFamily="Fonts/#Roboto Medium.ttf">
        </TextBox>
        <Border x:Name="borderName"
                BorderThickness="1 1 1 1" BorderBrush="Silver" Height="22"
                Visibility="Visible"
                Margin="-1 0 0 0"
                Background="Transparent">
            <TextBlock Margin="1 0 1 0"
                       x:Name="textName"
                       Foreground="Blue"
                       TextAlignment="Left"
                       VerticalAlignment="Center" FontFamily="Fonts/#Roboto Medium.ttf">
            </TextBlock>
        </Border>
    </DockPanel>
</UserControl>
