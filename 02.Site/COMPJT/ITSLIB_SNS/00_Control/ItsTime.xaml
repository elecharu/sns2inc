<UserControl x:Class="ITSLIB.Time"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:local="clr-namespace:ITSLIB"
             mc:Ignorable="d"
             Foreground="Black"
             Height="28" MinHeight="28" MaxHeight="28"
             Width="200" MinWidth="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="KEY_NUM" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="#333333" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_COMMON" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="SeaGreen" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_MOVE" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="SteelBlue" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KEY_CLOSE" TargetType="{x:Type Label}">
                <EventSetter Event="PreviewMouseUp" Handler="KEY_PreviewMouseUp"/>
                <Setter Property="Margin" Value="2 2 0 0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="IndianRed" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ICON_KEYPAD" TargetType="{x:Type UserControl}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Silver"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Popup x:Name="popup" 
                   StaysOpen="False"
                   PlacementTarget="{Binding ElementName=textEdit}">
            <DockPanel Background="Silver">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_MOVE}" Content="◀" Width="40" />
                            <Label Style="{DynamicResource KEY_MOVE}" Content="▶" Width="40" />
                            <Label Style="{DynamicResource KEY_CLOSE}" Content="✖" Width="40" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_NUM}" Content="1" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="2" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_NUM}" Content="4" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="5" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="6" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Style="{DynamicResource KEY_NUM}" Content="7" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="8" />
                            <Label Style="{DynamicResource KEY_NUM}" Content="9" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 2 2">
                            <Label Style="{DynamicResource KEY_NUM}" Content="0" Width="124" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Popup>
        <TextBlock DockPanel.Dock="Left" 
                   x:Name="textBlock"
                   TextWrapping="Wrap"
                   Width="75"
                   TextAlignment="Right"
                   VerticalAlignment="Center" FontFamily="Fonts/#Roboto Medium.ttf"/>
        <TextBlock DockPanel.Dock="Right" 
                   x:Name="textUnit"
                   TextWrapping="Wrap" 
                   TextAlignment="Right"
                   VerticalAlignment="Center" />
        <UserControl DockPanel.Dock="Right"
                     x:Name="keyPadIcon"
                     Width="20" Height="20" 
                     HorizontalAlignment="Right"
                     Style="{DynamicResource ICON_KEYPAD}"
                     MouseUp="canvas_MouseUp">
            <Canvas x:Name="canvas" Width="16" Height="16">
                <Line X1="9" Y1="7" X2="5" Y2="10" Stroke="Gray" StrokeThickness="2"></Line>
                <Line X1="8" Y1="3.5" X2="8" Y2="9" Stroke="Gray" StrokeThickness="2"></Line>
                <Ellipse Width="14" Height="14" Stroke="Gray" StrokeThickness="2" Canvas.Top="1" Canvas.Left="1"></Ellipse>
                <Line X1="3" Y1="16" X2="5" Y2="13" Stroke="Gray" StrokeThickness="2"></Line>
                <Line X1="11" Y1="13" X2="13" Y2="16" Stroke="Gray" StrokeThickness="2"></Line>
                <Ellipse Width="4" Height="4" Stroke="Gray" StrokeThickness="2" Canvas.Left="1"/>
                <Ellipse Width="4" Height="4" Stroke="Gray" StrokeThickness="2" Canvas.Left="11"/>
            </Canvas>
        </UserControl>
        <dxe:TextEdit x:Name="textEdit" 
                      DockPanel.Dock="Right"
                      MaskAutoComplete="Optimistic"
                      Mask="([0-1]\d|2[0-3]):[0-5]\d" 
                      MaskType="RegEx"
                      MaskUseAsDisplayFormat="True"
                      Height="22"
                      BorderBrush="Silver"
                      BorderThickness="1"
                      VerticalAlignment="Center" 
                      VerticalContentAlignment="Center"
                      Margin="3"
                      EditValueChanged="textEdit_EditValueChanged"
                      GotFocus="textEdit_GotFocus"
                      LostFocus="textEdit_LostFocus" FontFamily="Fonts/#Roboto Medium.ttf"/>
    </DockPanel>
</UserControl>
