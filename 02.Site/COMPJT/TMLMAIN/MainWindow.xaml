            <!-- 처리중 박스 -->

            <DockPanel x:Name="WAIT_MSG" Background="white" Width="150" Height="140" Margin="0 0 0 0" >
                <Border DockPanel.Dock="Top" Width="150" Height="100" Background="#5C84EE" BorderThickness="0">
