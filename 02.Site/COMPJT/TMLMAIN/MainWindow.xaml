                        <Label Height="12" FontSize="10" Margin="0" Padding="0" FontFamily="LG Smart UI Regular" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Foreground="#6C6C6C">데이터 처리중...</Label>
                        <Label Height="12" FontSize="10" Margin="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Foreground="#6C6C6C" FontFamily="LG Smart UI Regular">잠시만 기다려 주세요</Label>
                        <UserControl Height="10"></UserControl>
                    </StackPanel>
                </Border>
            </DockPanel>


            <!-- 메세지 박스 -->
            <DockPanel x:Name="PANEL_MSG" Width="250" Height="100" Background="White" Margin="0 0 0 0" >
                <Border DockPanel.Dock="Top" Height="68" Background="#FFFFFF" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect Color="black" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel>
                        <Image x:Name="TEXT_MSG_IMG" Source="popup_bg_choice.png" ></Image>
                        <UserControl FontWeight="Medium" Margin="10 -110 0 0" Foreground="White" VerticalAlignment="Center" FontSize="14">
                            <TextBlock TextWrapping="WrapWithOverflow" FontFamily="Global User Interface" FontSize="12">Message</TextBlock>
                        </UserControl>
                        <UserControl Margin="0 -90 0 0" Background="White"  Height="2" Opacity="0.4" >
                        </UserControl>
                        <UserControl Margin="10 -60 0 0" Foreground="White" VerticalAlignment="Center">
                            <TextBlock x:Name="TEXT_MSG" TextWrapping="WrapWithOverflow" FontFamily="Global User Interface" FontSize="10">저장하시겠습니까?</TextBlock>
                        </UserControl>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect Color="black" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <UserControl Width="50" Background="#468CC6" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            x:Name="MsgCommit" Height="16" MouseUp="MSG_COMMIT_MouseUp"
                            Margin="130 9 50 9" FontFamily="Global User Interface" FontSize="9">
                            <TextBlock TextWrapping="WrapWithOverflow">OK</TextBlock>
                        </UserControl>
                        <UserControl Width="50" Height="16" Background="#BFBFBF" Foreground="White"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            x:Name="MsgClose" MouseUp="MSG_CLOSE_MouseUp"
                            Margin="-40 9 0 9" FontFamily="Global User Interface" FontSize="9" >
                            <TextBlock TextWrapping="WrapWithOverflow">NO</TextBlock>
                        </UserControl>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- 기타 메뉴 -->
            <Popup x:Name="POP_OTHER_MENU" IsOpen="False" StaysOpen="False" Width="470"
                   PlacementTarget="{Binding ElementName=DOCK_TITLE}" Placement="Bottom">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="Silver" BorderThickness="1">
                        <StackPanel x:Name="PANEL_OTHER_MENU" Background="WhiteSmoke">
                            <UserControl Tag="OTHER_CLOSE" MouseUp="MENU_MouseUp" Background="#141622" Foreground="White"
                                     HorizontalContentAlignment="Right" FontSize="9"
                                     VerticalContentAlignment="Center">
                                <DockPanel HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center" Margin="0 0 3 0">기타메뉴</TextBlock>
                                    <Canvas Width="10" Height="10">
                                        <Line X1="2" Y1="2" X2="8" Y2="8" Stroke="White" StrokeThickness="2"></Line>
                                        <Line X1="2" Y1="8" X2="8" Y2="2" Stroke="White" StrokeThickness="2"></Line>
                                    </Canvas>
                                </DockPanel>
                            </UserControl>
                            <DockPanel>
                                <UserControl Name="OTHER_MENU0" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU1" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU2" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU3" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU4" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU5" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU6" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU7" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU8" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                                <UserControl Name="OTHER_MENU9" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <UserControl></UserControl>
                </DockPanel>
            </Popup>
        </Grid>
    </Viewbox>
</Window>
