<Window x:Class="TMLMAIN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TMLMAIN"
        xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
        xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
        Icon="icon_tml.ico"
        mc:Ignorable="d" 
        WindowState="Maximized"
        WindowStyle="None"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>

            <local:StringToVisibility x:Key="myStringToVisibility"></local:StringToVisibility>
            
            <!-- 좌측 메뉴 아이콘 -->
            <Style x:Key="TopMenuIcon" TargetType="Canvas">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- 닫기 & 환경설정 -->
            <Style x:Key="TopMenuLeft" TargetType="Canvas">
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- 창 닫기 아이콘 -->
            <Style x:Key="MainIconClose" TargetType="Canvas">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="IndianRed"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <!-- 메시지 아이콘 -->
            <Style x:Key="MsgIcon" TargetType="Canvas">
                <!--<Setter Property="Background" Value="IndianRed"/>-->
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 환경설정 아이콘 -->
            <Style x:Key="ConfigIcon" TargetType="Canvas">
                <Setter Property="Background" Value="SteelBlue"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 좌측메뉴 -->
            <Style x:Key="TML_MENU" TargetType="{x:Type UserControl}">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Silver"/>
                <Setter Property="Background" Value="WhiteSmoke"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="1 1 1 0"/>
                <Setter Property="FontSize" Value="6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Black"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="White"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AAA" TargetType="ComboBox">

            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Fill">
        <Grid Width="400" Height="225">
            <DockPanel x:Name="DOCK_MAIN" Background="White" Margin="0">

                <!-- 좌측 메뉴 -->
                <DockPanel Background="#4472c4" DockPanel.Dock="Left" x:Name="LEFT_MENU">
                    <StackPanel>
                        <DockPanel Background="#4472c4">
                            <Canvas DockPanel.Dock="Right" x:Name="ICON_HIDE" Width="30" Height="30" Background="#4472c4"
                                Style="{DynamicResource TopMenuLeft}"
                                MouseDown="ICON_HIDE_MouseDown">
                                <Ellipse Width="16" Height="16" Stroke="White" Canvas.Left="7" Canvas.Top="7" StrokeThickness="2"></Ellipse>
                                <Line X1="11" Y1="15" X2="16" Y2="11" Stroke="White" StrokeThickness="2"></Line>
                                <Line X1="10" Y1="15" X2="20" Y2="15" Stroke="White" StrokeThickness="2"></Line>
                                <Line X1="11" Y1="15" X2="16" Y2="19" Stroke="White" StrokeThickness="2"></Line>
                            </Canvas>
                            <Canvas x:Name="ICON_CONFIG" DockPanel.Dock="Left" Width="20" Height="20" Background="#4472c4"
                                    Style="{DynamicResource TopMenuLeft}"
                                    MouseDown="ICON_CONFIG_MouseDown">
                                <Ellipse Width="6" Height="6" Stroke="White" StrokeThickness="2" Canvas.Top="7" Canvas.Left="7"/>
                                <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2" Canvas.Top="4" Canvas.Left="4"/>
                                <Line X1="4" Y1="4" X2="6" Y2="6" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="2" Y1="10" X2="5" Y2="10" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="4" Y1="16" X2="6" Y2="14" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="10" Y1="18" X2="10" Y2="15" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="14" Y1="14" X2="16" Y2="16" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="14" Y1="10" X2="18" Y2="10" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="14" Y1="6" X2="16" Y2="4" Stroke="White" StrokeThickness="3"></Line>
                                <Line X1="10" Y1="2" X2="10" Y2="5" Stroke="White" StrokeThickness="3"></Line>
                            </Canvas>
                            <TextBlock DockPanel.Dock="Left"
                                VerticalAlignment="Center" Foreground="White" FontSize="8" FontWeight="Bold">설정</TextBlock>
                        </DockPanel>
                        <StackPanel x:Name="PANEL_MENU" Margin="0 0 1 0" Background="WhiteSmoke">
                            <UserControl Name="MENU0" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU1" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU2" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU3" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU4" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU5" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU6" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU7" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU8" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="MENU9" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- 상단 타이틀 -->
                <DockPanel x:Name="DOCK_TITLE" DockPanel.Dock="Top" Background="Black">
                    <Canvas x:Name="ICON_MENU" Width="24" Height="24" DockPanel.Dock="Left"
                                    Style="{DynamicResource TopMenuIcon}"
                                    MouseDown="ICON_MENU_MouseDown">
                        <Line X1="4" Y1="6" X2="6" Y2="6" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="8" Y1="6" X2="20" Y2="6" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="4" Y1="10" X2="6" Y2="10" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="8" Y1="10" X2="20" Y2="10" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="4" Y1="14" X2="6" Y2="14" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="8" Y1="14" X2="20" Y2="14" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="4" Y1="18" X2="6" Y2="18" Stroke="White" StrokeThickness="2"></Line>
                        <Line X1="8" Y1="18" X2="20" Y2="18" Stroke="White" StrokeThickness="2"></Line>
                    </Canvas>
                    <Canvas x:Name="ICON_CLOSE" DockPanel.Dock="Right" Width="24" Height="24"
                                Style="{DynamicResource MainIconClose}"
                                MouseDown="ICON_CLOSE_MouseDown">
                        <Line X1="5" Y1="5" X2="19" Y2="19" Stroke="White" StrokeThickness="4"></Line>
                        <Line X1="5" Y1="19" X2="19" Y2="5" Stroke="White" StrokeThickness="4"></Line>
                    </Canvas>
                    <Canvas x:Name="ICON_MIN" DockPanel.Dock="Right" Width="24" Height="24"
                                Style="{DynamicResource TopMenuIcon}"
                                MouseDown="ICON_MIN_MouseDown">
                        <Line X1="4" Y1="18" X2="20" Y2="18" Stroke="White" StrokeThickness="4"></Line>
                    </Canvas>

                    <Canvas Width="260" Margin="0 -3 0 0">
                        <Label x:Name="LABEL_TITLE" Content="스마트팩토리 MES시스템" 
                       FontSize="9" 
                           VerticalAlignment="Center"
                               Foreground="White" Width="180" Height="22"/>

                        <Label x:Name="LABEL_TITLE2" Content="0000-00-00 00:00" 
                               VerticalAlignment="Center"
                            FontSize="7" Canvas.Top="12"
                               Foreground="White" Width="180 " Height="20" />
                    </Canvas>


                    <Canvas Margin="-115 0 0 0" >
                        <ComboBox Margin="5"
                             Style="{DynamicResource AAA}"
                             x:Name="COMBO_PRINT" 
                             FontSize="6"
                             Width="100"
                             Height="16"
                             VerticalAlignment="Center" 
                             VerticalContentAlignment="Center"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Left"
                             FontFamily="DotumChe" 
                             SelectionChanged="COMBO_PRINT_SelectionChanged" />
                        <!--<Label x:Name="LABEL_LOGINUSER" Content="로그인 유저"                       
                               FontSize="9" 
                               VerticalAlignment="Center"
                               Foreground="White" Width="60" Height="22"/>
                        <Label x:Name="LABEL_LOIGNTIME" 
                               Content="접속시간 : 0000-00-00 00:00" 
                               VerticalAlignment="Center"
                               FontSize="7" Canvas.Top="12"
                               Foreground="White" Width="100 " Height="20" />-->
                    </Canvas>


                </DockPanel>

                <!-- 환경 설정 -->
                <DockPanel x:Name="PANEL_CONFIG" DockPanel.Dock="Top" Background="SteelBlue">
                    <DockPanel DockPanel.Dock="Bottom">
                        <its:Pass HidenLabel="Y" x:Name="CONFIG_PASS" FontSize="16"
                                  HorizontalAlignment="Center" VerticalContentAlignment="Center"
                             Width="210" DockPanel.Dock="Top"
                             KeyDown="CONFIG_PASS_KeyDown" ShowKeyPad="True"/>
                        <Button x:Name="PASS_CHECK" Background="IndianRed" Click="PASS_CHECK_Click"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="확인" Width="200" Height="20" DockPanel.Dock="Top"/>
                        <UserControl x:Name="CONFIG_LINE" Width="10" Height="10" DockPanel.Dock="Top" />
                        <its:WrapContent x:Name="PANEL_OPTION" Background="WhiteSmoke" DockPanel.Dock="Top">
                            <its:Combo x:Name="COMBO_COMPANYCD" Label="법인" Width="300" Value="{Binding COMPANYCD}" GPCD="COMPANYCD"></its:Combo>
                            <its:Combo x:Name="COMBO_FACTORYCD" Label="공장" Width="300" Value="{Binding FACTORYCD}" GPCD="FACTORYCD"></its:Combo>
                            <its:Combo x:Name="COMBO_TMLCD" Label="단말기" Width="300" Value="{Binding TMLCD}" GPCD="TMLCD"></its:Combo>
                            <!--<its:Combo x:Name="COMBO_PRINT" Label="프린터기" Width="300" Value="{Binding PRINT}"></its:Combo>-->
                            <its:Combo x:Name="COMBO_SCALEPORT" Label="저울포트" Width="150" Value="{Binding PORTSCALE}"></its:Combo>
                            <its:Combo x:Name="COMBO_PLCPORT" Label="PLC포트" Width="150" Value="{Binding PORTPLC}"></its:Combo>
                            <UserControl Height="20" Width="300"/>
                        </its:WrapContent>
                    </DockPanel>
                    <Canvas x:Name="ConfigIcon" Width="30" Height="30" DockPanel.Dock="Left"
                                    Style="{DynamicResource ConfigIcon}">
                        <Ellipse Width="6" Height="6" Stroke="White" StrokeThickness="2" Canvas.Top="12" Canvas.Left="12"/>
                        <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2" Canvas.Top="9" Canvas.Left="9"/>
                        <Line X1="9" Y1="9" X2="11" Y2="11" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="7" Y1="15" X2="10" Y2="15" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="9" Y1="21" X2="11" Y2="19" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="15" Y1="23" X2="15" Y2="20" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="19" Y1="19" X2="21" Y2="21" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="19" Y1="15" X2="23" Y2="15" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="19" Y1="11" X2="21" Y2="9" Stroke="White" StrokeThickness="3"></Line>
                        <Line X1="15" Y1="7" X2="15" Y2="10" Stroke="White" StrokeThickness="3"></Line>
                    </Canvas>
                    <Canvas Width="30" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="5 0 5 0"
                    x:Name="ConfigClose"
                    Style="{DynamicResource ConfigIcon}"
                    MouseUp="CONFIG_CLOSE_MouseUp">
                        <Ellipse Width="24" Height="24" Canvas.Left="3" Canvas.Top="3" Stroke="White" StrokeThickness="4"></Ellipse>
                        <Line X1="10" Y1="10" X2="20" Y2="20" Stroke="White" StrokeThickness="4"></Line>
                        <Line X1="10" Y1="20" X2="20" Y2="10" Stroke="White" StrokeThickness="4"></Line>
                    </Canvas>
                    <Canvas Width="30" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Center"
                    x:Name="ConfigCommit"
                    Style="{DynamicResource ConfigIcon}"
                    MouseUp="CONFIG_COMMIT_MouseUp">
                        <Ellipse Width="24" Height="24" Canvas.Left="3" Canvas.Top="3" Stroke="White" StrokeThickness="4"></Ellipse>
                        <Line X1="9" Y1="13" X2="16" Y2="20" Stroke="White" StrokeThickness="4"></Line>
                        <Line X1="14" Y1="20" X2="20" Y2="10" Stroke="White" StrokeThickness="4"></Line>
                    </Canvas>
                    <UserControl Foreground="White" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock x:Name="TEXT_Config" TextAlignment="Center" TextWrapping="WrapWithOverflow">>>> 환경설정 >>></TextBlock>
                    </UserControl>
                </DockPanel>

                <!-- 컨텐츠 -->
                <Viewbox Stretch="Fill" DockPanel.Dock="Bottom">
                    <DockPanel x:Name="DOCK_FRAME" Background="White">
                        <DockPanel x:Name="PAGE_MAIN" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME_MAIN"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE0" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME0"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE1" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME1"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE2" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME2"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE3" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME3"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE4" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME4"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE5" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME5"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE6" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME6"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE7" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME7"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE8" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME8"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="PAGE9" DockPanel.Dock="Top">
                            <Frame x:Name="FRAME9"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE0" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME0"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE1" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME1"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE2" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME2"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE3" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME3"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE4" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME4"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE5" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME5"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE6" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME6"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE7" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME7"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE8" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME8"></Frame>
                        </DockPanel>
                        <DockPanel x:Name="OTHER_PAGE9" DockPanel.Dock="Top">
                            <Frame x:Name="OTHER_FRAME9"></Frame>
                        </DockPanel>
                    </DockPanel>
                </Viewbox>
            </DockPanel>

            <!-- 메시지 박스 -->
            <DockPanel x:Name="WAIT_MSG" Background="SteelBlue" Margin="0 80 0 80">
                <Canvas x:Name="WAIT_ICON" 
                        Visibility="{Binding WAITVISIBLE, Mode=TwoWay, Converter={StaticResource myStringToVisibility}, ConverterParameter=Disabled}"
                        Width="20" Height="20" Margin="50 0 0 0" DockPanel.Dock="Left">
                    <Ellipse x:Name="WAIT_PROCESS" 
                             Width="20" Height="20" Stroke="White" StrokeThickness="4"/>
                    <Line X1="0" Y1="0" X2="20" Y2="20" Stroke="SteelBlue" StrokeThickness="3"></Line>
                    <Line X1="0" Y1="10" X2="20" Y2="10" Stroke="SteelBlue" StrokeThickness="3"></Line>
                    <Line X1="0" Y1="20" X2="20" Y2="0" Stroke="SteelBlue" StrokeThickness="3"></Line>
                    <Line X1="10" Y1="0" X2="10" Y2="20" Stroke="SteelBlue" StrokeThickness="3"></Line>
                </Canvas>
                <Label Margin="5 0 0 0" VerticalAlignment="Center" 
                       FontWeight="Bold" Foreground="White">데이터처리중입니다. 잠시만 기다려주세요.</Label>
            </DockPanel>

            <!-- 처리중 박스 -->
            <DockPanel x:Name="PANEL_MSG"  Margin="0 80 0 80">
                <UserControl Width="50" DockPanel.Dock="Left"></UserControl>
                <Canvas x:Name="MsgIcon" Width="30" Height="30" DockPanel.Dock="Left"
                    Style="{DynamicResource MsgIcon}">
                    <Line X1="16" Y1="9" X2="22" Y2="9" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="14" Y1="13" X2="24" Y2="13" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="16" Y1="17" X2="22" Y2="17" Stroke="White" StrokeThickness="2"></Line>
                    <Line X1="14" Y1="21" X2="24" Y2="21" Stroke="White" StrokeThickness="2"></Line>
                </Canvas>
                <Canvas Width="30" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="5 0 5 0"
                    x:Name="MsgClose"
                    Style="{DynamicResource MsgIcon}"
                    MouseUp="MSG_CLOSE_MouseUp">
                    <Ellipse Width="24" Height="24" Canvas.Left="3" Canvas.Top="3" Stroke="White" StrokeThickness="4"></Ellipse>
                    <Line X1="10" Y1="10" X2="20" Y2="20" Stroke="White" StrokeThickness="4"></Line>
                    <Line X1="10" Y1="20" X2="20" Y2="10" Stroke="White" StrokeThickness="4"></Line>
                </Canvas>
                <Canvas Width="30" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Center"
                    x:Name="MsgCommit"
                    Style="{DynamicResource MsgIcon}"
                    MouseUp="MSG_COMMIT_MouseUp">
                    <Ellipse Width="24" Height="24" Canvas.Left="3" Canvas.Top="3" Stroke="White" StrokeThickness="4"></Ellipse>
                    <Line X1="9" Y1="13" X2="16" Y2="20" Stroke="White" StrokeThickness="4"></Line>
                    <Line X1="14" Y1="20" X2="20" Y2="10" Stroke="White" StrokeThickness="4"></Line>
                </Canvas>
                <UserControl Foreground="White" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock x:Name="TEXT_MSG" TextWrapping="WrapWithOverflow">저장하시겠습니까?</TextBlock>
                </UserControl>
            </DockPanel>

                <!-- 기타 메뉴 -->
            <Popup x:Name="POP_OTHER_MENU" IsOpen="False" StaysOpen="False" Width="70"
                   PlacementTarget="{Binding ElementName=DOCK_TITLE}"
                   Placement="Bottom">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="SteelBlue" BorderThickness="1">
                        <StackPanel x:Name="PANEL_OTHER_MENU" Background="WhiteSmoke">
                            <UserControl Tag="OTHER_CLOSE" MouseUp="MENU_MouseUp" Background="SteelBlue" Foreground="White"
                                     HorizontalContentAlignment="Right" FontSize="9"
                                     VerticalContentAlignment="Center">
                                <DockPanel HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center" Margin="0 0 3 0">기타메뉴</TextBlock>
                                    <Canvas Width="20" Height="20">
                                        <Line X1="4" Y1="4" X2="16" Y2="16" Stroke="White" StrokeThickness="4"></Line>
                                        <Line X1="4" Y1="16" X2="16" Y2="4" Stroke="White" StrokeThickness="4"></Line>
                                    </Canvas>
                                </DockPanel>
                            </UserControl>
                            <UserControl Name="OTHER_MENU0" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="OTHER_MENU1" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
                            <UserControl Name="OTHER_MENU2" Style="{DynamicResource TML_MENU}" MouseUp="MENU_MouseUp">메뉴</UserControl>
