<Window x:Class="TMLMAIN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TMLMAIN"
        xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
        xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
        FontFamily="Fonts/#Roboto Medium.ttf"
        Icon="icon_tml.ico"
        mc:Ignorable="d" 
        WindowState="Maximized"
        WindowStyle="None">
    <Window.Resources>
         <ResourceDictionary>

            <local:StringToVisibility x:Key="myStringToVisibility"></local:StringToVisibility>

            <!-- 메뉴 아이콘 -->
            <Style x:Key="TopMenuIcon" TargetType="Canvas">
                <Setter Property="Background" Value="#262938"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 닫기 & 환경설정 -->
            <Style x:Key="TopMenuLeft" TargetType="Canvas">
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 창 닫기 아이콘 -->
            <Style x:Key="MainIconClose" TargetType="Canvas">
                <Setter Property="Background" Value="#262938"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="IndianRed"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 메시지 아이콘 -->
            <Style x:Key="MsgIcon" TargetType="Canvas">
                <Setter Property="Background" Value="IndianRed"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 환경설정 아이콘 -->
            <Style x:Key="ConfigIcon" TargetType="Canvas">
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 메뉴 -->
            <Style x:Key="TML_MENU" TargetType="{x:Type UserControl}">
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush" Value="#262938"/>
                <Setter Property="Background" Value="#262938"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Width" Value="47"/>
                <Setter Property="Height" Value="19"/>
                <!--<Setter Property="Margin" Value="1 1 1 1"/>-->
                <Setter Property="FontFamily" Value="Fonts/#Roboto Medium.ttf"></Setter>
                <Setter Property="FontSize" Value="5"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#262938"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="#70A6F3"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="#70A6F3"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>

        
    </Window.Resources>
 
