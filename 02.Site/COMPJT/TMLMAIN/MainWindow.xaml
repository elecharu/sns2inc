<Window x:Class="TMLMAIN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TMLMAIN"
        xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
        xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
        FontFamily="Fonts/#Roboto Medium.ttf"
        Icon="icon_tml.ico"
        mc:Ignorable="d" 
        WindowState="Maximized"
        WindowStyle="None">
    <Window.Resources>
         <ResourceDictionary>

            <local:StringToVisibility x:Key="myStringToVisibility"></local:StringToVisibility>

            <!-- 메뉴 아이콘 -->
            <Style x:Key="TopMenuIcon" TargetType="Canvas">
                <Setter Property="Background" Value="#262938"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 닫기 & 환경설정 -->
            <Style x:Key="TopMenuLeft" TargetType="Canvas">
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 창 닫기 아이콘 -->
            <Style x:Key="MainIconClose" TargetType="Canvas">
                <Setter Property="Background" Value="#262938"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="IndianRed"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 메시지 아이콘 -->
            <Style x:Key="MsgIcon" TargetType="Canvas">
                <Setter Property="Background" Value="IndianRed"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 환경설정 아이콘 -->
            <Style x:Key="ConfigIcon" TargetType="Canvas">
                <Setter Property="Background" Value="SeaGreen"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="Canvas.IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="Silver"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 메뉴 -->
            <Style x:Key="TML_MENU" TargetType="{x:Type UserControl}">
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="BorderBrush" Value="#262938"/>
                <Setter Property="Background" Value="#262938"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Width" Value="47"/>
                <Setter Property="Height" Value="19"/>
                <!--<Setter Property="Margin" Value="1 1 1 1"/>-->
                <Setter Property="FontFamily" Value="Fonts/#Roboto Medium.ttf"></Setter>
                <Setter Property="FontSize" Value="5"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#262938"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground">
                            <Setter.Value>
                                <SolidColorBrush Color="#70A6F3"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="#70A6F3"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>

        
    </Window.Resources>
 
    <Viewbox Stretch="Fill">
        <Grid Width="600" Height="315">
            <DockPanel x:Name="DOCK_MAIN" Background="White" Margin="0">

                <!-- 좌측 메뉴 -->
                <!--<UserControl Width="1" Height="5000" Background="DarkOrange"/>-->

                <!-- 상단 타이틀 -->
                <DockPanel x:Name="DOCK_TITLE" DockPanel.Dock="Top" Background="#141622">
                    <DockPanel Width="600" DockPanel.Dock="Top" Height="21">

                        <Label x:Name="LABEL_TITLE_MAIN" Content=" S&amp;S 2공장 MES 현장 프로그램 " 
                               FontSize="7" Margin="5 0 0 0" Padding="0 0 0 0" VerticalAlignment="Center" Foreground="White"/>
                        <Label x:Name="LABEL_TITLE_TIME" Content="0000-00-00 00:00" 
                               FontSize="7" Margin="5 0 0 0" Padding="0 0 0 0" VerticalAlignment="Center" Foreground="White"/>
                        <Canvas x:Name="ICON_CLOSE" DockPanel.Dock="Right" Width="10" Height="10" 
                                Style="{DynamicResource MainIconClose}" Margin="5,0,5,0"
                                MouseDown="ICON_CLOSE_MouseDown">
                            <Line X1="3" Y1="3" X2="7" Y2="7" Stroke="White" StrokeThickness="1"></Line>
                            <Line X1="3" Y1="7" X2="7" Y2="3" Stroke="White" StrokeThickness="1"></Line>
                        </Canvas>
                        <Canvas x:Name="ICON_MIN" DockPanel.Dock="Right" Width="11" Height="10" 
                                Style="{DynamicResource TopMenuIcon}"
                                MouseDown="ICON_MIN_MouseDown">
                            <Line X1="3" Y1="7" X2="9" Y2="7" Stroke="White" StrokeThickness="1"></Line>
                        </Canvas>

                        <Canvas DockPanel.Dock="Left" Margin="10 0 90 0" Width="100" >
                            <Label x:Name="LABEL_TITLE" Content="" Margin="0,8,0,0" Width="250"
                               FontSize="5" Padding="0 0 0 0" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Canvas>
                        <Canvas x:Name="PRINT_SETTING" DockPanel.Dock="Right" Width="120" Height="20">
                            <TextBlock Margin="0 6 0 0" Foreground="White" HorizontalAlignment="Center" FontSize="7">프린트</TextBlock>
                            <its:Combo x:Name="COMBO_PRINT" Width="130" FontSize="7" LabelWidth="0" 
                                       Margin="30 -3.5 0 0" Value="{Binding PRINT}" />
                            <!--<ComboBox Margin="50 3 0 0"
                             x:Name="COMBO_PRINT" 
                             FontSize="6"
                             Width="100"
                             Height="16"
                             VerticalAlignment="Center" 
                             VerticalContentAlignment="Center"
                             HorizontalAlignment="Right"
                             HorizontalContentAlignment="Left"
                             FontFamily="DotumChe" 
                             SelectionChanged="COMBO_PRINT_SelectionChanged" />-->
                        </Canvas>
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="Silver" BorderThickness="0">
                        <DockPanel x:Name="PANEL_MENU" DockPanel.Dock="Bottom" Width="600" Background="#262938"  >
                            <!-- 2026-11-16 상단 메뉴줄(MENU0~10, 기타메뉴) 없앰 → 전체화면 타일 메뉴(PANEL_HOME). 이 버튼은 타일 메뉴로 돌아가기 -->
                            <UserControl x:Name="MENU_HOME" Style="{DynamicResource TML_MENU}" MouseUp="MENU_HOME_MouseUp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="6" VerticalAlignment="Center" Margin="0 0 2 0"/>
                                    <TextBlock Text="메뉴" VerticalAlignment="Center"/>
                                </StackPanel>
                            </UserControl>
                            <!-- 2026-11-16 메뉴 목록·타일 설정을 DB 에서 다시 읽기 (열린 화면은 닫힘) -->
                            <UserControl x:Name="MENU_REFRESH" Style="{DynamicResource TML_MENU}" MouseUp="MENU_REFRESH_MouseUp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="5.5" VerticalAlignment="Center" Margin="0 0 2 0"/>
                                    <TextBlock Text="새로고침" VerticalAlignment="Center"/>
                                </StackPanel>
                            </UserControl>

                            <Canvas x:Name="ICON_CONFIG" DockPanel.Dock="Left" Width="30" Height="11" 
                                    Style="{DynamicResource TopMenuIcon}" MouseDown="ICON_CONFIG_MouseDown" Margin="15 0 0 0">
                                <Image Source="image/settings_ic_settings_white.png" Width="5.5" Height="4.1" Margin="0 3 0 0"></Image>
                                <Label   Content="환경설정" FontSize="5" Margin="7 2 0 0" Padding="0 0 0 0" VerticalAlignment="Center" Foreground="White"/>
                            </Canvas>
                            
                            <!--경진에서는 자동발행 주석처리-->
                            <Canvas DockPanel.Dock="Right" Width="34" Height="11" HorizontalAlignment="Right" >
                                <CheckBox x:Name="AUTOPRINT" Width="6" Height="6.5" Content="" FontSize="7"  FontFamily="Fonts/#Roboto Medium.ttf"
                                       Padding="0 0 0 0" VerticalAlignment="Center" Foreground="White" BorderThickness="0" Margin="0 2 0 0"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Visibility="Collapsed">
                                    <CheckBox.Resources>
                                        <SolidColorBrush x:Key="MaterialDesignCheckBoxOff" Color="#FF707070"/>
                                        <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#FF4DFF65"/>
                                    </CheckBox.Resources>
                                </CheckBox>
                                <Label Content="자동출력" FontSize="5" Margin="8 2 0 0" Padding="0 0 0 0" VerticalAlignment="Center" Foreground="White" Visibility="Collapsed"/>

                           </Canvas>
                        </DockPanel>

                    </Border>
                </DockPanel>

                <!-- 환경 설정 -->
                <DockPanel x:Name="PANEL_CONFIG" DockPanel.Dock="Top" >
                    <DockPanel.Background>
                        <ImageBrush ImageSource="image/main_setting.png" Stretch="Fill" />
                    </DockPanel.Background>
                    <DockPanel DockPanel.Dock="Bottom">
                        <Canvas x:Name="PANEL_PASSWORD"  Height="270" Width="600">
                            <Rectangle Fill="#262938" Width="240" Height="42" Canvas.Top="100" Canvas.Left="170" />
                            <Image Source="image/settings_popup_lock.png" Stretch="Fill" Width="20" Height="18" Opacity="50"
                                   Canvas.Top="110" Canvas.Left="187" ></Image>
                            <!--<PasswordBox x:Name="CONFIG_PASS" FontSize="16" Canvas.Top="110" Canvas.Left="220"  Margin="0 0 0 0"                        
                                 Width="100" Height="20" DockPanel.Dock="Top" Background="#7C7C7C" Foreground="White" BorderThickness="0"
                                 KeyDown="CONFIG_PASS_KeyDown"></PasswordBox>-->
                            <its:Pass HidenLabel="Y" x:Name="CONFIG_PASS" FontSize="16" Canvas.Top="105" Canvas.Left="220" Margin="0 0 0 0"
                                Width="100" Height="20" DockPanel.Dock="Top" Background="#7C7C7C" Foreground="White" BorderThickness="0"
                                KeyDown="CONFIG_PASS_KeyDown" ShowKeyPad="True"/>
                            <Canvas Width="30" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="5 0 5 0"
                                x:Name="passCheck"  Background="Transparent"  Canvas.Top="110" Canvas.Left="330"  
                                Style="{DynamicResource ConfigIcon}"
                                MouseUp="CONFIG_PASS_UP">
                                <TextBlock Text="확인" Foreground="White" FontSize="11"  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3 2 0 0" />
                            </Canvas>
                            <Canvas Width="30" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="5 0 5 0"
                                x:Name="passcancel"  Background="Transparent"  Canvas.Top="110" Canvas.Left="365"  
                                Style="{DynamicResource ConfigIcon}"
                                MouseUp="CONFIG_CLOSE_MouseUp">
                                <TextBlock Text="취소" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3 2 0 0"  />
                            </Canvas>
                            
                            <Button x:Name="PASS_CHECK" Background="Transparent"  Click="PASS_CHECK_Click" Foreground="White" FontSize="9"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  BorderThickness="0"
                                    Canvas.Top="110" Canvas.Left="320"  Visibility="Hidden"
                                    Content="확인" Width="50" Height="20" DockPanel.Dock="Top"/>

                        </Canvas>


                        <UserControl x:Name="CONFIG_LINE" Width="10" Height="10" DockPanel.Dock="Top" />
                        <Grid x:Name="PANEL_OPTION" DockPanel.Dock="Top" Background="WhiteSmoke">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="170"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#ECECEC">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="5"/>

                                </Grid.RowDefinitions>
                                <Image Width="13" Height="11" Source="image/settings_ic_settings_black.png" Margin="0 0 65 0" ></Image>
                                <TextBlock Margin="0 0 0 0" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">환경설정</TextBlock>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="5"/>
                                    </Grid.ColumnDefinitions>

                                    <its:Combo Grid.Column="0" Label="사업장" Width="140" LabelWidth="50" Value="{Binding BDVCD}" GPCD="BDVCD" FontSize="10"></its:Combo>
                                    <its:Combo Grid.Column="1" x:Name="COMBO_TMLCD" Label="단말기" Width="150" LabelWidth="40" Value="{Binding TMLCD}" GPCD="TMLCD" FontSize="10"></its:Combo>
                                    <its:Combo Grid.Column="2" x:Name="COMBO_EMPCD" Label="사용자" Width="140" LabelWidth="40" Value="{Binding TMLEMP}" GPCD="EMPCD" FontSize="10" ></its:Combo>
                                    <its:Combo Grid.Column="3" x:Name="COMBO_PRINTTP" Label="자동출력유형" Width="150" LabelWidth="70" Value="{Binding PRINTTP}" GPCD="*PRINTTP" FontSize="10" Visibility="Collapsed" ></its:Combo>

                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" BorderThickness="1" BorderBrush="#CBCBCB" Margin="5" Visibility="Hidden">
                                    <StackPanel >
                                        <TextBlock Margin="0 10 0 10" HorizontalAlignment="Center" FontSize="10">프린트(A4)</TextBlock>
                                        <Image Width="100" Height="90" Source="image/settings_img_printer.png" ></Image>
                                        <its:Combo Grid.Column="0" x:Name="COMBO_PRINT_SALES1" Label="" Width="130" FontSize="10" LabelWidth="0" Margin="0 5 0 0"
                                                   Value="{Binding PRINT_SALES1}"></its:Combo>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" BorderThickness="1" BorderBrush="#CBCBCB" Margin="5" Visibility="Hidden">
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Margin="0 10 0 10" HorizontalAlignment="Center" FontSize="10">프린트(자동출력)</TextBlock>
                                        <Image Width="100" Height="90" Source="image/settings_img_printer.png" ></Image>
                                        <its:Combo Grid.Column="1"  x:Name="COMBO_PRINT_SALES2" Label="" Width="130" FontSize="10" LabelWidth="0" Margin="0 5 0 0"
                                                   Value="{Binding PRINT_SALES2}"></its:Combo>
                                    </StackPanel>
                                </Border>

                                <!--<Border Grid.Column="2" BorderThickness="1" BorderBrush="#CBCBCB" Margin="5" Visibility="Hidden">
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Margin="0 10 0 10" HorizontalAlignment="Center" FontSize="10">프린트(바코드 40mm)</TextBlock>
                                        <Image Width="100" Height="90" Source="image/settings_img_printer.png" ></Image>
                                        <its:Combo Grid.Column="2"  x:Name="COMBO_PRINT" Label="" Width="130"  FontSize="10" LabelWidth="0" Margin="0 5 0 0"
                                                   Value="{Binding PRINT}"></its:Combo>
                                    </StackPanel>
                                </Border>-->

                                <Border Grid.Column="3" BorderThickness="1" BorderBrush="#CBCBCB" Margin="5" Visibility="Hidden">
                                    <StackPanel Grid.Column="3">
                                        <TextBlock  Margin="0 10 0 10" HorizontalAlignment="Center" FontSize="10">프린트(바코드 70mm)</TextBlock>
                                        <Image Width="100" Height="90" Source="image/settings_img_printer.png" ></Image>
                                        <its:Combo Grid.Column="3" x:Name="COMBO_PRINT_DAESIN" Label="" Width="130"  FontSize="10" LabelWidth="0" Margin="0 5 0 0"
                                                   Value="{Binding PRINT_DAESIN}"></its:Combo>
                                    </StackPanel>
                                </Border>

                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas Grid.Column="1" Width="102" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="0 0 0 0"
                                        x:Name="ConfigCommit" Background="Transparent"
                                        Style="{DynamicResource ConfigIcon}"
                                        MouseUp="CONFIG_COMMIT_MouseUp">
                                    <Border BorderThickness="1" CornerRadius="5" BorderBrush="#262938" Background="#262938" Width="100" Height="25">
                                        <Grid>
                                            <TextBlock Text="확인" Foreground="White"  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Canvas>
                                <Canvas Grid.Column="2" Width="102" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Center" Margin="0 0 0 0"
                                        x:Name="ConfigClose"  Background="Transparent"
                                        Style="{DynamicResource ConfigIcon}"
                                        MouseUp="CONFIG_CLOSE_MouseUp">
                                    <Border BorderThickness="1" CornerRadius="5" BorderBrush="#262938" Background="#262938" Width="100" Height="25">
                                        <Grid>
                                            <TextBlock Text="취소" Foreground="White"  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Grid>
                        <!--<its:WrapContent  Background="WhiteSmoke" DockPanel.Dock="Top">
 
                            <its:Combo x:Name="COMBO_SCALEPORT" Label="저울포트" Width="300" Value="{Binding PORTSCALE}" Visibility="Collapsed"></its:Combo>
                            <its:Combo x:Name="COMBO_PLCPORT" Label="PLC포트" Width="300" Value="{Binding PORTPLC}" Visibility="Collapsed"></its:Combo>
                            <UserControl Height="20" Width="300"/>

                            <UserControl Height="20" Width="300"/>
                        </its:WrapContent>-->
                    </DockPanel>
 
                </DockPanel>

                <!-- 컨텐츠 : 화면(DOCK_FRAME) 위에 타일 메뉴(PANEL_HOME)를 겹쳐 둔다 -->
                <Grid x:Name="GRID_CONTENT">
                    <Viewbox Stretch="Fill">
                        <DockPanel x:Name="DOCK_FRAME" Background="White">
                            <DockPanel x:Name="PAGE_MAIN" DockPanel.Dock="Top">
                                <Frame x:Name="FRAME_MAIN"></Frame>
                            </DockPanel>
                            <!-- 메뉴별 화면 칸은 메뉴 개수만큼 SetMenu 에서 이 아래에 만든다 (2026-11-16 고정 PAGE0~10 없앰) -->
                        </DockPanel>
                    </Viewbox>

                    <!-- 2026-11-16 타일 메뉴 : 로그인 후 첫 화면. 타일은 SetMenu 에서 메뉴 순번대로 만든다 -->
                    <Grid x:Name="PANEL_HOME" Background="#F4F4F4">
                        <!-- 위→아래로 채우고 다음 열로. 열 사이 간격 칸은 SetMenu(BuildMenus) 에서 만든다
                             2026-11-16 7열부터는 열 폭을 6열일 때로 고정하고 가로 스크롤 (터치로 끌기, 마우스 휠) -->
                        <ScrollViewer x:Name="SCROLL_TILE" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly" PreviewMouseWheel="SCROLL_TILE_PreviewMouseWheel">
                            <ScrollViewer.Resources>
                                <!-- 화면 전체가 확대되어 보이므로 스크롤바를 얇게 -->
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Height" Value="6"/>
                                    <Setter Property="MinHeight" Value="6"/>
                                </Style>
                            </ScrollViewer.Resources>
                            <Grid x:Name="GRID_TILE" Margin="6 6 6 6"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </DockPanel>

            <!-- 처리중 박스 -->

            <DockPanel x:Name="WAIT_MSG" Background="white" Width="150" Height="140" Margin="0 0 0 0" >
                <Border DockPanel.Dock="Top" Width="150" Height="100" Background="#5C84EE" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect Color="black" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Width="150" Height="100" Background="#5C84EE">
                        <Image Source="popup_ic_loading.png" Width="40" VerticalAlignment="Center"  Margin="0 20 0 0"  ></Image>
                        <Label FontFamily="LG Smart UI Bold" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Foreground="#FFFFFF">Loading</Label>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Width="150" Background="#FFFFFF" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect Color="black" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel  Width="150" Height="40">
                        <UserControl Height="8"></UserControl>
                        <Label Height="12" FontSize="10" Margin="0" Padding="0" FontFamily="LG Smart UI Regular" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Foreground="#6C6C6C">데이터 처리중...</Label>
                        <Label Height="12" FontSize="10" Margin="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Foreground="#6C6C6C" FontFamily="LG Smart UI Regular">잠시만 기다려 주세요</Label>
                        <UserControl Height="10"></UserControl>
                    </StackPanel>
                </Border>
            </DockPanel>


            <!-- 메세지 박스 -->
            <!-- 2026-11-16 내용 길이에 맞게 크기 자동 조절: 너비 250~400 (넘으면 줄바꿈), 높이는 줄 수만큼 늘어남.
                 배경 그림(TEXT_MSG_IMG)은 메시지 칸 크기에 맞춰 늘려 그린다 -->
            <DockPanel x:Name="PANEL_MSG" MinWidth="250" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Margin="0 0 0 0" >
                <Border DockPanel.Dock="Top" MinHeight="68" BorderThickness="0">
                    <Border.Background>
                        <ImageBrush x:Name="TEXT_MSG_IMG" ImageSource="popup_bg_choice.png" Stretch="Fill"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="black" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel Margin="10 7 10 10">
                        <TextBlock Foreground="White" FontWeight="Medium" FontFamily="Global User Interface" FontSize="12">Message</TextBlock>
                        <UserControl Margin="-10 4 -10 6" Background="White" Height="2" Opacity="0.4"/>
                        <TextBlock x:Name="TEXT_MSG" Foreground="White" TextWrapping="Wrap" FontFamily="Global User Interface" FontSize="10">저장하시겠습니까?</TextBlock>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect Color="black" Opacity="0.15" />
                    </Border.Effect>
                    <!-- 버튼은 오른쪽 정렬 (메시지 칸 너비가 바뀌어도 오른쪽 끝에 붙음) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <UserControl Width="50" Background="#468CC6" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            x:Name="MsgCommit" Height="16" MouseUp="MSG_COMMIT_MouseUp"
                            Margin="0 9 5 9" FontFamily="Global User Interface" FontSize="9">
                            <TextBlock TextWrapping="WrapWithOverflow">OK</TextBlock>
                        </UserControl>
                        <UserControl Width="50" Height="16" Background="#BFBFBF" Foreground="White"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            x:Name="MsgClose" MouseUp="MSG_CLOSE_MouseUp"
                            Margin="0 9 10 9" FontFamily="Global User Interface" FontSize="9" >
                            <TextBlock TextWrapping="WrapWithOverflow">NO</TextBlock>
                        </UserControl>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>
    </Viewbox>
</Window>
