<its:ItsPageOffice x:Class="SYS0101.R02"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0101"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R02">
    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <its:Text Label="키워드" Value="{Binding KEYWORD}"/>
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <UserControl Style="{DynamicResource GRID}" Grid.Column="0">
                <its:Grid x:Name="GRID_G1">
                    <its:Grid.Columns>
                        <!-- ################################# COLUMN FLEX: START -->
                        <its:Column Width="100" Header="그룹코드" FieldName="GPCD1"/>
                        <its:Column Width="100" Header="헤더명" FieldName="GPNM"/>
                        <!-- ################################# COLUMN FLEX: END -->
                    </its:Grid.Columns>
                </its:Grid>
            </UserControl>
            <GridSplitter Grid.Column="1"/>
            <DockPanel Grid.Column="2">
                <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
                    <its:WrapContent x:Name="PANEL_A1">
                        <!-- ################################# PANEL CONTENT: START -->
                        <its:Text Label="상세코드" Value="{Binding TPCD}"/>
                        <its:Text Label="상세명" Value="{Binding TPNM}"/>
                        <its:Number Label="정렬순서" DecimalPoint="0" Value="{Binding SORTNO}"/>
                        <its:Check Label="사용여부" Value="{Binding USEYN}"/>
                        <UserControl Width="5000"/>
                        <its:Text Label="참조01" x:Name="REF01" Visibility="Visible" Value="{Binding REF01}"/>
                        <its:Text Label="참조02" x:Name="REF02" Visibility="Visible"  Value="{Binding REF02}"/>
                        <its:Text Label="참조03" x:Name="REF03" Visibility="Visible"  Value="{Binding REF03}"/>
                        <its:Text Label="참조04" x:Name="REF04" Visibility="Visible"  Value="{Binding REF04}"/>
                        <its:Text Label="참조05" x:Name="REF05" Visibility="Visible"  Value="{Binding REF05}"/>
                        <UserControl Width="5000"/>
                        <its:Text Label="참조06" x:Name="REF06" Visibility="Visible"  Value="{Binding REF06}"/>
                        <its:Text Label="참조07" x:Name="REF07" Visibility="Visible"  Value="{Binding REF07}"/>
                        <its:Text Label="참조08" x:Name="REF08" Visibility="Visible"  Value="{Binding REF08}"/>
                        <its:Text Label="참조09" x:Name="REF09" Visibility="Visible"  Value="{Binding REF09}"/>
                        <its:Text Label="참조10" x:Name="REF10" Visibility="Visible"  Value="{Binding REF10}"/>
                        <UserControl Width="5000"/>
                        <its:Text Label="참조11" x:Name="REF11" Visibility="Visible"  Value="{Binding REF11}"/>
                        <its:Text Label="참조12" x:Name="REF12" Visibility="Visible"  Value="{Binding REF12}"/>
                        <its:Text Label="참조13" x:Name="REF13" Visibility="Visible"  Value="{Binding REF13}"/>
                        <its:Text Label="참조14" x:Name="REF14" Visibility="Visible"  Value="{Binding REF14}"/>
                        <its:Text Label="참조15" x:Name="REF15" Visibility="Visible"  Value="{Binding REF15}"/>
                        <UserControl Width="5000"/>
                        <its:Text Label="참조16" x:Name="REF16" Visibility="Visible"  Value="{Binding REF16}"/>
                        <its:Text Label="참조17" x:Name="REF17" Visibility="Visible"  Value="{Binding REF17}"/>
                        <its:Text Label="참조18" x:Name="REF18" Visibility="Visible"  Value="{Binding REF18}"/>
                        <its:Text Label="참조19" x:Name="REF19" Visibility="Visible"  Value="{Binding REF19}"/>
                        <its:Text Label="참조20" x:Name="REF20" Visibility="Visible"  Value="{Binding REF20}"/>
                        <UserControl Width="5000"/>
                        <its:Text Label="비고" Width="400" Value="{Binding REMARK}"/>
                        <!-- ################################# PANEL CONTENT: END -->
                    </its:WrapContent>
                </UserControl>
                <UserControl Style="{DynamicResource GRID}">
                    <its:Grid x:Name="GRID_G2">
                        <its:Grid.Columns>
                            <!-- ################################# COLUMN FLEX: START -->
                            <its:Column Width="100" Header="선택" IsRowCheck="True"/>
                            <its:Column Width="100" Header="그룹코드" FieldName="GPCD1" Visible="False"/>
                            <its:Column Width="100" Header="헤더명" FieldName="GPNM" Visible="False"/>
                            <its:Column Width="100" Header="상세코드" FieldName="TPCD" ReadOnly="True"/>
                            <its:Column Width="100" Header="상세명" FieldName="TPNM" ReadOnly="False"/>
                            <its:Column Width="100" Header="정렬순서" FieldName="SORTNO" ReadOnly="False" DecimalPoint="0"/>
                            <its:Column Width="100" Header="사용여부" FieldName="USEYN" ReadOnly="False" CellType="Check"/>
                            <its:Column Width="100" Header="참조01" FieldName="REF01" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조02" FieldName="REF02" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조03" FieldName="REF03" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조04" FieldName="REF04" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조05" FieldName="REF05" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조06" FieldName="REF06" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조07" FieldName="REF07" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조08" FieldName="REF08" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조09" FieldName="REF09" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조10" FieldName="REF10" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조11" FieldName="REF11" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조12" FieldName="REF12" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조13" FieldName="REF13" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조14" FieldName="REF14" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조15" FieldName="REF15" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조16" FieldName="REF16" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조17" FieldName="REF17" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조18" FieldName="REF18" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조19" FieldName="REF19" ReadOnly="False"/>
                            <its:Column Width="100" Header="참조20" FieldName="REF20" ReadOnly="False"/>
                            <its:Column Width="100" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                            <!-- ################################# COLUMN FLEX: END -->
                        </its:Grid.Columns>
                    </its:Grid>
                </UserControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</its:ItsPageOffice>
