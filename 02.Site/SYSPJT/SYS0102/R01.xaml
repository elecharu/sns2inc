<its:ItsPageOffice x:Class="SYS0102.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0102"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">
    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <its:Text Label="키워드" Width="300" Value="{Binding KEYWORD}"></its:Text>
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_A1">
                <!-- ################################# PANEL CONTENT: START -->
                <its:Text Label="권한코드" Value="{Binding AUTCD}"/>
                <its:Text Label="권한명" Value="{Binding AUTNM}"/>
                <its:Check Label="사업장변경" Value="{Binding BDVYN}" Visibility="Collapsed"/>
                <its:Check Label="부서변경" Value="{Binding DEPYN}" Visibility="Collapsed"/>
                <UserControl Width="5000"/>
                <its:Text Label="비고" Width="400" Value="{Binding REMARK}"/>
                <!-- ################################# PANEL CONTENT: END -->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource GRID}">
            <its:Grid x:Name="GRID_G1">
                <its:Grid.Columns>
                    <!-- ################################# COLUMN FLEX: START -->
                    <its:Column Width="100" Header="선택" IsRowCheck="True"/>
                    <its:Column Width="100" Header="권한코드" FieldName="AUTCD" ReadOnly="True"/>
                    <its:Column Width="100" Header="권한명" FieldName="AUTNM" ReadOnly="False"/>
                    <its:Column Width="100" Header="사업장변경" FieldName="BDVYN" CellType="Check" ReadOnly="False" Visible="False"/>
                    <its:Column Width="100" Header="부서변경" FieldName="DEPYN" CellType="Check" ReadOnly="False" Visible="False"/>
                    <its:Column Width="100" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                    <!-- ################################# COLUMN FLEX: END -->
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>
    </DockPanel>
</its:ItsPageOffice>
