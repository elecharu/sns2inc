<its:ItsPageOffice x:Class="SYS0203.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SYS0203"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">

    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <its:Pop Label="권한코드" Width="250" Value="{Binding AUTCD}" GPCD="AUTCD"></its:Pop>
                <its:Pop Label="화면정보" Width="250" Value="{Binding PRGCD}" GPCD="PRGCD"></its:Pop>
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_A1">
                <!-- ################################# MODEL_SEARCH : START -->
                <its:Pop GPCD="AUTCD" Width="250" Label="권한코드" Value="{Binding AUTCD}" />
                <its:Pop GPCD="PRGCD" Width="250" Label="화면정보" Value="{Binding PRGCD}" />
                <!-- ################################# MODEL_SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <UserControl Style="{DynamicResource GRID}">
            <its:Grid x:Name="GRID_G1">
                <!-- ################################# MODEL_GRID: START -->
                <its:Grid.Columns>
                    <its:Column Width="100" Header="선택" IsRowCheck="True"/>
                    <its:Column Width="100" Header="권한코드" FieldName="AUTCD"></its:Column>
                    <its:Column Width="100" Header="프로그램코드" FieldName="PRGCD"></its:Column>
                    <its:Column Width="150" Header="프로그램명" FieldName="PRGNM"/>
                    <its:Column Width="100" Header="조회권한" FieldName="SEARCHYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="추가권한" FieldName="INSERTYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="저장권한" FieldName="UPDATEYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="삭제권한" FieldName="DELETEYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="출력권한" FieldName="PRINTYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="미리보기권한" FieldName="PREVIEWYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="내보내기권한" FieldName="EXPORTYN" CellType="Check" ReadOnly="False"></its:Column>
                    <its:Column Width="100" Header="비고" FieldName="REMARK" ReadOnly="False"></its:Column>
                </its:Grid.Columns>
            </its:Grid>
            <!-- ################################# MODEL_GRID: END -->
        </UserControl>
    </DockPanel>
</its:ItsPageOffice>
