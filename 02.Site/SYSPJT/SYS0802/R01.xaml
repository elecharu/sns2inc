<its:ItsPageOffice x:Class="SYS0802.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
      xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
      xmlns:local="clr-namespace:SYS0802"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="R01">
    <DockPanel>
        <UserControl Style="{DynamicResource SEARCH}" DockPanel.Dock="Top">
            <its:WrapContent x:Name="PANEL_S1">
                <!-- ################################# PANEL SEARCH : START -->
                <its:Combo Label="프레임타입" Value="{Binding FRAMETP}" GPCD="*FRAMETP"/>
                <its:Text Label="키워드" Value="{Binding KEYWORD}" />
                <!-- ################################# PANEL SEARCH : END -->
            </its:WrapContent>
        </UserControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <UserControl Style="{DynamicResource GRID}" Grid.Column="0">
                <its:Grid x:Name="GRID_G1">
                    <its:Grid.Columns>
                        <!-- ################################# COLUMN FLEX: START -->
                        <its:Column Width="100" Header="장비키" FieldName="PLCCD"/>
                        <its:Column Width="100" Header="장비명" FieldName="PLCNM" ReadOnly="False"/>
                        <its:Column Width="100" Header="장비IP" FieldName="PLCIP" ReadOnly="False"/>
                        <its:Column Width="100" Header="장비포트" FieldName="PLCPORT" DecimalPoint="0" ReadOnly="False"/>
                        <its:Column Visible="False" Width="100" Header="프레임타입" FieldName="FRAMETP" ReadOnly="False" GPCD="FRAMETP"/>
                        <its:Column Visible="False" Width="100" Header="수집주기" FieldName="READCYCLE" DecimalPoint="0" ReadOnly="False"/>
                        <its:Column Visible="False" Width="100" Header="히스토리주기" FieldName="HISCYCLE" DecimalPoint="0" ReadOnly="False"/>
                        <its:Column Width="200" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                        <!-- ################################# COLUMN FLEX: END -->
                    </its:Grid.Columns>
                </its:Grid>
            </UserControl>
            <GridSplitter Grid.Column="1"/>
            <DockPanel Grid.Column="2">
                <UserControl Style="{DynamicResource ADD}" DockPanel.Dock="Top">
                    <its:WrapContent x:Name="PANEL_A1">
                        <!-- ################################# PANEL CONTENT: START -->
                        <its:Text Label="PLC번지" Value="{Binding PLCADDR}"/>
                        <its:Pop Width="250" Label="설비코드" Value="{Binding EQMCD}" GPCD="EQMCD"/>
                        <its:Text Width="300" Label="작업표준항목" Value="{Binding STDKNDCD}"/>
                        <UserControl Width="5000" />
                        <its:Number Label="변환계수" Value="{Binding CONVFACT}" DecimalPoint="0"/>
                        <its:Number Label="정렬순번" Value="{Binding SORTNO}" DecimalPoint="0"/>
                        <its:Number Label="현재 값" Value="{Binding PLCVALUE}" DecimalPoint="2"/>
                        <its:Number Label="쓰기 값" Value="{Binding WRITEVALUE}" DecimalPoint="2"/>
                        <UserControl Width="5000" />
                        <its:Check Width="100" Label="사용여부" Value="{Binding USEYN}"/>
                        <its:Check Width="100" Label="읽기여부" Value="{Binding READYN}"/>
                        <its:Check Width="100" Label="쓰기여부" Value="{Binding WRITEYN}"/>
                        <its:Check Width="100" Label="카운터번지YN" Value="{Binding CNTYN}"/>
                        <its:Check Width="100" Label="비가동YN" Value="{Binding NONYN}"/>
                        <its:Check Width="100" Label="리셋번지YN" Value="{Binding RESETYN}"/>
                        <its:Check Width="100" Label="히스토리YN" Value="{Binding HISYN}"/>
                        <its:Text Width="300" Label="비고" Value="{Binding REMARK}"/>
                        <!-- ################################# PANEL CONTENT: END -->
                    </its:WrapContent>
                </UserControl>
                <UserControl Style="{DynamicResource GRID}" Grid.Column="2">
                    <its:Grid x:Name="GRID_G2">
                        <its:Grid.Columns>
                            <!-- ################################# COLUMN FLEX: START -->
                            <its:Column Width="100" Header="선택" ReadOnly="True" IsRowCheck="True" />
                            <its:Column Width="100" Header="PLC코드" FieldName="PLCCD"/>
                            <its:Column Width="100" Header="PLC번지" FieldName="PLCADDR"/>
                            <its:Column Width="200" Header="작업표준항" FieldName="STDKNDCD" ReadOnly="False"/>
                            <its:Column Width="100" Header="설비코드" FieldName="EQMCD" ReadOnly="False" GPCD="EQMCD"/>
                            <its:Column Width="100" Header="정렬순번" FieldName="SORTNO" ReadOnly="False" DecimalPoint="0"/>
                            <its:Column Visible="True" Width="100" Header="현재값" FieldName="PLCVALUE" DecimalPoint="8" ReadOnly="False"/>
                            <its:Column Visible="True" Width="100" Header="쓰기값" FieldName="WRITEVALUE" DecimalPoint="8" ReadOnly="False"/>
                            <its:Column Width="100" Header="변환계수" FieldName="CONVFACT" ReadOnly="False" DecimalPoint="0"/>
                            <its:Column Width="75" Header="사용여부" FieldName="USEYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="75" Header="읽기여부" FieldName="READYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="75" Header="쓰기여부" FieldName="WRITEYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="75" Header="카운터번지YN" FieldName="CNTYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="75" Header="비가동YN" FieldName="NONYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="75" Header="리셋번지YN" FieldName="RESETYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="75" Header="히스토리YN" FieldName="HISYN" CellType="Check" ReadOnly="False"/>
                            <its:Column Width="200" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                            <its:Column Width="200" Header="수정시간" FieldName="MTIME" ReadOnly="True"/>
                            <!-- ################################# COLUMN FLEX: END -->
                        </its:Grid.Columns>
                    </its:Grid>
                </UserControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</its:ItsPageOffice>
