<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="1176" Height="576">
    <!-- 2026-11-10 화면 크기 980x480 → 1176x576 (무상사급 실적등록 R03 과 같게) -->
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="1176" Height="60">
                <its:Date Label="발주일자" Width="180" Value="{Binding SDATE}"/>
                <its:Date HidenLabel="Y" Width="100"  Value="{Binding EDATE}"/>
                <its:Combo GPCD="*CUSTCD" Width="250" Label="거래처" Value="{Binding CUSTCD}" x:Name="cb_CUSTCD"/>
                <its:Pop GPCD="ITEMID" Width="250" Label="품목" Value="{Binding ITEMID}" ShowKeyPad="True" />
                <UserControl Width="20"/>
                <its:Button Label="발 주 조 회" Width="100" Height="30" CommandName="LIST_MTRODR" FontWeight="Bold"/>
                <its:Date Width="280" Label="출하일자" Value="{Binding PRDDATE}" Foreground="Green" FontWeight="Bold"/>
            </its:WrapContent>
        </UserControl>

        <!-- 2026-11-09 발주 행의 [입력] 버튼 → 정보입력 팝업에서 BOX 단위 수량 x BOX 수량으로 납품등록 -->
        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="60">
            <!-- 2026-11-10 오른쪽에 납품등록 BOX 현황을 두려고 폭 1176 → 816, 규격은 숨김 (입력 팝업에 표시) -->
            <its:Grid x:Name="GRID_G1" Width="816" Height="516">
                <its:Grid.Columns>
                    <its:Column Width="55" Header="납품" CellType="Button" ButtonText="입력" CommandName="POP_INPUT"/>
                    <its:Column Width="85" Header="발주일자" FieldName="MTRODRDATE" ALGIN="Center"/>
                    <its:Column Width="100" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                    <its:Column Width="95" Header="거래처명" FieldName="CUSTNM"/>
                    <its:Column Width="60" Header="품목유형" FieldName="ITEMCGNM" ALGIN="Center"/>
                    <its:Column Width="125" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="135" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="140" Header="규격" FieldName="ITEMSPEC" Visible="False"/>
                    <its:Column Width="65" DecimalPoint="0" Header="발주량" FieldName="ODRQTY"/>
                    <its:Column Width="65" DecimalPoint="0" Header="납품량" FieldName="CUSTLOTQTY"/>
                    <its:Column Width="65" DecimalPoint="0" Header="미납량" FieldName="OKQTY"/>
                    <!--<its:Column Width="40" Header="단위" FieldName="ITEMUNIT" ALGIN="Center"/>-->
                    <its:Column Width="80" DecimalPoint="0" Header="납품이력보기" CellType="Button" ButtonText="🔍" CommandName="POP_MTRCUSTLOT" Visible="False"/>
                    <its:Column Width="100" Header="발주키" FieldName="MTRODRKEY" Visible="False"/>
                    <its:Column Width="100" Header="발주상세키" FieldName="MTRODRSEQ" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <!-- 2026-11-10 납품등록 BOX 현황: 입력 팝업 [확인] 으로 쌓고, [등록] 때 한 번에 저장 (발주별 거래명세서 1장). 화면에만 있고 닫으면 사라짐 -->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="816" Canvas.Top="60" Width="360" Height="516">
            <StackPanel>
                <TextBlock Text=" ■ 납품등록 BOX 현황" FontWeight="Bold" FontSize="14" Margin="5,6,0,4"/>
                <its:Grid x:Name="GRID_G4" Width="350" Height="410">
                    <its:Grid.Columns>
                        <its:Column Width="105" Header="품목코드" FieldName="ITEMCD"/>
                        <its:Column Width="55" Header="BOX단위" FieldName="BOXQTY" DecimalPoint="0"/>
                        <its:Column Width="45" Header="BOX수" FieldName="BOXCNT" DecimalPoint="0"/>
                        <its:Column Width="60" Header="수량합계" FieldName="BOXSUM" DecimalPoint="0"/>
                        <its:Column Width="80" Header="HEAT NO" FieldName="HEATNO"/>
                        <its:Column Width="80" Header="품명" FieldName="ITEMNM" Visible="False"/>
                        <its:Column Width="80" Header="발주키" FieldName="MTRODRKEY" Visible="False"/>
                        <its:Column Width="80" Header="발주상세키" FieldName="MTRODRSEQ" Visible="False"/>
                        <its:Column Width="45" Header="삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_STAGE"/>
                    </its:Grid.Columns>
                </its:Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,5,0">
                    <its:Button Label="등 록" Width="110" Height="50" CommandName="ADD_MTRCUSTLOT" FontWeight="Bold" BackColor="Green"/>
                    <UserControl Width="10"/>
                    <its:Button Label="취 소" Width="110" Height="50" CommandName="CLEAR_STAGE" FontWeight="Bold" BackColor="Gray"/>
                </StackPanel>
            </StackPanel>
        </UserControl>

        <UserControl Canvas.Left="238" Canvas.Top="88" Style="{DynamicResource TML_POP}" Width="700" Height="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <its:WrapContent x:Name="PANEL_A1">
                    <its:Text Label="거래명세번호" Value="{Binding INVOICEKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주키" Value="{Binding MTRODRKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주상세키" Value="{Binding MTRODRSEQ}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="출고일자" Value="{Binding OUTDATE}" ReadOnly="True"/>
                    <TextBlock Text="▶▶▶" Width="280" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16"/>
                    <its:Text Label="입고일자" Value="{Binding INDATE}" ReadOnly="True"/>
                    <its:Text Label="출고처" Value="{Binding OUTCUSTCD}" ReadOnly="True"/>
                    <UserControl Width="280"/>
                    <its:Text Label="입고처" Value="{Binding INCUSTCD}" ReadOnly="True"/>
                </its:WrapContent>

                <its:WrapContent Grid.Row="1" >
                    <its:Grid x:Name="GRID_G2" Height="250" Width="695">
                        <its:Column FieldName="INVOICEKEY" Width="100" Header="거래명세서" ALGIN="Center"/>
                        <its:Column FieldName="ITEMCD" Width="110" Header="품목코드" ALGIN="Center"/>
                        <its:Column FieldName="ITEMNM" Width="120" Header="품명" ALGIN="Center"/>
                        <its:Column FieldName="LOTKEY" Width="105" Header="로트번호" ALGIN="Center"/>
                        <its:Column FieldName="LOTQTY" Width="70" Header="로트수량" ALGIN="Center" DecimalPoint="0"/>
                        <its:Column FieldName="HEATNO" Width="90" Header="HEAT NO" ALGIN="Center"/>
                        <its:Column FieldName="LOTTP"  Width="60" Header="로트구분" ALGIN="Center"/>
                    </its:Grid>
                </its:WrapContent>

                <its:WrapContent Grid.Row="2" x:Name="PANEL_A2" >
                    <UserControl Width="220"/>
                    <its:Button Label="거래명세표 출력" CommandName="MTRCUST_INVOICE_PRINT" FontWeight="Bold" Height="50" Width="100" BackColor="GREEN"/>
                    <UserControl Width="50"/>
                    <its:Button Label="납품 취소" CommandName="MTRCUST_INVOICE_CANCEL" FontWeight="Bold" Height="50" Width="100" BackColor="RED"/>
                </its:WrapContent>
            </Grid>
        </UserControl>

        <!-- 정보입력 팝업: BOX 단위 수량(1박스 적입량) x BOX 수량(박스 개수) → BOX 1개당 LOT 1개 -->
        <!-- 2026-11-10 화면 크기에 맞춰 900x500 으로 키움, BOX 그리드는 칸을 꽉 채우고 컬럼 합계를 줄여 수량 합계까지 스크롤 없이 보이게 -->
        <UserControl Canvas.Left="138" Canvas.Top="38" Style="{DynamicResource TML_POP}" Width="900" Height="500">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <its:WrapContent x:Name="PANEL_A3" Grid.ColumnSpan="2" Margin="5,5,5,0">
                    <its:Text Label="발주키" Value="{Binding MTRODRKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="발주상세키" Value="{Binding MTRODRSEQ}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="품목명" LabelWidth="80" Width="880" Value="{Binding ITEMNM}" ReadOnly="True"/>
                    <its:Text Label="규격" LabelWidth="80" Width="520" Value="{Binding ITEMSPEC}" ReadOnly="True"/>
                    <its:Text Label="품목코드" LabelWidth="80" Width="360" Value="{Binding ITEMCD}" ReadOnly="True"/>
                    <its:Text Label="거래처" LabelWidth="80" Width="520" Value="{Binding CUSTNM}" ReadOnly="True"/>
                    <its:Number Label="미납량" LabelWidth="80" Width="360" Value="{Binding OKQTY}" DecimalPoint="0" ReadOnly="True"/>
                    <its:Text Label="HEAT NO" LabelWidth="80" Width="520" Value="{Binding HEATNO}" ShowKeyPad="True"/>
                    <its:Number Label="납품량" LabelWidth="80" Width="360" Value="{Binding TOTQTY}" DecimalPoint="0" ReadOnly="True" Foreground="Green" FontWeight="Bold"/>
                </its:WrapContent>

                <Border Grid.Row="1" Margin="5" BorderBrush="Black" BorderThickness="1" Background="White">
                    <!-- 팝업 틀(TML_POP)이 세로 길이를 제한하지 않아 크기는 지정 (칸 760 x 310 에 맞춤, 컬럼 합계 670) -->
                    <its:Grid x:Name="GRID_G3" Width="760" Height="300">
                        <its:Grid.Columns>
                            <its:Column Width="80" Header="삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_BOX"/>
                            <its:Column Width="210" Header="BOX 단위 수량" FieldName="BOXQTY" ALGIN="Right" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                            <its:Column Width="190" Header="BOX 수량" FieldName="BOXCNT" ALGIN="Right" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                            <its:Column Width="190" Header="수량 합계" FieldName="BOXSUM" ALGIN="Right" CellType="Number" DecimalPoint="0"/>
                        </its:Grid.Columns>
                    </its:Grid>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <its:Button Label="추 가" Width="100" Height="50" CommandName="ADD_BOX" FontWeight="Bold" BackColor="SteelBlue"/>
                    <UserControl Height="130"/>
                    <its:Button Label="확 인" Width="100" Height="50" CommandName="ADD_STAGE" FontWeight="Bold" BackColor="Green"/>
                    <UserControl Height="10"/>
                    <its:Button Label="취 소" Width="100" Height="50" CommandName="CLOSE_INPUT" FontWeight="Bold" BackColor="Gray"/>
                </StackPanel>
            </Grid>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
