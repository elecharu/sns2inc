<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.R02"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="980" Height="480">
    <!-- 2026-11-12 외주이동 : ERP POP 화면 기준 (이동일자 / 출고창고 / 입고창고 / 바코드 스캔 → 이동량 수정 → 등록, 취소) -->
    <TabControl x:Name="TAB_MAIN" Width="980" Height="480" Padding="0" BorderThickness="0" Background="WhiteSmoke">
    <TabItem Height="25">
    <TabItem.Header><TextBlock Text="  등 록  " FontSize="14" FontWeight="Bold"/></TabItem.Header>
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="980" Height="62">
                <its:Combo GPCD="CUSTCD" Width="250" Label="거래처" Value="{Binding CUSTCD}" ReadOnly="True" x:Name="cb_CUSTCD" Visibility="Collapsed"/>
                <its:Date Label="이동일자" LabelWidth="70" Width="230" Value="{Binding MOVEDATE}" Foreground="Green" FontWeight="Bold"/>
                <UserControl Width="30"/>
                <its:Combo GPCD="WARECD_OSC" LabelWidth="70" Width="330" Label="출고창고" Value="{Binding OUTWARE}" ReadOnly="True" x:Name="cb_OUTWARE" FontWeight="Bold"/>
                <UserControl Width="30"/>
                <its:Text x:Name="txt_BARCODE" Label="바코드 스캔" LabelWidth="90" Width="340" Value="{Binding SCANLOT}" KeyDown="Text_KeyDown"/>
                <UserControl Width="260"/>
                <its:Combo GPCD="WARECD_HQ" LabelWidth="70" Width="330" Label="입고창고" Value="{Binding INWARE}" FontWeight="Bold"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="62">
            <its:Grid x:Name="GRID_G1" Width="860" Height="393">
                <its:Grid.Columns>
                    <its:Column Width="55" Header="삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_ROW"/>
                    <its:Column Width="105" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="125" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="100" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="80" Header="HEAT NO" FieldName="HEATNO" ALGIN="Center"/>
                    <its:Column Width="105" Header="LOT NO" FieldName="LOTKEY" ALGIN="Center"/>
                    <its:Column Width="45" Header="단위" FieldName="UNITNM" ALGIN="Center"/>
                    <its:Column Width="85" Header="이동량" FieldName="MOVEQTY" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                    <its:Column Width="80" Header="시편수량" FieldName="TESTQTY" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                    <its:Column Width="85" Header="잔여재고량" FieldName="LOTQTY" DecimalPoint="0"/>
                    <its:Column Width="70" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                    <its:Column Width="80" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                    <its:Column Width="80" Header="창고" FieldName="WARECD" Visible="False"/>
                    <its:Column Width="80" Header="재고유형" FieldName="LOTTP" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <!-- 오른쪽 버튼 영역 (ERP POP 과 같이 등록 / 취소) -->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="860" Canvas.Top="62" Width="120" Height="393">
            <StackPanel Width="100" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <its:Button Label="등 록" Width="100" Height="55" FontWeight="Bold" CommandName="MOVE_LOT" BackColor="Green"/>
                <UserControl Height="10"/>
                <its:Button Label="취 소" Width="100" Height="55" FontWeight="Bold" CommandName="CLEAR_SCAN" BackColor="Gray"/>
            </StackPanel>
        </UserControl>

        <!-- 등록 직후 거래명세서 확인 팝업 (거래명세표 재출력, 납품 취소) -->
        <UserControl Canvas.Left="140" Canvas.Top="40" Style="{DynamicResource TML_POP}" Width="700" Height="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <its:WrapContent x:Name="PANEL_A1">
                    <its:Text Label="거래명세번호" Value="{Binding INVOICEKEY}" ReadOnly="True" Visibility="Collapsed"/>
                    <its:Text Label="출고일자" Value="{Binding OUTDATE}" ReadOnly="True"/>
                    <TextBlock Text="▶▶▶" Width="280" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16"/>
                    <its:Text Label="입고일자" Value="{Binding INDATE}" ReadOnly="True"/>
                    <its:Text Label="출고처" Value="{Binding OUTCUSTCD}" ReadOnly="True"/>
                    <UserControl Width="280"/>
                    <its:Text Label="입고처" Value="{Binding INCUSTCD}" ReadOnly="True"/>
                </its:WrapContent>

                <its:WrapContent Grid.Row="1" >
                    <its:Grid x:Name="GRID_G2" Height="250" Width="695">
                        <its:Column FieldName="ITEMCD" Width="120" Header="품목코드" ALGIN="Center"/>
                        <its:Column FieldName="ITEMNM" Width="200" Header="품명" ALGIN="Center"/>
                        <its:Column FieldName="LOTKEY" Width="120" Header="로트번호" ALGIN="Center"/>
                        <its:Column FieldName="LOTQTY" Width="120" Header="로트수량" ALGIN="Center" DecimalPoint="0"/>
                        <its:Column FieldName="LOTTP"  Width="100" Header="로트구분" ALGIN="Center"/>
                    </its:Grid>
                </its:WrapContent>

                <its:WrapContent Grid.Row="2" x:Name="PANEL_A2" >
                    <UserControl Width="220"/>
                    <its:Button Label="거래명세표 출력" CommandName="MTRCUST_INVOICE_PRINT" FontWeight="Bold" Height="50" Width="100" BackColor="GREEN"/>
                    <UserControl Width="50"/>
                    <its:Button Label="납품 취소" CommandName="MTRCUST_INVOICE_CANCEL" FontWeight="Bold" Height="50" Width="100" BackColor="RED"/>
                </its:WrapContent>
            </Grid>
        </UserControl>
    </Canvas>
    </TabItem>
    <!-- [거래명세서 발행] 이동 거래명세서 조회 → 선택한 행 거래명세서 출력 -->
    <TabItem Height="25">
    <TabItem.Header><TextBlock Text="  거래명세서 발행  " FontSize="14" FontWeight="Bold"/></TabItem.Header>
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S2" Width="980" Height="58">
                <its:Date Label="이동일자" LabelWidth="70" Width="230" Value="{Binding SDATE}"/>
                <its:Date HidenLabel="Y" Width="160" Value="{Binding EDATE}"/>
                <UserControl Width="20"/>
                <its:Button Label="조 회" Width="120" Height="45" FontWeight="Bold" CommandName="SEARCH_INVOICE" BackColor="SteelBlue"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="58">
            <its:Grid x:Name="GRID_G3" Width="860" Height="397">
                <its:Grid.Columns>
                    <its:Column Width="95" Header="이동일자" FieldName="MOVEDATE" ALGIN="Center"/>
                    <its:Column Width="130" Header="거래명세번호" FieldName="INVOICEKEY" ALGIN="Center"/>
                    <its:Column Width="150" Header="입고처" FieldName="INNM"/>
                    <its:Column Width="60" Header="LOT수" FieldName="LOTCNT" DecimalPoint="0"/>
                    <its:Column Width="85" Header="이동량" FieldName="TOTQTY" DecimalPoint="0"/>
                    <its:Column Width="80" Header="시편수량" FieldName="TESTQTY" DecimalPoint="0"/>
                    <its:Column Width="80" Header="상태" FieldName="STATUSNM" ALGIN="Center"/>
                    <its:Column Width="70" Header="등록자" FieldName="EMPNM" ALGIN="Center"/>
                    <its:Column Width="140" Header="등록시간" FieldName="RTIME" ALGIN="Center"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="860" Canvas.Top="58" Width="120" Height="397">
            <StackPanel Width="100" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <its:Button Label="거래명세서 발행" Width="100" Height="55" FontWeight="Bold" CommandName="PRINT_INVOICE_TAB" BackColor="Green"/>
            </StackPanel>
        </UserControl>
    </Canvas>
    </TabItem>
    <!-- [이동내역삭제] 이동 거래명세서 조회 → 체크한 이동 삭제 -->
    <TabItem Height="25">
    <TabItem.Header><TextBlock Text="  이동내역삭제  " FontSize="14" FontWeight="Bold"/></TabItem.Header>
    <Canvas Background="WhiteSmoke">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S3" Width="980" Height="58">
                <its:Date Label="이동일자" LabelWidth="70" Width="230" Value="{Binding SDATE}"/>
                <its:Date HidenLabel="Y" Width="160" Value="{Binding EDATE}"/>
                <UserControl Width="20"/>
                <its:Button Label="조 회" Width="120" Height="45" FontWeight="Bold" CommandName="SEARCH_INVOICE" BackColor="SteelBlue"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="58">
            <its:Grid x:Name="GRID_G4" Width="860" Height="397">
                <its:Grid.Columns>
                    <its:Column Width="45" Header="선택" CellType="Check" FieldName="ISCHECKED" IsRowCheck="True"/>
                    <its:Column Width="95" Header="이동일자" FieldName="MOVEDATE" ALGIN="Center"/>
                    <its:Column Width="130" Header="거래명세번호" FieldName="INVOICEKEY" ALGIN="Center"/>
                    <its:Column Width="150" Header="입고처" FieldName="INNM"/>
                    <its:Column Width="60" Header="LOT수" FieldName="LOTCNT" DecimalPoint="0"/>
                    <its:Column Width="85" Header="이동량" FieldName="TOTQTY" DecimalPoint="0"/>
                    <its:Column Width="80" Header="시편수량" FieldName="TESTQTY" DecimalPoint="0"/>
                    <its:Column Width="80" Header="상태" FieldName="STATUSNM" ALGIN="Center"/>
                    <its:Column Width="70" Header="등록자" FieldName="EMPNM" ALGIN="Center"/>
                    <its:Column Width="140" Header="등록시간" FieldName="RTIME" ALGIN="Center"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="860" Canvas.Top="58" Width="120" Height="397">
            <StackPanel Width="100" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <its:Button Label="삭 제" Width="100" Height="55" FontWeight="Bold" CommandName="DEL_INVOICE" BackColor="IndianRed"/>
            </StackPanel>
        </UserControl>
    </Canvas>
    </TabItem>
    </TabControl>
</its:ItsPageTml>