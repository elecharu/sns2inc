<its:ItsPageTml x:Class="TML1010.R03"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="1176" Height="576">
    <!-- 2026-11-09 무상사급 실적 등록: TML2010_R01(사내 생산실적등록)과 같은 방식. 작업장 = 로그인 외주처 작업장 고정, 공정 선택, 설비 없음 -->
    <Canvas Background="Silver">

        <!--좌측 버튼-->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_L1" Width="80" Height="576">
                <its:Button Label="작업완료" Width="75" Height="60" SetFontSize="13" CommandName="WORK_DONE" BackColor="GREEN" FontWeight="Bold"/>
                <UserControl Width="75" Height="40"/>
                <its:Button Label="공정&#x0a;이동표" Width="75" Height="60" SetFontSize="13" CommandName="PRINT_MOVE" FontWeight="Bold"/>
                <UserControl Width="75" Height="200"/>
                <its:Button Label="실적삭제" Width="75" Height="60" SetFontSize="13" CommandName="DEL_RST" BackColor="RED" FontWeight="Bold"/>
                <its:Button Label="초기화" Width="75" Height="60" SetFontSize="13" CommandName="CLEAR_INPUT" FontWeight="Bold"/>
            </its:WrapContent>
        </UserControl>

        <!--투입품번정보-->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="80" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="1096" Height="100">
                <!-- REF02 = 로그인 외주처 코드 (코드에서 설정) → 외주처 작업장만 -->
                <its:Combo Label="생산작업장" LabelWidth="95" Width="365" GPCD="LINECD" Value="{Binding LINECD}" REF01="07" ReadOnly="True" x:Name="CMB_LINECD"/>
                <!-- PRCCD_LINEPRC : REF01 = 작업장, 작업장 공정설정(MSTLINE_PRC) 기준 (외주처 작업장은 설비가 없어 PRCCD_LINE 은 비어 나옴) -->
                <its:Combo Label="생산공정" LabelWidth="95" Width="365" GPCD="PRCCD_LINEPRC" Value="{Binding PRCCD}"/>
                <its:Text Label="생산설비" LabelWidth="95" Width="365" Value="{Binding EQMNM}" ReadOnly="True"/>
                <its:Text Label="생산품목코드" LabelWidth="95" Width="365" Value="{Binding ITEMCD}" ReadOnly="True"/>
                <its:Text Label="생산품명" LabelWidth="95" Width="365" Value="{Binding ITEMNM}" ReadOnly="True"/>
                <its:Text Label="생산규격" LabelWidth="95" Width="365" Value="{Binding ITEMSPEC}" ReadOnly="True"/>
                <UserControl Width="730"/>
                <its:Text Label="투입바코드스캔" LabelWidth="95" Width="365" Value="{Binding SCANLOT}" x:Name="TXT_SCANLOT" KeyDown="TXT_SCANLOT_KeyDown"/>
                <its:Text Label="외주처" Value="{Binding CUSTCD}" Visibility="Collapsed"/>
                <its:Text Label="품목ID" Value="{Binding ITEMID}" Visibility="Collapsed"/>
            </its:WrapContent>
        </UserControl>

        <!--투입 그리드-->
        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="80" Canvas.Top="100">
            <its:Grid x:Name="GRID_G1" Width="1096" Height="346">
                <its:Grid.Columns>
                    <its:Column Width="55" Header="삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_INPUT"/>
                    <its:Column Width="140" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="190" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="150" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="60" Header="구분" FieldName="ITEMCG" ALGIN="CENTER"/>
                    <its:Column Width="110" Header="LOT NO" FieldName="LOTKEY" ALGIN="CENTER"/>
                    <its:Column Width="45" Header="단위" FieldName="ITEMUNIT" ALGIN="CENTER"/>
                    <its:Column Width="80" Header="사용량" FieldName="USEQTY" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                    <its:Column Width="80" Header="잔여재고량" FieldName="LOTQTY" DecimalPoint="0"/>
                    <its:Column Width="100" Header="HEAT NO" FieldName="HEATNO"/>
                    <its:Column Width="85" Header="창고" FieldName="WARECD" GPCD="WARECD"/>
                    <its:Column Width="80" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <!--생산실적정보-->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="80" Canvas.Top="446">
            <its:WrapContent x:Name="PANEL_B1" Width="490" Height="130">
                <its:Combo Label="주야구분" LabelWidth="60" Width="230" GPCD="PP161" Value="{Binding DNTP}" REF05="07" x:Name="CMB_DNTP"/>
                <its:Text Label="양품수량" LabelWidth="60" Width="200" Value="{Binding GOODQTY}" ReadOnly="True"/>
                <its:Date Label="작업시작일" LabelWidth="60" Width="230" Value="{Binding WORKSDAY}"/>
                <its:Time Label="시작시간" LabelWidth="60" Width="200" Value="{Binding WORKSTIME}"/>
                <its:Date Label="작업종료일" LabelWidth="60" Width="230" Value="{Binding WORKEDAY}"/>
                <its:Time Label="종료시간" LabelWidth="60" Width="200" Value="{Binding WORKETIME}"/>
            </its:WrapContent>
        </UserControl>

        <!--최근 실적 (어제·오늘) : 실적삭제·공정이동표 재출력할 실적 선택-->
        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="570" Canvas.Top="446">
            <TabControl Width="606" Height="130" Padding="0">
                <TabItem Header="생산실적">
                    <!-- 크기를 주지 않고 탭 안쪽 여백 0 → 탭 안을 공백 없이 꽉 채움. 컬럼 폭 합계 490 (행머리·세로스크롤 포함해도 가로 스크롤 없게) -->
                    <its:Grid x:Name="GRID_G3">
                        <its:Grid.Columns>
                            <its:Column Width="105" Header="실적시간" FieldName="RSTTIME" ALGIN="CENTER"/>
                            <its:Column Width="70" Header="공정" FieldName="PRCNM" ALGIN="CENTER"/>
                            <its:Column Width="110" Header="품목코드" FieldName="ITEMCD"/>
                            <its:Column Width="60" Header="양품수량" FieldName="GOODQTY" DecimalPoint="0"/>
                            <its:Column Width="45" Header="주야" FieldName="DNTPNM" ALGIN="CENTER"/>
                            <its:Column Width="100" Header="실적로트" FieldName="LOTKEY" ALGIN="CENTER"/>
                            <its:Column Width="80" Header="실적키" FieldName="OSCRSTKEY" Visible="False"/>
                        </its:Grid.Columns>
                    </its:Grid>
                </TabItem>
            </TabControl>
        </UserControl>

        <!--생산품목선택 팝업-->
        <UserControl x:Name="POPUP_A1" Style="{DynamicResource TML_POP}" Canvas.Left="188" Canvas.Top="50" Visibility="Collapsed">
            <its:WrapContent x:Name="PANEL_A1" Width="800" Height="450">
                <its:Text Label="스캔품번" Width="265" Value="{Binding ITEMCD}" ReadOnly="True"/>
                <its:Text Label="스캔LOT NO" Width="265" Value="{Binding LOTKEY}" ReadOnly="True"/>
                <UserControl Width="100"/>
                <its:Button Label="확    인" Width="150" Height="40" SetFontSize="18" CommandName="SEL_ITEM" BackColor="DARKORANGE" FontWeight="Bold"/>
                <its:Grid x:Name="GRID_G5" Width="795" Height="360">
                    <its:Grid.Columns>
                        <its:Column Width="300" Header="품목명" FieldName="ITEMNM"/>
                        <its:Column Width="220" Header="품목코드" FieldName="ITEMCD"/>
                        <its:Column Width="220" Header="규격" FieldName="ITEMSPEC"/>
                        <its:Column Width="80" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                    </its:Grid.Columns>
                </its:Grid>
            </its:WrapContent>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
