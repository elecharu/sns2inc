<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.R05"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="980" Height="580">
    <its:ItsPageTml.Resources>
    <Style x:Key="GRID_BUTTON" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="#E6E6E6" />
        <Setter Property="BorderBrush" Value="#A0A0A0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Malgun Gothic" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    </its:ItsPageTml.Resources>

    <Canvas Background="WhiteSmoke">

        <!-- 상단 조회 패널 -->
        <UserControl Canvas.Left="0" Canvas.Top="0" Style="{DynamicResource TML_PANEL}">
            <its:WrapContent x:Name="PANEL_S1" Width="980" Height="45">
                <Grid Width="980" Height="45">
                    <Grid.Resources>
                        <ScaleTransform x:Key="HEADER_SCALE" ScaleX="1.36" ScaleY="1.36" />
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="6" />
                    </Grid.ColumnDefinitions>
                    <its:Button Grid.Column="1" Width="150" Height="36" VerticalAlignment="Center" CommandName="SEARCH_EQMPARTS" Label="설비부품 재고조회" SetFontSize="13" />
                    <its:Text Grid.Column="3" x:Name="txt_SCAN" Label="바코드 스캔" LabelWidth="66" Width="200" VerticalAlignment="Center" Value="{Binding SCANCD}" KeyDown="Text_KeyDown" LayoutTransform="{StaticResource HEADER_SCALE}" />
                    <its:Combo Grid.Column="5" x:Name="cmb_S_GRADE" Label="등급" LabelWidth="30" Width="110" VerticalAlignment="Center" Value="{Binding GRADE}" LayoutTransform="{StaticResource HEADER_SCALE}" />
                    <its:Combo Grid.Column="7" x:Name="cmb_S_LOCACD" Label="로케이션" LabelWidth="48" Width="150" VerticalAlignment="Center" Value="{Binding LOCACD}" LayoutTransform="{StaticResource HEADER_SCALE}" />
                    <its:Button Grid.Column="9" Width="150" Height="36" VerticalAlignment="Center" CommandName="POP_LOCA" Label="로케이션 지정·해제" BackColor="SteelBlue" SetFontSize="13" />
                </Grid>
            </its:WrapContent>
        </UserControl>

        <!-- 메인 설비부품 현재고 그리드 -->
        <UserControl Canvas.Left="0" Canvas.Top="45" Style="{DynamicResource TML_GRID}">
            <its:Grid x:Name="GRID_G1" Width="980" Height="530">
                <its:Grid.Columns>
                    <its:Column Width="110" FieldName="ITEMCD" Header="설비부품코드" ALGIN="Center" />
                    <its:Column Width="250" FieldName="ITEMNM" Header="설비부품명" />
                    <its:Column Width="80" FieldName="GRADE" Header="중요도등급" ALGIN="Center" />
                    <its:Column Width="90" FieldName="LOCANM" Header="로케이션" ALGIN="Center" />
                    <its:Column Width="75" FieldName="SAFEQTY" Header="안전재고" ALGIN="Right" DecimalPoint="0" />
                    <its:Column Width="75" FieldName="LOTQTY" Header="현재고" ALGIN="Right" DecimalPoint="0" />
                    <its:Column Width="50" FieldName="ITEMUNIT" Header="단위" ALGIN="Center" GPCD="DM150" />
                    <its:Column Width="65" Header="출고" CellType="Button" ButtonText="출고" CommandName="POP_OUT_EQMPARTS" />
                    <its:Column Width="85" Header="출고 이력" CellType="Button" ButtonText="조회" CommandName="POP_EQM_OUT" />
                    <its:Column Width="75" Header="라벨출력" CellType="Button" ButtonText="출력" CommandName="POP_PRINT_LABEL" />
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <!-- 출고 등록 팝업 -->
        <UserControl x:Name="POP_OUT" Canvas.Left="170" Canvas.Top="30"
                     Style="{DynamicResource TML_POP}" Width="640" Height="522" Visibility="Collapsed">
            <its:WrapContent x:Name="PANEL_A3" Background="WhiteSmoke" Width="604" Margin="18">
                <Grid Width="604">
                    <Grid.Resources>
                        <ScaleTransform x:Key="TABLET_SCALE" ScaleX="1.4" ScaleY="1.4" />
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="294" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="294" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="White" BorderBrush="#C9D3E0" BorderThickness="1" CornerRadius="6" Padding="16,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="현재고" FontSize="13" Foreground="#6B7480" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding LOTQTY, StringFormat={}{0:N0}}" FontSize="28" FontWeight="Bold" Foreground="SteelBlue" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ITEMCD}" FontSize="14" Foreground="#6B7480" />
                                <TextBlock Text="{Binding ITEMNM}" FontSize="22" FontWeight="Bold" Foreground="#262938" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <its:Date Grid.Row="2" Grid.Column="0" Label="출고일자" LabelWidth="60" Width="210" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding OUTDATE}" LayoutTransform="{StaticResource TABLET_SCALE}" />
                    <its:Combo Grid.Row="2" Grid.Column="2" x:Name="cmb_OUTTP" Label="출고구분" LabelWidth="60" Width="210" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding OUTTP}" GPCD="INOUTTP_EQMPARTS" REF01="OUT" LayoutTransform="{StaticResource TABLET_SCALE}" />
                    <its:Combo Grid.Row="3" Grid.Column="0" x:Name="cmb_LINECD" Label="작업장" LabelWidth="60" Width="210" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding LINECD}" REF01="07" GPCD="@LINECD" LayoutTransform="{StaticResource TABLET_SCALE}" />
                    <its:Combo Grid.Row="3" Grid.Column="2" x:Name="cmb_EQMGROUP1" Label="라인" LabelWidth="60" Width="210" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding EQMGROUP1}" LayoutTransform="{StaticResource TABLET_SCALE}" />
                    <its:Combo Grid.Row="4" Grid.ColumnSpan="3" x:Name="cmb_EQMCD" Label="설비" LabelWidth="60" Width="431" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding EQMCD}" LayoutTransform="{StaticResource TABLET_SCALE}" />
                    <its:Number Grid.Row="5" Grid.Column="0" Label="출고수량" LabelWidth="60" Width="210" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding OUTQTY}" ShowKeyPad="True" DecimalPoint="0" LayoutTransform="{StaticResource TABLET_SCALE}" />
                    <its:Pop Grid.Row="6" Grid.ColumnSpan="3" x:Name="pop_OUT_EMP" Label="출고자" LabelWidth="60" Width="431" HorizontalAlignment="Left" VerticalAlignment="Top" GPCD="EMPCD" Value="{Binding EMPCD}" ShowKeyPad="True" LayoutTransform="{StaticResource TABLET_SCALE}" />

                    <DockPanel Grid.Row="8" Grid.ColumnSpan="3">
                        <its:Button DockPanel.Dock="Left" Width="180" Height="56" Label="닫 기" CommandName="CLOSE_POP_OUT" BackColor="Gray" SetFontSize="18" />
                        <its:Button Width="408" Height="56" HorizontalAlignment="Right" Label="출고 등록" CommandName="OUT_EQMPARTS" BackColor="Orange" SetFontSize="20" />
                    </DockPanel>
                </Grid>
            </its:WrapContent>
        </UserControl>

        <!-- 로케이션 지정·해제 팝업 -->
        <UserControl x:Name="POP_LOCA" Canvas.Left="210" Canvas.Top="120"
                     Style="{DynamicResource TML_POP}" Width="560" Height="300" Visibility="Collapsed">
            <its:WrapContent x:Name="PANEL_A4" Background="WhiteSmoke" Width="524" Margin="18">
                <Grid Width="524">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="52" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="56" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#C9D3E0" BorderThickness="1" CornerRadius="6" Padding="16,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="현재 로케이션" FontSize="13" Foreground="#6B7480" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding CURLOCANM}" FontSize="20" FontWeight="Bold" Foreground="SteelBlue" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ITEMCD}" FontSize="14" Foreground="#6B7480" />
                                <TextBlock Text="{Binding ITEMNM}" FontSize="22" FontWeight="Bold" Foreground="#262938" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <its:Combo Grid.Row="2" x:Name="cmb_LOCACD" Label="로케이션" LabelWidth="60" Width="374" HorizontalAlignment="Left" VerticalAlignment="Top" Value="{Binding LOCACD}">
                        <its:Combo.LayoutTransform>
                            <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                        </its:Combo.LayoutTransform>
                    </its:Combo>

                    <DockPanel Grid.Row="4">
                        <its:Button DockPanel.Dock="Left" Width="190" Height="56" Label="저 장" CommandName="SET_LOCA" BackColor="SteelBlue" SetFontSize="20" />
                        <its:Button DockPanel.Dock="Right" Width="140" Height="56" Label="닫 기" CommandName="CLOSE_POP_LOCA" BackColor="Gray" SetFontSize="18" />
                        <its:Button Width="170" Height="56" HorizontalAlignment="Center" Label="해 제" CommandName="CLEAR_LOCA" BackColor="IndianRed" SetFontSize="20" />
                    </DockPanel>
                </Grid>
            </its:WrapContent>
        </UserControl>

        <!-- 출고 이력 팝업 -->
        <UserControl x:Name="POP_OUT_HIS" Canvas.Left="15" Canvas.Top="35" Style="{DynamicResource TML_POP}" Width="950" Height="510" Visibility="Collapsed">
            <its:WrapContent x:Name="PANEL_A1" Background="WhiteSmoke" Width="944" Height="475">
                <its:Date Label="조회일자" LabelWidth="60" Width="184" Value="{Binding SDATE}" />
                <its:Date HidenLabel="Y" Width="124" Value="{Binding EDATE}" />
                <UserControl Width="20" />
                <its:Button Width="160" Height="32" Label="출고 이력조회" CommandName="SEARCH_OUT_EQMPARTS" BackColor="SeaGreen" SetFontSize="16" />
                <its:Grid x:Name="GRID_G2" Width="940" Height="430" Margin="2,5,2,0">
                    <its:Grid.Columns>
                        <its:Column Width="100" FieldName="INOUTDATE" Header="발생일자" ALGIN="Center" />
                        <its:Column Width="100" FieldName="INOUTTPNM" Header="출고유형" ALGIN="Center" />
                        <its:Column Width="70" FieldName="EQMGROUP1NM" Header="라인" ALGIN="Center" />
                        <its:Column Width="200" FieldName="EQMNM" Header="설비" />
                        <its:Column Width="120" FieldName="ITEMCD" Header="설비부품코드" ALGIN="Center" />
                        <its:Column Width="90" FieldName="OUTQTY" Header="출고량" ALGIN="Right" DecimalPoint="0" />
                        <its:Column Width="110" FieldName="EMPNM" Header="처리자" ALGIN="Center" />
                        <its:Column Width="100" Header="출고취소" CellType="Button" ButtonText="취소" CommandName="CANCEL_OUT_EQMPARTS" />
                    </its:Grid.Columns>
                </its:Grid>
            </its:WrapContent>
        </UserControl>

    </Canvas>
</its:ItsPageTml>
