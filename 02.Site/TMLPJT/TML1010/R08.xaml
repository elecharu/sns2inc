<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.R08"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="1176" Height="576">
    <its:ItsPageTml.Resources>
        <Style x:Key="GRID_BUTTON" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#A0A0A0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Malgun Gothic" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </its:ItsPageTml.Resources>

    <!-- 태블릿용 탭 구성: [입고등록] 발주 선택 → 품목별 입고수량(기본값 미입고량) 입력 → 입고 등록 / [입고취소] 입고 이력 조회 → 체크한 이력 입고 취소·라벨 재발행 -->
    <TabControl x:Name="TAB_MAIN" Width="1176" Height="576" Padding="0" BorderThickness="0" Background="Silver">
        <TabItem Height="40">
            <TabItem.Header>
                <TextBlock Text="    입고등록    " FontSize="18" FontWeight="Bold"/>
            </TabItem.Header>
            <Canvas Background="WhiteSmoke">

                <!-- 발주 조회 조건 -->
                <UserControl Canvas.Left="0" Canvas.Top="0" Style="{DynamicResource TML_PANEL}">
                    <its:WrapContent x:Name="PANEL_S1" Width="1176" Height="56">
                        <Grid Width="1176" Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <its:Date Grid.Column="1" Label="발주일자" LabelWidth="70" Width="220" VerticalAlignment="Center" Value="{Binding SDATE}" />
                            <its:Date Grid.Column="2" HidenLabel="Y" Width="130" VerticalAlignment="Center" Value="{Binding EDATE}" />
                            <its:Combo Grid.Column="4" Label="공장" LabelWidth="40" Width="190" VerticalAlignment="Center" REF01="60" GPCD="FACTORYCD" Value="{Binding FACTORYCD}" />
                            <its:Pop Grid.Column="6" Label="거래처" LabelWidth="55" Width="320" VerticalAlignment="Center" GPCD="CUSTCD" Value="{Binding CUSTCD}" ShowKeyPad="True" />
                            <its:Button Grid.Column="8" Label="발주 조회" Width="160" Height="46" VerticalAlignment="Center" SetFontSize="18" CommandName="SEARCH_MTRODR" BackColor="SteelBlue" />
                        </Grid>
                    </its:WrapContent>
                </UserControl>

                <!-- 목록 제목 -->
                <TextBlock Canvas.Left="10" Canvas.Top="64" Text="■ 발주 목록" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="txt_ODR_TITLE" Canvas.Left="450" Canvas.Top="64" Text="■ 발주 품목" FontSize="16" FontWeight="Bold" />

                <!-- 좌측 발주 목록 (▶ 선택) -->
                <UserControl Canvas.Left="0" Canvas.Top="92" Style="{DynamicResource TML_GRID}">
                    <its:Grid x:Name="GRID_G1" Width="436" Height="444">
                        <its:Grid.Columns>
                            <its:Column Width="60" ButtonText="▶" CommandName="SEL_ODR" Header="선택" />
                            <its:Column Width="95" FieldName="MTRODRDATE" Header="발주일자" ALGIN="Center" />
                            <its:Column Width="115" FieldName="MTRODRKEY" Header="발주번호" ALGIN="Center" />
                            <its:Column Width="80" FieldName="MTRODRSTTNM" Header="발주상태" ALGIN="Center" />
                            <its:Column Width="85" FieldName="CUSTNM" Header="거래처명" />
                        </its:Grid.Columns>
                    </its:Grid>
                </UserControl>

                <!-- 우측 선택 발주 품목 (입고수량 칸 터치 → 키패드, 기본값 = 미입고량) -->
                <UserControl Canvas.Left="440" Canvas.Top="92" Style="{DynamicResource TML_GRID}">
                    <its:Grid x:Name="GRID_G2" Width="736" Height="370">
                        <its:Grid.Columns>
                            <its:Column Width="80" FieldName="MTRODRSTTNM" Header="발주상태" ALGIN="Center" />
                            <its:Column Width="120" FieldName="ITEMCD" Header="품목코드" />
                            <its:Column Width="170" FieldName="ITEMNM" Header="품명" />
                            <its:Column Width="110" FieldName="ITEMSPEC" Header="규격" />
                            <its:Column Width="80" FieldName="ODRQTY" Header="발주수량" ALGIN="Right" DecimalPoint="0" />
                            <its:Column Width="80" FieldName="REMAINQTY" Header="미입고량" ALGIN="Right" DecimalPoint="0" />
                            <its:Column Width="90" FieldName="INQTY" Header="입고수량" ALGIN="Right" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False" />
                            <its:Column Width="80" FieldName="MTRODRKEY" Header="발주번호" Visible="False" />
                            <its:Column Width="80" FieldName="MTRODRSEQ" Header="발주순번" Visible="False" />
                            <its:Column Width="80" FieldName="ITEMID" Header="품목ID" Visible="False" />
                        </its:Grid.Columns>
                    </its:Grid>
                </UserControl>

                <!-- 입고일자·입고자·입고 등록 (버튼을 뺀 입력 영역 522 를 입고일자 : 입고자 = 4 : 6 → 208 : 313. 공통 Pop 은 로드 때 Width 로 계산해 Auto 불가, 칸 폭과 같은 값 지정) -->
                <UserControl Canvas.Left="440" Canvas.Top="462" Style="{DynamicResource TML_PANEL}">
                    <its:WrapContent x:Name="PANEL_A2" Width="736" Height="74">
                        <Grid Width="736" Height="74">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <its:Date Grid.Column="1" Label="입고일자" LabelWidth="60" Width="208" HorizontalAlignment="Left" VerticalAlignment="Center" Value="{Binding INDATE}" />
                            <its:Pop Grid.Column="3" x:Name="pop_IN_EMP" Label="입고자" LabelWidth="45" Width="280" HorizontalAlignment="Left" VerticalAlignment="Center" GPCD="EMPCD" Value="{Binding EMPCD}" ShowKeyPad="True" />
                            <its:Combo Grid.Column="5" x:Name="cmb_INTP" Value="{Binding INTP}" GPCD="INOUTTP_EQMPARTS" Visibility="Collapsed" />
                            <its:Button Grid.Column="5" Width="170" Height="50" VerticalAlignment="Center" Label="입고 등록" CommandName="IN_EQMPARTS" BackColor="Green" SetFontSize="22" />
                        </Grid>
                    </its:WrapContent>
                </UserControl>

            </Canvas>
        </TabItem>

        <TabItem Height="40">
            <TabItem.Header>
                <TextBlock Text="    입고취소    " FontSize="18" FontWeight="Bold"/>
            </TabItem.Header>
            <Canvas Background="WhiteSmoke">

                <!-- 입고 이력 조회 조건 -->
                <UserControl Canvas.Left="0" Canvas.Top="0" Style="{DynamicResource TML_PANEL}">
                    <its:WrapContent x:Name="PANEL_S2" Width="1176" Height="56">
                        <Grid Width="1176" Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                            </Grid.ColumnDefinitions>
                            <its:Date Grid.Column="1" Label="입고일자" LabelWidth="70" Width="220" VerticalAlignment="Center" Value="{Binding SDATE}" />
                            <its:Date Grid.Column="2" HidenLabel="Y" Width="130" VerticalAlignment="Center" Value="{Binding EDATE}" />
                            <its:Combo Grid.Column="4" Label="공장" LabelWidth="40" Width="190" VerticalAlignment="Center" REF01="60" GPCD="FACTORYCD" Value="{Binding FACTORYCD}" />
                            <its:Pop Grid.Column="6" Label="거래처" LabelWidth="55" Width="320" VerticalAlignment="Center" GPCD="CUSTCD" Value="{Binding CUSTCD}" ShowKeyPad="True" />
                            <its:Button Grid.Column="8" Label="이력 조회" Width="160" Height="46" VerticalAlignment="Center" SetFontSize="18" CommandName="SEARCH_IN_EQMPARTS" BackColor="SteelBlue" />
                        </Grid>
                    </its:WrapContent>
                </UserControl>

                <!-- 목록 제목 -->
                <TextBlock Canvas.Left="10" Canvas.Top="64" Text="■ 입고 이력" FontSize="16" FontWeight="Bold" />

                <!-- 입고 이력 (체크 선택) -->
                <UserControl Canvas.Left="0" Canvas.Top="92" Style="{DynamicResource TML_GRID}">
                    <its:Grid x:Name="GRID_G3" Width="1176" Height="370">
                        <its:Grid.Columns>
                            <its:Column Width="60" Header="선택" CellType="Check" FieldName="ISCHECKED" IsRowCheck="True" />
                            <its:Column Width="100" FieldName="INOUTDATE" Header="입고일자" ALGIN="Center" />
                            <its:Column Width="130" FieldName="MTRODRKEY" Header="발주번호" ALGIN="Center" />
                            <its:Column Width="160" FieldName="CUSTNM" Header="거래처명" />
                            <its:Column Width="140" FieldName="ITEMCD" Header="품목코드" />
                            <its:Column Width="220" FieldName="ITEMNM" Header="품명" />
                            <its:Column Width="90" FieldName="INQTY" Header="입고수량" ALGIN="Right" DecimalPoint="0" />
                            <its:Column Width="100" FieldName="EMPNM" Header="입고자" ALGIN="Center" />
                            <its:Column Width="160" FieldName="RTIME" Header="등록시간" ALGIN="Center" />
                            <its:Column Width="80" FieldName="INOUTKEY" Header="입고키" Visible="False" />
                        </its:Grid.Columns>
                    </its:Grid>
                </UserControl>

                <!-- 라벨 재발행·입고 취소 -->
                <UserControl Canvas.Left="0" Canvas.Top="462" Style="{DynamicResource TML_PANEL}" Width="1176" Height="74">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <its:Button Label="라벨 재발행" Width="190" Height="60" SetFontSize="20" CommandName="LABEL_REPRINT" BackColor="SteelBlue" />
                        <UserControl Width="14" />
                        <its:Button Label="입고 취소" Width="190" Height="60" SetFontSize="20" CommandName="CANCEL_IN_EQMPARTS" BackColor="IndianRed" />
                    </StackPanel>
                </UserControl>

            </Canvas>
        </TabItem>
    </TabControl>
</its:ItsPageTml>
