<its:ItsPageTml xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"  
                x:Class="TML1010.S01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TML1010"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="800" Height="533">
    <Canvas Background="WhiteSmoke">

        <UserControl Canvas.Left="0" Canvas.Top="0" Style="{DynamicResource TML_PANEL}">
            <its:WrapContent x:Name="PANEL_S1" Width="800" Height="88">
                <UserControl Width="800" Height="3" />
                <its:Combo Width="450" GPCD="*WARECD" Label="창고코드" Value="{Binding WARECD}" />
                <UserControl Width="55" />
                <UserControl Width="175" />
                <its:Button Width="120" Height="40" CommandName="SEARCH" Label="조회" />
                <its:Pop Width="450" GPCD="ITEMID" Label="품목" ShowKeyPad="TRUE" Value="{Binding ITEMID}" />
                <UserControl Width="15" />
                <its:Combo Width="205" GPCD="*DM100" Label="품목유형" Value="{Binding ITEMCG}" />
                <UserControl Width="10" />
                <its:Button Width="120" Height="40" BackColor="SEAGREEN" CommandName="LOT_SEARCH" Label="LOT 조회" />
            </its:WrapContent>
        </UserControl>
        <UserControl Canvas.Left="0" Canvas.Top="88" Style="{DynamicResource TML_GRID}">
            <its:Grid x:Name="GRID_G1" Width="800" Height="447">
                <its:Grid.Columns>
                    <its:Column Width="130" FieldName="WARENM" Header="창고명" ALGIN="Center"/>
                    <its:Column Width="57" FieldName="ITEMCG" Header="품목유형" ALGIN="Center"/>
                    <its:Column Width="120" FieldName="ITEMID" Header="품목ID" ALGIN="Center" Visible="False"/>
                    <its:Column Width="120" FieldName="ITEMCD" Header="품목코드" ALGIN="Center"/>
                    <its:Column Width="210" FieldName="ITEMNM" Header="품명" />
                    <its:Column Width="90" FieldName="SUMQTY" Header="재고수량"  ALGIN="Right"/>
                    <its:Column Width="40" FieldName="UNIT" Header="단위" ALGIN="Center"/>
                    <its:Column Width="100" FieldName="WARECD" Header="창고코드" Visible="False" />
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>
        <UserControl Canvas.Left="130" Canvas.Top="88" Style="{DynamicResource TML_POP}" Width="560">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="0*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="280" />
                </Grid.RowDefinitions>
                <its:WrapContent x:Name="PANEL_A1" Grid.Row="0" Background="WhiteSmoke" Margin="0,0,0,210" Grid.RowSpan="2">
                    <its:Text Width="280" Label="창 고 명" ReadOnly="True" Value="{Binding WARENM}" />
                    <its:Text Width="275" Label="품목" ReadOnly="True" Value="{Binding ITEMID}" Visibility="Collapsed" />
                    <its:Text Width="275" Label="품목코드" ReadOnly="True" Value="{Binding ITEMCD}" />
                    <UserControl Width="5000" Height="3" />
                    <its:Text Width="285" Label="품    명" ReadOnly="True" Value="{Binding ITEMNM}" />
                    <its:Text Width="1" Label="품목유형" Visibility="Hidden" Value="{Binding ITEMTP}"/>
                    <its:Text Width="1" Label="분류코드" Visibility="Hidden" Value="{Binding ITEMCG1}"/>
                    <its:Button Width="70" Label="발행" CommandName="LABEL_PRINT"/>

                </its:WrapContent>
                <its:WrapContent Grid.Row="1">
                    <its:Grid x:Name="GRID_G2" Width="555" Height="280">
                        <its:Column Width="40" Header="선택" IsRowCheck="True"/>
                        <its:Column Width="150" FieldName="LOTKEY" Header="LOT 번호" ALGIN="Center"/>
                        <its:Column Width="90" FieldName="LOTQTY" Header="재고수량" ALGIN="Right"/>
                        <its:Column Width="160" FieldName="PRDDATE" Header="입고일자" ALGIN="Center"/>
                        <its:Column Width="160" FieldName="WARENM" Header="창고" ALGIN="Center"/>
                        <its:Column Width="160" FieldName="WARECD" Header="창고코드" Visible="False"/>
                    </its:Grid>
                </its:WrapContent>
            </Grid>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
