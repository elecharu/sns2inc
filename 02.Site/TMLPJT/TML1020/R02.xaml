<its:ItsPageTml x:Class="TML1020.R02"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TML1020"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="1176" Height="576">
    <!-- 2026-11-10 외주반출: SNS 2공장 사내 양품창고 → 외주처 창고 재고이동. LOT 스캔 → 이동량(기본 현재고) 수정 → 등록 -->
    <Canvas Background="Silver">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="1176" Height="70">
                <its:Date Label="이동일자" LabelWidth="70" Width="230" Value="{Binding MOVEDATE}" Foreground="Green" FontWeight="Bold"/>
                <UserControl Width="40"/>
                <its:Combo Label="출고창고" LabelWidth="70" Width="330" GPCD="WARECD_GOOD" Value="{Binding OUTWARE}"/>
                <UserControl Width="40"/>
                <its:Text x:Name="txt_BARCODE" Label="바코드 스캔" LabelWidth="90" Width="420" Value="{Binding SCANLOT}" KeyDown="Text_KeyDown"/>
                <UserControl Width="270"/>
                <its:Combo Label="입고창고" LabelWidth="70" Width="330" GPCD="WARECD_OSC" Value="{Binding INWARE}"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="70">
            <its:Grid x:Name="GRID_G1" Width="1056" Height="506">
                <its:Grid.Columns>
                    <its:Column Width="55" Header="삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_ROW"/>
                    <its:Column Width="140" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="170" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="140" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="100" Header="HEAT NO" FieldName="HEATNO" ALGIN="Center"/>
                    <its:Column Width="110" Header="LOT NO" FieldName="LOTKEY" ALGIN="Center"/>
                    <its:Column Width="45" Header="단위" FieldName="UNITNM" ALGIN="Center"/>
                    <its:Column Width="85" Header="이동량" FieldName="MOVEQTY" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                    <its:Column Width="85" Header="잔여재고량" FieldName="LOTQTY" DecimalPoint="0"/>
                    <its:Column Width="80" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                    <its:Column Width="80" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <!-- 오른쪽 버튼 영역 (TML1020 R01 과 같게) -->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="1056" Canvas.Top="70" Width="120" Height="506">
            <StackPanel Width="100" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <its:Button Label="등 록" Width="100" Height="55" FontWeight="Bold" CommandName="ADD_MOVE" BackColor="Green"/>
                <UserControl Height="10"/>
                <its:Button Label="취 소" Width="100" Height="55" FontWeight="Bold" CommandName="CLEAR_SCAN" BackColor="Gray"/>
            </StackPanel>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
