<its:ItsPageTml x:Class="TML2040.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
      xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
      xmlns:local="clr-namespace:TML2040"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="900" Height="480">
    <Canvas Background="Silver">
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:ButtonList x:Name="EQM_LIST" PanelWidth="900" Height="105"/>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="105">
            <its:WrapContent x:Name="PANEL_B1" Width="900" Height="40">
                <UserControl Width="800" Height="3"/>
                <its:Button Label="비가동조회" Width="150" Height="35" FontSize="15" CommandName="SEARCH_WORK" BackColor="BLACK"/>
                <its:Button Label="비가동추가" Width="150" Height="35" FontSize="15" CommandName="ADD" BackColor="SEAGREEN" Visibility="Collapsed"/>
                <its:Button Label="비가동수정" Width="150" Height="35" FontSize="15" CommandName="UPDATE" BackColor="BLUE"/>
                <its:Button Label="삭  제" Width="150" Height="35" CommandName="DELETE" FontSize="15" BackColor="IndianRed"/>
                <its:Button Label="고장내용 / 수리내역상세" CommandName="ERR" FontSize="15" Width="200" Height="35" BackColor="PURPLE"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="142">
            <its:WrapContent x:Name="PANEL_B2" Width="900" Height="40">
                <UserControl Width="800" Height="3"/>
                <its:Date Label="조회 일자" Value="{Binding DATE}"/>
            </its:WrapContent>
        </UserControl>

        <!--비가동 이력 그리드-->
        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="175">
            <Grid>
                <its:Grid x:Name="GRID_G1" Width="900" Height="305">
                    <!--<its:Column Width="50" Header="선택" IsRowCheck="True"/>-->
                    <its:Column Width="90" Header="설비코드" FieldName="EQMCD" Visible="False"/>
                    <its:Column Width="120" Header="설비명" FieldName="EQMNM"/>
                    <its:Column Width="120" Header="상세설비명" FieldName="FANONM"/>
                    <its:Column Width="130" Header="시작시간" FieldName="NONSTIME" ALGIN="CENTER"/>
                    <its:Column Width="130" Header="종료시간" FieldName="NONETIME" ALGIN="CENTER"/>
                    <its:Column Width="80" Header="비가동시간" FieldName="NONTIME" ALGIN="CENTER"/>
                    <its:Column Width="80" Header="비가동코드" FieldName="NONCD" Visible="False"/>
                    <its:Column Width="85" Header="비가동명" FieldName="NONNM"/>
                    <its:Column Width="100" Header="작업키" FieldName="PRDWORKKEY" Visible="False"/>
                    <its:Column Width="80" Header="비가동유형" FieldName="NONTP"/>
                    <its:Column Width="100" Header="고장내용" FieldName="PROBLEM"/>
                    <its:Column Width="100" Header="수리내역상세" FieldName="SOLUTION"/>
                    <its:Column Width="100" Header="비가동키" FieldName="PRDNONKEY"/>
                </its:Grid>
            </Grid>
        </UserControl>

        <!--비가동 유형선택 팝업-->
        <UserControl Style="{DynamicResource TML_POP}" Canvas.Left="250" Canvas.Top="0" >
            <its:WrapContent x:Name="PANEL_A1" Width="400" Height="450">
                <its:Text Label="비가동키" Value="{Binding PRDNONKEY}" Visibility="Collapsed"/>
                <its:Date Label="시작시간" Value="{Binding NONSDAY}" ReadOnly="True"/>
                <its:Time HidenLabel="Y" Value="{Binding NONSTIME}" ReadOnly="True"/>
                <its:Date Label="종료시간" Value="{Binding NONEDAY}" ReadOnly="True"/>
                <its:Time HidenLabel="Y" Value="{Binding NONETIME}" ReadOnly="True"/>
                <its:Pop Label="상세설비" Width="325" Value="{Binding FANO}" GPCD="EQMFANO"/>
                <its:ButtonList x:Name="NONTP_LIST" PanelWidth="400" Height="160"/>
                <UserControl Width="5000" Height="1" Background="Black"/>
                <its:ButtonList x:Name="NONCD_LIST" PanelWidth="400" Height="160"/>
                <its:Button Label="등    록" FontSize="14" Width="400" Height="43" x:Name="btnPOP" CommandName="ADD_NON"/>
            </its:WrapContent>
        </UserControl>

        <!--비가동 시작종료-->
        <UserControl Style="{DynamicResource TML_POP}" Canvas.Left="150" Canvas.Top="0" >
            <its:WrapContent x:Name="PANEL_A3" Width="600" Height="450">
                <UserControl Width="3000" Height="3"/>
                <its:Date Label="시작시간" Value="{Binding NONSDAY}"  />
                <its:Time HidenLabel="Y" Value="{Binding NONSTIME}"  ShowSecond="Y" />
                <its:Button Label="시  작" x:Name="BTN_START" CommandName="START" Width="70" Height="35"/>
                <its:ButtonList x:Name="SE_NONTP_LIST" PanelWidth="500" Height="100" Width="600"/>
                <UserControl Width="600" Height="2" Background="Black"/>
                <UserControl Height="10"/>
                <its:ButtonList x:Name="SE_NONCD_LIST" PanelWidth="500" Height="150" Width="600"/>
                <UserControl Width="3000" Height="55"/>
                <its:Text Label="비  고" x:Name="SE_REMARK" Value="{Binding REMARK}" Width="305"/>
                <UserControl Width="33"/>
                <UserControl Width="3000"/>
                <its:Date Label="종료시간" Value="{Binding NONEDAY}" />
                <its:Time HidenLabel="Y" Value="{Binding NONETIME}"  ShowSecond="Y"/>
                <its:Button Label="종  료" x:Name="BTN_END" CommandName="END" Width="70" Height="35" BackColor="IndianRed"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_POP}" Canvas.Left="200" Canvas.Top="90">
            <its:WrapContent x:Name="PANEL_A4" Width="500" Height="250">
                <UserControl Width="5000" Height="5"/>
                <UserControl Width="10"/>
                <Label Content="고장내용" Width="230" HorizontalContentAlignment="Center" HorizontalAlignment="Left"
                       FontSize="20" Foreground="Red" FontWeight="Heavy"/>
                <UserControl Width="10"/>
                <Label Content="수리내역상세" Width="250" HorizontalContentAlignment="Center" HorizontalAlignment="Right"
                       FontSize="20" Foreground="Purple" FontWeight="Heavy"/>
                <UserControl Width="5000"/>
                <UserControl Width="10"/>

                <TextBox Width="230" Height="150" x:Name="PROB" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding PROBLEM}"/>
                <UserControl Width="20"/>
                <TextBox Width="230" Height="150" x:Name="SOL" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding SOLUTION}"/>

                <UserControl Width="5000" Height="15"/>
                <UserControl Width="150"/>
                <its:Button Label="저  장" CommandName="SAVE_ERR" Width="200" Height="40"/>
            </its:WrapContent>
        </UserControl>
    </Canvas>
</its:ItsPageTml>
