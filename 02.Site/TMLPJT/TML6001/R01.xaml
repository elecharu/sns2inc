<its:ItsPageTml x:Class="TML6001.R01"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TML6001"
      xmlns:its="clr-namespace:ITSLIB;assembly=ITSLIB"
      Width="1176" Height="576">
    <!-- 2026-11-20 제품 반입등록: 고객사로 출하한 제품이 문제가 있어 되돌아오면 제품불량창고(04S230_N)에 반입 (TML3001 과 같은 UI)
         공정이동표가 붙어 오면 바코드 스캔, 없으면 품목(거래처 출하품목) + 반입수량 입력 → [추가] → 등록 (새 로트 채번 + 공정이동표 출력)
         [반입등록] 탭 / [반입취소] 탭 -->
    <TabControl x:Name="TAB_MAIN" Width="1176" Height="576" Padding="0" BorderThickness="0" Background="Silver">
    <TabItem Height="25">
    <TabItem.Header><TextBlock Text="  반입등록  " FontSize="14" FontWeight="Bold"/></TabItem.Header>
    <Canvas Background="Silver">

        <!-- 2026-11-20 반입 방식 두 가지를 화면에서 구분: 윗줄 공통(반입일자·거래처), 아래 왼쪽 ① 공정이동표 있음(파란 칸), 오른쪽 ② 공정이동표 없음(주황 칸) -->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S1" Width="1176" Height="50">
                <UserControl Width="1176" Height="10"/>
                <its:Date Label="반입일자" LabelWidth="70" Width="230" Value="{Binding RTNDATE}" FontWeight="Bold"/>
                <UserControl Width="30"/>
                <its:Pop GPCD="CUSTCD" Label="거래처" LabelWidth="60" Width="330" Value="{Binding CUSTCD}" ShowKeyPad="True" FontWeight="Bold"/>
            </its:WrapContent>
        </UserControl>

        <!-- ① 공정이동표가 붙어 온 경우 : 바코드 스캔 -->
        <Border Canvas.Left="2" Canvas.Top="50" Width="396" Height="80" BorderBrush="SteelBlue" BorderThickness="3" Background="#EAF2FB">
            <StackPanel>
                <TextBlock Text="① 공정이동표 있음  (바코드 스캔)" FontSize="15" FontWeight="Bold" Foreground="SteelBlue" Margin="8,3,0,0"/>
                <its:WrapContent x:Name="PANEL_S3" Width="390" Height="45">
                    <its:Text x:Name="txt_BARCODE" Label="스캔" LabelWidth="50" Width="370" Value="{Binding SCANLOT}" KeyDown="Text_KeyDown"/>
                </its:WrapContent>
            </StackPanel>
        </Border>

        <!-- ② 공정이동표 없이 온 경우 : 거래처에 출하한 품목 + 반입수량 → [추가] (로트번호는 등록 때 새로 채번, 공정이동표 출력) -->
        <Border Canvas.Left="402" Canvas.Top="50" Width="772" Height="80" BorderBrush="DarkOrange" BorderThickness="3" Background="#FFF3E6">
            <StackPanel>
                <TextBlock Text="② 공정이동표 없음  (품목·수량 입력 → 등록 시 새 로트번호로 공정이동표 발행)" FontSize="15" FontWeight="Bold" Foreground="DarkOrange" Margin="8,3,0,0"/>
                <its:WrapContent x:Name="PANEL_S4" Width="766" Height="45">
                    <its:Combo Label="품목" LabelWidth="50" Width="420" GPCD="ITEMID_SALCUST" Value="{Binding ITEMID}"/>
                    <UserControl Width="15"/>
                    <its:Number Label="반입수량" LabelWidth="70" Width="190" Value="{Binding RTNQTY}" ShowKeyPad="True" DecimalPoint="0"/>
                    <UserControl Width="15"/>
                    <its:Button Label="추 가" Width="95" Height="35" FontWeight="Bold" CommandName="ADD_ITEM" BackColor="DarkOrange"/>
                </its:WrapContent>
            </StackPanel>
        </Border>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="132">
            <its:Grid x:Name="GRID_G1" Width="1056" Height="419">
                <its:Grid.Columns>
                    <its:Column Width="55" Header="삭제" CellType="Button" ButtonText="삭제" CommandName="DEL_ROW"/>
                    <its:Column Width="90" Header="구분" FieldName="RTNTPNM" ALGIN="Center"/>
                    <its:Column Width="150" Header="LOT NO" FieldName="LOTKEY" ALGIN="Center"/>
                    <its:Column Width="140" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="190" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="140" Header="규격" FieldName="ITEMSPEC"/>
                    <its:Column Width="45" Header="단위" FieldName="UNITNM" ALGIN="Center"/>
                    <its:Column Width="90" Header="반입가능량" FieldName="SHIPQTY" DecimalPoint="0"/>
                    <its:Column Width="90" Header="반입수량" FieldName="RTNQTY" CellType="Number" DecimalPoint="0" ShowKeyPad="Y" ReadOnly="False"/>
                    <its:Column Width="66" Header="비고" FieldName="REMARK" ReadOnly="False"/>
                    <its:Column Width="80" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                    <its:Column Width="80" Header="신규" FieldName="NEWYN" Visible="False"/>
                    <its:Column Width="80" Header="거래처" FieldName="CUSTCD" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <!-- 오른쪽 버튼 영역 (TML3001 과 같게) -->
        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="1056" Canvas.Top="132" Width="120" Height="419">
            <StackPanel Width="100" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <its:Button Label="등 록" Width="100" Height="55" FontWeight="Bold" SetFontSize="15" CommandName="ADD_RTN" BackColor="Green"/>
                <UserControl Height="10"/>
                <its:Button Label="취 소" Width="100" Height="55" FontWeight="Bold" SetFontSize="15" CommandName="CLEAR_SCAN" BackColor="Gray"/>
            </StackPanel>
        </UserControl>
    </Canvas>
    </TabItem>

    <!-- [반입취소] 반입 이력 (반입 행 단위), 체크한 행 취소 / 공정이동표 재발행 -->
    <TabItem Height="25">
    <TabItem.Header><TextBlock Text="  반입취소  " FontSize="14" FontWeight="Bold"/></TabItem.Header>
    <Canvas Background="Silver">

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="0" Canvas.Top="0">
            <its:WrapContent x:Name="PANEL_S2" Width="1176" Height="58">
                <its:Date Label="반입일자" LabelWidth="70" Width="230" Value="{Binding SDATE}"/>
                <its:Date HidenLabel="Y" Width="160" Value="{Binding EDATE}"/>
                <UserControl Width="20"/>
                <its:Pop GPCD="CUSTCD" Label="거래처" LabelWidth="60" Width="330" Value="{Binding CUSTCD}" ShowKeyPad="True"/>
                <UserControl Width="20"/>
                <its:Button Label="조 회" Width="120" Height="45" FontWeight="Bold" CommandName="SEARCH_RTN" BackColor="SteelBlue"/>
            </its:WrapContent>
        </UserControl>

        <UserControl Style="{DynamicResource TML_GRID}" Canvas.Left="0" Canvas.Top="58">
            <its:Grid x:Name="GRID_G2" Width="1056" Height="493">
                <its:Grid.Columns>
                    <its:Column Width="45" Header="선택" CellType="Check" FieldName="ISCHECKED" IsRowCheck="True"/>
                    <its:Column Width="95" Header="반입일자" FieldName="RTNDATE" ALGIN="Center"/>
                    <its:Column Width="120" Header="거래처" FieldName="CUSTNM"/>
                    <its:Column Width="85" Header="구분" FieldName="RTNTPNM" ALGIN="Center"/>
                    <its:Column Width="130" Header="LOT NO" FieldName="LOTKEY" ALGIN="Center"/>
                    <its:Column Width="110" Header="품목코드" FieldName="ITEMCD"/>
                    <its:Column Width="140" Header="품명" FieldName="ITEMNM"/>
                    <its:Column Width="75" Header="반입수량" FieldName="RTNQTY" DecimalPoint="0"/>
                    <its:Column Width="75" Header="현재고" FieldName="LOTQTY" DecimalPoint="0"/>
                    <its:Column Width="70" Header="등록자" FieldName="EMPNM" ALGIN="Center"/>
                    <its:Column Width="111" Header="등록시간" FieldName="RTIME" ALGIN="Center"/>
                    <its:Column Width="80" Header="OUTKEY" FieldName="OUTKEY" Visible="False"/>
                    <its:Column Width="80" Header="품목ID" FieldName="ITEMID" Visible="False"/>
                </its:Grid.Columns>
            </its:Grid>
        </UserControl>

        <UserControl Style="{DynamicResource TML_PANEL}" Canvas.Left="1056" Canvas.Top="58" Width="120" Height="493">
            <StackPanel Width="100" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <its:Button Label="공정이동표" Width="100" Height="55" FontWeight="Bold" CommandName="PRINT_MOVE" BackColor="Green"/>
                <UserControl Height="10"/>
                <its:Button Label="반입취소" Width="100" Height="55" FontWeight="Bold" CommandName="DEL_RTN" BackColor="IndianRed"/>
            </StackPanel>
        </UserControl>
    </Canvas>
    </TabItem>
    </TabControl>
</its:ItsPageTml>
